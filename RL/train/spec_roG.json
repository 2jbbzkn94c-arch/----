    "phases_v2_design":  {
                             "_status":  "DESIGN ONLY - not yet executed. Written 2026-09-14 for user review at breakfast.",
                             "_why":  "Old plan tuned 61 knobs against a single fixed opponent (base difficulty-2). Two problems measured tonight: (a) opponent beam 100..800 makes no measurable difference to the candidate win rate (53.1/56.2/53.1/56.2 over 32 games each), so the fixed opponent is not what caps us - and a fixed opponent with a wrong forward model teaches the trainer to exploit its blind spots; (b) a fixed opponent saturates the signal once we pass it, while self-play always sits near 50%.",
                             "step0_fix_signal_first":  {
                                                            "goal":  "clean the residual diff family that biases the score signal itself (damage over-predicted by 1..4; counter-attack predicted then absent)",
                                                            "evidence":  "monitor round 7: ~7 of ~11 events are this family",
                                                            "gate":  "after the fix, rerun the full -All gate and the long random scan"
                                                        },
                             "step1_opponent_pool":  {
                                                         "goal":  "replace \u0027fixed base opponent\u0027 with a league",
                                                         "mix":  {
                                                                     "self_play_vs_previous_checkpoint":  0.7,
                                                                     "base_difficulty2_beam100":  0.3
                                                                 },
                                                         "needs_code":  "RlTrain.ps1 currently takes ONE global opponent (spec.opponent). League = per-cell opponent selection + -wB injection for the cand-vs-cand path (opp=cand already supported by 对局.gd). No frozen file needs editing.",
                                                         "gate":  "small equivalence run: same cells serial vs parallel, and a 2-arm sanity run (self-play vs base) before any long run"
                                                     },
                             "step2_search":  {
                                                  "goal":  "screening then coordinate ascent, not 61 knobs at once",
                                                  "phase_screen":  "P1 arms (22 configs x 32 games) -\u003e keep only 3..6 levers whose paired delta-pts CI excludes 0",
                                                  "phase_ascent":  "each round moves 1..2 parameters only, 96 games, accept only if paired delta-pts CI excludes 0; 10..20 rounds; every accepted step is a new named config (auditable)",
                                                  "hero_coefficients":  "grouped by role (tank/dps/support) + a few high-impact heroes, never all 49 at once",
                                                  "primary_metric":  "paired delta-pts per game (information per game ~3-5x that of win/loss); win rate is display only"
                                              },
                             "league_ascent":  {
                                                   "goal":  "coordinate ascent against an opponent that gets stronger with us, instead of a fixed opponent we can overfit",
                                                   "round_structure":  "each round: 70% of cells self-play vs league.checkpoint, 30% vs the fixed difficulty arm (opp=base, beam_opp=100); accept a step only if paired delta-pts CI excludes 0 against BOTH arms",
                                                   "checkpoint_update":  "after the round, write the accepted candidate weights to RL/weights/league_current.json (that file is what the next round\u0027s self-play cells read)",
                                                   "why_deterministic_split":  "which cells are self-play is sha256(run|config|seed|first)-derived, so the same cells stay self-play across generations and the paired comparison stays valid; the checkpoint\u0027s sha12 enters the cell key, so a new checkpoint invalidates exactly the old self-play measurements",
                                                   "cost_note":  "self-play cells run opp=cand, i.e. both sides at beamA=400; the fixed arm runs opp=base at beam_opp=100 and is much cheaper, so a 70/30 round costs more per game than a P1 arm"
                                               },
                             "step3_acceptance_panel":  {
                                                            "goal":  "one-shot holdout against a panel, not just the base opponent",
                                                            "panel":  [
                                                                          "base difficulty2 beam800 (production truth)",
                                                                          "base difficulty2 beam100 (weakened, overfit probe)",
                                                                          "previous generation of ourselves",
                                                                          "mirror self-play (expect ~0.50)"
                                                                      ],
                                                            "gate":  "Wilson 95% lower bound \u003e 0.5 against both base arms AND \u003e 0.5 against our own previous generation (the anti-self-deception check)",
                                                            "holdout_discipline":  "holdout seed set + holdout lineup pool are still touched exactly once (existing guard)"
                                                        },
                             "beam_decisions_measured":  {
                                                             "candidate_side":  400,
                                                             "candidate_evidence":  "200/400/600/1200 all within noise (50.0/56.2/53.6/50.0, N=24..32)",
                                                             "opponent_side":  100,
                                                             "opponent_evidence":  "100/200/400/800 all within noise (53.1/56.2/53.1/56.2, N=32 each); injection proven by 14/10/10 of 32 games differing plus the pre-patch 800 arm matching 28/28"
                                                         }
                         },
    "_weight_training":  "2026-09-17 权重训练专用 spec：候选 beam=对手 beam=200（与困难档同步），两边同一套英雄 deck（hero_06,hero_17,hero_26）⇒ 唯一变量 = 权重。判据：候选胜率必须 \u003e 50% 才算有意义的权重。",
    "_round2":  "2026-09-17 round 2：基线 = 噩梦.json（含已确认的 THREAT_MOVE_DISCOUNT=0.45）。镜像同队伍、beam 200/200 ⇒ 唯一变量=权重。控制臂 r2_ctrl = 新基线。",
    "_broad_A":  "广度扫（用户口径）：队伍 hero_06,hero_17,hero_26；asides 只有 e；每队每权重 4 种子 × 先后手 2 把 = 8 把；镜像同队伍、beam 200/200。",
    "_stack_batch":  "叠加批次（2026-09-19 收尾）：把今晚两个\"方向对\"的改动叠起来 —— 并列裁决（TIEBREAK_MODE=1，探针实测能改 100% 的对局，5 队 Δpts +0.79 / 生产侧 0.55）+ FOCUS_FIRE_WEIGHT=45（历史最强权重信号 Δpts +4.97 [+1.88,+8.07]，7 队）。队伍 G。"
