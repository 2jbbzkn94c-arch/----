					#     同一个条件、O(1)），只有"名义上够得着"的敌人才付 `_threat_can_hit` 的钱
					#     （它内部第一层"站着就能打"命中时**不跑 BFS**，正是"站在火力线上"的常见情形）。
					if grid.distance(eu.cell, hu.cell) <= eu.emove + eu.atk_range \
							and _threat_can_hit(sim, eu, hu.cell, hu):
						score += wsh
						break
	# 吃增益道具：本回合实际拾取的道具按价值计入（攻击/移动/圣盾/回血），
	# 让 AI 主动绕路去吃有用的道具，而不是"顺路才吃"。
	# 【RL 修正 2026-09-15·用户选 B】`buff_taken` 已**按阵营定符号**（见 `_buff_gain`）：
	# AI 自己拾取 +价值、玩家方拾取 −价值 → 这里不再是无条件加分。
	score += sim.buff_taken * w_buff_take
	# 【2026-09-15 整项删除·用户决定】这里原先有一项"站在炸弹格 −8 分"（BOMB_STAND_PENALTY）：
	# 本引擎的模拟**已经真的会算**落停／被击退／换位／拉拽落到炸弹上的 5 点伤害
	# （SIM_BOMB_DAMAGE + _sim_trigger_bomb，见 _apply 的落停引爆段与四条强制位移），
	# 那一项属于重复计价，故删除（可调键 35 → 34）；"炸弹该不该踩"现在完全由模拟的伤害账决定。
	# 走位候选(见 _actions_for):矿工把可达金矿格排最前(d=-1),这里额外把"能走到金矿"纳入评分,
	# 让"绕路去吃矿"也值得,而不只盯着当前占格。
	# 搏命攻击激励：敌方单位本回合攻击过（即使之后被反死也保留 attacked 标记），且**逃不掉且必死**。
	# 这种单位注定会被击杀，死前攻击换血是划算的；给一个足够大的激励，
	# 抵消"玩家反击/单位死亡"等扰动对攻击方案的压制。
	# 判据必须是 _was_doomed（"当前格致命 + 所有可达格也致命"）——
	# 早先这里只判了"当前格会被打到"，等于**只要停在会被打的位置就白拿 +6+1.5×攻击力**，
	# 反而奖励了"贴脸打 1 点"（远程最差走法）。
	for i in sim.units.size():
		var u2: SimUnit = sim.units[i]
		if u2.fn == DataRegistry.Faction.ENEMY and u2.attacked and _was_doomed(sim, u2):
			score += 6.0 + float(u2.eatk) * 1.5
	# 【2026-09-15 已合并 · 2026-09-20 再删·用户决定】原来的"玩家反应前瞻"曾并进 `_threat_forecast`（威胁图位置统一算），
	# **该族已于 2026-09-20 第三轮整族删除**（见 `_dead_fold()` 上方说明）⇒ 这里也不再有任何"挨打前瞻"项。
	# 【2026-09-15 删除·用户决定】这里原有两项**写死的状态奖励**（§14#12 里的另两个）：
	#   ① "骗反击名额 +0.5"：数"玩家本回合已反击过几个单位"→ 每人 +0.5。
	#      用户判定**反直觉、删掉**（原话）："正常来说让对方反击次数越少越好，每多一次你就要吃一次反击伤害"
	#      —— 挨的那一下反击伤害本来就已经记在血量账里了，再因为"对方额度用掉了"发 0.5 分是重复计价 + 方向可疑。
	#   ② "德鲁伊光环 +0.6"：AI 这方有活着的未沉默 hero_08 时，给自己每个伤员 +0.6。
	#      用户判定**没啥用、删掉**；量级 0.6/伤员 也确实只是"打平时候的倾向"（对比 1 点血 = 1 分）。
	#      注意：德鲁伊回合末的群体治疗**本引擎的模拟并没有实现**，所以这一项从来不是"算出被奶回来的收益"，
	#      只是一个固定补贴；真要做对，应该让模拟在回合末真的结算一次治疗（"预测≈真实"方向）。
	# 两项删除后，本函数末尾不再有写死的状态分（唯一剩下的写着死数的是 `_actions_for` 里
	# "吃道具格优先"那个硬编码 3.0，见 §8）。
	# 【2026-09-18 新增·默认关闭】终局项（判负线凸曲线）：`w_terminal` = 0 时这一行不执行 ⇒ 逐位不变。
	if w_terminal != 0.0:
		score += w_terminal * _terminal_value(sim)
	# 【2026-09-21 新增·默认关】两项"队形"评分（见 `const FORM_COHESION_W` 处说明）：
	#   ⑳抱团（每个我方单位至少一个队友在 FORM_RADIUS 格内、且中间没被障碍/墓碑挡开）·
	#   ㉑退路/被夹（可走邻格 / 邻敌多于邻友）。两项都是纯局面量、纯罚分（永远 ≤ 0）。
	#   ⚠️ **只在末态结算**（`end_of_turn`，2026-09-21 深夜用户口径「不要计算过程，按照行动完的站位计算」）：
	#   中途恒为 0 ⇒ 不会再出现「死神走开扣 3 分、下一个队友贴回来又 +3」的来回。详见 const 处说明。
	if end_of_turn and (w_form_cohesion != 0.0 or w_form_escape != 0.0 or w_form_spread != 0.0):
		var fp := _formation_parts(sim)
		score -= w_form_cohesion * fp.x
		score -= w_form_escape * fp.y
		score -= w_form_spread * fp.z   # 【2026-09-22】㉓离队距离（⑳ 的每格梯度，见 const 处说明）
	# 【2026-09-22 新增·默认关】㉒隔断（见 `const SPLIT_W` 处说明）：奖励"用身体把玩家切开"的站位
	#   —— 塔盾扛不到那 1 点、医护兵奶不到、嬉皮死神打孤立目标翻倍。
	#   与 ⑳㉑ **同一层**：只在"全队都行动完"的末态结算（纯站位量，中途结算会来回跳）。
	if end_of_turn and w_split != 0.0:
		score += w_split * _split_parts(sim)
	return score

# 【2026-09-18 新增·默认关闭】终局项：把"死 3 个判负"这条线变成单调且**越近越陡**的分。
# 用户第 2/3 条要的"最优平衡"里，最重要的就是别把队伍送到判负线上；而 `_evaluate` 原本
# **没有任何终局项**（噩梦档还把 KILL_BONUS / SELF_DEATH_W 都设成了 0 ⇒ 彻底没有死亡意识）。
# 我方存活 3/2/1/0 → 0 / −10 / −100 / −1000；对方 3/2/1/0 → 0 / +10 / +100 / +1000。
# 语义：① "再死一个就输"（剩 2）时，任何会导致阵亡的线路都被显著压低；
#       ② 对方剩 1 个时，"能收割就收割"的价值暴涨（人类玩家的收尾意识）；
#       ③ 数值按 10 倍递进 ⇒ 是**凸**的，而不是线性的"每人头等值"。
func _terminal_value(sim: Sim) -> float:
	var mine := 0
	var foe := 0
	for i in sim.units.size():
		var u: SimUnit = sim.units[i]
		if u == null or not u.alive:
			continue
		if u.fn == DataRegistry.Faction.ENEMY:
			mine += 1
		else:
			foe += 1
	mine = clampi(mine, 0, 3)
	foe = clampi(foe, 0, 3)
	const MINE_CURVE := [ -1000.0, -100.0, -10.0, 0.0 ]    # 下标 = 我方存活数
	const FOE_CURVE := [ 1000.0, 100.0, 10.0, 0.0 ]         # 下标 = 对方存活数（0 = 全灭我赢）
	return float(MINE_CURVE[mine]) + float(FOE_CURVE[foe])

# 【2026-09-15 合并·用户决定】「威胁图」与「玩家反制前瞻」原本是**两项、两把尺子**在描述同一件事
# （下回合会不会挨打）：
#   · 威胁图 `_threat_map`：求和口径的来袭伤害 ÷ 当前血 × 3.0（**比例尺**）+ "安全格 +1.0"（**单向**）
#   · 反制前瞻① `_player_reaction_threat`（**已改口径**：现在只是给 `tests/PlayerLookaheadVerify.gd` 用的兼容壳）
#     —— "允许先贴一步"这件事 `_incoming_damage` 里本来就算了（距离 ≤ 射程 + 移动力，要动一步的折算 0.7），
#        "能击杀"的特殊加价也被下面的 ② 覆盖 → 这一半是**重复**的
#   · 反制前瞻② 集火拔除：来袭合计 ≥ 当前血 → −身价 × 0.5（**与威胁图调同一个 `_incoming_damage`，白算第二遍**）
# 现在合成**一项、一把尺子**（都是"分"）：
#   ① 挨打血点：− `THREAT_INCOMING_W` × 预期承受伤害（与血量账同尺子：1 点血 = 1 分 × 权重）
#   ② 会被打掉：合计 ≥ 当前血 → 再按**身价**罚一次（原反制前瞻②；身价是"这个单位值多少"，
#      比原来①里"按被击杀者攻击力×1.5+2"更贴切）
#   ③ 数值来源：当时那把"按目标"的尺子（`_incoming_damage_on`，**已删**：把 嘲讽拉仇恨 / 圣盾 / 重伤 / 坚固 /
#      相邻塔盾代扛 都算进去，用户 2026-09-15 定）——不再用"逐格"的 `_incoming_damage`。
# 顺带：原来①那一半每个玩家单位每次评估都要跑一次 `_move_cells`（寻路），删掉后评估更快。
# 【2026-09-15 删掉 ⓪ "安全的输出位 +1.0"（`THREAT_SAFE_CELL`）·用户决定】
#   原条件：`incoming == 0`（没人够得到它）**且**它下回合够得着人 → +1.0。
#   删的理由（用户："`THREAT_SAFE_CELL` 这个有什么意义"后确认删除）：
#     · "能打人"已经有分（血量账 + 集火 frac²），"不挨打"本身就是**不扣分**（本函数下面两支都不触发）
#       → 它唯一独有的语义只是"把 incoming=0 和 incoming 很小分开"，值 1 分多；
#     · 量级太小（1 分/单位，对比 击杀 38 / 身价 20 / 1 点血 1 分），只在两条候选打平时才起作用；
#     · 而且它是"状态奖励"不是"动作奖励"（怎么到达那个位置不影响得分），还只对 `eatk > 0` 的单位生效。
#   删掉后：**完全安全 = 不扣分**，就这么多；`_can_hit_next_turn()` 随之成为死代码，一并删除。
## 【2026-09-20 用户设计】"可接受伤害"开关的**生效阈值**（唯一出口）：**未交战**时返回阈值（> 0 = 生效），
## **交战中**返回 0.0 = 不生效（改由"本回合输出 / 被反击 / 下回合总伤害"三笔账权衡）。
## ⚠️ 【2026-09-20 用户第五次改口径】**判据时机 = 本回合行动前**（读局面上的 `sim.engaged0` 快照，
## 建局时算一次）—— 用户原话：「第一个回合 AI 首发，他走完即使在对方的攻击范围内，他也应该是未交战，
## 阈值判断有效。**他判断的时机应该是本回合行动前**」。
##   改之前是**在候选局面上现算**（`_engaged(sim)`）⇒ 自己走进对方威胁圈的那一步就把阈值关掉了，
##   于是"开局第一步冲进射程"这件事**根本没被 ⑥ 拦过**（只有第一步之前的那几步被拦）。
##   现在：整回合用同一个判据 ⇒ 只要**回合开始时**没交战，这一回合所有走位都按阈值扣分。
## "交战"的定义见 `_engaged()`（我方有单位进了敌方的"射程＋移动力"威胁圈）。
## ⚠️ 阈值本身**只用于软扣分**（`_rule_b_score()`：超出部分按血点罚）—— 用户 2026-09-20 第二次改回了这个语义。
## ⚠️ 关掉时（`w_move_accept_damage <= 0`）**先短路再判交战**（否则每次 `_evaluate()` 都要付一次位置判定）。
func _accept_threshold(sim: Sim) -> float:
	if w_move_accept_damage <= 0.0:
		return 0.0
	if sim.engaged0:
		return 0.0
	return float(w_move_accept_damage)

## 规则 B「下回合站位约束」（2026-09-15 用户定；**默认全部关闭** ⇒ 参数都是关闭值时直接返回 0.0）。
## 用户原话：「如果够不着，要尽可能贴近敌人，但要考虑敌人下回合的可攻击范围以及可接受伤害」。
## ⇒ `ENGAGE_PULL_PER_CELL` 负责"**贴近**"，本函数负责"**以什么方式贴近**"（两者协同，不是替代）。
##   ① `MOVE_ACCEPT_DAMAGE`：**"超出阈值的部分按血点罚"（软扣分）** —— 这个语义在 2026-09-20 被改了两次、
##      最终回到软扣分：先被改成"硬门禁"（未交战时把"挨打 ≥ 阈值"的落点整格砍出候选表），用户实机判定否掉
##      （「阈值还是像之前那样超过阈值就扣分吧。现在一刀切的话，有 buff 也不拿了」）⇒ **门禁整段删除**。
##      现状：未交战（`_accept_threshold()`）时 `罚 = max(落点挨打 − 阈值, 0) × HP_VALUE_W`；交战中不罚。
##      候选表**一字不动**（带增益道具/金矿的格子照旧可选），也**没有**恢复旧的候选排序剪枝。
##   ② `EVADE_NETWORK_BONUS`：站得让**对方路网距离 > 它移动力 + 射程**（真够不着我）→ 每个这样的敌人加分。
##      棋盘只有 5×7、敌人包络常见 3~6 格 ⇒ 这一条多数局面拿不到（生产与噩梦都是 0）。
##   ③ `NEXT_TURN_THREAT_W`：对称地算"我移动后下回合能威胁谁"（现在只有"本回合能打就打"）。
## 【2026-09-20 用户第四次改口径】"是否已经打起来" —— "可接受伤害"开关的**限定条件**。
## 用户原话：①「这个阈值开关**不要按照有没有产生伤害来判断，按照有没有进入敌人的攻击范围**」
##   ②「**攻击范围需要加移动力**」。
## ⇒ 判据（唯一一条）：**我方任一存活单位处在敌方任一存活单位的"攻击范围"之内** ⇒ 已交战，
##   其中**攻击范围 = 射程 + 移动力**（= 这个对手下回合"走上去就能打到"的那一圈 = 全引擎统一的
##   `_threat_can_reach()`，与 ⑥ 自己罚分、撤退过滤、必死折用的是**同一把尺子**；远程被贴脸射程压 1）。
## ⚠️ 与旧口径（① 任一方掉过血 **或** ② 任一敌我单位相邻）的三处差别：
##   · **不看"掉过血"** —— 那是"已经打完了"的**滞后信号**（用户点名的毛病：等掉血才关阈值太晚）；
##   · **不再单独判"相邻"** —— 距离 1 必落在任何单位的威胁圈内（`射程 ≥ 1`）⇒ 已被本判据涵盖；
##   · **判据提前很多** —— 进"对方下回合够得到我"的圈就算交战（不是等它真开火）。
## ⚠️ 【2026-09-20 第五次改口径·时机】**本函数现在只在建局（`build_state`）里调用一次**，
##   结果存进 `Sim.engaged0` ⇒ ⑥ 的开关判据 = **本回合行动前**那一刻的状态，**整回合不再变**。
##   用户原话：「第一个回合 AI 首发，他走完即使在对方的攻击范围内，他也应该是未交战，阈值判断有效。
##   **他判断的时机应该是本回合行动前**」⇒ 改之前是"在候选局面上现算"（走进射程就翻面），
##   于是"开局第一步冲进射程"根本没被 ⑥ 拦过。
## 成本：每回合建局时算一次（O(单位数²) 次 `walk_dist` 查表，BFS 场缓存共享）⇒ 可忽略。
func _engaged(sim: Sim) -> bool:
	for i in sim.units.size():
		var u: SimUnit = sim.units[i]
		if u == null or not u.alive or u.fn != DataRegistry.Faction.ENEMY:
			continue
		for j in sim.units.size():
			var v: SimUnit = sim.units[j]
			if v == null or not v.alive or v.fn == u.fn:
				continue
			# 【2026-09-21】加视线判据：隔着墙「够得到」不算进威胁圈（与 _incoming_total_on / ⑦ 同一把尺子）
			if _threat_can_hit(sim, v, u.cell):
				return true
	return false

func _rule_b_score(sim: Sim) -> float:
	# 【2026-09-20 用户决定·第二次改】**阈值回到"软扣分"**（原话：「阈值还是像之前那样超过阈值就扣分吧。
	#   现在一刀切的话，有 buff 也不拿了」）⇒ 恢复 `max(挨打 − 阈值, 0) × HP_VALUE_W`：
	#     ① **不删候选** ⇒ 带增益道具/金矿/关键落点的格子照样可选，只要"挨这顿"值这个价；
	#     ② 阈值仍只在**未交战**时生效（`_accept_threshold()`，交战中返回 0 = 不罚）—— 这是同一天上一轮定的口径；
	#     ③ **不恢复**旧的候选排序剪枝（`dkey += threat − 阈值`）：那条也会把带 buff 的格子挤出候选表。
	var thr := _accept_threshold(sim)
	# 【已删 2026-09-20·用户拍板】原规则 B 的另一半（`EVADE_NETWORK_BONUS` / `NEXT_TURN_THREAT_W`）已判死删除 ⇒
	#   本函数现在**只剩"软扣分"这一支**。
	# 【2026-09-20 用户要求·口径改动】比较用的数从"逐敌人求和"（`_incoming_damage`，会把每个够得着的
	#   敌人都算成打这一格 ⇒ 虚高 k 倍）换成 **`_incoming_total_on()`：这个英雄**下回合会挨多少血**
	#   （所有能打到他的敌人的伤害**总和**，按目标算、不折减）⇒ 未交战时 `罚 = max(挨打合计 − 阈值, 0) × HP_VALUE_W`。
	if thr <= 0.0:
		return 0.0
	var s := 0.0
	for i in sim.units.size():
		var u: SimUnit = sim.units[i]
		if u == null or not u.alive or u.fn != DataRegistry.Faction.ENEMY:
			continue
		var inc := _incoming_total_on(sim, u, u.cell)
		if inc > thr:
			s -= float(inc - thr) * w_hp_value
	return s

## 【2026-09-21 用户拍板 A】**一次算好"每个我方单位下回合会挨多少"**（=「挨打合计」，
##   `_incoming_total_on()`：按目标求和的真实单击 + 移动后技能 + 毒 + 盾修正）。
## 谁读它：**⑦核心风险** 与 **⑮必死折**（合并成一次遍历 ⇒ 只多一份 `_incoming_total_on` 的开销）。
## 返回与 `sim.units` 同下标的数组（非我方/已阵亡 = 0）。调用方负责门控（两个权重都为 0 时别调）。
func _incoming_incs(sim: Sim) -> Array:
	var incs: Array = []
	for i in sim.units.size():
		var u: SimUnit = sim.units[i]
		if u == null or not u.alive or u.fn != DataRegistry.Faction.ENEMY:
			incs.append(0.0)
			continue
		incs.append(_incoming_total_on(sim, u, u.cell))
	return incs

## 【2026-09-21 用户拍板 A · 恢复】**⑦核心风险**（**max 型 · 位置暴露账**）：
##   罚 = `RISK_W × max_我方[ **挨打合计** ÷ 当前血 × 核心系数^RISK_CORE_POW ]`
## 为什么要它（用户实机反馈）：「没有威胁的话，就没有走位了…远程会乱跑，脱离队伍自己站到敌人那边」。
##   根因：删掉分摊族后 `_position_score()` 只剩"够不到人时的压上拉力"，**一个能开火的单位站在哪
##   分数完全一样**；而候选排序键 `dkey` 只管"形状"（远程：卡射程边缘 1.0 分最好、被贴身 60 分最差）
##   且**不进分数** ⇒ 它会为了躲贴身、凑射程边缘**绕到敌人背后**，而那里没有任何一项在扣分。
## 为什么是 **max 型**（不是 Σ）：只罚最危险的那一个 ⇒ 其余单位没有"各自躲一格"的收益
##   （2026-09-20 实测教训：逐单位线性挨打血点 ⇒ 人人各自躲、队形散、该打不打）。
## 与旧版的唯一差别：**输入换成「挨打合计」**（不折减、不分摊）—— 旧版读的是已删除的分摊向量
##   ⇒ 同一 `RISK_W` 下本项比旧版强约 2~4 倍（见 `_2026-09-21 恢复` 的换算说明：18 血单位被 3 个
##   3 攻敌人盯上：旧版分摊后 3 点 → 0.17×W，本版求和 9 点 → 0.5×W）。
func _exposure_risk(sim: Sim, incs: Array) -> float:
	if w_risk == 0.0:
		return 0.0
	var core_ref := _core_ref(sim) if w_risk_core_pow != 0.0 else 0.0
	var risk_max := 0.0
	for i in sim.units.size():
		var u: SimUnit = sim.units[i]
		if u == null or not u.alive or u.fn != DataRegistry.Faction.ENEMY:
			continue
		var inc: float = float(incs[i]) if i < incs.size() else 0.0
		if inc <= 0.0:
			continue                      # 完全安全：不扣分就是它的全部价值
		var r := inc / float(maxi(u.hp, 1))
		if w_risk_core_pow != 0.0:
			var cf := clampf(_core_raw(sim, u) / core_ref, VALUE_IMPORTANCE_MIN_RATIO, VALUE_IMPORTANCE_MAX_RATIO)
			r *= pow(cf, w_risk_core_pow)
		risk_max = maxf(risk_max, r)
	return -(w_risk * risk_max)

## 核心量 = **静态身价**（`_unit_value`）。`CORE_BY_THREAT`（改用"本回合最大单击"）2026-09-20 已判死删除。
func _core_raw(sim: Sim, u: SimUnit) -> float:
	return _unit_value(sim, u)

## 核心系数的**基准** = 我方存活单位的均值；取不到时兜底 `VALUE_IMPORTANCE_REF`。
func _core_ref(sim: Sim) -> float:
	var sum := 0.0
	var n := 0
	for i in sim.units.size():
		var u: SimUnit = sim.units[i]
		if u == null or not u.alive or u.fn != DataRegistry.Faction.ENEMY:
			continue
		sum += _core_raw(sim, u)
		n += 1
	var ref := sum / float(n) if n > 0 else 0.0
	return ref if ref > 0.0 else VALUE_IMPORTANCE_REF

## 【2026-09-20 用户拍板·第三轮 / 2026-09-21 改接口】**必死折**：
##   站在当前格 ⇒「**挨打合计**」≥ 当前血（= 下回合会被打掉）⇒ 罚 `身价 × THREAT_DEAD_FOLD`。
## 为什么保留它：它是"别把核心留在必死位"的罚分，也是实测里三个写死数中唯一真正改变取舍的那个（§14#12）；
##   它不需要分摊那套估算 —— 直接复用量尺统一的那把尺子（与 ⑥规则B / 撤退过滤 / `_was_doomed()` 同一把）。
## 这一支**没有必死豁免**：它可以通过"这回合先把火力点解决掉"消除 ⇒ 是决策相关的，不是常数。
## `incs` = `_incoming_incs(sim)` 的结果（与 ⑦核心风险共用一次遍历）。
func _dead_fold(sim: Sim, incs: Array) -> float:
	if w_threat_dead_fold == 0.0:
		return 0.0
	var s := 0.0
	for i in sim.units.size():
		var u: SimUnit = sim.units[i]
		if u == null or not u.alive or u.fn != DataRegistry.Faction.ENEMY or u.hp <= 0:
			continue
		var inc: float = float(incs[i]) if i < incs.size() else 0.0
		if inc >= float(u.hp):
			s -= float(_unit_value(sim, u)) * w_threat_dead_fold
	return s

## 【2026-09-23 新增·默认关】㉕嘲讽吸火（`TAUNT_SOAK_W`，口径见文件上方 const 处的长说明）：
##   对每个**存活的我方非嘲讽单位** X：`关掉嘲讽门时的挨打合计(X) − 实际挨打合计(X)`（> 0 = 嘲讽门替它挡下了这些伤害），
##   再乘 `_incoming_pool_mult(X)`（与 ③血量账 同一套血量池折算 ⇒「坦克拿 2 点换脆皮 4 点」自动变成赚）。
## 只读**当前局面**（单位现在站的位置），不看候选落点 ⇒ 与 ⑥⑦ 同层、可被任意一步的行动改变。
## ⚠️ 性能：① 只在"我方有存活嘲讽单位"时才算（没有嘲讽 = 整项 0 开销）；
##   ② 每个非嘲讽单位**先算"关掉嘲讽"的那一趟**，为 0（没人够得到它）就直接跳过第二趟 ⇒ 常见局面只多一趟；
##   ③ 嘲讽单位自己**不算**（它挨打本来就是本分；它的收益在 ⑭`SOLID_HOLD_W` 那笔"站着换[坚固]"与 ③⑦ 的少挨账里）。
func _taunt_soak(sim: Sim) -> float:
	var has_taunt := false
	for i in sim.units.size():
		var t0: SimUnit = sim.units[i]
		if t0 != null and t0.alive and t0.fn == DataRegistry.Faction.ENEMY and t0.skills.has(DataRegistry.Skill.TAUNT):
			has_taunt = true
			break
	if not has_taunt:
		return 0.0
	var s := 0.0
	for i in sim.units.size():
		var u: SimUnit = sim.units[i]
		if u == null or not u.alive or u.fn != DataRegistry.Faction.ENEMY:
			continue
		if u.skills.has(DataRegistry.Skill.TAUNT):
			continue                                  # 嘲讽单位自己不算（见上方说明）
		var free_inc := _incoming_total_on(sim, u, u.cell, {}, true)
		if free_inc <= 0.0:
			continue                                  # 关掉嘲讽也没人打得到它 ⇒ 差额必然 0，省掉第二趟
		var soaked := free_inc - _incoming_total_on(sim, u, u.cell)
		if soaked > 0.0:
			s += soaked * _incoming_pool_mult(u)
	# 【2026-09-23 深夜⑮·用户拍板"封顶"】**"少挨的血点"不可能超过对手这一回合的总输出**。
	#   病灶（用户实机「锤头鲨龟缩不前」+ 探针自证）：上面那个 Σ 是**对每个非嘲讽我方单位各求一次**
	#   `关掉嘲讽门 − 实际`，而**同一发对手攻击只能落在其中一个人身上** ⇒ 有两个脆皮被掩护时，
	#   同一笔伤害被记两次。实测（`RL/probe/锤头鲨不前进自检.gd`）：原始血点 **20.59**，
	#   而对手全队一回合的输出上限 = 4+5+1 = **10**（正好贴着双倍）⇒ ㉕ 单项 61.76 分，
	#   把"5 伤的进攻"彻底压死 ⇒ 计划变成龟缩。
	#   封顶口径 = **对手这一回合"普通攻击"的总输出**（只有 ① 走嘲讽门，②技能/③毒 本来就不受门控）：
	#   逐个存活对手取 `_echo_atk_now()`（共鸣者按共鸣后的值），**后勤/眩晕者不能主动攻击 ⇒ 不计**
	#   （与 `_threat_can_hit()` 开头那道门同一口径）。O(单位数)，不跑 BFS，热路径安全。
	var foe_cap := 0.0
	for i in sim.units.size():
		var e: SimUnit = sim.units[i]
		if e == null or not e.alive or e.fn == DataRegistry.Faction.ENEMY:
			continue
		if e.stunned or e.skills.has(DataRegistry.Skill.LOGISTICS):
			continue
		foe_cap += maxf(_echo_atk_now(sim, e), 0.0)
	return minf(s, foe_cap)

## 【2026-09-23 深夜⑫·用户拍板 A】⑭`SOLID_HOLD_W` 的"**它真的站在前面**"判据。
##   用户实机（截图 `PICTURE/堡垒不向前.png`）：敌方装甲堡垒蹲在左上角不进。那一局的账 ——
##   ① ⑤压上拉力 `ENGAGE_PULL_PER_CELL` 只在 `到最近敌人的路网距离 > 移动+射程` 时生效，而它
##      `2+1 = 3`、我方最近的单位**正好在 3 格外** ⇒ **从 3 格一路到贴脸都没有任何拉力**；
##   ② ⑭ 那 5 分却**不分位置**：缩在全队最后面、谁的刀也没挡，照样白拿（代价是"一挪窝就没了"）
##      ⇒ 原地 +5.0 / 前进 +0 ⇒ 搜索每次都选不动。
##   ③ 真正给"坦克往前站"付钱的是 ㉕`TAUNT_SOAK_W`（3.0，挡下我方火力才算钱），但它得**先挪到**
##      能挡住我方火力的位置才拿得到 ⇒ 得先把 ⑭ 这笔"缩在最后面的白钱"取消掉。
##   **判据**：它到最近敌人的路网距离 ≤ 自己**所有存活队友**到最近敌人的距离（并列也算它在前）
##   ⇒ "它是全队最靠前的那个（之一）"才付这 5 分。
##   ⚠️ **只改判据、不动 `SOLID_HOLD_W` 的值**：那个 5.0 有 6 队批量证据（=5 → +8.11 分，
##      见 `噩梦.json` 的 hero_48 注释），而且这条判据改动**不随键回退**。
##   ⚠️ 成本：只在"hero_48 + 本回合没动 + 键非 0"时才算，且**放在 `_threat_can_hit()` 那圈之前**
##      —— O(队友数 × 单位数) 次路网距离查表，比它后面那一圈便宜。
func _solid_front_ok(sim: Sim, hu: SimUnit) -> bool:
	var mine := _nearest_enemy_dist(sim, hu)
	for i in sim.units.size():
		var ally: SimUnit = sim.units[i]
		if ally == null or not ally.alive or ally == hu or ally.fn != hu.fn:
			continue
		if _nearest_enemy_dist(sim, ally) < mine:
			return false          # 有队友比它更靠前 ⇒ 它是缩在后面那个，不给钱
	return true

## 【2026-09-21 用户拍板 A】**"我方挨打"的血量池折算**：
##   倍率 = `1 + INCOMING_POOL_W × (参考血 TRADE_HP_REF(20) ÷ 该单位**本回合起始血** − 1)`（比值夹在 0.5~3.0）
## 为什么需要它（用户实机）：「一个 2 的坦克不敢打 4 攻的输出，但实际坦克的血多，不一定亏」——
##   ③血量账 原来是**纯线性 1.0 分/血点**，不分血量池 ⇒ 独脚龟(33血)拿 2 点换火枪手(20血) 4 点被算成
##   −1.7 分（打出去 +2.3、被反击 −4.0），可按池子看是 12.1% 换 10%，几乎打平。
## 只折算**我方掉血**这一侧：我们**打出去**的那一侧已经有 ④集火 frac² 在做"按目标血量池计价"
##   （打空 20 血目标 = +30；只打 2 点 = +0.3）⇒ 两侧都折会造成重复计价。
## ⚠️ **2026-09-22 用户拍板 A：分母从"当前血"改成"回合起始血 `hp0`"**（改动动机是用户的两个观察）：
##   ① 「AI 掉血比玩家掉血值钱 ⇒ 就不打」：倍率只乘我方那一侧，而且**读的是打完之后的血**
##      ⇒ 同一笔伤害被按"最惨时刻"计价。实测（`RL/probe/避战自检.gd`）：红帽 13→9 血时那 4 点反击
##      记 **8.89 分**（= 4 × 2.22），而按回合初血量应是 4 × 1.54 = 6.15。
##   ② 「脆皮+坦克都能打同一个还没反击的敌人时，AI 会让坦克先吃反击」：这个行为**方向是对的**
##      （肉盾替脆皮吃反击 = 坦克本职，且让脆皮也出得了手），但**强度被"最惨时刻"放大了 ~1.4 倍**
##      （塔盾吃反击 −2.0 vs 红帽吃 −6.2，差 4.2 分；按当前血算会拉到 ~6 分）。
##   改成 `hp0` 之后：倍率反映的是"**这回合开始时这个单位的血量池有多大**"（本来就是它的语义），
##   同一笔伤害不再按最惨时刻计价，**结账顺序也不再影响结果**（与 T14 那类顺序依赖的教训同向）。
##   ⚠️ **生产三档逐位不变**：`INCOMING_POOL_W = 0`（简单/普通/困难的默认）时本函数恒返回 1.0，
##     与分母取什么**无关** ⇒ 只有噩梦档（= 1.0）受影响。
## ⚠️ 历史包袱：同族的 `VALUE_IMPORTANCE_POW`（按**身价**、两侧对称乘幂）2026-09-20 实测为**负**
##   （p2 Δ−8.35 / p3 Δ−5.00）⇒ 本项故意更窄：按**血量池**、只**我方**、在 20 血处归一
##   （20 血单位倍率恰好 1.0 ⇒ 与改动前逐位相同）。
func _incoming_pool_mult(u: SimUnit) -> float:
	if w_incoming_pool == 0.0:
		return 1.0
	# 【2026-09-22 A】分母 = **回合起始血**（`hp0`；本回合新召唤的是 0 ⇒ 退回当前血，避免除 0 后倍率被顶到上限）
	var ref_hp := u.hp0 if u.hp0 > 0 else u.hp
	var ratio := clampf(TRADE_HP_REF / float(maxi(ref_hp, 1)), 0.5, 3.0)
	return 1.0 + w_incoming_pool * (ratio - 1.0)
# ---- 【2026-09-20 用户拍板·第三轮】**整族删除**："下回合挨打"的**分摊**记账（2026-09-21 部分恢复，见下）----
# 用户原话（第三轮）：「下回合挨打这个太难了啊，想计算准确的话，要考虑走位，要考虑技能，技能有很多变，
#   考虑不完全。可以删掉吗」⇒ 删。**删掉且没有恢复的**：`THREAT_ALLOC_W`（⑮分摊总量）·
#   `_threat_alloc_vec()`（对手每次出手按"够得到几个人"按 1/k 摊、AoE 族各记全额）·
#   `_threat_alloc_weighted()` · `AOE_ATTACKERS` 常量 · 日志里的 `下回合挨打X.X(来源÷k)` 字段
#   （`_alloc_share_at()`）。
#   **为什么可以删**（实测）：`THREAT_ALLOC_W` 剂量批（5 队 × 3 种子 × 双先后手 = 30 配对/臂）
#     `2.0`−关掉 = **−0.20，CI [−9.40, +8.99]**；整族删族的 A/B（60 配对，代码级）Δpts **+7.50 [−8.14, +23.13]**
#     ⇒ **没有掉分**；它要手工建模"对手够得到几个人（走位）+ 各技能"，永远算不全。
#   **2026-09-21 用户拍板 A（恢复一半）**：`RISK_W` / `RISK_CORE_POW` 两个键 + `_exposure_risk()`（⑦）
#     回来了，但**输入换成「挨打合计」**（`_incoming_incs()`，不做分摊/AoE 几何/移动折减）——
#     因为删掉之后实测出现"远程绕到敌人背后"（空位没有任何位置分）。**恢复的只是"位置暴露"这一层**，
#     分摊向量与日志那两个数**没有再回来**。
#   · `_outgoing_threat_on()` **保留**：并列裁决 mode≥2 的"威胁差"还在用它。
#   · `THREAT_MOVE_DISCOUNT`（0.7）**保留**：现在只剩 `_outgoing_threat_on()` 与 `_bulwark_soak()` 读它。
#   ⚠️ 历史 spec（`RL/train/spec_*.json`）里凡有 `THREAT_ALLOC_W` 的都会因未知键被拒（训练器校验 theta 键）。

# 兼容壳：`tests/PlayerLookaheadVerify.gd` 直接调这个旧名字（它验的就是"玩家反制"这一族）。
# ⚠️ 原语义 = ⑦核心风险（分摊向量，已删）。现在改用**唯一剩下的那把尺子**：对手能打到我方 ⇒
#   「挨打合计」（`_incoming_total_on`）为正 ⇒ 值更负；对手够不到 ⇒ 0
#   ⇒ 那个 harness 的两条断言（贴脸更负 / 远离≈0）仍然成立。
#   **它不进任何评分**（`_evaluate` 不再调它），只为那个 harness 保留 —— 别往这里加东西。
func _player_reaction_threat(sim: Sim) -> float:
	var s := 0.0
	for i in sim.units.size():
		var u: SimUnit = sim.units[i]
		if u == null or not u.alive or u.fn != DataRegistry.Faction.ENEMY:
			continue
		s -= maxf(_incoming_total_on(sim, u, u.cell), 0.0)
	return s

# 【2026-09-18 新增】"威胁"算子 = 当时那把"按目标挨打"尺子（`_incoming_damage_on`，**已删**）的**镜像**：
#   这个单位**本回合最多能打出多少伤害**（对每个可达的敌方目标取最大，含重伤/坚固/圣盾/嘲讽/塔盾修正）。
# 为什么用它当"核心"：静态身价只说明"这个英雄值多少"（队内区分度只有 1.01~1.23×），
# 而**当前能打出多少伤害**才是"它现在有多危险/多重要"——残血被围的人威胁掉到 0，
# 站位好能打到三个人的低分英雄威胁很高。这正是人类说的"核心"。
func _outgoing_threat_on(sim: Sim, actor: SimUnit) -> float:
	if actor == null or not actor.alive:
		return 0.0
	if actor.moved and actor.attacked:
		return 0.0                 # 本回合已经行动完：不再构成威胁
	var best := 0.0
	for i in sim.units.size():
		var t: SimUnit = sim.units[i]
		if t == null or not t.alive or t.fn == actor.fn:
			continue
		var d := walk_dist(sim, actor.cell, t.cell)
		# 【2026-09-23 深夜⑧】嘲讽折进去：按**开火那格**判（原来无 `from_cell` ⇒ "够得到就锁死"，见 `_taunt_allows`）
		if not _threat_can_hit(sim, actor, t.cell, t):
			continue
		var one := _threat_hit_value(sim, actor, d)
		if t.heavy:
			one += 1.0             # [重伤] 受伤 +1
		if t.solid:
			one = maxf(one - 1.0, 0.0)   # [坚固] 攻击伤害 −1
		if one > 1.0 and _bulwark_for(sim, t) != null:
			one -= 1.0             # 相邻塔盾替它吃 1 点
		if t.shield:
			one = 0.0              # 圣盾整次免伤 ⇒ 对带盾目标本轮威胁为 0（下一次才有效）
		best = maxf(best, one)
	return best

