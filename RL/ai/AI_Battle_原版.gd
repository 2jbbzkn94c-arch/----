	for k in t.keys():
		var key := String(k)
		var v = t[key]
		# 【RL 新增】英雄段：{ "HERO_VALUE": { "hero_22": 1.35, "hero_40": 0.9 } }
		# （与 set_hero_weights 的"hero_id -> {键: 值}"结构同族，这里只认 VALUE 一个键）
		if key == "HERO_VALUE" and typeof(v) == TYPE_DICTIONARY:
			hero_acc["HERO_VALUE"] = v
			continue
