##   · **要走一步才够到**：先看当前格视线（通了就算能打 —— 走过去仍在同一侧）；被挡了再在"离目标 ≤ 射程"
##     的那一圈格子里找一格（`a` 走得过去 + 站那儿视线通；血锁 hero_41 还要求沿直线）。
##     ⚠️ 这一段**只在有东西挡着时才跑**（正常局面 1 次 `los_blocked` 就返回）⇒ 成本可忽略。
func _threat_can_hit(sim: Sim, a: SimUnit, target_cell: Vector2i, threatened: SimUnit = null) -> bool:
		# 【2026-09-23 深夜⑩·用户】**后勤（`<后勤>`）没有普攻** ⇒
		#   「它这回合能打到哪一格」这个问题对它们**恒为否**。真实侧同款判据：
		#   `src/Battle.gd::_can_actively_attack(u)` = `u.can_attack() and not _is_logistics(u)`
		#   （`_is_logistics` = `skills.has(DataRegistry.Skill.LOGISTICS)`）；模拟侧的动作生成
		#   (`_actions_for()` / `_tp_attack_actions()`) 也早就在同一条件上 `return` 了。
		#   ⚠️ 全表**只有三个** `<后勤>`：烛火 hero_17 · 末日 hero_31 · 涌电技师 hero_38（角色列表逐行数过；
		#      `autoload/DataRegistry.gd` 里"荆棘树人「远程/后勤」"那句是**旧注释**，探针 `嘲讽吸火自检.gd`
		#      实测 hero_49 的 `skills` 里**没有** LOGISTICS ⇒ 别照抄注释去扩名单）。
		#   ⚠️ 病灶（用户看日志当场指出）：这里原来**不判后勤** ⇒ 挨打合计把后勤**当成普通攻击手记一笔**，
		#   而它真实的伤害在 ②`_on_move_hit_on()`（移动触发：烛火灼烧 / 末日 / 涌电技师电击）里单独算
		#   ⇒ 用户看到的就是"涌电技师对同一个目标两笔伤害：一笔普攻 2、一笔技能 3"，而它明明是后勤。
		#   ⚠️ 本判据同时管到 5 个调用点（挨打合计① / ⑭坚固驻守 / `_engaged()` 交战圈 / 威胁差 / ㉕嘲讽吸火），
		#   全部同义（"这一下普通攻击能不能落上去"）⇒ 判在这里一次修全。**反击不走这里**（后勤能反击，
		#   由 `_sim_counter_check()` 那条独立路径管）。
		if a == null or a.skills.has(DataRegistry.Skill.LOGISTICS):
			return false
		var range_at := a.atk_range
		if a.atk_type == DataRegistry.AttackType.RANGED and _sim_enemy_adjacent(sim, a, a.cell):
			range_at = 1   # 远程被贴身：射程压 1（真实规则）
		# 【2026-09-21 用户定稿·宿魂 hero_46】瞬移威胁：它**能落到任意合法格再开火** ⇒
		#   判据从「路网距离 ≤ 射程＋移动力」换成「目标周围存在一个合法落点、且从那儿能打中」。
		#   ⚠️ 这条会很『狠』（宿魂几乎能威胁全场）—— 那是真实规则，不是高估。
		#   被钉住（眩晕 / 移动力被压到 0）时退回普通判据（与 Battle._move_reachable 同一道门）。
		if a.hero_id == "hero_46" and not a.stunned and a.emove > 0:
			for c in _cells_within_radius(target_cell, maxi(range_at, 1)):
				if c == target_cell:
					continue                  # 不能落在目标自己那格（单位占位）
				if sim.obstacles.has(c) or sim.graves.has(c) or sim.occ.has(c):
					continue                  # 站不了那儿
				if _threat_firing_ok(sim, a, c, target_cell) and _threat_taunt_ok(sim, a, c, threatened):
					return true
			return false
		# 【2026-09-23 深夜⑤·用户实测「能打到圣光的格子被暗域挡住了，圣光却有伤害量」】重写：
		#   ① **站着就能打** = `_in_range()`（几何距离 ≤ 射程 + 血锁直线 + **视线**；单位/障碍/墓碑都挡）；
		#   ② **走过去打** = 这一回合**能走到**的空格里，有哪个能打中。
		#   ⚠️ 旧写法在②用的是 `walk_dist()`（**只看地形、单位不算墙**）+ 挑落点只看障碍/墓碑
		#     ⇒「唯一能站的那格被我们的单位占了」也照样算成够得着 ⇒ 挨打合计虚高（用户实机那一例：
		#     近战矿工要站到"与圣光相邻"的格，那格被暗域占了，却仍记了 `阈值比较2.0(黄金矿工2)`）。
		#   ⚠️ 时间线也支持"单位算墙"：挨打合计估的是**下一回合**的伤害，到那时**我方（AI）单位已经
		#     全部行动完、一定站在原地**，玩家那边**已经动过的单位**也站原地 ⇒ 只有"还没动的玩家单位"
		#     可能挪开。⇒ 现在把**所有身体**都当墙（引擎别处本来就按真规则这么做：`_move_cells()` 与
		#     `_sim_path_blocked()` 都把占位格当阻挡）——只有 `dkey` 走位排序**故意**仍用只看地形的口径
		#     （那里排的是"我自己走过去"，不该被队友身体一票否决）。
		# 【2026-09-23 深夜⑤】① 站着就能打；② 走过去打。
		# 【2026-09-23 深夜⑧】嘲讽按**开火那一格**判：只要有一个"够不着任何嘲讽者"的开火位能打到目标 ⇒ 算威胁得到。
		#   ⚠️ 必须**边找边返回**（第一个通过的开火位就 return）：早先一版把"能开火的格子"全收集起来再判，
		#     丢掉了提前退出 ⇒ 每次调用都把 BFS 跑满、单次搜索慢到超时（探针 600s 没跑完）。
		if _cell_in_range(sim, a, a.cell, target_cell):
			if threatened == null or _taunt_allows(sim, a, threatened, a.cell):
				return true
		var budget := maxi(a.emove, 0)
		if budget <= 0:
			return false
		# 几何预筛：几何距离 > 射程＋移动力 ⇒ 一定够不着（几何距离是路网下界 ⇒ 必要条件，安全）
		if grid.distance(a.cell, target_cell) > range_at + budget:
			return false
		for c in _sim_walk_cells(sim, a.cell, budget):
			if not _cell_in_range(sim, a, c, target_cell):
				continue
			if threatened == null or _taunt_allows(sim, a, threatened, c):
				return true
		return false

## 【2026-09-23 深夜⑧】"从 `from_cell` 开火能不能威胁到 `target_cell`" = 打得到 **且** 嘲讽允许：
##   嘲讽按**这一格**判（`_taunt_allows(..., from_cell)`）⇒ 换一个够不着嘲讽者的开火位就照样能打别人。
func _threat_fire_ok_at(sim: Sim, a: SimUnit, from_cell: Vector2i, target_cell: Vector2i, threatened: SimUnit) -> bool:
	if not _cell_in_range(sim, a, from_cell, target_cell):
		return false
	if threatened == null:
		return true
	return _taunt_allows(sim, a, threatened, from_cell)

## 宿魂瞬移分支用：只有"视线通"这一层（距离由周围落点保证），嘲讽仍按落点判（见上）。
func _threat_taunt_ok(sim: Sim, a: SimUnit, from_cell: Vector2i, threatened: SimUnit) -> bool:
	if threatened == null:
		return true
	return _taunt_allows(sim, a, threatened, from_cell)

## 与 `_in_range()` **同一把尺子**，但目标是**格子**而不是单位 —— 威胁估计问的是"能不能打到**那一格**"
##   （`_incoming_total_on()` 估的是"我们那个单位站到某格会挨多少"，威胁源要打的是**格**）：
##   几何距离 ≤ 射程（远程被贴身压 1）+ 血锁只能走直线 + 视线（障碍/墓碑/**单位**都挡；
##   坠炮手 hero_45 未沉默时无视阻挡）。
func _cell_in_range(sim: Sim, u: SimUnit, from_cell: Vector2i, target_cell: Vector2i) -> bool:
	var range_at := u.atk_range
	if u.atk_type == DataRegistry.AttackType.RANGED and _sim_enemy_adjacent(sim, u, from_cell):
		range_at = 1
	var d := grid.distance(from_cell, target_cell)
	if d < 1 or d > range_at:
		return false
	if u.hero_id == "hero_41" and not _sim_straight_line_cells(from_cell, target_cell):
		return false
	if not (u.ignore_los and not u.silenced) and _sim_path_blocked(sim, from_cell, target_cell):
		return false
	return true

## 【2026-09-23 深夜⑤】"这一回合能走到的**空格**"（BFS **限步**；**障碍 / 墓碑 / 被单位占的格都当墙**）。
##   为什么另写一份、不复用 `walk_dist()`：那一份的语义就是"只看地形、**不把单位当墙**"（见它的注释），
##   而且带**跨局面共享**的缓存（`sim.walk_cache`）—— 单位位置每一步都在变，那份缓存对"单位算墙"的口径无效。
##   棋盘只有 32 格、这里又限了步数（移动力通常 ≤ 3）⇒ 现算一遍远比维护第二套缓存便宜。
##   ⚠️ 只给**威胁估计**用；走位候选排序（`dkey`）仍走旧的 `walk_dist()`，两把尺子各管一处。
func _sim_walk_cells(sim: Sim, from: Vector2i, budget: int) -> Array:
	var out: Array = []
	if budget <= 0:
		return out
	var seen := { from: true }
	var frontier: Array = [from]
	for _step in budget:
		var nxt: Array = []
		for cur in frontier:
			for n in grid.neighbors(cur):
				if seen.has(n):
					continue
				seen[n] = true
				if sim.obstacles.has(n) or sim.graves.has(n) or sim.occ.has(n):
					continue   # 墙：地形 + **身体**
				out.append(n)
				nxt.append(n)
		frontier = nxt
		if frontier.is_empty():
			break
	return out

## 【2026-09-23 深夜⑨·用户】**最多能有几个敌人同时打到 `t` 站的这一格** = **可站的开火位数量**。
##   六边形一格只站一个人 ⇒ 这是"同时能挨几下"的硬上界（用户提的那条）。
##   ⚠️ 只在 `_incoming_total_on()` 里用来削**①普攻**那一族：②移动后技能/③毒不占开火位，原样计入。
##   排除：目标自己那格 · 障碍/墓碑（站不了）· **我方单位占着的格**（我方这回合不会再动 ⇒ 那格空不出来）·
##   站着敌人但"它从那儿其实打不到这里"的格（它不在开火位上，这格也不会空出来）。
##   ⚠️ 热路径（每次 `_evaluate` 都会调）⇒ **不**对空格逐个查视线、也不逐个敌人跑 BFS：
##     几何半径 2（我方最远射程）内的空格一律算作"可能站得上去的位"⇒ 这是个**上界**，
##     宁可略微高估（少扣一点分），也不把这一项变成新的性能黑洞。
func _threat_slots(sim: Sim, t: SimUnit, cell: Vector2i) -> int:
	var n := 0
	for c in _cells_within_radius(cell, 2):
		if c == cell:
			continue
		if sim.obstacles.has(c) or sim.graves.has(c):
			continue
		var holder = sim.occ.get(c, null)
		if holder is SimUnit:
			var hu: SimUnit = holder
			if hu.fn == t.fn:
				continue                      # 我方单位占着 ⇒ 这个位子敌方用不了
			if not hu.alive or not _cell_in_range(sim, hu, c, cell):
				continue                      # 敌人站着但打不到这里 ⇒ 它不在开火位上，这格也空不出来
			if hu.skills.has(DataRegistry.Skill.LOGISTICS):
				continue                      # 【2026-09-23 深夜⑩】**后勤不会开火** ⇒ 它占的这格不是开火位
		n += 1
	return n

## 与 `_incoming_total_on` 配套的小工具：**这一回合能不能走到"与 target_cell 相邻"的空格**（单位/障碍/墓碑都当墙）。
##   用途：烛火(hero_17) "移动到相邻位置再对相邻敌人造成伤害" 那条威胁的判据。
func _sim_reach_adjacent(sim: Sim, a: SimUnit, target_cell: Vector2i, budget: int) -> bool:
	if grid.distance(a.cell, target_cell) == 1:
		return true                       # 已经贴着 ⇒ 原地就能触发
	for c in _sim_walk_cells(sim, a.cell, budget):
		if grid.distance(c, target_cell) == 1:
			return true
	return false

	## 【2026-09-21 用户实测补】"站在 from_cell 打 target_cell"这一下合不合法：**视线**（障碍/墓碑/单位挡）
	##   ＋ **血锁 hero_41 只能沿直线攻击**（原来这条只在兜底分支里查 ⇒ 与真打一遍的 _in_range() 不一致）。
func _threat_firing_ok(sim: Sim, a: SimUnit, from_cell: Vector2i, target_cell: Vector2i) -> bool:
		if a.hero_id == "hero_41" and not _sim_straight_line_cells(from_cell, target_cell):
			return false
		return not _sim_path_blocked(sim, from_cell, target_cell)
func _cells_within_radius(center: Vector2i, radius: int) -> Array:
	var out: Array = [center]
	var frontier: Array = [center]
	for step in radius:
		var nxt: Array = []
		for c in frontier:
			for n in grid.neighbors(c):
				if out.has(n) or not grid.in_bounds(n):
					continue
				out.append(n)
				nxt.append(n)
		frontier = nxt
	return out
# 某对手 t 对"距离 d 那格上的目标"这一下的伤害：
# 远程被贴身 → 基础压 1、buff 保留；要动一步才够到的按 THREAT_MOVE_DISCOUNT 折算。
# 【2026-09-20 用户口径】`discount = false` ⇒ 返回**真实单击伤害**（不乘移动折减）。
#   为什么还留着 `discount`：**并列裁决的"威胁差"**（`_outgoing_threat_on`）与塔盾代扛记分（`_bulwark_soak`）要的是
#   "预期会掉多少血"⇒ 移动要花掉一次走位机会，折减合理；而 ⑥`MOVE_ACCEPT_DAMAGE` 要比的是
#   "**这个英雄真挨这一下会掉多少血**"⇒ 6 攻的敌人走上来打就是实打实 6 点，折成 4.2 会让阈值形同虚设。
func _threat_hit_value(sim: Sim, t: SimUnit, d: int, discount: bool = true) -> float:
	var range_at := t.atk_range
	var pinned: bool = t.atk_type == DataRegistry.AttackType.RANGED and _sim_enemy_adjacent(sim, t, t.cell)
	if pinned:
		range_at = 1
	# 【2026-09-23 深夜⑪·用户】共鸣者(hero_47) 这一下要用**技能后的攻击力**，不是面板值（见 `_echo_atk_now`）。
	var base_atk := _echo_atk_now(sim, t)
	var dmg := base_atk
	# ⚠️ 共鸣值**覆盖**"远程被贴身压 1"（真实 `Unit.effective_atk()` 在 `echo_set >= 0` 时**提前 return**）
	#   ⇒ 共鸣中的共鸣者不做贴身回落（共鸣者本身是近战、走不到这一支，留着只为将来变身/改表时不埋雷）。
	if pinned and not _echo_active(t):
		# ⚠️ 这里**必须用 `maxf`**：`maxi` 收 float 参数会触发 Godot 4.7 的 NARROWING_CONVERSION 报错
		#   （用户 2026-09-23 深夜贴的 `BattleAI.gd:6036`）。`base_atk` 出自 `_echo_atk_now()`，
		#   它只由整数值拼出来 ⇒ 改用 float 写法与原来**数值完全一致**（`dmg` 本来也是浮点）。
		var buff := maxf(base_atk - float(t.atk), 0.0)
		dmg = 1.0 + buff
	if discount and d > range_at:
		dmg *= w_threat_discount
	return dmg

## 【2026-09-23 深夜⑪·用户】"共鸣者(hero_47) 下一回合打这一下的攻击力"。
##   ⚠️ 用户原话：「**AI 在计算阈值比较里共鸣者的时候，算的是共鸣者的面板数值，而不是共鸣者技能后的攻击力**」。
##   真实规则（`heroes/hero_47_共鸣者.gd::on_side_turn_start`）：**该方回合开始**时，
##   `echo_set = Σ_{同阵营 · 除自己外 · 存活} v.effective_atk()`（先对**所有**共鸣者取样、再统一赋值 ⇒
##   另一名共鸣者贡献的是它**未共鸣**的值），直到**该方回合结束**（`Battle._clear_statuses()` 里 `echo_set = -1` 复位）；
##   `Unit.effective_atk()` 在 `echo_set >= 0` 时返回 `max(echo_set + atk_use_buff, 0)`
##   （**覆盖自身基础与全部加成**，只有"下一次攻击 +1"的一次性道具叠在上面）。
##   ⚠️ 时序病灶：AI 的搜索跑在**敌方(AI)回合**，此刻玩家的共鸣者 `echo_set` 已被清成 -1
##   ⇒ 快照带过来的 `eatk` = **面板攻击力**；而挨打合计估的是**下一个玩家回合**的伤害 ——
##   那时它**一开回合就已经共鸣**了 ⇒ 少算一大截（队友越多、差得越多）。
##   ⇒ 这里按真实公式补算：`Σ 同阵营（除自己）存活单位的 eatk` + 它自己的一次性攻击道具；被沉默/眩晕时不共鸣
##   （真实 `skill_allowed()` 那一关）。**只在"下一回合"语义的估计里用**（`_threat_hit_value`）——
##   不能改 sim 建局时的 `eatk`：同一回合的**反击**里共鸣者是没加成的（那时 echo 已被清），
##   改建局值会把反击伤害一起算错。
func _echo_atk_now(sim: Sim, t: SimUnit) -> float:
	if not _echo_active(t):
		return float(t.eatk)
	var total := 0.0
	for i in sim.units.size():
		var v: SimUnit = sim.units[i]
		if v == null or not v.alive or v == t or v.fn != t.fn:
			continue
		total += float(v.eatk)
	return maxf(total + float(t.atk_use_buff), 0.0)

## 共鸣者这一回合到底共不共鸣：真实门槛 = 是 hero_47 且 `skill_allowed()`（被沉默/眩晕时本回合不共鸣）。
func _echo_active(t: SimUnit) -> bool:
	return t != null and t.hero_id == "hero_47" and not t.silenced and not t.stunned

## 【2026-09-23 深夜⑧·用户口径】嘲讽是**"从哪一格开火"决定的**，不是"这回合够得到就必须打它"：
##   用户原话：「**不是说够得着嘲讽我就必须打嘲讽，我可以走够不着嘲讽的格子去打其他敌人啊**」。
##   真实侧同口径：`src/Battle.gd::_attackable_from(u, from_cell)` —— 嘲讽者**从 `from_cell`** 收集
##   （距离 + 血锁直线 + 视线），只有"**从这一格**够得到某个嘲讽者"时才禁止打别人。
##   ⚠️ 旧签名没有 `from_cell`，用 `_threat_can_hit(sim, a, t.cell)`（= 这回合**任意落点**够不够得到嘲讽者）
##   ⇒ 于是"够得到"就被锁死：暗域那类本该能被打的目标一律记 0（用户实机那局：矿工够不到敌方的嘲讽圣光，
##   却因为"理论上能绕过去"把暗域算成了 0）。现在按格子判 ⇒ **换一个够不着嘲讽者的开火位就照样打别人**。
func _taunt_allows(sim: Sim, a: SimUnit, target: SimUnit, from_cell: Vector2i) -> bool:
	if target.skills.has(DataRegistry.Skill.TAUNT):
		return true                                     # 打的正是嘲讽单位本身 → 永远允许
	if a.ignore_los and not a.silenced and not a.stunned and not _mortar_engaged(sim, a):
		return true                                     # 坠炮手豁免（= Unit.mortar_ignores_taunt）
	for i in sim.units.size():
		var t: SimUnit = sim.units[i]
		if not t.alive or t.fn == a.fn or not t.skills.has(DataRegistry.Skill.TAUNT):
			continue
		# 【2026-09-21 用户实测补】用 `_cell_in_range()`（距离＋**视线**＋**血锁只能沿直线**），与真打一遍用的
		#   `_valid_targets()`/`_in_range()` 同一把尺子；【2026-09-23 深夜⑧】改成**只问 `from_cell` 这一格**。
		if _cell_in_range(sim, a, from_cell, t.cell):
			return false                                # 从这一格够得到某个嘲讽单位 → 只能打它
	return true

# 相邻同阵营的"代扛者"（= 塔盾 hero_11；对齐 `hero_11_塔盾.gd::is_damage_absorber`）。
# 条件同真实：紧邻（六边形距离 1）、同阵营、技能可用（被沉默/眩晕则盾牌失效）。
func _bulwark_for(sim: Sim, target: SimUnit) -> SimUnit:
	return _bulwark_near(sim, target, target.cell)

# 【2026-09-20 新增】"假设目标站在 `cell`"时的代扛者（走位诊断要问"落到那一格会不会被塔盾代扛"）。
func _bulwark_near(sim: Sim, target: SimUnit, cell: Vector2i) -> SimUnit:
	for i in sim.units.size():
		var s: SimUnit = sim.units[i]
		if s == target or not s.alive or s.fn != target.fn or s.hero_id != "hero_11":
			continue
		if s.silenced or s.stunned:
			continue
		if grid.distance(s.cell, cell) == 1:
			return s
	return null

## 【2026-09-20 用户口径定稿·第五次修正】⑥`MOVE_ACCEPT_DAMAGE` 的比较口径：
## **"这个英雄下回合会挨多少血"** —— 用户原话：「我说的**单个英雄受到的最高伤害**是指**敌人能打到这的
## 英雄的伤害总和**」⇒ 是 **sum**；后又补一条：「**没有考虑技能效果和自己身上的盾**」⇒ 本轮补上：
##   **① 普攻**：能打到他的每个对手各记一次**真实单击**（不打移动折减）。
##   **② 移动后触发的技能伤害**（与 `_sim_on_move` 的分支逐条对齐，规则照抄真实英雄脚本；
##      见 `_on_move_hit_on()`）：烛火 hero_17（相邻全伤）· 末日 hero_31（全体低血）· 涌电技师 hero_38（电最低血）。
##   **③ 毒 tick**：真实 `src/Battle.gd:1959` —— 无论哪一方回合开始，场上所有中毒单位各结算 **1 点**。
##   **④ 盾**：现在身上的 [圣盾] **或** "本回合末就要发下来的盾"（`pending_guard`，圣光已占位）
##      ⇒ 按真实规则**整次免伤并消费**：**抵消其中最大的一次**伤害。
## 逐项修正都按**被打的这个人**算：嘲讽门（`_taunt_allows`）· 重伤 +1 · 坚固 −1 ·
##   相邻塔盾代扛 −1（每一次各减 1）· 远程被贴射程压 1 · **不乘 `THREAT_MOVE_DISCOUNT`**（真实伤害）。
## 够得到的判据与全引擎一致：`walk_dist ≤ 射程 + 移动力`（用户 2026-09-20 口径）。
## ⚠️ 与三把"看过的尺子"的区别（别再搞混）：**不是**已删除的「该格挨打」（逐格求和、不知道谁站那儿）；
##   **不是**当年 ⑮ 的分摊值（`alloc`：把对手一次出手**分**给多个目标，那是队级总量账 —— 该族 2026-09-20 第三轮已删）；**不是** `max`。
## ⚠️ **仍未覆盖**（要"真推演对方一整回合"才算得准，已登记 T13）：位移（暗域换位/血锁拉人）、
##   攻击触发的溅射（白游侠散射 / 长剑剑气穿透 / 超新星击退击穿）、长角撞飞、红帽扑街自爆、
##   大骑士冲锋加攻、太阳斩衰减、炸弹落停引爆、宿魂附体镜像。"移动后触发"那一族**已覆盖**。
## `cell` = 目标**假设站的位置**（走位诊断要问"落到那一格会挨多少"）。
## `ignore_taunt`（【2026-09-23 新增】）= **把嘲讽门关掉**再算一遍（`_threat_can_hit(..., threatened=null)`）。
##   只有 ㉕嘲讽吸火（`_taunt_soak()`）用它求"没有嘲讽时这个单位会挨多少"的对照值，别处一律用默认 false。
## `out`（可选，字典按引用传递）= 只给日志用：写回 `out["n"]`（**几"次"伤害**：N 个人打 + N 个技能
##   + 毒 1 次）与 `out["max"]`（其中最大的一次）。
## 【2026-09-23 深夜⑨·用户】①普攻那一族先按 `_threat_slots()`（可站开火位数）削到上限，再叠加 ②③
##   （技能/毒不占开火位）—— 详见函数体内 ①.5。
func _incoming_total_on(sim: Sim, t: SimUnit, cell: Vector2i, out: Dictionary = {}, ignore_taunt: bool = false) -> float:
	if t == null:
		return 0.0
	var inst: Array = []      # 每一次伤害单独入列：圣盾"挡最大的一次"要靠它
	var names: Array = []     # 与 inst 一一对应：这一击是谁打的（只为日志）
	# ① 普攻：能打到他的每个对手各一次（**只有这一族受开火位数量限制**，见下面 ①.5）
	var pos_inst: Array = []
	var pos_names: Array = []
	for i in sim.units.size():
		var a: SimUnit = sim.units[i]
		if a == null or not a.alive or a.fn == t.fn:
			continue
		var d := walk_dist(sim, a.cell, cell)
		# 【2026-09-21 用户实测补】距离 **＋ 视线**：被障碍/墓碑/单位挡住的攻击不再算进「挨打合计」（见 _threat_can_hit()）
		# 【2026-09-23 深夜⑧】嘲讽也折进 `_threat_can_hit()`：**按开火那格判**（够不着嘲讽者的格子照样能打别人）。
		# 【2026-09-23 ㉕】`ignore_taunt=true` 时把嘲讽门关掉（`threatened=null`）—— 只给 `_taunt_soak()` 求对照值。
		var gate_t: SimUnit = null if ignore_taunt else t
		if not _threat_can_hit(sim, a, cell, gate_t):
			continue
		var one := _hit_after_target_mods(sim, t, cell, _threat_hit_value(sim, a, d, false))
		if one > 0.0:
			pos_inst.append(one)
			pos_names.append(a.name)
	# ①.5 【2026-09-23 深夜⑨·用户】"同时能打到他的人"受**可站开火位的数量**限制：六边形一格站一个人，
	#   目标周围只有 2 个能开火的位子时，最多 2 个敌人能同时打到他 —— 旧算法却把**每个"够得到"的
	#   敌人都各算一笔**（3 个敌人 ⇒ 3 笔）⇒ 虚高。用户原话：「比如玩家只有两个位置能达到A英雄，
	#   但是A英雄会把3个能够到他的伤害都算上，即使实际只有两个能打到，另一个贴不了身……我的想法是
	#   这种情况，伤害就算能打到的最高两个之和」。
	#   ⚠️【同日追加·别搞混】**只削普攻**：开火位挤占是"谁站到那一格架枪"的问题，而 ②"移动后触发"
	#   （烛火/末日/涌电技师）是**顺着自己的路顺手放的**、③毒是**回合开始 tick**，两者既不占别人的
	#   开火位、也不跟普攻抢位子 ⇒ 先按开火位数把**普攻**削到上限，再把技能/毒**原样加上去**，
	#   最后才让圣盾"挡最大的一次"在这条合并后的清单上裁决。
	var slots := maxi(_threat_slots(sim, t, cell), 1)
	if pos_inst.size() > slots:
		var order: Array = []
		for i in pos_inst.size():
			order.append({ "i": i, "v": float(pos_inst[i]) })
		order.sort_custom(func(a, b): return float(a["v"]) > float(b["v"]))
		for k in slots:
			var oi := int(order[k]["i"])
			inst.append(float(pos_inst[oi]))
			names.append(String(pos_names[oi]))
	else:
		for i in pos_inst.size():
			inst.append(float(pos_inst[i]))
			names.append(String(pos_names[i]))
	# ② 移动后触发的技能（烛火/末日/涌电技师）
	for i in sim.units.size():
		var b: SimUnit = sim.units[i]
		if b == null or not b.alive or b.fn == t.fn:
			continue
		var sk := _on_move_hit_on(sim, b, t, cell)
		if sk > 0.0:
			var sk2 := _hit_after_target_mods(sim, t, cell, sk)
			if sk2 > 0.0:
				inst.append(sk2)
				names.append(b.name + "技")
	# ③ 毒 tick（真实规则：回合开始结算 1 点，**圣盾可挡**）
	if t.poisoned:
		inst.append(1.0)
		names.append("毒")
	var total := 0.0
	var top := 0.0
	for v in inst:
		total += float(v)
		top = maxf(top, float(v))
	# ④ 盾（现在有 / 本回合末要发下来）：整次免伤并消费 ⇒ 挡掉最大的一次
	if _shield_next_turn(sim, t) and inst.size() > 0:
		total = maxf(total - top, 0.0)
		var ix := inst.find(top)
		if ix >= 0:
			inst.remove_at(ix)
			if ix < names.size():
				names[ix] = names[ix] + "(盾挡)"      # 被盾挡掉的那一次标出来，日志才不骗人
	var parts: Array = []
	for j in inst.size():
		parts.append([String(names[j]) if j < names.size() else "?", float(inst[j])])
	out["n"] = inst.size()
	out["max"] = top
	out["parts"] = parts
	return total

## 【2026-09-20 用户口径】把"某一次打在这个目标身上的伤害"按**目标侧**规则修正：
##   [重伤] +1 · [坚固] −1（只减攻击伤害，这里三次来源都是 is_attack=true）· 相邻塔盾代扛 −1。
## （[圣盾] 不在这一层：它挡的是"整次伤害"，要等所有来源都列齐之后抵消最大的一次。）
func _hit_after_target_mods(sim: Sim, t: SimUnit, cell: Vector2i, one: float) -> float:
	if t.heavy:
		one += 1.0
	if t.solid:
		one = maxf(one - 1.0, 0.0)
	if one > 1.0 and _bulwark_near(sim, t, cell) != null:
		one -= 1.0
	return maxf(one, 0.0)

## 【2026-09-20 用户拍板·第三轮 · 已删】原 `_alloc_share_at()`（日志里"假设站在这个落点、平摊算法下
##   这个英雄分到多少伤害"）随**整个分摊族**一起删除（理由与清单见下方「整族删除」说明）。
##   日志里现在只剩 `阈值比较` 一个威胁数（`_incoming_total_on`，见 `_print_decision`）。

## 【2026-09-20 用户要求】把"谁贡献了多少"打成括号：`[[名字, 值], …]` ⇒ `(小阴影3+暗域3)`。
## `dec` = 小数位（求和口径用 0）。空列表 ⇒ 返回空串（不打空括号）。
func _fmt_parts(parts: Array, dec: int) -> String:
	if parts.is_empty():
		return ""
	var bits: Array[String] = []
	for e in parts:
		var row: Array = e
		var nm := String(row[0])
		var v := float(row[1])
		bits.append(("%s%.0f" % [nm, v]) if dec <= 0 else ("%s%.1f" % [nm, v]))
	return "(%s)" % "+".join(bits)
## 【2026-09-20 用户口径】这个目标**下回合手上有盾**吗：
##   ① 现在就带 [圣盾]；② **本回合末要发下来的盾** —— 圣光(hero_22) 的发放是 `grant.call_deferred()`
##   （回合末落盘，撑过整个对方回合），在模拟里就是 `sim.pending_guard` 里排着队的那一条。
func _shield_next_turn(sim: Sim, t: SimUnit) -> bool:
	if t.shield:
		return true
	for q in sim.pending_guard:
		if q.get("dst", null) == t:
			return true
	return false

## 【2026-09-20 用户口径：把"技能效果"算进来】**移动后触发**的技能会不会额外打到"站在 `cell` 的这个目标"。
## 规则**逐条照抄真实英雄脚本**，并与模拟侧 `_sim_on_move()` 的分支一致（三处来源，全部 is_attack=true）：
##   · **hero_17 烛火**（`heroes/hero_17_烛火.gd:5-18`）：移动后伤害**相邻敌人** ⇒ 它要贴上来打我们就必触发；
##     判据：它能在这一回合走到"我们旁边" ⇒ `walk_dist(a→cell) ≤ 移动力 + 1`。
##   · **hero_31 末日**（`heroes/hero_31_末日.gd:5-19`）：移动后伤害**所有 HP 低于自己的敌人**，
##     **没有距离限制** ⇒ 只要它移动就触发；判据：`我的血 < 它的血`。
##   · **hero_38 涌电技师**（`heroes/hero_38_涌电技师.gd` · `BattleAI._sim_on_move`）：移动后自身攻击 **+1**
##     并电"**全场 HP 最低的敌人**"（真实 `Battle._lowest_enemy` 不判距离/射程）⇒ 判据：那个最低血的就是我。
## ⚠️ **上界口径**：只要"它够得到我们 / 会移动"就按会触发计（不去预测它这一回合到底动不动）——
##   这是"可接受伤害"的**危险估计**，宁可略微高估。
## ⚠️ 被[沉默]/[眩晕]时不派发（真实 `_trigger_on_move` 开头就是 `if not u.skill_allowed(): return`）。
## ⚠️ 雪拳(hero_26) 冰冻 / 医护兵(hero_06) 治疗 / 炸弹人(hero_35) 布雷 / 风语者(hero_43) 回血
##   都**不造成伤害** ⇒ 不在本函数口径内（状态与炸弹的代价由别的项管）。
func _on_move_hit_on(sim: Sim, a: SimUnit, t: SimUnit, cell: Vector2i) -> float:
	if a.silenced or a.stunned:
		return 0.0
	match a.hero_id:
		"hero_17":
			# 烛火：移动后对**相邻**敌人造成伤害 ⇒ 判据 = 这一回合能不能走到目标的**相邻空格**。
			#   【2026-09-23 深夜⑤】原来用 `walk_dist() ≤ emove + 1`（只看地形、单位不算墙）⇒ 身体挡着
			#   也算得着；现与威胁估计同一把尺子（`_sim_walk_cells()`：单位/障碍/墓碑都当墙）。
			if not _sim_reach_adjacent(sim, a, cell, maxi(a.emove, 0)):
				return 0.0
			return float(a.eatk)
		"hero_31":
			if t.hp < a.hp:
				return float(a.eatk)
			return 0.0
		"hero_38":
			var lowest: SimUnit = null
			for v in sim.units:
				if v != null and v.alive and v.fn != a.fn and (lowest == null or v.hp < lowest.hp):
					lowest = v
			if lowest == t:
				return float(a.eatk + 1)     # 真实：先 `u.eatk += 1` 再电
			return 0.0
	return 0.0

# 塔盾这一轮替相邻队友吃下的总点数：每个"相邻队友将要受到、且伤害 >1"的攻击吃 1 点。
# 为什么要给它记账：那 1 点是**真实扣在塔盾身上**的（`hero_11_塔盾.gd` 直接扣血），
# 不记的话"塔盾往前站替核心挡刀"在评分里只会看到自己挨打的坏处、看不到价值。
func _bulwark_soak(sim: Sim, self_u: SimUnit) -> int:
	if not self_u.alive or self_u.hero_id != "hero_11" or self_u.silenced or self_u.stunned:
		return 0
	var soak := 0
	for i in sim.units.size():
		var ally: SimUnit = sim.units[i]
		if ally == self_u or not ally.alive or ally.fn != self_u.fn:
			continue
		if grid.distance(self_u.cell, ally.cell) != 1:
			continue
		for j in sim.units.size():
			var a: SimUnit = sim.units[j]
			if not a.alive or a.fn == ally.fn:
				continue
			var d := walk_dist(sim, ally.cell, a.cell)
			# 【2026-09-23 深夜⑧】这一下到底会不会落在 ally 身上：距离/视线/嘲讽**一并**由 `_threat_can_hit()` 判
			#   （嘲讽按开火那格判 ⇒ 敌人若能绕到一个够不着嘲讽者的点，照样会打 ally ⇒ 代扛照算）。
			if not _threat_can_hit(sim, a, ally.cell, ally):
				continue
			var one := _threat_hit_value(sim, a, d)
			if ally.heavy:
				one += 1.0
			if ally.solid:
				one = maxf(one - 1.0, 0.0)
			if one > 1.0:
				soak += 1
	return soak

# 该敌方单位是否"被迫死战"：当前被玩家威胁（会被打），且无法移动到不受攻击的格（逃不掉）。

# 单位在所有可达格（含当前格）中被攻击的最小威胁值。
# 若 >0，说明它无论怎么走都会被玩家攻击到（逃不掉）。
# 【2026-09-20 口径定稿】用 `_incoming_total_on()`（能打到他的敌人的伤害总和，与 ⑥ 同尺）。
func _min_escape_incoming(sim: Sim, u: SimUnit) -> float:
	var best := _incoming_total_on(sim, u, u.cell)      # 当前格挨打合计
	var reach := _move_cells(sim, u)
	for c in reach.keys():
		var inc := _incoming_total_on(sim, u, c)
		if inc < best:
			best = inc
	return best

# 该敌方单位是否"逃不掉且必死"：当前所在格会被打到**致死**，且所有可达格也都会被致死。
# 判据用"威胁 ≥ 当前血量"而不是"威胁 > 0"：后者在"威胁已含玩家移动力"之后几乎恒真
# （小棋盘上玩家基本够得到任何格），会让"死亡不扣分/威胁不扣分/搏命奖励"三条全线失控。
# 【2026-09-20 口径定稿】判据 = **`_incoming_total_on()` ≥ 血**，即"**能打到他的敌人加起来够杀他**"
#   （按目标求和、不折减）。⚠️ 中途曾按"最高单击（单次一击）"收窄过一版，用户澄清后**已还原成求和口径**：
#   "三个人各打 4 点、他 10 血"**仍然算必死**（这正是"整队火力够杀他"的原意）。
# 允许对已死亡的单位调用（死亡后 cell 仍保留，用于判定其是否注定损失）。
func _was_doomed(sim: Sim, u: SimUnit) -> bool:
	var lethal := maxf(float(u.hp), 1.0)
	if _incoming_total_on(sim, u, u.cell) < lethal:
		return false
	return _min_escape_incoming(sim, u) >= lethal

# 走位定位分（敌方视角）—— **2026-09-15 起是"结果导向"的**：
#   - 未参战（本回合够不到任何敌人）：离可打击范围越远扣越多 → 压上参战，不在后方迂回
#   - 每保留 1 格移动力 = 小价值（灵活走位）
#   - "会不会挨打 / 够不够得着人 / 谁替谁挡刀"**不在这一层**（原本在「下回合交换预判」`_threat_forecast`，
#     2026-09-20 整族删除；现在防守侧只剩 ⑥规则B + ⑮必死折 + 终选层 T13）——所以这里不再写身份偏好。
func _position_score(sim: Sim) -> float:
	var s := 0.0
	# 【已删 2026-09-20·用户拍板】原 `ENGAGE_STANDOFF`（"推进停止线"：拉力只推到"对方下回合够不到"的那一格）：
	#   实测未过判据 ⇒ 键 + 那段 `standoff` 计算一起删 ⇒ `gate` 恒等于 `engage`（= 本回合全力够到的距离）。
	for i in sim.units.size():
		var u: SimUnit = sim.units[i]
		if not u.alive or u.fn != DataRegistry.Faction.ENEMY:
			continue
		# 【2026-09-15 删除·用户决定】这里原有三条**按角色身份**写死的站位偏好：
		#   坦克(嘲讽) 按 `row/max_y ×4.0` 前压、后勤 `(1−row/max_y) ×3.0` 缩后、烛火(hero_17) ×4.0 前压。
		# 用户早就说"位置层太杂了：位置无非多攻击、少扣血" → 现在删掉，改由**结果**推出来：
		#   · 坦克往前站的价值（原本记在 `_threat_forecast` 里，已删）= 嘲讽拉仇恨
		#     （敌人够得到嘲讽单位时只能打它 → 坦克吸走火力，核心自然少掉血）
		#   · 塔盾(hero_11) 往前站的价值 = `_bulwark_soak`（替相邻队友吃下的那 1 点/次 记在它自己头上）
		#   · 烛火要冲前线 = 它**能打人**（`_logistics_charges` 那条"够得着就该压上"的拉力照旧生效）
		# 可调键 32 → 29。
		var near := _nearest_enemy_dist(sim, u)   # 到最近玩家的**路网**距离（场上无玩家 = 大数）
		# 【2026-09-15 删除·用户决定】这里原有两条**远程专属**判分：
		#   `near == 1 → −8.0`（被贴脸）与 `near == atk_range → +2.0`（卡射程边缘）。
		# 用户指出"**远程的判定，伤害评分已经能覆盖**：被贴身只有 1 伤，天生就是低分" ✓
		# —— 被贴身时模拟会把远程的有效攻击压成 1（真实规则），所以①它打出去的那一下在血量账
		# （`HP_VALUE_W`）里几乎没有收益、②它还占着挨打的位置（⑮必死折照扣），
		# 那 −8 是**第三把尺子**在说同一件事。而"卡射程边缘"的语义（够得着人、又没人打得到它）
		# 也不需要单独的 +2.0（原文那条"安全的输出位 +1.0"随 `_threat_forecast` 一起删了）。
		# 可调键 34 → 32。
		# 未参战压上（近战/远程/坦克/烛火都算；普通后勤另按上面的"缩后"项走）：
		# 这一回合**够不到**任何敌人时，离"可打击范围"越远扣越多 —— 逼它往战场压，
		# 而不是在后方/出生点原地迂回看戏（"队友已经打起来、它还在出生点晃悠"就是这条拉力太弱）。
		# 关键：拉力只在 near > 移动+射程 时生效，一旦进了"本回合就能打到"的范围就归零，
		# 后半程交给 ⑥规则B / ⑮必死折 逐格权衡（原文的「下回合交换预判」2026-09-20 已删）——
		# 所以整体是"在尽量不挨打的前提下尽量靠近"：既不缩在后排，也不会为了靠近而撞进集火圈。
		if not u.skills.has(DataRegistry.Skill.LOGISTICS) or _logistics_charges(u):
			var gate: int = u.emove + u.atk_range   # 本回合全力后可够到的距离（原 `ENGAGE_STANDOFF` 的停止线已删）
			if near > gate and near < INF_DIST:
				# 场上已无存活对手时 near=INF，此时不给拉力（否则杀最后一人会被判成天文负分）
				# 【2026-09-20 解 const】斜率的来源：`w_engage_pull`（默认 = 1.2）
				s -= float(near - gate) * w_engage_pull
		# 【2026-09-15 删除·用户决定】这里原有"本回合没移动 → +0.5"（`POS_MISC`，注释写的是"保留机动性"）。
		# 删的理由：① "保留机动性"在这个游戏里**不成立**——`Unit.reset_for_new_turn()` 每回合把
		#    `moved_this_turn` 重置，没走掉的移动力**不会存到下回合**；② 它只做一件事：两条候选打平时
		#    偏向"不移动"的那条；③ 量级 0.5 分/单位（全表最小），且不分英雄（要表达 hero_48"没移动得[坚固]"
		#    这类机制应该写成它的 `hero_XX` 专属项，而不是给全队发 0.5）。
		# 现在本函数只剩纯结果导向的一条：够不着就压上（ENGAGE_PULL）。
		# 拆墙绕路代价在 `_obstacle_detour()`（`OBSTACLE_DETOUR_WEIGHT`）；"增援靠拢"（`SIEGE_*` / `_siege_bonus()`）
		# 已于 2026-09-15 按用户决定删除（与 ENGAGE_PULL 重复）。
	return s

# 【2026-09-19 新增·默认关】矿工"眼前有没有自己一击能收掉的残血敌人"（供 `GOLD_KILL_GATE`）。
# 口径：**直线六角距离** ≤ `emove + atk_range` 且 `目标hp ≤ 自己攻击力`。
#   ⚠️ 直线距离是**乐观**估计（不绕墙）：宁可偶尔多抑制一次吃矿，也不在这里做寻路 ——
#   `_evaluate` 每次决策要跑十万次量级，只允许 O(单位数) 的整数比较。
func _gold_kill_ready(sim: Sim, u: SimUnit) -> bool:
	for j in sim.units.size():
		var p: SimUnit = sim.units[j]
		if p == null or not p.alive or p.fn == DataRegistry.Faction.ENEMY:
			continue
		if p.hp <= u.eatk and grid.distance(u.cell, p.cell) <= u.emove + u.atk_range:
			return true
	return false

# 【2026-09-19 新增·默认关】吃矿的**机会成本**：这一手"踩上矿格且没攻击"时，
# 返回"若改为攻击能造成的价值"（用同一套 `_evaluate` 反事实推演，**不另立一套公式**）。
#   · 触发三条全中才算：能捡矿 / 真吃到了矿（`gold_taken` 增加）/ 这一步没攻击。
#   · 反事实的取法是"该单位本回合**能打出的最优一击**"（含走位到能打的位置）——即最优替代方案。
#   · 若本回合根本打不到人（如 S4 场景）⇒ 最优一击为空 ⇒ 返回 0 ⇒ 吃矿不被罚（这正是我们要的）。
#   · 成本：只在"吃矿且没攻击"的那几条子状态上算（每个决策最多几次），每次 ≈ 几十次 clone+apply+evaluate。
func _gold_opportunity(pre_sim: Sim, idx: int, action: Dictionary, post_sim: Sim, acts: Array) -> float:
	var u: SimUnit = pre_sim.units[idx]
	if u == null or not u.can_pickup_gold:
		return 0.0
	if post_sim.gold_taken <= pre_sim.gold_taken:
		return 0.0                       # 这一步没吃到矿 ⇒ 没有机会成本
	if int(action.get("atk", -99)) >= 0:
		return 0.0                       # 吃了矿又打了人 ⇒ 没有放弃攻击
	var base := _evaluate(pre_sim)
	var best := 0.0
	for a2 in acts:
		if int(a2.get("atk", -99)) < 0:
			continue
		var s3: Sim = pre_sim.clone()
		_apply(s3, idx, a2)
		var g := _evaluate(s3) - base
		if g > best:
			best = g
	return best

# 黄金矿工到最近金矿的路网距离（无金矿返回一个大数）。用于给"朝矿靠拢"的评分梯度。
# 被墙隔死时退回软代价（"肯砸墙的话要走多远"），否则矿工对着被墙隔开的矿会完全没有方向。
func _nearest_gold_dist(sim: Sim, u: SimUnit) -> int:
	var best := INF_DIST
	var passing: bool = u.skills.has(DataRegistry.Skill.INFILTRATE)
	for c in sim.gold_cells.keys():
		var d := approach_dist(sim, u.cell, c, passing)
		if d < best:
			best = d
	return best

# 后勤里"需要冲前线"的特例：烛火(hero_17) 靠"移动后伤害相邻敌人"输出，
# 必须顶到敌人身边才有效——不能按普通后勤缩在后方。
func _logistics_charges(u: SimUnit) -> bool:
	return u.hero_id == "hero_17"

# 与最近对立单位（此处即玩家单位）的**路网距离**；无则返回一个大数。
# 用路网距离：被墙挡着时"直线 3 格"不等于"这一回合够得到"。
# 被墙完全隔死时退回软代价（"肯砸墙的话有多远"），这样"我够不到谁"的判断仍有远近之分。
func _nearest_enemy_dist(sim: Sim, u: SimUnit) -> int:
	var best := INF_DIST
	var passing: bool = u.skills.has(DataRegistry.Skill.INFILTRATE)
	for i in sim.units.size():
		var t: SimUnit = sim.units[i]
		if t.alive and t.fn != u.fn:
			var d := approach_dist(sim, u.cell, t.cell, passing)
			if d < best:
				best = d
	return best

# 【2026-09-15 删除·用户决定】原 `_siege_bonus()`（"战斗增援激励"）整段删除：
# 门控 = "战斗已爆发"（有敌方掉血 或 有敌对单位相邻）且场上有玩家；满足后每个存活敌方单位
# 按 `SIEGE_BASE(3.0) - 超出射程格数 × SIEGE_OVER(0.8)` 计分（射程内 +3、超 4 格起转负）。
# 用户判定它与 `_position_score()` 里的 `ENGAGE_PULL_PER_CELL` 重复（同一把路网距离
# `_nearest_enemy_dist`、同一条后勤豁免、在"本回合全力也够不到"的区间里两条同时生效 →
# 每格合计 −2.0），选 **B：删 `SIEGE_*`、只留 ENGAGE_PULL**。
# 除重复外的理由：① "射程内 +3"是**状态奖励**（站那儿不动就有分），与已删的 `THREAT_SAFE_CELL`
# 同类，"能打到人"已由血量账 + 集火 frac² 覆盖；② 它多带一条"战斗已爆发"门控启发式，而
# `ENGAGE_PULL` 全程有效（开局只有它在推）；③ 意图有张力：SIEGE 一直逼到"站进射程"，
# 而 ENGAGE_PULL **有意**在"本回合够得到"时归零、后半程交给站位侧的账（⑥规则B / ⑮必死折）。
# 可调键 20 → 18。另按用户决定删掉了只测这一项的两个旧探针：
# `tests/SiegeVerify.gd/.tscn`、`tests/SiegePushVerify.gd/.tscn`。

# 【RL 新增】身价缓存：键 = "E:"/"P:" + hero_id（E = 我方 Faction.ENEMY，P = 玩家方）。
# 为什么要缓存：一次 _evaluate 会对每个在场单位各取一次身价，而一回合要评估几十万次；
# 身价只依赖"在场英雄是谁"（不依赖血量/位置），所以整局有效，只在**存活阵容变化**时清空。
# 镜像局里同一英雄可能两边都在场，所以键必须带阵营前缀。
var _v_parts := {}
var _v_mine_n := -1
var _v_foe_n := -1
var _v_mine_h := -1     # 我方存活阵容的哈希（见 `_value_refresh`）
var _v_foe_h := -1

# 存活**阵容**签名（数量 + 阵容哈希）：单位只增不减（召唤/阵亡都会改数量）。
# ⚠️ 【2026-09-20 修 bug】原来只比**数量**（`mn`/`fn2`）⇒ "死的是 A 还是 B"在缓存里区分不出来，
#   而 `_unit_price()` 的身价恰恰依赖**队友/对手是谁**（solo/synergy/counter 三项）⇒
#   同一层里**先被评估的候选**会把身价写进缓存，**后评估的另一个阵亡组合**直接读到别人的值。
#   后果：评分与**评估顺序**挂钩。实测物证：当年只把终选层"真推演"那一层的评估顺序改了一下
#   （从"边比边推演"改成"先全部推演再比"）——**逻辑完全等价**——出招却变了 2 个盘面（§14#184）。
#   ⚠️ 那一层已于 2026-09-22 晚整段删除；这条**隐藏状态依赖本身仍然存在**（T14 未修）。
#   修法：签名里带上（阵营, hero_id）的滚动哈希 ⇒ 阵容一变就作废；成本仍是每次 `_evaluate` 一次
#   O(单位数) 的整数滚动（`hash()` 对短字符串很快，且比原来的纯计数多不了多少）。
func _value_refresh(sim: Sim) -> void:
	var mn := 0
	var fn2 := 0
	var hm := 0
	var hf := 0
	for i in sim.units.size():
		var u: SimUnit = sim.units[i]
		if not u.alive:
			continue
		var h := hash(u.hero_id)
		if u.fn == DataRegistry.Faction.ENEMY:
			mn += 1
			hm = (hm * 1000003 + h) & 0x3fffffff
		else:
			fn2 += 1
			hf = (hf * 1000003 + h) & 0x3fffffff
	if mn != _v_mine_n or fn2 != _v_foe_n or hm != _v_mine_h or hf != _v_foe_h:
		_v_mine_n = mn
		_v_foe_n = fn2
		_v_mine_h = hm
		_v_foe_h = hf
		_v_parts.clear()

# 取某英雄的"身价"（缓存未命中时才真的去算：收集队友/对手 id + 三项分量加权）。
func _unit_price(sim: Sim, hero_id: String, mine: bool) -> float:
	var ck := ("E:" if mine else "P:") + hero_id
	if _v_parts.has(ck):
		return float(_v_parts[ck])
	var same: Array = []
	var other: Array = []
	for i in sim.units.size():
		var cu: SimUnit = sim.units[i]
		if not cu.alive:
			continue
		if (cu.fn == DataRegistry.Faction.ENEMY) == mine:
			same.append(cu.hero_id)
		else:
			other.append(cu.hero_id)
	var p: Dictionary = DataRegistry.battle_unit_value_parts(hero_id, same, other, null)
	var v: float = float(p["solo"]) * VALUE_SOLO_W * _hero_value(hero_id) \
			+ (float(p["synergy"]) + float(p["counter"])) * VALUE_RELATION_W
	_v_parts[ck] = v
	return v

# 【打谁/保谁】= **身价**（唯一成分，见 §1）。动态的东西都在别的项里：
#   伤害收益 → §2 血量账 `HP_VALUE_W`；集火/补刀/击杀 → §5；威胁/位置 → §6/§7。
# 已删除（用户 2026-09-15 决定，全部整段删掉、不留开关）：
#   · "当下战力"（`NUM_ATK_W×eatk + NUM_HP_W×hp`）—— 用户："值不值得打，通过算伤害评分就可以了，
#     我打的越多、扣的血越少，那这条路径就是最好的"；且"可调键越多，越难训练"。
#     顺带修掉两个毛病：血量被重复计价、"血厚反而更值钱"的倒挂；
#   · 4 个"身份词条"加成（远程+2.0 / 嘲讽+1.5 / 疾行+0.5 / 后勤+1.0）
#     —— 与角色列表"总评分"里的 特性评分/技能评分 **重复计价**；
#   · "有盾 +2.0" —— 盾的作用**已经由伤害结算考虑了**（_sim_take_damage 里先扣护盾吸收），
#     再给"有盾加分"是重复计价，而且方向可疑（会让 AI 更想打有盾的敌人）；
#   · `_synergy_value()`（3 条判断里 2 条符号写反）—— 并入身价公式。
# 【兼容性】本函数支持**两种调用形式**（冻结的 harness 必须继续能跑）：
#   ① 内部热路径：`_unit_value(sim, u)` —— 身价 = 单人评分×HERO_VALUE + 配合分 + 克制分
#   ② 【技能对拍.gd L195-196 的单参形式】`_unit_value(u)` —— 拿不到队友/对手，
#      所以只返回「单人评分 × HERO_VALUE」（那个 harness 只拿它比较两个单位的价值高低）。
# 改签名时务必保住 ②，否则会静默打挂 `技能对拍 plancore` 模式。
func _unit_value(a, b = null) -> float:
	var u: SimUnit = null
	var sim: Sim = null
	if b == null:
		u = a as SimUnit
	else:
		sim = a as Sim
		u = b as SimUnit
	if u == null:
		return 0.0
	# 骷髅兵是"回合结束即消失"的消耗品：价值为 0，死亡不亏——
	# AI 不会护着它（避免它往远离敌人的地方跑），而是拿它去换伤害/骚扰。
	if u.hero_id == "summon_skeleton":
		return 0.0
	if sim == null:
		return DataRegistry.hero_strength(u.hero_id) * _hero_value(u.hero_id)
	# 身价就是全部：动态成分都在别的项里（血量账 HP_VALUE_W / 集火 / 补刀 / 击杀）。
	var v := _unit_price(sim, u.hero_id, u.fn == DataRegistry.Faction.ENEMY)
	# 眩晕/沉默的折减**已整项删除**（2026-09-19，见 §14 登记）；状态价值只由模拟表达。
	return v
