## 英雄特化：t 形如 { "hero_42": {"GOLD_TAKE_VALUE": 40.0, "GOLD_TAKE_VALUE_LOW": 60.0} }
## 【RL 新增】另支持 `{ "HERO_VALUE": { "hero_22": 1.35, ... } }` 这一段，
## 填的是"核心价值系数"（乘进身价的「单人评分」项）；见 _hero_value()。
func set_hero_weights(t: Dictionary) -> void:
	var hv = t.get("HERO_VALUE", null)
	if typeof(hv) == TYPE_DICTIONARY:
		w_hero_value = {}
		for hid in (hv as Dictionary).keys():
			var mv = (hv as Dictionary)[hid]
			if typeof(mv) == TYPE_FLOAT or typeof(mv) == TYPE_INT:
				w_hero_value[String(hid)] = float(mv)
	w_hero = {}
	for hid in t.keys():
		if String(hid) == "HERO_VALUE":
			continue
		var sub = t[hid]
		if typeof(sub) != TYPE_DICTIONARY:
			continue
		for k in (sub as Dictionary).keys():
			var v = sub[k]
			if typeof(v) == TYPE_FLOAT or typeof(v) == TYPE_INT:
				w_hero["%s|%s" % [String(hid), String(k)]] = float(v)

## 【RL 新增】取某英雄的核心价值系数：**只认注入值**，不给就是 1.0。
## 迁移说明：原先这里回退到写死的 `HERO_VALUE_DEFAULT`（49 条手写档位），已删除——
## "单人评分"现在统一由角色列表的"总评分"决定（DataRegistry.hero_strength），手写表属于"写死"。
## 那张表原样搬到了数据文件 `RL/weights/身价_英雄系数.json`（以 HERO_VALUE 段注入即可继续用）。
func _hero_value(hero_id: String) -> float:
	return float(w_hero_value.get(hero_id, 1.0))

## 取英雄特化权重；没有则回退通用值
func _wh(hero_id: String, key: String, fallback: float) -> float:
	if w_hero.is_empty():
		return fallback
	return float(w_hero.get("%s|%s" % [hero_id, key], fallback))

## 【2026-09-21 新增·B 档】目标英雄的「技能评分 + 补强」（角色列表第 14/15 列 ⇒ `HeroDef.ai_skill_score/ai_boost`）。
## 用途：⑰⑱⑲ 三个"把对手关掉一回合"的动作项**共用这一种货币** —— 一张卡"不靠面板"的那部分价值。
## 名字可能取不到（召唤物/未知英雄没有 def）⇒ 返回 0 是安全的（那一项就不加分）。
func _skill_worth(hero_id: String) -> float:
	var d = DataRegistry.get_hero(hero_id)
	if d == null:
		return 0.0
	return float(d.ai_skill_score) + float(d.ai_boost)

## 【2026-09-21 新增·B 档·⑰】沉默术士(hero_34) 沉默这个目标值多少分。
## 口径 = 角色列表 hero_34「克制」列原文**照抄**：「技能评分+补强>3的非替补角色」⇒
##   非替补 + (技能评分+补强) > `SILENCE_COUNTER_MIN` 才给分，分值就是 (技能评分+补强)（系数由 `SILENCE_VALUE_W` 乘）。
## 不满足门槛 ⇒ 返回 0（这就是"沉默术士不克它"）。
func _silence_worth(hero_id: String) -> float:
	var d = DataRegistry.get_hero(hero_id)
	if d == null or d.skills.has(DataRegistry.Skill.BENCH):
		return 0.0
	var worth := float(d.ai_skill_score) + float(d.ai_boost)
	return worth if worth > SILENCE_COUNTER_MIN else 0.0

## 【2026-09-21 新增·B 档·⑱】荆棘树人(hero_49) 把目标封住（[荆棘] = 无法移动）值多少分。
## 只有**后勤**(`<后勤>`：烛火/末日/涌电技师) 与 **远程**(`<远程>`) 两类目标给分 —— 用户原话
## 「荆棘树人打远程和后勤非常强」：这两类卡的强度靠"站位自由"（后勤要走到队友旁边、远程要拉开距离），
## 而被封住这一回合它们在 ⑥⑦ 里只会体现成"打出来的伤害少了一点"，完全读不到"走不动"这笔账。
## **系数按施加者英雄覆盖读**（`_wh`，与 SOLID_HOLD_W 同口径：值写在 `hero_49` 段里才算数，扁平键只是兜底）。
## 后勤优先判（两类同时命中时只算一次，避免重复计价）。
func _thorn_pin_worth(applier: String, target: String) -> float:
	var d = DataRegistry.get_hero(target)
	if d == null:
		return 0.0
	var worth := float(d.ai_skill_score) + float(d.ai_boost)
	if d.skills.has(DataRegistry.Skill.LOGISTICS):
		return _wh(applier, "THORN_PIN_SUP_W", w_pin_sup) * worth
	if d.attack_type == DataRegistry.AttackType.RANGED:
		return _wh(applier, "THORN_PIN_RANGED_W", w_pin_ranged) * worth
	return 0.0

## 【2026-09-20·用户拍板】"这批键里有没有任何一条被英雄段覆盖过"。
## 用途：⑫⑬⑭⑯ 这几个**按英雄覆盖**读取的项，原来的总闸门是"扁平键非 0 才进这段循环"
## ⇒ 一旦值只写在 `hero_XX` 段里（扁平键保持 0），整段就被跳过、英雄段白写。
## 这里扫一遍 `w_hero`（通常只有几条）比"让英雄段也被算进去"更精确：没写英雄段时**一分钱开销都不多**。
func _any_hero_key(keys: Array) -> bool:
	for k in w_hero.keys():
		var s := String(k)
		var i := s.find("|")
		if i >= 0 and keys.has(s.substr(i + 1)):
			return true
	return false

func _init(g: HexGrid) -> void:
	grid = g

# 由 Battle 提供的数据构建模拟状态（units 顺序与 Battle.units 一致）
# active_fn：【RL 修正】当前行动方阵营，缺省=敌方（=AI 自己行动，生产路径就是这个语义）。
# 只影响"圣光只在敌方回合护己方"这类**看回合归属**的技能；对拍 harness 测 active=P 的场景时显式传入。
# rosters：【RL 修正】快照 "rosters" 键（用户已批准的那一行）→ sim 用它预测"窗口内替补登场"。
# 缺省 {} = 不预测替补（= 改动前的行为），生产路径与老调用点都不受影响。
# auto_sub：【RL 修正】"哪些阵营的替补是工具/生产自动补位、按什么规则选人"（fn -> "score"/"first"；
# 老口径 `true` 等价于 "score"，见 Sim.auto_sub 与 `_sim_sub_rule`）。
# **可选**第 10 参；缺省 {} = 谁都不预测替补 = 与加本参之前逐位相同（生产路径与老调用点不变）。
# 只有 harness（检视器）在"它自己会替那一方按已知规则点选"时才传。
# **可选**第 11 参 `buff_owner`：道具**归属**（cell -> 阵营），来自快照 `"buff_owner"`。
# 缺省 {} = 所有道具都当**中立**（双方都能捡）= 与加本参之前逐位相同（老调用点不受影响）。
# 见 `Sim.buff_owner` 与 `_sim_pickup_owned()` 的说明。
func build_state(unit_descs: Array, occ: Dictionary, gold_cells: Dictionary = {}, graves: Dictionary = {}, obstacles: Dictionary = {}, bombs: Dictionary = {}, buff_cells: Dictionary = {}, active_fn: int = -1, rosters: Dictionary = {}, auto_sub: Dictionary = {}, buff_owner: Dictionary = {}) -> Sim:
	var s := Sim.new()
	s.rosters = rosters.duplicate(true)
	s.auto_sub = auto_sub.duplicate()
	s.active_fn = DataRegistry.Faction.ENEMY if active_fn < 0 else (active_fn as DataRegistry.Faction)
	s.buff_owner = buff_owner.duplicate()   # 【2026-09-21】道具归属（圣诞老人的礼物只有放置方能捡）
	s.gold_cells = gold_cells.duplicate()
	s.graves = graves.duplicate()
	s.obstacles = obstacles.duplicate()
	s.bombs = bombs.duplicate()
	s.buff_cells = buff_cells.duplicate()
	for d in unit_descs:
		var u := SimUnit.new()
		u.fn = d["fn"]
		u.hero_id = d["hero"]
		u.cell = d["cell"]
		u.hp = d["hp"]
		u.hp0 = u.hp   # 本回合起点血量：评估"本回合对同一目标累计伤害"的基准
		u.max_hp = d["max_hp"]
		u.atk = d["atk"]
		u.eatk = d.get("eatk", d["atk"])
		u.move = d["move"]
		u.emove = d.get("emove", d["move"])
		# 【RL 修正】移动道具的存在量（真实 `Unit.move_use_buff`）：快照不带，由 harness 在
		# build_state 前补进 descs（与 [坚固]/solid 同一做法）；生产路径缺省 0。
		# 有了它，"移动消耗本次移动前持有的道具"与"移动中捡到道具"才能按真实公式记账（见 _apply）。
		u.move_use_buff = int(d.get("move_use_buff", 0))
		# 【RL 修正】一次性攻击道具（真实 `Unit.atk_use_buff`）：它**属于** `effective_atk()`
		# （`base + atk_buff + ramble_bonus + sun_bonus + atk_use_buff − 麻痹`），所以模拟里
		# `eatk` 也要含它、攻击结算后再扣掉；快照不带这个字段，由 harness 补进 descs。
		u.atk_use_buff = int(d.get("atk_use_buff", 0))
		u.atk_range = d["atk_range"]
		u.atk_type = d["atk_type"]
		u.skills = d["skills"].duplicate()
		u.name = d["name"]
		# 【RL 修正】**每回合状态**（真实 `Unit.moved_this_turn / attacked_this_turn / counter_used_this_turn`）：
		# 检视器/对拍是"**每一招**都用出招前的真实盘面重建一份 sim"，若不带这三个标志，
		# "本回合已经反击过/已经出过手"这件事就丢了。实测（用户实机）：
		#   赏金猎人(hero_20) 本回合**已经反击过**，鼠队长(hero_04) 再去打它 → 真实 0 反击伤害（名额已用），
		#   模拟却按"还能反击"扣了鼠队长 1 点血 → `血量 预测14→实际15`。
		# 缺省 false = 不传 descs 键时与改动前完全一致（生产侧在回合开始建快照，本来就都是 false）。
		u.moved = bool(d.get("moved", false))
		u.attacked = bool(d.get("attacked", false))
		u.counter_used = bool(d.get("counter_used", false))
		u.stunned = d.get("stunned", false)
		u.silenced = d.get("silenced", false)
		u.shield = d.get("shield", false)
		u.heavy = d.get("heavy", false)
		# 【RL 修正】[坚固](hero_48)：快照不带此字段 → 缺省 false（由 harness 在 build_state 前补进 descs）
		u.solid = bool(d.get("solid", false))
		u.poisoned = d.get("poisoned", false)
		# 【2026-09-20】毒的施加者（sim_index）：快照不带 ⇒ 缺省 -1 ⇒ ⑫ 退回扁平键兜底值。
		u.poisoner = int(d.get("poison_by", -1))
		u.frozen = d.get("frozen", false)
		# 【RL 修正】共鸣者的 echo 状态（src/BattleSnapshot.gd 的 unit_desc 带该键；
		# 缺省 -1 = 未激活 = 改动前行为）。2026-09-20 修 bug 后：真实 `effective_atk()` = 
		# `max(echo_set + atk_use_buff, 0)` ⇒ **攻击道具 +1 照常生效**，sim 侧不再为 echo 单开减免分支
		# （旧的"捡道具/消耗两处守卫"已删，理由见 `src/Unit.gd:414` 与那两处的注释）。
		u.echo_set = int(d.get("echo_set", -1))
		# 【RL 修正】[麻痹]/[荆棘] 的状态存在性：src/BattleSnapshot.gd 的 unit_desc 现在带这两个键
		# （缺省 false = 改动前行为）。注意两者的**效果**本来就已经在快照里了（eatk 已含麻痹降攻、
		# emove 已含荆棘清零），这里补的是"状态在不在"这一位（供检视器字段层比对）。
		u.atkdown = bool(d.get("atkdown", false))
		# 【RL 修正】风语者(hero_43)移动光环的"真实账本份数"（harness 注入 descs 键 `ws_aura`）：
		# 缺省 -1 = 键缺失（生产路径）→ 阵亡收回时退回"同阵营存活队友全减"的近似。
		u.ws_aura = int(d.get("ws_aura", -1))
		# 【RL 修正】真实 `src/Unit.gd:29` `once_this_turn`（每回合限一次类技能；圣光在
		# heroes/hero_22_圣光.gd:27/31/45/48/52 读写它）：快照原本**不带**这个字段，而检视器/矩阵是
		# "每一招都新建一份 sim" → `aura_used` 永远从 false 开始 → 真实那回合前面某招已把名额用掉，
		# 模拟却以为还能发 → **多发一面盾**（用户局那 3 条残项正是这个）。
		# 键名与注入端约好为 `once_this_turn`；缺省 false = 改动前行为（生产路径不注入时行为完全不变）。
		u.aura_used = bool(d.get("once_this_turn", false))
		u.thorn = bool(d.get("thorn", false))
		u.possessed_by = int(d.get("poss_by", -1))   # 已有宿魂附体绑定（真实残留）
		# 【RL 修正】召唤物主人（真实 `Unit.summon_owner` → 本快照里的下标）：死灵法师阵亡时
		# 只让自己召唤的骷髅消散。快照不带这个字段 → 由 harness 注入；缺省 -1 = 退回"同阵营骷髅"近似。
		u.owner_idx = int(d.get("owner", -1))
		u.immune_bombs = bool(d.get("immune_bombs", false))   # 由英雄脚本免疫钩子提供（炸弹人=true）
		u.can_pickup_gold = bool(d.get("can_pickup_gold", false))   # 由英雄脚本金矿钩子提供（矿工=true）
		# 【RL 修正】出生即成立的"英雄特化修正"（坠炮手全场狙击、血锁被沉默射程退化）
		# 走同一入口，供 build_state 与 _sim_spawn_sub（替补登场）共用。
		_sim_apply_hero_fixups(u)
		s.units.append(u)
	# 统一 occupancy 值语义为 SimUnit 对象：外部传入的是 "cell -> idx"，这里转成 "cell -> 对象"，
	# 与 _apply/_sim_swap_cells 等写入对象保持类型一致，避免部分状态 int、部分对象导致 cast 失败。
	var by_idx: Dictionary = {}
	for i in s.units.size():
		s.units[i].sim_index = i
		by_idx[i] = s.units[i]
	s.occ.clear()
	for k in occ.keys():
		var unit: SimUnit = by_idx.get(occ[k], null)
		if unit != null:
			s.occ[k] = unit
	# 【RL 修正】建局时先定"远程被贴"缓存标记，再反推 buff 部分（pin_buffs/pin_init）。
	# 标记来源：descs 的 `ranged_adjacent`（真实 `Unit.ranged_adjacent`，由 harness 注入；见技能对拍 _build_sim）。
	# 没有这个键时退回"按当前相邻关系实时算"（老行为，生产侧目前就是这个口径）。
	# 注意：真实这个标记**可能是过期的**（击退/换位/拉人/召唤落点都不刷新它），
	# 用快照的真实值才能复现"过期窗口内攻击用旧攻击力、收尾时才修正"这条真实行为。
	for i in s.units.size():
		var pu: SimUnit = s.units[i]
		if pu == null or pu.atk_type != DataRegistry.AttackType.RANGED:
			continue
		var pd: Dictionary = unit_descs[i]
		if pd.has("ranged_adjacent"):
			pu.pin_flag = bool(pd["ranged_adjacent"])
		else:
			pu.pin_flag = _sim_enemy_adjacent(s, pu, pu.cell)
	_sim_sync_pins(s)
	# 【2026-09-20 用户口径】把"**本回合行动前**是否已交战"记在局面上（⑥ 的开关判据，整回合不变）：
	#   建局 = 本回合开始（生产侧 Battle.gd 每回合用快照建一次 sim 再 `search()`）⇒ 这里算一次就够。
	s.engaged0 = _engaged(s)
	return s

# 【2026-09-19 新增·默认关】难度档「概率性弱化」的确定性抽签：
#   用**局面的哈希**当随机源 ⇒ 同一局面永远同一结果，整局可复现（与 `LOTTERY_SEED` 同一套做法）。
#   为什么不用 `randf()`：全局 RNG 不受对局种子控制 ⇒ 同一局重跑结果不同，评测与回放都不可复现
#   （这也是 `JITTER` 那一族"跨进程不可复现"的原因）。
func _weak_roll(sim: Sim) -> float:
	var h := int(w_weak_seed) & 0x7fffffff
	for u in sim.units:
		if u == null or not u.alive:
			continue
		h = (h * 1103515245 + 12345 + int(u.hp) * 7919
				+ (int(u.cell.x) * 31 + int(u.cell.y)) * 104729) & 0x7fffffff
	return float(h % 100000) / 100000.0

# 【2026-09-19 新增·默认关】判负线判定（见 `const NO_LOSS_FILTER` 处说明）：
#   "指挥方（`fn`）的非召唤物存活数 = 0" ⇒ 这一线**直接判负**（3 人阵容 = 累计阵 3 人）。
#   召唤物不计：`owner_idx >= 0` 的单位是召唤物（真实侧同样不计入判负死亡数，见 `_sim_kill`）。
func _myside_wiped(sim: Sim, fn: int) -> bool:
	for u in sim.units:
		if u == null or not u.alive:
			continue
		if u.fn == fn and u.owner_idx < 0:
			return false
	return true

# ---- 【2026-09-23 新增·默认关】搜索模式（`SEARCH_MODE`）----
# 用户口径（原话）：「我希望 AI 的攻击不要按顺序，移动打移动打移动打这样…比如 A 走 → B 走 → C 打 →
#   A 打 → B 打 这种逻辑」。现役模式（0）排不出这条：每个单位的"移动+攻击"被绑成一个组合、一步做完就
#   `done` ⇒ 一个单位只要"只移动不打"，它的攻击就作废。而真人规则**允许**这条（`Battle._unit_done()`
#   对普通单位只看 `attacked_this_turn`，只移动过不算完成；本文件 `_actions_for()` 的边界注释也写着
#   "已移动但未攻击仍允许"）⇒ 现役 AI 少了一条合法选项。
#   1 = 两阶段联合搜索（实现与理由见 `_search_two_phase()`）：**先联合决定"每个单位走到哪"，再联合决定
#   "谁打谁、什么顺序"**。⚠️ 模式 1 是**严格两段**：阶段 1 的所有移动都在阶段 2 的所有动作之前
#   ⇒ 排不出"夹在两次攻击中间挪位"（用户追问的第二条：「A 挪位，B 挪位，C 挪位打，B 打，A 打 能吗」）。
#   2 = 模式 1 **放宽一处**：阶段 2 里**还没挪位的单位**可以直接用现役那一整套组合（含"移动+攻击"）
#   ⇒ 于是"A 先挪、B 先挪、C 这一手移动+出手、B 出手、A 出手"这类穿插排得出来，
#   也能排"先打死挡路的、再走过去"（单位挡移动路）与"医护兵晚点移动去治刚被打残的人"。
#   ⚠️ 剩下的结构限制（模式 2 也做不到）：位移**夹在两次攻击中间**（`Y 打 → X 挪位 → Z 打 → X 打`）——
#   要覆盖得回到"每单位两槽 + 完全任意穿插"的动作空间，那会踩剪枝陷阱（详见 `_search_two_phase()` 注释）。
#   默认 0 = 关 ⇒ 现役路径（`search()` 的后半段）逐位不变；简单/普通/困难也不注入这个键。
const SEARCH_MODE := 0
# 阶段 2 只看阶段 1 排前 N 套阵型（其余剪掉）—— 与内层宽度一起决定"两阶段"的总预算（≈ 与现役同量级）。
# ⚠️ 【2026-09-23 深夜②·已试过并回退】曾放到 **32**（想盖住"阶段 1 位置分看走眼"的那一段），实测
#   没有棋力收益、阶段 2 却贵约 4 倍 ⇒ **按用户拍板回到 8**（依据见 `_layout_score()` 上方那段与
#   `Data/Progress_tracking/1_通用策略.md` 文末那一轮：`sm24` 批 Δpts(sm2−sm0) = −6.07 [−14.52,+2.38]）。
const TWO_PHASE_LAYOUTS := 8

# ---- 主入口：返回最优行动序列 [{idx, action}] ----
func search(sim: Sim, enemy_faction: int) -> Array:
	# 【RL 修正】把"本次搜索指挥的一方"写进 active_fn（对齐 src/BattleAI.gd 的 `sim.me_faction = enemy_faction`）。
	# 两个用途：① 圣光"只在敌方回合护己方"的时机判定；② 落停炸弹惩罚里判"我方"。
	# 生产里 AI 只在敌方回合行动 → active_fn 与 src 的 me_faction 取值一致。
	# `enemy_faction` 是 int 入参、`Sim.active_fn` 是 `DataRegistry.Faction` 枚举类型字段：
	# 直接赋 int 会报 `INT_AS_ENUM_WITHOUT_CAST` 警告（编辑器里会看到），所以显式 `as` 转换。
	sim.active_fn = enemy_faction as DataRegistry.Faction
	var enemy_idxs: Array = []
	for i in sim.units.size():
		if sim.units[i].fn == enemy_faction and sim.units[i].alive:
			enemy_idxs.append(i)

	# 【2026-09-19 新增·默认关】难度档「概率性弱化」（见 `const WEAK_MODE` 处说明）：
	# 这一回合以 `WEAK_P` 的概率走弱化引擎，否则走满血引擎 ⇒ 低档也能"偶尔打出最好的操作"。
	# `WEAK_MODE=0` 或 `WEAK_P<=0` ⇒ `wk_on` 恒 false ⇒ 下面三行都是恒等操作 ⇒ **逐位不变**。
	var wk_on := (w_weak_mode > 0 and w_weak_p > 0.0 and _weak_roll(sim) < w_weak_p)
	# 三种弱法（可单用可叠加）：
	#   ① 每单位独立贪心（结构差：不跑整队联合束搜索）
	#   ② 关威胁预判整层（价格差：不看下回合挨打）—— ⚠️ 实测"改它无剂量-响应"，弱化效果存疑
	#   ③ **关集火合力**（价格差：不再往同一目标叠伤害）—— 三轮独立合并 **−5.85 [−10.9,−0.8] 显著**，
	#      是项目里**唯一有跨轮显著证据**的削弱手段
	var wk_greedy := wk_on and (w_weak_mode == 1 or w_weak_mode == 3 or w_weak_mode == 5)
	var wk_nothreat := wk_on and (w_weak_mode == 2 or w_weak_mode == 3)
	var wk_nofocus := wk_on and (w_weak_mode == 4 or w_weak_mode == 5)
	var kd_save := w_threat_dead_fold
	var kf_save := w_focus_fire
	if wk_nothreat:
		w_threat_dead_fold = 0.0
	if wk_nofocus:
		w_focus_fire = 0.0
	if wk_greedy:
		# 不跑整队联合束搜索，改成"每个己方单位各自贪心挑一步"（复用超时兜底那套）。
		# 代价：跨单位的配合（先贴脸再收割、替队友开盾）全没了 ⇒ **结构性的能力差**，不是调价格。
		var gw: Array = _greedy_finish([{ "sim": sim, "path": [], "score": _evaluate(sim), "done": {},
				"tb": (_tiebreak_tuple(sim) if w_tiebreak_mode > 0 else []) }], enemy_idxs)
		w_threat_dead_fold = kd_save
		w_focus_fire = kf_save
		if gw.size() > 0:
			return gw[0]["path"]
		return []

	# 【2026-09-23 新增·默认关】两阶段联合搜索（见 `const SEARCH_MODE` 与 `_search_two_phase()` 的说明）：
	#   把"移动"和"攻击"分成两段联合搜索 ⇒ 排得出 "A 走 → B 走 → C 打 → A 打 → B 打" 这类方案。
	#   ⚠️ 两条**已知不与本模式叠加**的机制（同时开就退回现役路径，避免两套簿记打架）：
	#     ① 低档弱化引擎（`WEAK_MODE`：贪心/关威胁/关集火）—— 那几档本来就不会开本模式；
	#     ② 吃矿机会成本（`GOLD_OPPORTUNITY_W`）—— 它是"动作层跨阶段"记账，本模式没复刻。
	if w_search_mode >= 1 and not wk_greedy and not wk_nothreat and not wk_nofocus and w_gold_oc == 0.0:
		var plan_two := _search_two_phase(sim, enemy_idxs)
		w_threat_dead_fold = kd_save
		w_focus_fire = kf_save
		return plan_two

	# 自由行动顺序：每层从"尚未行动"的敌人中任选一个扩展，让搜索能探索不同攻击顺序
	# （如先近战贴脸、后远程收割残血），选出整体利益最大的方案。用 done 记录各状态已行动单位。
	# 规模控制：deadline 决定"能搜多广"（见 time_budget_ms），beam 决定"每层保留多少条线"；
	# 边扩边归并（只留 top 2×beam）——不把所有子状态同时驻留，内存不随候选总量膨胀。
	var t0 := Time.get_ticks_msec()
	var deadline := (t0 + time_budget_ms) if time_budget_ms > 0 else 0
	var beam := _beam()
	# 【已删 2026-09-20·用户拍板】原规则 A（`FOCUS_KILL_RULE` / `FOCUS_NET_MARGIN` = "合力可杀 + 净收益"的并列裁决层）：
	#   实测只 +0.20、CI 跨 0 ⇒ 键 + `_rule_a_gain()` / `_rule_a_can_reach()` / 状态里的 `ra` 累计 + `RULE_A_TIE_EPS` 一起删。
	var states: Array = [{ "sim": sim, "path": [], "score": _evaluate(sim), "done": {},
			"tb": (_tiebreak_tuple(sim) if w_tiebreak_mode > 0 else []) }]
	# 【2026-09-19 新增·默认关】判负线硬闸门的兜底池：只有当**所有**候选都是判负线时才会用到它
	# （否则会一条计划都搜不出来）。见 `const NO_LOSS_FILTER` 处说明。
	var wipe_fallback: Array = []
	while true:
		var pending := false
		var timed_out := false
		var merged: Array = []
		for st in states:
			# 找出该状态尚未行动的敌人
			var remaining: Array = []
			for i in enemy_idxs:
				if not (st["done"] as Dictionary).has(i):
					remaining.append(i)
			if remaining.size() == 0:
				merged.append(st)   # 已全部行动完，保留该完成态
				continue
			pending = true
			for idx in remaining:
				var acts: Array = _actions_for(st["sim"], idx)
				# 【2026-09-22 用户拍板·改判据】"能打到人却不打"的代价（见 `const IDLE_HIT_PENALTY`）。
				# **旧判据**只看"移动前**原位**够不够得到"（`_valid_targets(sim, iu, iu.cell)`）⇒ 于是
				#   **"走一步上去打"这条路一分钱都不罚**：实测（`RL/probe/避战自检.gd`）雪拳 (2,1)、
				#   移动 3、射程 1，玩家矿工 (3,3)：可达 14 格里有 **4 格与矿工相邻、各有 1 个目标**
				#   ⇒ 它本来就能打，可"原地"那一项是 0 ⇒ 三条候选的 `idle` 全是 0.00 ⇒
				#   "打一下（净 ≈ 0：+2 伤害 − 3 反击）"与"走位不打（0）"**打平** ⇒ 并列裁决把不打赢走。
				# **新判据**＝"**本回合存在任何能打到人的出招**"（原位打 / 走一步再打都算），
				#   而且**直接读候选表自己**（`acts` 里有没有 `atk >= 0`）⇒ 与"它到底有哪些选择"逐字同源：
				#     · 与"撤退克制过滤"（`_actions_for()` 末尾的 `any_attack_avail`）**同一把尺子**；
				#     · 顺带修掉旧判据的两处口径差：**后勤单位**（不能主动攻击、只有反击）不再被误罚，
				#       以及"攻击候选被远程不贴脸闸门筛掉"时也不会再凭空罚它；
				#     · **零额外开销**（复用已经算好的 `acts`，不再多做一次 `_valid_targets`）。
				# 它仍然是**价钱不是硬规则**：抢金矿 / 残血逃命 / 吃关键道具这些更大的收益照样能压过它。
				var any_attack := false
				for a0 in acts:
					if int(a0.get("atk", -1)) >= 0:
						any_attack = true
						break
				var idle_hit := 0.0
				if w_idle_hit_penalty != 0.0 and any_attack:
					var iu: SimUnit = st["sim"].units[idx]
					if iu != null and iu.alive and not iu.attacked:
						idle_hit = w_idle_hit_penalty
				for a in acts:
					var s2: Sim = st["sim"].clone()
					_apply(s2, idx, a)
					var path: Array = (st["path"] as Array).duplicate()
					path.append({ "idx": idx, "action": a })
					var done2: Dictionary = (st["done"] as Dictionary).duplicate()
					done2[idx] = true
					# 【已删 2026-09-20·用户拍板】原规则 A 的"合格击杀净收益"累计（`ra`）随该键一起删除。
					# 【2026-09-19 新增·默认关】吃矿的**机会成本**（用户选的口径）：
					#   `矿的净价值 = 矿分 − GOLD_OPPORTUNITY_W × (这一手若改为攻击能造成的价值)`。
					#   为什么必须在**动作层**算：`_evaluate` 只看一个状态，看不到"这一手放弃了什么" ⇒
					#   只有这里同时握着"移动前的局面 + 这一步动作 + 移动后的局面"。
					#   触发条件（三条全中）：① 该单位能捡矿 ② 这一步**真的吃到了矿**（gold_taken 增加）
					#   ③ 这一步**没有攻击**（没攻击才谈得上放弃）。λ=0（默认）⇒ 整段不算 ⇒ 逐位不变。
					var oc := 0.0
					if w_gold_oc > 0.0:
						oc = _gold_opportunity(st["sim"], idx, a, s2, acts)
					# 【已删 2026-09-20·用户拍板】古拉博士(hero_14)的 `LEECH_TRIGGER_W`（"这一击触发吸血 ⇒ 补一笔"）
					# 连同这一段动作层代码**整块删除**：3 队 × 3 个值的棋力批越调越负（−0.56 / −1.83 / −3.70，
					# 胜率 0.39→0.33）⇒ 判死。吸血本身已经进血量账，不需要再单独定价（理由见
					# `RL/progress_tracking/2_英雄特化.md` 的古拉一行）。
					# 【2026-09-20 新增·默认关】这一手**没攻击**、而它移动前站着就能打到人 ⇒ 扣 `IDLE_HIT_PENALTY`。
					var idle := idle_hit if int(a.get("atk", -1)) < 0 else 0.0
					# 【2026-09-21 深夜·用户口径】"全队行动完"的那一层才把 ⑳㉑ 计入（见 `_evaluate` 注释）。
					var eot := done2.size() >= enemy_idxs.size()
					var cand: Dictionary = { "sim": s2, "path": path, "score": _evaluate(s2, eot) - w_gold_oc * oc - idle,
							"done": done2,
							"tb": (_tiebreak_tuple(s2) if w_tiebreak_mode > 0 else []) }
					# 【2026-09-19 新增·默认关】判负线硬闸门：这一手走完我方（非召唤物）全军覆没
					# ⇒ 直接判负的线**不进主比较池**（`NO_LOSS_FILTER=0` 时这个分支一次都不进 ⇒ 逐位不变）。
					if w_no_loss_filter > 0 and _myside_wiped(s2, enemy_faction):
						wipe_fallback.append(cand)
					else:
						merged.append(cand)
				# 归并：只留最好的若干条（被丢掉的状态分数更低，之后不可能再回到前 beam）
				if merged.size() > beam * 2:
					merged.sort_custom(_cmp_state)
					merged = merged.slice(0, beam)
				if deadline > 0 and Time.get_ticks_msec() >= deadline:
					timed_out = true
					break
			if timed_out:
				break
		if not pending:
			break
		merged.sort_custom(_cmp_state)
		states = merged.slice(0, beam)
		if timed_out:
			# 时间用尽：剩余单位改用贪心收尾（各自选一步内的最优动作），
			# 保证"每个敌人都行动"、计划完整，且不再花时间做 beam 扩展。
			# 只收尾最好的一小撮线（决赛只取 states[0]，尾部收益不值得再花时间）。
			states = _greedy_finish(states.slice(0, mini(states.size(), 24)), enemy_idxs)
			break
	# 【2026-09-19 新增·默认关】判负线硬闸门的兜底：主池空 ⇒ 退回判负线（至少给一个完整计划）。
	if states.size() == 0 and wipe_fallback.size() > 0:
		wipe_fallback.sort_custom(_cmp_state)
		states = wipe_fallback.slice(0, _beam())
	if states.size() == 0:
		w_threat_dead_fold = kd_save
		w_focus_fire = kf_save
		return []
	if log_decisions:
		_print_decision(sim, states[0])
	# 【2026-09-19】弱化引擎的临时权重还原（`wk_*` 全 false 时这三行是恒等操作）
	w_threat_dead_fold = kd_save
	w_focus_fire = kf_save
	return states[0]["path"]

## ---- 【2026-09-23 新增·默认关】两阶段联合搜索（`SEARCH_MODE = 1`）----
## 用户口径（原话）：「我希望 AI 的攻击不要按顺序，移动打移动打移动打这样…比如 A 走 → B 走 → C 打 →
##   A 打 → B 打 这种逻辑」。现役模式（0）排不出这条：每个单位的"移动+攻击"被绑成一个组合、一步做完就
##   `done` ⇒ 一个单位只要"只移动不打"，它的攻击就作废。而真人规则**允许**（`Battle._unit_done()` 对
##   普通单位只看 `attacked_this_turn`，只移动过不算完成；本文件 `_actions_for()` 的边界注释也写着
##   "已移动但未攻击仍允许"）⇒ 现役 AI 少了一条合法选项。
##
## 为什么必须**分两段**、而不是把"移动""攻击"混进一个动作空间让 beam 自己排：
##   beam 每层按"当前局面分"剪枝，而"只移动、还没打"的中间状态天然比"移动+打完了"低几分
##   ⇒ 混着排会把"延后攻击"这条线在半路剪掉（代码改了但行为没变、静默无效）。
##   分两段后**每一段内部所有候选处在同一进度**（阶段 1 谁都没打、阶段 2 位置已定）⇒ 比较才公平。
##
## 结构：
##   阶段 1「先各自挪位」：每个单位从自己的移动候选里挑一个落点（含原地），层内按 `_layout_score()` 排序、
##     保留 `_beam()` 条；**顺序由 beam 探索**（"A 让位给 B"这类要顺序对才走得通）。
##   阶段 2「再安排谁打谁」：取阶段 1 排前 `TWO_PHASE_LAYOUTS` 套阵型，在每套上把"打谁 / 敲哪块障碍 /
##     不打"逐个单位分配（**出手顺序同样由 beam 探索**），用完整评分 `_evaluate()` 挑最优。
##   最终：所有阵型的最好完态里取最高分；`path` = 走位步 + 出手步（同一个单位可以出现两次 ⇒ 回放器
##   `EnemyReplay` 是逐步执行的、`Battle._do_attack` 不检查"是否已移动" ⇒ 真实侧能照做）。
##
## ⚠️ 与现役路径的**已知差异**（有意为之）：
##   · 现役里那三道"把移动和攻击绑在一起"的补丁——撤退克制过滤 / 远程"不贴脸"闸门 / 附带在这里的
##     `IDLE_HIT_PENALTY`——在本模式里由**阶段 2 的完整评分**自然覆盖（少打的伤害、多挨的打都会算进
##     最后的整条方案比较）⇒ 不再单独施加；**只有 `IDLE_HIT_PENALTY` 仍按原样收**（"这回合能打却不打"
##     照罚，口径与现役逐字一致）⇒ 该键照旧生效。
##   · 训练/低档用的 `WEAK_MODE`、吃矿机会成本 `GOLD_OPPORTUNITY_W` 不与本模式叠加（`search()` 里已拦，
##     同时开自动退回现役路径）。
##   · 阶段 1 只比"位置 + 进攻潜力"，不比"这一格能打出多少伤害"⇒ 可能漏掉"位置看着一般、合起来最强"
##     的阵型（`TWO_PHASE_LAYOUTS` 就是给这个留的余量）。
##   ⚠️ 【2026-09-23 深夜③】上面那句"三道补丁由阶段 2 的完整评分自然覆盖"**有一处不成立**，已补：
##     `IDLE_HIT_PENALTY` 原来在阶段 2 是拿"**阶段 1 挪完位之后**"的候选表算 `any_attack` ⇒ 单位被挪到
##     一格打不到人的位置后，候选表里自然没有 `atk >= 0` ⇒ **一分不罚** ⇒ 模式 2 把"挪了位却没出手"
##     变成了零成本（用户实机症状：「莫名其妙的不打」）。现改为**本回合开始时**的判据
##     （`_actions_for()` 里有没有 `atk >= 0`，与现役逐字同一把尺子 ⇒ "原位打 / 走一步再打都算"）。
func _search_two_phase(sim: Sim, enemy_idxs: Array) -> Array:
	var deadline := (Time.get_ticks_msec() + time_budget_ms) if time_budget_ms > 0 else 0
	var beam := _beam()
	# ⚠️ 内层宽度必须是整数：这里用 **8.0** 走浮点除再 `int()` 取整，避免编辑器那条
	#   `INTEGER_DIVISION`（"Integer division. Decimal part will be discarded."）警告 ——
	#   `beam` 恒为正 ⇒ 截断与整数除完全等价，行为逐位不变（2026-09-23 用户报的那条警告）。
	var inner := maxi(4, int(beam / 8.0))   # 阶段 2 每套阵型的内层宽度（阵型数 × 内层宽度 ≈ 与现役同量级）
	# 【2026-09-23 深夜③】阶段 2 的 `IDLE_HIT_PENALTY` 判据：**在阶段 1 动任何人之前**先记下
	#   "这个单位本回合有没有能打到人的出招"（与现役 `search()` 里那段同一把尺子）。
	var start_can_hit: Dictionary = {}
	for i in enemy_idxs:
		var hit := false
		for a0 in _actions_for(sim, int(i)):
			if int(a0.get("atk", -1)) >= 0:
				hit = true
				break
		start_can_hit[i] = hit
	# ---------- 阶段 1：先各自挪位（只走位、不出手） ----------
	# 【2026-09-23 深夜⑥·用户实测「你算的是过程中的伤害吧：圣光先挪，那格那时还能被矿工打到，
	#   暗域才挪过去挡在前面」】确认属实，而且是个独立的病：阶段 1 是**逐层**决定落点的，排在前面的层
	#   里只有一部分单位挪过位 ⇒ 用 `_evaluate(partial, true)` 排序会让"还没轮到挪的那个单位"**按它
	#   旧的站位**被记暴露 ⇒ **同一套最终阵型，谁先决定谁吃亏**（顺序相关）。两处一起修：
	#     ① `end_of_turn` 不再写死 true ⇒ ⑳㉑㉒㉓ 只在这个阵型**全员落点都已定**时才算（它自己的规矩）；
	#     ② **阵型没排完时，不计"个人暴露"三项**（⑥规则B阈值 / ⑦核心暴露 / ⑮必死折）——它们描述的是
	#        "我站这儿会不会挨打"，而队友还没挪过来挡在前面，这时算出来的数既不完整、又依赖决定顺序。
	#        （⚠️ 只对**阶段 1 的排序**这么做；`SEARCH_MODE = 0` 与阶段 2 的完整评分一律照旧把这三项算满。）
	var layouts: Array = [_tp_state(sim, [], {}, _layout_score(sim, start_can_hit, enemy_idxs.size() == 0))]
	var timed_out := false
	while true:
		var pending := false
		var merged: Array = []
		for st in layouts:
			var remaining: Array = []
			for i in enemy_idxs:
				if not (st["done"] as Dictionary).has(i):
					remaining.append(i)
			if remaining.size() == 0:
				merged.append(st)
				continue
			pending = true
			for idx in remaining:
				for a in _tp_move_actions(st["sim"], idx):
					var s2: Sim = (st["sim"] as Sim).clone()
					_apply(s2, idx, a)
					var done2: Dictionary = (st["done"] as Dictionary).duplicate()
					done2[idx] = true
					var path: Array = (st["path"] as Array).duplicate()
					if a["move"] != null:
						path.append({ "idx": idx, "action": a })   # 原地不生成步骤（省一次回放亮边）
					var full: bool = done2.size() >= enemy_idxs.size()
					merged.append(_tp_state(s2, path, done2, _layout_score(s2, start_can_hit, full)))
				if deadline > 0 and Time.get_ticks_msec() >= deadline:
					timed_out = true
					break
			if timed_out:
				break
		if not pending:
			break
		merged.sort_custom(_cmp_state)
		layouts = merged.slice(0, beam)
		if timed_out:
			break
	if layouts.is_empty():
		return []
	if timed_out:
		# 走位阶段就超时：交给现役那套贪心收尾（`_actions_for` 对"没移动过"的单位仍给完整候选）。
		# ⚠️ 【2026-09-23 修·用户实机"AI 都不攻击了"】交出去之前**必须把 `done` 清空**：
		#   `_greedy_finish()` 第一件事就是 `if (cur["done"] as Dictionary).has(i): continue`
		#   ⇒ 阶段 1 里"落点已经定好、但还没出手"的单位会被整段跳过 = 攻击直接作废。
		#   而真实规则里"只移动过"**根本不算完成**（`_actions_for()` 只禁 `u.attacked`；`Battle._unit_done()`
		#   对普通单位也只看 `attacked_this_turn`）⇒ 阶段 1 的 `done` 只是"落点已定"的簿记，
		#   **不能当"这一步的候选已经给完"用**。清空后 `_actions_for()` 对这些单位只剩
		#   "原地出手 / 敲相邻障碍 / 不打"（它自己就按 `u.moved` 卡住移动）⇒ 规则照样守住，
		#   而且挪过位的单位**该打的这一下不会白丢**。
		var gw_in: Array = []
		for st0 in layouts.slice(0, mini(layouts.size(), 8)):
			gw_in.append(_tp_state(st0["sim"], st0["path"], {}, float(st0["score"])))
		var gw1: Array = _greedy_finish(gw_in, enemy_idxs)
		return gw1[0]["path"] if gw1.size() > 0 else (layouts[0]["path"] as Array)
	# ---------- 阶段 2：再安排谁打谁（不再移动） ----------
	var best: Dictionary = {}
	var best_wiped: Dictionary = {}
	var layout_n := mini(maxi(TWO_PHASE_LAYOUTS, 1), layouts.size())
	for li in layout_n:
		var base: Dictionary = layouts[li]
		var layer: Array = [_tp_state((base["sim"] as Sim).clone(), (base["path"] as Array).duplicate(), {},
				float(base["score"]))]
		var complete: Array = []
		var p2_timeout := false
		while true:
			var pending2 := false
			var merged2: Array = []
			for st in layer:
				var remaining2: Array = []
				for i in enemy_idxs:
					if not (st["done"] as Dictionary).has(i):
						remaining2.append(i)
				if remaining2.size() == 0:
					merged2.append(st)
					continue
				pending2 = true
				for idx in remaining2:
					var acts2: Array = _tp_attack_actions(st["sim"], idx)
					# "这回合能打到人却不打"照罚（口径与现役 `search()` 里那段一致）：
					# ⚠️ 【2026-09-23 深夜③】判据用**本回合开始时**算好的 `start_can_hit`，**不能**用
					#   `acts2`（那已经是"阶段 1 挪完位之后"的候选表 ⇒ 被挪到打不到人的格子时它恒空 ⇒
					#   一分不罚 ⇒ 模式 2 把"挪了位却没出手"变成零成本，实机症状＝「莫名其妙的不打」）。
					var any_attack: bool = bool(start_can_hit.get(idx, false))
					var idle_hit := 0.0
					if w_idle_hit_penalty != 0.0 and any_attack:
						var iu: SimUnit = (st["sim"] as Sim).units[idx]
						if iu != null and iu.alive and not iu.attacked:
							idle_hit = w_idle_hit_penalty
					for a in acts2:
						var s3: Sim = (st["sim"] as Sim).clone()
						var done3: Dictionary = (st["done"] as Dictionary).duplicate()
						done3[idx] = true
						var path3: Array = (st["path"] as Array).duplicate()
						var hit: bool = int(a.get("atk", -1)) >= 0 or a.has("atk_obs")
						if hit:
							_apply(s3, idx, a)
							path3.append({ "idx": idx, "action": a })
						var eot := done3.size() >= enemy_idxs.size()
						merged2.append(_tp_state(s3, path3, done3,
								_evaluate(s3, eot) - (idle_hit if not hit else 0.0)))
				if deadline > 0 and Time.get_ticks_msec() >= deadline:
					p2_timeout = true
					break
			if p2_timeout:
				break
			if not pending2:
				complete = merged2
				break
			merged2.sort_custom(_cmp_state)
			layer = merged2.slice(0, inner)
		if p2_timeout and complete.is_empty():
			# 出手阶段超时：这一套阵型用贪心补齐（位置已定 ⇒ `_actions_for` 只会给"原地出手/不打"）
			complete = _greedy_finish(layer.slice(0, mini(layer.size(), 4)), enemy_idxs)
		for st in complete:
			if w_no_loss_filter > 0 and _myside_wiped(st["sim"], sim.active_fn):
				if best_wiped.is_empty() or _cmp_state(st, best_wiped):
					best_wiped = st
				continue
			if best.is_empty() or _cmp_state(st, best):
				best = st
		if deadline > 0 and Time.get_ticks_msec() >= deadline:
			break
	if best.is_empty():
		best = best_wiped
	if best.is_empty():
		return []
	if log_decisions:
		_print_decision(sim, best)
	return best["path"]

## 两阶段搜索的状态字典：四个字段与现役 `search()` 的状态**同构**（好让 `_cmp_state` / `_greedy_finish` /
## `_print_decision` 直接复用；`tb` 只在并列裁决开启时才算，默认 0 ⇒ 空数组 ⇒ 逐位不变）。
func _tp_state(s2: Sim, path: Array, done: Dictionary, score: float) -> Dictionary:
	return {
		"sim": s2, "path": path, "done": done, "score": score,
		"tb": (_tiebreak_tuple(s2) if w_tiebreak_mode > 0 else []),
	}

## 阶段 1 候选：**只走位、不攻击**。落点集合 = 现役 `_actions_for()` 里出现过的移动落点
##   （它已含"能打到人的落点强制入选"）＋"原地不动"。这样一个"能打到的位置"都不漏，候选也不会爆。
## 【2026-09-23 深夜③·补一道现役有、两阶段漏掉的守卫】"**远程别把自己贴进人堆**"：
##   现役那道闸门 `_ranged_pinned_shot_ok()` 只作用在 `_actions_for()` 的**带攻击组合**上；而这里只从
##   `_actions_for()` 里**收落点**、自己造 `{move: c, atk: -1}` ⇒ 一个"站上去会被贴身"的落点照样进阶段 1。
##   阶段 1 的尺子上"贴过去"能吃到 ⑤位置拉力（噩梦 2.4/格），而"被贴身"只让进攻潜力从 3~4 掉到 1
##   （差 2~3 分）⇒ **位置收益盖过它**，阶段 2 又不能让单位挪回来 ⇒ 实机症状 =「远程莫名其妙贴脸」
##   （用户 2026-09-23 报：模式 2 有时候"不打或远程贴身"）。
##   判据与现役**同一把尺子**：`alt_best` = 非贴身处开火的最高伤害（现役 `_actions_for()` 里同式），
##   `pinned_atk` = 贴身时的伤害（基础压 1、buff 照常）；**只有存在更高的非贴身伤害时**才丢掉这个落点，
##   并且**这一格能击杀就保留**（与 `_ranged_pinned_shot_ok` 的两条例外逐字一致）⇒ 被围住的远程不会被删光候选。
func _tp_move_actions(sim: Sim, idx: int) -> Array:
	var out: Array = [{ "move": null, "atk": -1 }]   # 原地
	if idx < 0 or idx >= sim.units.size():
		return out
	var u: SimUnit = sim.units[idx]
	if u == null or not u.alive or u.stunned or u.attacked:
		return out
	var acts_all: Array = _actions_for(sim, idx)
	var ranged := u.atk_type == DataRegistry.AttackType.RANGED
	var alt_best := 0
	# 【2026-09-23 深夜⑮·F1】两个值都改成"退开后 / 贴身时"的**正确**攻击力（见 `_sim_free_atk()`）：
	#   原来两处都读 `u.eatk`，而**当前已被贴身**的远程 `eatk` 已经是 1 ⇒ 这道守卫在它身上恒不触发。
	var pinned_atk := _sim_pinned_atk(u)
	if ranged:
		for a in acts_all:
			if int(a.get("atk", -1)) < 0:
				continue
			var mc0: Vector2i = u.cell if a.get("move") == null else a["move"]
			if not _sim_enemy_adjacent(sim, u, mc0):
				alt_best = maxi(alt_best, _sim_free_atk(u))
	var seen := { u.cell: true }
	for a in acts_all:
		var mv: Variant = a.get("move")
		if mv == null:
			continue
		var c: Vector2i = mv
		if seen.has(c):
			continue
		seen[c] = true
		if ranged and alt_best > pinned_atk and _sim_enemy_adjacent(sim, u, c):
			# 例外：站上去还能"击杀"（贴身后的伤害也够）⇒ 保留（与 `_ranged_pinned_shot_ok` 同口径）
			var kill_ok := false
			for ti in _valid_targets(sim, u, c):
				var tt: SimUnit = sim.units[int(ti)]
				if tt != null and tt.alive and tt.hp <= pinned_atk:
					kill_ok = true
					break
			if not kill_ok:
				continue
		out.append({ "move": c, "atk": -1 })
	return out

## 阶段 2 候选：**只出手、不再移动**（位置已在阶段 1 定好）：打人 / 敲够得着的障碍 / 不打（不生成步骤）。
##   判据与现役 `_actions_for()` 的攻击段一致：后勤不能主动攻击、嘲讽由 `_valid_targets()` 管、
##   红帽"点杀不安全"不放行、敲障碍要求"当前格够得着且视线不被墙挡"。
func _tp_attack_actions(sim: Sim, idx: int) -> Array:
	# 【模式 2·2026-09-23 用户追加】阶段 2 里**还没挪位的单位**直接给现役那一整套组合（含"移动+攻击"、
	#   只移动、敲相邻障碍）⇒ 于是排列得下"A 先在阶段 1 挪位 → B 打 → C 这一步移动+出手 → …"这类
	#   **移动与出手互相穿插**的顺序（用户原话：「A 挪位，B 挪位，C 挪位打，B 打，A 打」）。
	#   已经挪过位的单位不受影响：`_actions_for()` 对 `u.moved` 的单位**不再产出移动候选**（只剩原地出手/
	#   敲障碍/不打）⇒ 规则上的"一个单位一回合只移动一次、攻击后不能再移动"照样守住。
	#   ⚠️ 走这条分支意味着这一步也要过 `_actions_for()` 里那道**撤退克制过滤**（"能打却不打还往后缩"会被丢）
	#   —— 那是现役对"移动+攻击"绑在一起的候选的口径，与现役一致；纯"先挪位、后出手"的路仍由阶段 1 提供。
	if w_search_mode >= 2:
		return _actions_for(sim, idx)
	var out: Array = [{ "move": null, "atk": -1 }]   # 不打
	if idx < 0 or idx >= sim.units.size():
		return out
	var u: SimUnit = sim.units[idx]
	if u == null or not u.alive or u.stunned or u.attacked:
		return out
	if u.skills.has(DataRegistry.Skill.LOGISTICS):
		return out   # 后勤：不能主动攻击
	for t in _valid_targets(sim, u, u.cell):
		if _redhood_kill_unsafe(sim, u, t):
			continue
		out.append({ "move": null, "atk": int(t) })
	for oc in sim.obstacles.keys():
		var oc2: Vector2i = oc
		if _sim_obstacle_ok(sim, u, u.cell, oc2):
			out.append({ "move": null, "atk": -2, "atk_obs": oc2 })
	return out

## 阶段 1 的排序分：位置/威胁/队形（`_evaluate(..., true)` —— 此时**谁都没出手** ⇒ 比较公平）
##   再补一笔**进攻潜力**：走位本身不产生伤害，只比位置分的话"走过去就能打"的阵型会被"躲得漂亮"的阵型
##   压下去、在阶段 1 就被剪掉。潜力 = 有目标可打 ⇒ 记它的有效攻击力（1 攻 ≈ 1 分，与血量账同尺）。
##   ⚠️ 只用于阶段 1 内部排序（最终仍由阶段 2 的完整评分裁决）⇒ 即使与阶段 2 重复计价也无害。
##   ⚠️ 【2026-09-23 深夜②·已试过并回退】曾把这笔潜力换成"与 `_evaluate` 同尺"的 `_tp_quick_gain()`
##     （伤害 + ④集火增量 + 击杀身价），并把 `TWO_PHASE_LAYOUTS` 8 → 32。**实测没有棋力收益**
##     （`难度体检 -Mode smode` tag `sm24`：Δpts(sm2 − sm0) = **−6.07 [−14.52,+2.38]**，同 5 队口径
##     修前 −3.19 → 修后 −4.97；两批 CI 大幅重叠），代价却是阶段 2 约 4 倍 ⇒ **按用户拍板整块回退**
##     （见 `Data/Progress_tracking/1_通用策略.md` 文末那一轮）。教训写在那一轮里：**在"评分函数本身
##     不忠实"的前提下，把搜索放宽只会把"评分认为最好"的路找得更彻底，不保证更强。**
##   ⚠️ 【2026-09-23 深夜③·补"挪了位却打不到人"的罚】**阶段 1 是唯一能拦住它的地方**：一旦某个单位
##     在这套阵型里**已经动过**（`u.moved`）而脚下**一个目标都没有**，阶段 2 就只能让它空手（不能再移动）
##     ⇒ 这里按现役那条 `IDLE_HIT_PENALTY` 的口径**当场扣一笔**（前提：它本回合**本来**有能打到人的出招，
##     `start_can_hit` 由 `_search_two_phase()` 在动任何人之前算好）。这解释了用户报的实机症状
##     「模式 2 有时候莫名其妙不打」：阶段 2 的那份 `IDLE_HIT_PENALTY` 用的是"挪完之后"的候选表 ⇒
##     被挪到打不到人的格子时它恒为 0 ⇒ 一分钱不罚。⚠️ 只在"已经动过"时罚：**没动过的单位阶段 2 还能
##     "移动+攻击"救回来**，不该罚。
func _layout_score(sim: Sim, start_can_hit: Dictionary = {}, complete: bool = true) -> float:
	# 【2026-09-23 深夜⑥】阵型没排完 ⇒ **不计个人暴露三项**（⑥规则B阈值 / ⑦核心暴露 / ⑮必死折）：
	#   它们描述"我站这儿会不会挨打"，而队友还没挪过来挡在前面 ⇒ 这时算出来的数既不完整、又让
	#   排序依赖"谁先被决定"（用户实测：圣光先挪就被记成暴露，其实暗域随后会挡在它前面）。
	#   手段与低档弱化那套一致（`WEAK_MODE` 的关威胁分支）：**临时把权重清零**再还原 ⇒ 不动 `_evaluate`。
	var r_save := w_risk
	var d_save := w_threat_dead_fold
	var a_save := w_move_accept_damage
	if not complete:
		w_risk = 0.0
		w_threat_dead_fold = 0.0
		w_move_accept_damage = 0
	var sc := _evaluate(sim, complete)
	w_risk = r_save
	w_threat_dead_fold = d_save
	w_move_accept_damage = a_save
	# 【2026-09-23 深夜④·用户拍板「做」】**让阶段 1 看得见伤害**：把"这套阵型如果立刻全员出手能拿多少"
	#   作为一笔潜力加进来，用**带目标记账的贪心**算（`_tp_attack_gain_accounted()`）。
	#   为什么必须记账：上一版是"每个单位各自取它最赚的那个目标"，三个人同时"看中"同一个残血目标时，
	#   击杀（②身价）与集火（④ frac²）那几笔会被**重复计入三次** ⇒ 高估"扎堆挤同一个目标"的阵型
	#   （D2 那局修好了、整局胜率却没收益，怀疑就是这里虚报抵消掉了收益）。
	sc += _tp_attack_gain_accounted(sim)
	for i in sim.units.size():
		var u: SimUnit = sim.units[i]
		if u == null or not u.alive or u.fn != int(sim.active_fn) or u.attacked:
			continue
		if u.stunned or u.skills.has(DataRegistry.Skill.LOGISTICS):
			continue
		if _valid_targets(sim, u, u.cell).size() == 0 and u.moved and bool(start_can_hit.get(i, false)):
			# 【2026-09-23 深夜③】"已经动过、脚下却没目标" ⇒ 这一手多半要空掉 ⇒ 按现役
			#   `IDLE_HIT_PENALTY` 的口径当场扣一笔（阶段 2 拦不住它：那时它已经不能再移动了）。
			sc -= w_idle_hit_penalty
	return sc

## 【2026-09-23 深夜④】**这套阵型"立刻全员出手"能拿到的总收益** —— 带目标记账的贪心：
##   反复挑"当前最赚的（单位→目标）"这一对，把它分配掉、并把这笔伤害落到**工作副本**的目标血上
##   ⇒ 后续单位的击杀（②身价）与集火（④ frac²）都按**剩余血/已打掉血**算 ⇒ **同一份收益不会被重复计价**。
##   ① 目标表每个单位只算一次（`_valid_targets()` 走视线/嘲讽/负墟免疫，比较贵）；
##   ② 每轮只扫"还没分配的单位 × 它的目标"，单位数 ≤ 6 ⇒ 最多 ~36 次简单乘法，代价可忽略；
##   ③ 与 `_evaluate` 同一把尺子：③血量账（1 血 1 分，按剩余血封顶）+ ④集火 frac² 增量 + 击杀时 ②身价 ×
##      `PLAYER_VALUE_MULT`（对面那一项整项消失，与 `_evaluate` 里同式）。
##   ⚠️ 仍是**排序用的代理**：不进 `_evaluate`、不占权重键、`SEARCH_MODE = 0` 路径完全不经过它。
func _tp_attack_gain_accounted(sim: Sim) -> float:
	var pool: Array = []
	var targets_of: Dictionary = {}
	for i in sim.units.size():
		var u: SimUnit = sim.units[i]
		if u == null or not u.alive or u.fn != int(sim.active_fn) or u.attacked:
			continue
		if u.stunned or u.skills.has(DataRegistry.Skill.LOGISTICS):
			continue
		var tl: Array = _valid_targets(sim, u, u.cell)
		if tl.is_empty():
			continue
		pool.append(i)
		targets_of[i] = tl
	if pool.is_empty():
		return 0.0
	# 工作副本：目标的剩余血 + 本回合已打掉的血（只服务这一趟排序，绝不改真局面）
	var hp: Dictionary = {}
	var dealt: Dictionary = {}
	for ti in sim.units.size():
		var t: SimUnit = sim.units[ti]
		if t != null and t.alive and t.fn != int(sim.active_fn) and t.hp0 > 0:
			hp[ti] = t.hp
			dealt[ti] = t.hp0 - maxi(t.hp, 0)
	var total := 0.0
	var used: Dictionary = {}
	for _round in pool.size():
		var best_u := -1
		var best_t := -1
		var best_gain := 0.0
		var best_real := 0
		for i in pool:
			if used.has(i):
				continue
			var u2: SimUnit = sim.units[i]
			for tix in (targets_of[i] as Array):
				var ti2 := int(tix)
				if not hp.has(ti2):
					continue
				var g := _tp_hit_gain(sim, u2, sim.units[ti2], int(hp[ti2]), int(dealt[ti2]))
				if g.x > best_gain:
					best_gain = g.x
					best_real = int(g.y)
					best_u = i
					best_t = ti2
		if best_u < 0:
			break
		used[best_u] = true
		total += best_gain
		hp[best_t] = maxi(int(hp[best_t]) - best_real, 0)
		dealt[best_t] = int(dealt[best_t]) + best_real
	return total

## 一次打击的收益（③ + ④ + 击杀的 ②）。`thp` / `tdealt` 来自上面那本**工作副本**的账。
## 返回 `Vector2(收益, 实际伤害)`（GDScript 没多返回值，用 Vector2 传两个数）。
func _tp_hit_gain(sim: Sim, u: SimUnit, t: SimUnit, thp: int, tdealt: int) -> Vector2:
	# 预计伤害：与 `_apply` 同源（`eatk × _sim_mult`，再补重伤 +1 / 坚固 −1），按**剩余血**封顶
	var dmg := int(u.eatk) * _sim_mult(sim, u, t)
	if t.heavy:
		dmg += 1
	if t.solid:
		dmg = maxi(dmg - 1, 0)
	var cur := maxi(thp, 0)
	var real := mini(dmg, cur)
	if real <= 0:
		return Vector2(0.0, 0.0)
	var hp0 := maxi(t.hp0, 1)
	var f0 := float(tdealt) / float(hp0)
	var f1 := float(tdealt + real) / float(hp0)
	var g := float(real) * w_hp_value
	if w_focus_fire != 0.0:
		g += w_focus_fire * (f1 * f1 - f0 * f0)
	if real >= cur:
		g += _unit_value(sim, t) * PLAYER_VALUE_MULT   # 打死 ⇒ 对面 ②身价整项消失
	return Vector2(g, float(real))

## 状态比较器（`search()` 的两处 `sort_custom` 都用它）：
## · 规则 A **关闭**时（默认）本函数与旧的 `a["score"] > b["score"]` **完全等价** ⇒ 行为逐位不变；
## · 规则 A 开启且两条线分数差 < `RULE_A_TIE_EPS`（= 判定为"并列"）时，改用**合格击杀的净收益**裁决
##   （`ra` = 本线累计的 `_rule_a_gain`）—— 这正是设计稿说的"并列裁决层，不新增加分项"。
func _cmp_state(a: Dictionary, b: Dictionary) -> bool:
	var d := float(a["score"]) - float(b["score"])
	# 【2026-09-19 新增·默认关闭】并列裁决层：分差 < `TIEBREAK_EPS` 时改用**结局量字典序**。
	# `w_tiebreak_mode = 0`（默认）时整段跳过 ⇒ 与改动前逐位相同（含下面规则 A 的老行为）。
	if w_tiebreak_mode > 0 and absf(d) < w_tiebreak_eps:
		var ta: Array = a.get("tb", [])
		var tb: Array = b.get("tb", [])
		var n := mini(ta.size(), tb.size())
		for i in n:
			var dd := float(ta[i]) - float(tb[i])
			if absf(dd) > 1.0e-9:
				return dd > 0.0
	# 【已删 2026-09-20·用户拍板】原规则 A（`FOCUS_KILL_RULE`）的"并列时改用合格击杀净收益"分支已删 ⇒
	#   现在并列时就是 `d > 0.0`（与规则 A 出现之前逐位相同）。
	return d > 0.0

## 【2026-09-19 新增·默认关闭】并列裁决用的**结局量元组**（**每一项都是"越大越好"**，与胜负条件同序）：
##   ① 我方存活数 ↑好（= 阵亡数 ↓）② 敌方存活数 ↓好（= 阵亡数 ↑）③ [mode 2] 威胁差 = Σ_我方各单位威胁 − Σ_对面各单位威胁
##   ④ 双方剩余总血差  ⑤ 我方最残血（别让某个人快死）
##
## ⚠️ 2026-09-19 修正：① ② 原来写成 `[-my_alive, +foe_alive]`（符号写反 = 奖励自己送人头、奖励对面活着）。
##   在**本层**它几乎惰性——并列集内阵亡数通常相同，而一旦真的出现死亡，分数差（身价项自动 ∓20）
##   远大于 `TIEBREAK_EPS` ⇒ 那种局面由分数裁决、根本进不到这里；所以历史 `tb*` 臂的读数并没有因此反转。
##   历史上同一套符号也曾被"真推演"那一层复用（`_rollout_key_post()`，**2026-09-22 晚已整段删除**），
##   那里"推演后我方会不会死人"正是要判的东西 ⇒ 那处写反过一次、已一并改正（两处都是默认关闭项 ⇒ 生产三档逐位不变）。
## 只在 `TIEBREAK_MODE > 0` 时**在候选态生成时算一次**并缓存进 `tb` 字段（不放进比较器里重算，
## 否则 200 宽度的排序会退化成 O(n log n) × 每次全量扫描）。
func _tiebreak_tuple(sim: Sim) -> Array:
	var my_alive := 0
	var foe_alive := 0
	var my_hp := 0
	var foe_hp := 0
	var my_min_hp := 1 << 30
	for i in sim.units.size():
		var u: SimUnit = sim.units[i]
		if u == null or not u.alive:
			continue
		if u.fn == DataRegistry.Faction.ENEMY:
			my_alive += 1
			my_hp += maxi(u.hp, 0)
			my_min_hp = mini(my_min_hp, maxi(u.hp, 0))
		else:
			foe_alive += 1
			foe_hp += maxi(u.hp, 0)
	if my_min_hp > 1 << 29:
		my_min_hp = 0
	var out: Array = [float(my_alive), -float(foe_alive)]
	if w_tiebreak_mode >= 2:
		var mt := 0.0
		var ft := 0.0
		for i in sim.units.size():
			var u2: SimUnit = sim.units[i]
			if u2 == null or not u2.alive:
				continue
			if u2.fn == DataRegistry.Faction.ENEMY:
				mt += _outgoing_threat_on(sim, u2)
			else:
				ft += _outgoing_threat_on(sim, u2)
		out.append(mt - ft)
	out.append(float(my_hp - foe_hp))
	out.append(float(my_min_hp))
	return out

# 【已删 2026-09-20·用户拍板】原规则 A（`FOCUS_KILL_RULE` / `FOCUS_NET_MARGIN`）：
#   「合力可杀 + 净收益为正才优先」的并列裁决层 —— 实测只 +0.20（CI 跨 0）⇒ 判死。
#   连同 `_rule_a_gain()` / `_rule_a_can_reach()` / 状态里的 `ra` 累计 / `RULE_A_TIE_EPS` 一起删。
#   注：`FOCUS_NET_MARGIN` 只是规则 A 里那条"net > 边距"的门槛参数，没有别的用途 ⇒ 一起删。
## 规则 C「替补落点要能直接参战」（2026-09-15 用户定；**默认关闭**，调用方先看 `w_sub_join_rule`）。
## 用户原话：「已在交战时，替补落点应能直接加入战斗，而不是白浪费一回合」。
## 关闭时（现状）：`Battle._free_sub_cell_for()` 只挑"本方墓碑格 → 出生区第一个空格"，**完全不看战斗**。
## 开启后：在**同一批合法落点**里按 ①能否本回合打到人 ②打到谁最疼（身价）③离战场多近 ④下回合更安全 打分。
## `cells` = 合法落点（Battle 侧给：本方墓碑格 + 出生区空格）；返回选中的格（`cells` 空 → (-99,-99)）。
func pick_sub_cell(sim: Sim, hero_id: String, cells: Array) -> Vector2i:
	if cells.is_empty():
		return Vector2i(-99, -99)
	var mv := 3
	var ar := 1
	var atk := 1
	var def = DataRegistry.get_hero(hero_id)
	if def != null:
		mv = DataRegistry.spawn_move(def)
		ar = DataRegistry.spawn_attack_range(def)
		atk = def.atk
	var best := Vector2i(-99, -99)
	var best_s := -INF
	# 【2026-09-19 新增·默认关】收尾优先（见 `const SUB_FINISH_W` 处说明）：对面只剩 1 个存活单位
	# （3 人阵容 ⇒ 打死它 = 直接判负对方）时，把"这一格能不能打到它、能不能一击打死"抬到压倒性位置。
	# `w_sub_finish_w = 0`（默认）⇒ 这一段一次都不算 ⇒ 逐位不变。
	var fin_foe: SimUnit = null
	if w_sub_finish_w > 0.0:
		var alive_n := 0
		for i in sim.units.size():
			var t0: SimUnit = sim.units[i]
			if t0 != null and t0.alive and t0.fn != DataRegistry.Faction.ENEMY:
				alive_n += 1
				fin_foe = t0
		if alive_n != 1:
			fin_foe = null
	for c in cells:
		var cell: Vector2i = c
		var s := 0.0
		# ① / ②：本回合能不能打到人？打到谁最疼（身价）
		for i in sim.units.size():
			var t: SimUnit = sim.units[i]
			if t == null or not t.alive or t.fn == DataRegistry.Faction.ENEMY:
				continue
			if approach_dist(sim, cell, t.cell) <= mv + ar:
				s += 100.0 + _unit_value(sim, t)
			else:
				s -= float(approach_dist(sim, cell, t.cell)) * 0.5   # ③ 离战场多近（路网）
		# ④ 下回合更安全：站这儿有多少敌人够得到我（越少越好）
		for j in sim.units.size():
			var e: SimUnit = sim.units[j]
			if e == null or not e.alive or e.fn == DataRegistry.Faction.ENEMY:
				continue
			if approach_dist(sim, e.cell, cell) <= e.emove + e.atk_range:
				s -= 2.0
		s += float(atk) * 0.1     # 同一格条件打平时，攻击力高的更值得上前线
		if fin_foe != null:
			var fd := approach_dist(sim, cell, fin_foe.cell)
			if fd <= mv + ar:
				s += w_sub_finish_w
				if fin_foe.hp <= atk:
					s += w_sub_finish_w * 0.5      # 能一击斩杀：再抬一档
			else:
				s -= float(fd) * 1.0               # 打不到它：加倍往它靠（③ 那支只有 0.5/格）
		if s > best_s:
			best_s = s
			best = cell
	return best

## 【2026-09-19 新增·默认关】收尾优先的**替补选人**（见 `const SUB_FINISH_W` 处说明，1b 步）。
## 调用方（`Battle._place_enemy_sub`）只在 `_sub_finish_w() > 0` 且**对面只剩 1 个存活单位**时调用。
## 为什么需要它：现有选人（`Battle._best_enemy_sub_idx`）只看 身价/缺前排/后勤/替补技 ⇒ 可能补上来一个
## 够不到、也打不死那个残血的坦克/辅助，白占一个名额。这里直接问"谁能补上来就收官"。
## 打分（越大越好），对每个候选替补，取它在**所有合法落点**里离目标最近的那一格：
##   ① 够得到（`approach_dist ≤ spawn_move + spawn_attack_range`）且 `def.atk ≥ 目标当前血`
##      ⇒ **补上来就是收官那一刀** ⇒ `1000 + 攻击力`
##   ② 够得到但打不死 ⇒ `100 + 攻击力`（能参与合围）
##   ③ 都够不到 ⇒ `1/距离`（越近越好）
## ⚠️ 只改"选谁"，不改"能不能上"：`roster` 空 ⇒ 返回 ""；`cells` 空或全选不出 ⇒ 返回 `roster[0]`
##    （= 调用方原逻辑的兜底，保证行为不会比改动前更差）。
func pick_sub_hero(sim: Sim, roster: Array, cells: Array) -> String:
	if roster.is_empty():
		return ""
	var last: SimUnit = null
	for i in sim.units.size():
		var t: SimUnit = sim.units[i]
		if t != null and t.alive and t.fn != DataRegistry.Faction.ENEMY:
			last = t
	if last == null or cells.is_empty():
		return String(roster[0])
	var best_id := String(roster[0])
	var best_s := -INF
	for r in roster:
		var hid := String(r)
		var def = DataRegistry.get_hero(hid)
		if def == null:
			continue
		var mv: int = DataRegistry.spawn_move(def)
		var ar: int = DataRegistry.spawn_attack_range(def)
		var atk: int = def.atk
		var near := 1 << 30
		for c in cells:
			near = mini(near, approach_dist(sim, c, last.cell))
		var s := 0.0
		if near <= mv + ar:
			s = (1000.0 if atk >= last.hp else 100.0) + float(atk)
		else:
			s = 1.0 / float(maxi(near, 1))
		if s > best_s:
			best_s = s
			best_id = hid
	return best_id

# 超时收尾：对每个候选状态，让尚未行动的敌人依次各自贪心选一步内的最优动作。
# 这样即使没搜完也返回"每个敌人都行动过"的完整计划，不会出现有人站着不动。
func _greedy_finish(states_in: Array, enemy_idxs: Array) -> Array:
	var out: Array = []
	for st in states_in:
		var cur: Dictionary = st
		for i in enemy_idxs:
			if (cur["done"] as Dictionary).has(i):
				continue
			var best_score := -INF
			var best_child: Dictionary = {}
			for a in _actions_for(cur["sim"], i):
				var s2: Sim = cur["sim"].clone()
				_apply(s2, i, a)
				var done2: Dictionary = (cur["done"] as Dictionary).duplicate()
				done2[i] = true
				# 【2026-09-21 深夜】同上：只有"全队都行动完"的那一步才把 ⑳㉑ 计入。
				var sc := _evaluate(s2, done2.size() >= enemy_idxs.size())
				if sc > best_score:
					best_score = sc
					var path: Array = (cur["path"] as Array).duplicate()
					path.append({ "idx": i, "action": a })
					best_child = { "sim": s2, "path": path, "score": sc, "done": done2 }
			if best_child.is_empty():
				continue
			cur = best_child
		out.append(cur)
	out.sort_custom(func(a, b): return a["score"] > b["score"])
	return out

# 控制台输出本次敌方决策说明：总评分 + 每步行动的理由 + 每步得分变化（分析 AI 用）
func _print_decision(sim: Sim, chosen: Dictionary) -> void:
	var path: Array = chosen["path"]
	var txt := "\n===== 敌方AI 行动方案 · 总评分 %.1f · %d 步 =====" % [float(chosen["score"]), path.size()]
	# 【2026-09-20 新增·只为诊断】把"可接受伤害"的当前状态打在标题上 —— 用户要能一眼看出
	# 这一回合走的是"开局按阈值扣分"还是"交战中不罚"（不罚时移动行没有「规则B罚」标签）。
	if w_move_accept_damage > 0:
		txt += " · 可接受伤害:%s(阈值%d)" % ["罚·未交战" if not sim.engaged0 else "不罚·已交战", w_move_accept_damage]
	# 【2026-09-20】用户定了日志口径：**只要每个英雄那几步的细节**，不要顶部的公式表 ⇒
	# 这里不再打印「评分项·公式」块（`_term_defs()` 仍保留，供每步的逐项 Δ 归因用）。
	# 逐项 Δ 的自校验仍在每步那一行末尾：`Σ=… vs 本步 Δ…`（两者不等 = 拆解漂移）。
	# 【2026-09-20 用户口径·第二轮】日志里那两个威胁数（`下回合挨打` / `阈值比较`）改在
	#   **本回合全部走完之后**的局面上算 —— 用户原话「正确算法不应该是，长角 = 3*0.7/2，死灵法师也一样」。
	#   **原来为什么会打出两把尺子**（÷1 和 ÷2）：日志是**逐步回放**的，算某一步的分摊时，
	#   **还没轮到走的队友还站在旧格子上** ⇒ 对手"够得到几个人"就数少了 ⇒ 先被决定的那个英雄
	#   被记成"对手只能打我"（÷1，全额）。这不是算法错，是**诊断时点错**。
	#   现在先克隆一份把**整条方案走完**得到 `end_sim`（= 对方下一回合真正面对的局面：我方全部到位），
	#   两个威胁数都用它 ⇒ **同一个敌人对同一批人永远是同一个 `÷k`，不再看决策顺序**。
	#   （每步的 `本步 Δ` 仍按逐步回放算，两者互不影响；`真推演对方一回合` 本来就用走完后的局面。）
	var end_sim := sim.clone()
	for st in path:
		_apply(end_sim, int(st["idx"]), st["action"])
	# 再给这两个诊断数一份**私有空路网缓存**：`walk_cache` 在 `clone()` 里是**共享引用**（谁先算过某格就
	#   一直用它），而本回合可能有单位阵亡 ⇒ 墓碑让路网变了 ⇒ 共享缓存会把"旧地形算出来的距离"喂给
	#   这两个数。清空只影响 `end_sim` 自己 ⇒ 这两个数从此只反映**走完后**的地形，也不再受"谁先算"影响。
	end_sim.walk_cache = {}
	end_sim.walk_cache_pass = {}
	# 回放克隆：按路径逐步执行，算出每一步给局面评分带来的增量 Δ
	var replay := sim.clone()
	var prev := _evaluate(replay)
	var start_score := prev
	for si in path.size():
		var step: Dictionary = path[si]
		var idx := int(step["idx"])
		var u0: SimUnit = sim.units[idx]        # 名字用初始
		var ur: SimUnit = replay.units[idx]     # 数值用回放当前状态
		var a: Dictionary = step["action"]
		var line := " · %s" % u0.name
		var moved_to: Variant = a.get("move")
		if moved_to != null:
			var nc: Vector2i = moved_to
			var old_d := -1
			var new_d := -1
			var near: SimUnit = _nearest_player(replay, ur.cell)
			if near != null:
				old_d = grid.distance(ur.cell, near.cell)
			var near2: SimUnit = _nearest_player(replay, nc)
			if near2 != null:
				new_d = grid.distance(nc, near2.cell)
			line += " 移动 %s→%s" % [str(ur.cell), str(nc)]
			var reason: Array[String] = []
			if u0.can_pickup_gold and sim.gold_cells.has(nc):
				reason.append("捡金矿")
			# 【2026-09-20 新增·只为诊断】落点有增益道具时，把**它算给谁、值多少分**直接打出来。
			# 这一行就是为了回答"AI 为什么走那一格去吃道具"：`_buff_gain()` 已按阵营定符号、且
			# 【2026-09-21 更正】`heal` 曾经在**满血时返回 0**（错：真实规则 `u.hp += 3` 可溢出血量上限）⇒ 现在满血也值
			# 3.6 分（= 1.2 × BUFF_TAKE_WEIGHT）⇒ 你会看到形如「吃道具:heal(+3.6分)」。
			if replay.buff_cells.has(nc):
				var bt := String(replay.buff_cells[nc])
				reason.append("吃道具:%s(%+.1f分)" % [bt, _buff_gain(replay, ur, bt) * w_buff_take])
			if old_d >= 0 and new_d >= 0:
				if new_d < old_d:
					reason.append("贴近玩家(近%d格)" % new_d)
				else:
					reason.append("保持/拉距")
			# 【2026-09-20 新增·只为诊断】"从这个落点够得到几个玩家单位" —— 直接回答
			# 「它为什么不上毒 / 不打人」：0 = 本回合根本够不到（只能走位），>0 = 能打却没打（要查账）。
			# ⚠️ 这里用的是**真实动作生成器** `_valid_targets()`（含射程/路网/嘲讽/直线规则）。
			reason.append("落点够得到%d个" % _valid_targets(replay, ur, nc).size())
			# 【2026-09-20 用户口径·第三轮】**日志里只剩一个威胁数了**：用户拍板把"平摊版下回合挨打"
			#   整族删除（原话：「下回合挨打这个太难了啊，想计算准确的话，要考虑走位，要考虑技能，
			#   技能有很多变，考虑不完全。可以删掉吗」）。
			#   · **`阈值比较X.X(来源…)` = 敌人能打到他的伤害【总和】**（`_incoming_total_on`：按目标求和、
			#     含移动触发技能 / 毒 / 盾修正）—— ⑥规则B 拿它跟阈值比，与撤退过滤 / 必死判定同一把尺子。
			#   「避威胁」也按**总和**算（它回答"这个落点是不是更安全"）。
			# ⚠️ 这两个数读的是 `end_sim`（**本回合全部走完之后**的局面），不是当前回放局面；
			#    目标格照旧是 `ur.cell`（旧格）与 `nc`（落点）—— 队友位置不再随决策顺序变。
			var eu: SimUnit = end_sim.units[idx]
			var inc0 := _incoming_total_on(end_sim, eu, ur.cell)
			var info := {}
			var inc1 := _incoming_total_on(end_sim, eu, nc, info)
			if inc1 < inc0 - 0.5:
				reason.append("避威胁(-%.0f伤)" % (inc0 - inc1))
			# ⚠️ 这个数必须与真正进评分的那个一致（`_accept_threshold()` + `_rule_b_score()` 同一套口径），
			#    否则这行日志会骗人。交战中阈值为 0（不罚）⇒ 这行不打「规则B罚」标签。
			reason.append("阈值比较%.1f%s" % [inc1, _fmt_parts(info.get("parts", []), 0)])
			var thr_log := _accept_threshold(replay)
			if thr_log > 0.0:
				reason.append("规则B罚%.1f(阈值%.0f)" % [maxf(inc1 - thr_log, 0.0), thr_log])
			if reason.size() == 0:
				reason.append("走位")
			line += "(%s)" % "、".join(reason)
		else:
			line += " 原地"
		var atk := int(a.get("atk", -1))
		if atk >= 0 and atk < replay.units.size():
			var t: SimUnit = replay.units[atk]
			line += " → 攻击 %s" % t.name
			if t.hp <= ur.eatk:
				line += "（此击可击杀 hp%d≤攻%d）" % [t.hp, ur.eatk]
			else:
				line += "（造成%d伤，剩hp%d）" % [ur.eatk, maxi(t.hp - ur.eatk, 0)]
		else:
			# 【2026-09-20 新增·只为诊断】没攻击时把"原地够得到几个"也打出来（与落点那项互补）：
			# 两项都是 0 ⇒ 本回合**根本够不到人**（只能走位）；>0 ⇒ **能打却没打**（那才需要查账）。
			line += " → 不攻击（原地够得到%d个）" % _valid_targets(replay, ur, ur.cell).size()
		var bd0 := _eval_breakdown(replay)     # 本步之前（逐项）
		_apply(replay, idx, a)
		# 【2026-09-21 深夜】⑳㉑ 只在**末态**结算 ⇒ 诊断回放里也只有"本回合最后一步"带这两项
		#   （否则 Σ 自校验会差一个 ±3，日志会自相矛盾）。
		var last_step := (si == path.size() - 1)
		var aft := _evaluate(replay, last_step)
		var delta := aft - prev
		var bd1 := _eval_breakdown(replay, last_step)     # 本步之后（逐项）
		prev = aft
		line += "  [本步 Δ%+.1f]" % delta
		txt += "\n" + line
		txt += "\n" + _breakdown_line(bd0, bd1, delta)
	txt += "\n · 局面纯评分：%.1f → %.1f（决策总评含难度抖动=%.1f）" % [start_score, prev, float(chosen["score"])]
	# 【2026-09-22 晚·已删】这里原来还会打一行「真推演对方一回合：我方共掉 X 血」——该层
	#   （`ROLLOUT_TOPK` / `_rollout_enemy_turn()` / `_rollout_incoming()`）已按用户拍板**整段删除**：
	#   剂量批 16/32 都与关打平（−1.72 / −1.74，CI 跨 0），实机又验出它把「对面会来打我们」判成 0
	#   （模型里的玩家按我们自己的评分贪心 ⇒ 遇上 `<嘲讽>`＋反击×2 就不出手）⇒ 过度乐观。
	#   完整依据见 `RL/progress_tracking/1_通用策略.md` §四登记表。
	txt += "\n===== 决策输出结束 ====="
	print(txt)

