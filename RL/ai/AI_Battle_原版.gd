		# 分叉出去的队列仍指向**父局面的单位对象**。于是延后结算一执行（`_sim_on_died` / `_sim_kill` /
		# 圣光发盾），就会改到**别的候选/父局面**的单位身上：血量、alive、墓碑格全被跨候选改写。
		# 后果（实测物证）：评分与**评估顺序**挂钩 —— 只把终选层"边比边推演"改成"先全部推演再比"
		# （逻辑完全等价），出招就变了 2 个盘面；逐项拆解显示**同一个局面对象**两次评估的
		# ①障碍绕路 / ⑤位置拉力 / ⑦威胁预判 / ⑮下回合挨打 全都不同（§14#184；⑦/⑮ 已于 2026-09-20 第三轮删除）。
		# 修法：单位循环结束后，把队列里的引用**按 `sim_index` 映射到克隆自己的单位**。
		c.pending_died = []
		for e in pending_died:
			c.pending_died.append(c._map_unit(e))
		c.pending_vanish = []
		for e in pending_vanish:
			c.pending_vanish.append(c._map_unit(e))
		c.pending_guard = []
		for e in pending_guard:
			var ed: Dictionary = e
			c.pending_guard.append({
				"dst": c._map_unit(ed.get("dst", null)),
				"giver": c._map_unit(ed.get("giver", null)),
