	#   ⇒ 每次调用都把上一段**清空** ⇒ **只有最后一段活下来**。
	#   实测（探针打印 `w_hero`）：`噩梦.json` 里写了 `hero_42` + `hero_48` + `hero_03` 三段，
	#   引擎装进去的只有最后一段 `hero_03` ⇒ **金矿 40/14 与坚固 5.0 被静默丢掉**（"按英雄覆盖"白写）。
	#   这也是"堡垒 5.0 体感没变化"的直接原因（那一档真正吃到的是扁平兜底 0）。
	var hero_acc: Dictionary = {}
	for k in t.keys():
		var key := String(k)
		var v = t[key]
		# 【RL 新增】英雄段：{ "HERO_VALUE": { "hero_22": 1.35, "hero_40": 0.9 } }
		# （与 set_hero_weights 的"hero_id -> {键: 值}"结构同族，这里只认 VALUE 一个键）
		if key == "HERO_VALUE" and typeof(v) == TYPE_DICTIONARY:
			hero_acc["HERO_VALUE"] = v
			continue
		# 【2026-09-15 补上的一环】按英雄的**逐键覆盖段**：{ "hero_42": { "GOLD_TAKE_VALUE": 40.0 } }
