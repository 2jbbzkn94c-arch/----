	# 【2026-09-20 修 bug】把一个**父局面的** SimUnit 引用映射到**本局面**里的同一个单位
	# （按 `sim_index`；clone 保证下标一一对应）。null / 越界 / 非单位 ⇒ 原样返回。
	func _map_unit(u: SimUnit) -> SimUnit:
		if u == null:
			return null
		var ix := u.sim_index
		if ix >= 0 and ix < units.size():
			return units[ix]
		return u

