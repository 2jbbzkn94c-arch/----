		# 金矿那 6 个键从通用表搬进英雄段之后，注入就靠这一条。
		if key.begins_with("hero_") and typeof(v) == TYPE_DICTIONARY:
			hero_acc[key] = v
			continue
		if typeof(v) != TYPE_FLOAT and typeof(v) != TYPE_INT:
			continue
