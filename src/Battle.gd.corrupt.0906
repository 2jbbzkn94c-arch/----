				s += float(wounded) * 1.2
			elif player_near:
				s -= 4.0
			else:
				s -= 1.5
		if def.skills.has(DataRegistry.Skill.BENCH):
			s += 0.5   # 鏇胯ˉ鏍囩锛氱櫥鍦鸿Е鍙戞妧鑳斤紝灏忓姞鍒?		# 鏇胯ˉ鍏ュ満鎶€鐨勬儏澧冧环鍊硷紙璋佸厛涓婂満鏀剁泭鏇村ぇ锛?match hid:
			"hero_16":   # 娉㈢浘锛氱櫥鍦鸿宸辨柟鍏ㄤ綋鑾峰緱鍦ｇ浘
				s += 5.0 + (3.0 if wounded > 0 else 0.0)
			"hero_36":   # 姊呮灄锛氭不鐤楁渶浣庤閲忛槦鍙嬪苟涓庡叾鎹綅
				s += 5.0 if wounded > 0 else 1.0
			"hero_29":   # 澶槼鏂╋細鐧诲満鏀诲嚮鍔?3锛堢煭鏃剁垎鍙戯級
				s += 3.0
			"hero_39":   # 鐚庨鑰咃細鐧诲満閿佸畾鐩爣
