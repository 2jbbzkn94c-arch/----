var enemy_dead := 0

func _ready() -> void:
	NetBus.packet_received.connect(_on_net_packet)   # 鑱旀満鏀舵寚浠?	NetBus.disconnected.connect(_on_net_disconnected)   # 鑱旀満瀵瑰眬涓細瀵圭閫€鍑?鏂嚎 -> 鏈涔熼€€鍑哄洖澶у巺
	grid = HexGrid.new(board_size.x, board_size.y, hex_size)
	grid.top_cap_cols = [1, 3, 5]   # 浠庡乏鏁扮 2/4/6 鍒楋紙0-based 1/3/5锛夊悇涓€鏍?	# 鑱旀満璁垮锛氭妸妫嬬洏缁曚腑蹇冩棆杞?180掳锛岃"鎴戞柟闃佃惀"濮嬬粓钀藉湪灞忓箷涓嬫柟銆?	# 鍙奖鍝嶆覆鏌?榧犳爣鍥炴煡锛屼笉鏀逛换浣曢€昏緫鏍?闃佃惀锛屾晠涓ょ纭畾鎬т笉鍙楀奖鍝嶃€?	grid.view_flip = GameState.is_online and not GameState.is_host
	board_view = BoardView.new(grid, _board_origin())
	board_view.enemy_zone_cells = ENEMY_ZONE_CELLS.duplicate()   # 鏁屾柟鍑虹敓鍖烘暣鐗囷紙搴曡壊涓婅壊鐢級
	board_view.bombs = bombs
	board_view.obstacles = obstacles
	board_view.buff_items = buff_items
	board_view.graves = graves
	# 閰掗鏈ㄥ湴鏉胯儗鏅紙鍨湪妫嬬洏涓嬪眰锛涘繀椤诲拷鐣ラ紶鏍囷紝鍚﹀垯浼氬悆鎺夋鐩樼偣鍑伙級
	var wood := WoodFloor.new()
	var wsize := get_viewport().get_visible_rect().size
	wood.position = Vector2.ZERO
	wood.size = wsize
	wood.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(wood)
	add_child(board_view)
	if GameState.is_online:
		# 鑱旀満瀵瑰眬锛氫袱绔娇鐢?NetLobby 骞挎挱鐨勫悓涓€闅忔満绉嶅瓙锛堢‘瀹氭€э級锛涗娇鐢ㄥ弻鏂归€夋嫨鐨勫崱缁勶紙涓虹┖鎵嶇敤榛樿锛夛紝
		# 璧颁笌鍗曟満涓€鑷寸殑 _begin_deployment 杞祦閮ㄧ讲锛堟晫杞敼涓虹瓑寰呭绔湡浜哄彂閮ㄧ讲鎸囦护锛夈€?		# 绔炴妧鍦鸿仈鏈猴細鍏堢敱涓绘満鍙戠墝鍙屼汉 2 閫?1 鏋勫缓鍙屾柟鍗＄粍锛堝悇 8 鍚嶏級锛屽啀杩涘叆鍚屾牱鐨勯儴缃叉祦绋嬨€?set_random_seed(GameState.online_seed)
		_place_obstacles()
		_setup_hud()
		if GameState.arena_mode:
			_begin_online_arena_draft()
		else:
			if GameState.player_deck.size() == 0:
				GameState.player_deck = ["hero_06", "hero_17", "hero_26"]
			if GameState.enemy_deck.size() == 0:
				GameState.enemy_deck = ["hero_13", "hero_12", "hero_23"]
			_begin_deployment()
	elif GameState.player_placement.size() > 0 or GameState.enemy_placement.size() > 0:
		# 娴嬭瘯鍦烘櫙鐩存帴鎸囧畾鏀剧疆锛氫笉涓婇儴缃查€変汉
		_place_units()
		_setup_hud()
		_start_match()
	else:
		_place_obstacles()
		_setup_hud()
		if GameState.arena_mode:
			_begin_arena_draft()   # 绔炴妧鍦猴細鍏堥殢鏈?閫?鏋勫缓鍙屾柟鍗＄粍锛屽啀閮ㄧ讲
		else:
			_begin_deployment()

# 姣忓抚鍒锋柊"浠嶆湁琛屽姩鑻遍泟"鐨勯《閮ㄦ爣璇嗭紙浠呮湰绔垜鏂瑰洖鍚堛€佷笖浠呮湰绔垜鏂瑰崟浣嶆樉绀猴級
func _process(dt: float) -> void:
	# 寮€灞€閫変汉闄愭椂锛氭湰绔笁杞叡鐢ㄤ竴涓叡浜绠楋紱棰勭畻鑰楀敖 -> 鑷姩闅忔満琛ヤ汉锛堟瘡娆¤ˉ涓€浜猴紝鎹㈠洖鏈晶杞户缁ˉ鍒版弧锛?	if state == State.DEPLOY or state == State.PLACE_DEPLOY:
		if deploy_budget_active:
			deploy_budget_left = maxf(deploy_budget_left - dt, 0.0)
			if deploy_budget_left <= 0.0:
				deploy_budget_active = false   # 鏈晶鏈疆绔嬪嵆闅忔満琛ヤ汉
				action_info.emit("閫変汉鏃堕棿鍒帮紝鑷姩闅忔満涓婁汉銆?)
				_auto_deploy_random()
	# 绔炴妧鍦洪€変汉杞檺鏃讹細浠?鏈姝ｅ湪 2 閫?1"鏃跺€掕鏃讹紙绛夊緟瀵规柟/鏁屾柟AI杞笉闄愭椂锛?	if state == State.ARENA_DRAFT and arena_pick_time_left >= 0.0:
		if _my_arena_choosing():
			arena_pick_time_left -= dt
			if arena_pick_time_left <= 0.0:
				arena_pick_time_left = 0.0
				action_info.emit("閫夊崱瓒呮椂锛岃嚜鍔ㄩ€夋嫨绗竴寮犮€?)
				_auto_pick_first()
	var match_live: bool = GameState.match_running and not GameState.match_over
	var my_turn_live: bool = match_live and GameState.active_side == _my_side()
	# 鏈鍥炲悎鍊掕鏃讹紙浠庡洖鍚堝紑濮嬭捣绠楋紝婕斿嚭/琛屽姩鍔ㄧ敾涔熺畻鏃堕棿锛夛紱瓒呮椂缃爣璁帮紝鍥炲埌鍙彁浜ょ姸鎬佹椂鑷姩缁撴潫
	if my_turn_live and turn_time_left > 0.0:
		turn_time_left = maxf(turn_time_left - dt, 0.0)
		if turn_time_left <= 0.0:
			turn_time_left = 0.0
			_turn_expired = true
			action_info.emit("鍥炲悎瓒呮椂锛岃嚜鍔ㄧ粨鏉熷洖鍚堛€?)
	if _turn_expired and state == State.PLAYER_INPUT and my_turn_live:
		_turn_expired = false
		submit_end_turn()   # 瀹㈡埛绔秴鏃?-> 鍙戜富鏈猴紱涓绘満瓒呮椂 -> 鏈湴缁撴潫
	# 鑱旀満绛夊緟瀵圭琛屽姩锛氬绔箍鎾彧浣滀负鍩哄噯锛屾湰绔瘡甯ц嚜琛岄€掑噺锛堝绔紨鍑?鏂寘鏈熼棿涓嶆秷澶憋級
	if GameState.is_online and match_live and not my_turn_live and peer_turn_time_left > 0.0:
		peer_turn_time_left = maxf(peer_turn_time_left - dt, 0.0)
	# 鑱旀満锛氭湰绔鍔ㄦ椂锛堝惈琛屽姩鍔ㄧ敾鏈熼棿锛夋妸鍓╀綑绉掓暟鍚屾缁欏绔紱鍥炲悎寮€濮嬫椂涔熺珛鍗冲悓姝ヤ竴娆?	if GameState.is_online and my_turn_live and _time_sync_acc >= 0.5:
		_time_sync_acc = 0.0
		_send_turn_time_left()
	elif GameState.is_online and my_turn_live:
		_time_sync_acc += dt
	if state == State.PLAYER_INPUT and my_turn_live:
		for u in units:
			if u == null or not is_instance_valid(u):
				continue
			if u.alive and u.faction == _my_faction():
				# 鍙Щ鍔?缁胯壊銆佸彲鏀诲嚮=绾㈣壊锛涗袱鑰呭彲鐙珛鏄剧ず锛堝悗鍕や笉鑳芥敾鍑伙紝鏀诲嚮鏍囪瘑涓嶄寒锛?u.set_action_markers(not u.moved_this_turn, not u.attacked_this_turn and _can_actively_attack(u))
				u.set_action_marker(false)   # 鏃х粺涓€鏍囪瘑鍏抽棴锛岄伩鍏嶆畫鐣?else:
				u.set_action_markers(false, false)
				u.set_action_marker(false)
	else:
		for u in units:
			if u == null or not is_instance_valid(u):
				continue
			u.set_action_markers(false, false)
			u.set_action_marker(false)

func _send_turn_time_left() -> void:
	if not GameState.is_online or not NetBus.is_online:
		return
	NetBus.send_all(JSON.stringify({ "type": "turn_time", "left": int(ceil(turn_time_left)) }))

# ---- 绔炴妧鍦烘ā寮忥細闅忔満2閫?鏋勫缓鍙屾柟鍗＄粍 ----
func _begin_arena_draft() -> void:
	state = State.ARENA_DRAFT   # 鍏堣繘鍏ラ€変汉鎬侊細椤堕儴鏍囩鏄剧ず"绔炴妧鍦洪€変汉"
	_prepare_first_side()   # 娴鎻愮ず"鏈眬鍏堟墜"锛岄殢鍚庡紑濮?2 閫?1 閫変汉
	arena_pick_time_left = -1.0   # 棣栬疆灞曠ず鏃跺啀缃檺鏃?	# 鍊欓€夋睜 = 鍏ㄩ儴鑻遍泟锛堝幓閲嶏紝涓嶅惈琛嶇敓鐗╋級
	_arena_pool = DataRegistry.heroes.keys().duplicate()
	_rng_shuffle(_arena_pool)   # 鐢?rng 娲楃墝锛堝悓绉嶅瓙涓ょ涓€鑷达級
	_arena_picked = []
	_arena_enemy = []
	_arena_player_rounds = 0
	_arena_enemy_rounds = 0
	# 鍏抽敭锛氶€変汉涓€寮€濮嬪氨娓呯┖涓婁竴灞€鍗＄粍銆傚惁鍒欏湪 8 杞€夊畬锛堟墠 set_decks锛変箣鍓嶏紝
	# 浠讳綍璇诲彇 GameState.player_deck/enemy_deck 鐨勫湴鏂癸紙閮ㄧ讲/闃熶紞闈㈡澘绛夛級閮戒細鏄剧ず涓婁竴灞€闃靛銆?	GameState.set_decks([], [])
	_notify_team()   # 绔嬪嵆鍒锋柊 HUD锛氬凡閫夐樀瀹逛负绌?-> 鏃ч槦浼嶉潰鏉块殢涔嬫敹璧?	_show_arena_round()

func _show_arena_round() -> void:
	# 鍏?8 杞細鍓?4 杞帺瀹?2 閫?1锛堣嚜宸辨嬁 1銆佸彟 1 缁欐晫鏂癸級锛涘悗 4 杞晫鏂归€夛紙鏁屾柟鎷?1銆佸彟 1 缁欎綘锛?	var total_done: int = _arena_player_rounds + _arena_enemy_rounds
	if total_done >= ARENA_PICKS_PER_SIDE * 2:
		# 8 杞€夊畬锛歘arena_picked 绱Н浜嗙帺瀹舵嬁鍒扮殑鍏ㄩ儴 8 涓紙鐜╁4+鏁岃疆褰掍綘4锛夛紝
		# _arena_enemy 绱Н浜嗘晫鏂规嬁鍒扮殑鍏ㄩ儴 8 涓紙鐜╁杞綊鏁?+鏁屾柟鑷€?锛夈€?		# 淇濇寔 arena_mode=true锛氱珵鎶€鍦烘ā寮忎笅"鍐嶆潵涓€灞€"浼氶噸鏂伴€変汉锛岀洿鍒扮帺瀹惰繑鍥為€変汉鐣岄潰閫€鍑恒€?		# 鍙屾柟閮芥妸甯?<鏇胯ˉ> 鏍囩鐨勮嫳闆勬帓鍒板崱缁勬湯灏撅紙杩涙浛琛ュ腑锛夛紝淇濊瘉鍓?3 鍚?= 棣栧彂鑻遍泟銆?GameState.set_decks(_order_deck(_arena_picked), _order_deck(_arena_enemy))
		log_message.emit("绔炴妧鍦洪€変汉瀹屾垚锛氭垜鏂?%d 鍚嶏紝鏁屾柟 %d 鍚嶃€? % [GameState.player_deck.size(), GameState.enemy_deck.size()])
		arena_draft_done.emit()
		_begin_deployment()
		return
	var remaining := _arena_pool.duplicate()
	if remaining.size() >= 2:
		# 鍙栦袱涓笉閲嶅鐨?var a: String = remaining.pop_front()
		var b: String = remaining.pop_front()
		_arena_pending = [a, b]
		if _arena_player_rounds < ARENA_PICKS_PER_SIDE:
			# 鐜╁杞紙鏄剧ず鐜╁鑷繁鎿嶄綔鐨勮疆鏁帮細鍏?4 杞級
			arena_pick_time_left = ARENA_PICK_SECONDS   # 寮€濮嬫湰杞檺鏃?arena_draft_requested.emit(_arena_pending)
			action_info.emit("绔炴妧鍦洪€変汉锛堢 %d/%d 杞紝浣犵殑鍥炲悎锛夛細浠庝袱鍚嶈嫳闆勪腑閫?1 鍚嶅姞鍏ヤ綘鐨勯槦浼嶃€? % [_arena_player_rounds + 1, ARENA_PICKS_PER_SIDE])
		else:
			# 鏁屾柟杞細鍏堝彂绌烘彁绀猴紙HUD 鏄剧ず"鏁屾柟閫夋嫨涓?锛夛紝鏁屾柟鑷姩閫変竴涓紝鍙?涓綊浣狅紙涓嶉檺鏃讹級
			arena_pick_time_left = -1.0
			arena_draft_requested.emit([])
			_action_arena_enemy_pick()
		return
	else:
		# 姹犱笉瓒筹紙鐞嗚涓嶄細鍑虹幇锛屽厹搴曠敤榛樿鍗＄粍锛?GameState.set_decks([], [])
		arena_draft_done.emit()
		_begin_deployment()

# 鍗＄粍鎺掑簭锛氬甫 <鏇胯ˉ> 鏍囩鐨勮嫳闆勶紙姊呮灄/娉㈢浘/澶槼鏂?鐚庨鑰咃級鎺掑埌鏈熬锛堣繘鏇胯ˉ甯級锛?# 淇濊瘉鍓?3 鍚?= 棣栧彂鍨嬭嫳闆勩€傞潪鏇胯ˉ淇濇寔鐩稿椤哄簭鍦ㄥ墠銆?func _order_deck(deck: Array) -> Array:
	var starts: Array = []
	var bench: Array = []
	for hid in deck:
		var def := DataRegistry.get_hero(hid)
		if def != null and def.skills.has(DataRegistry.Skill.BENCH):
			bench.append(hid)
		else:
			starts.append(hid)
	return starts + bench

# 鑻遍泟寮哄害鎵撳垎锛堝崟浣撳熀鍑嗭紝鍗忓悓鍙﹁鍔犲垎锛涗笌鑿滃崟閫変汉鍏辩敤鍙ｅ緞锛?func _hero_strength(id: String) -> float:
	var def: DataRegistry.HeroDef = DataRegistry.heroes[id]
	var s := float(def.atk) * 1.8 + float(def.max_hp)
	if def.attack_type == DataRegistry.AttackType.RANGED:
		s += 2.0
	for sk in def.skills:
		match sk:
			DataRegistry.Skill.TAUNT:
				s += 2.0
			DataRegistry.Skill.SWIFT:
				s += 1.0
			DataRegistry.Skill.INFILTRATE:
				s += 1.5
			DataRegistry.Skill.LOGISTICS:
				s += 1.0
	s += float(def.rarity) * 0.5
	return s

# 鏌愯嫳闆勪笌"宸查€夊崱缁?鐨勬満鍒跺崗鍚屾€诲拰锛堣€冭檻宸查€夎嫳闆勯棿鐨勯厤鍚堬級
func _deck_synergy(deck: Array, hid: String) -> float:
	var s := 0.0
	for c in deck:
		s += DataRegistry.synergy_bonus(c, hid)
	return s

# 鏁屾柟閫変汉杈呭姪锛氬€欓€夎嫳闆勮兘瀵圭帺瀹跺凡閫夎嫳闆勭殑鍏嬪埗绋嬪害锛堜粠瑙掕壊鍒楄〃"琚厠鍒?鍒楁娊鍙栫殑鍏崇郴锛?func _counter_player_score(hid: String) -> float:
	var s := 0.0
	for pid in _arena_picked:
		var cr := DataRegistry.counter_bonus(hid, pid)
		if cr > 0.0:
			s += cr   # 璇ュ€欓€夊厠鍒剁帺瀹舵煇鑻遍泟 -> 鏁屾柟鏇村€煎緱鎷?	return s

# 鏁屾柟杞細鏁屾柟鑷姩浠?涓€欓€夐噷閫?涓紝鍙?涓繘鐜╁鍗＄粍銆?# 绛栫暐锛氶€?涓庢晫鏂瑰凡閫夊崱缁勫崗鍚屾洿楂樸€佷笖鍗曚綋鏇村己"鐨勭暀缁欒嚜宸憋紝鎶婂急/闅鹃厤鍚堢殑璁╃粰鐜╁锛?# 鍚屾椂缁撳悎涓€鐐归殢鏈烘€э紙top 1 鑻ヤ笉澶熷己鍒欎粛淇濆墠浜岋級锛岄伩鍏嶆瘡娆￠兘鎷垮悓涓€鎵广€?func _action_arena_enemy_pick() -> void:
	if _arena_pending.size() < 2:
		_arena_pending = []
		_show_arena_round()
		return
	var a: String = _arena_pending[0]
	var b: String = _arena_pending[1]
	# 鍊欓€夎嫢鍔犲叆鏁屾柟鍗＄粍甯︽潵鐨?浠峰€? = 鍗曚綋寮哄害 + 涓庢晫鏂瑰凡閫夎嫳闆勭殑鍗忓悓 + 涓庡鏂瑰€欓€夌殑鍗忓悓
	# + 瀵圭帺瀹跺凡閫夎嫳闆勭殑鍏嬪埗锛堝亸濂介€夎兘鍏嬪埗鐜╁鐨勮嫳闆勶級
	var sc_a := _hero_strength(a) + _deck_synergy(_arena_enemy, a) + DataRegistry.synergy_bonus(a, b) + _counter_player_score(a)
	var sc_b := _hero_strength(b) + _deck_synergy(_arena_enemy, b) + DataRegistry.synergy_bonus(b, a) + _counter_player_score(b)
	# 杞诲井闅忔満锛氫袱涓€欓€変环鍊兼帴杩戯紙宸€?< 1.5锛夋椂闅忔満鍐冲畾锛岄伩鍏嶅畬鍏ㄥ彲棰勬祴銆?	var en_hid: String
	if abs(sc_a - sc_b) <= 1.5:
		en_hid = a if rng.randi() % 2 == 0 else b
	else:
		en_hid = a if sc_a >= sc_b else b
	var give_player: String = _arena_pending[1] if en_hid == _arena_pending[0] else _arena_pending[0]
	_arena_enemy.append(en_hid)
	_arena_picked.append(give_player)   # 鏁屾柟娌℃嬁鐨勫綊浣?	for c in _arena_pending:
		_arena_pool.erase(c)   # 鏈疆涓や釜鍊欓€夌寮€鍊欓€夋睜锛岄伩鍏嶉噸澶嶆娊鍙?	_arena_enemy_rounds += 1
	log_message.emit("鏁屾柟閫夋嫨浜?%s锛?s 褰掍綘銆? % [DataRegistry.get_hero(en_hid).display_name, DataRegistry.get_hero(give_player).display_name])
	_arena_pending = []
	_notify_team()   # 鏁屾柟杞綊浣犵殑鑻遍泟涔熷疄鏃舵洿鏂颁笅鏂归槦浼?	_show_arena_round()

# 鐜╁鍦ㄧ珵鎶€鍦洪€変汉闈㈡澘涓偣鍑绘煇鍚嶈嫳闆?func _on_arena_pick(hid: String) -> void:
	if state != State.ARENA_DRAFT:
		return
	if GameState.is_online and _oa_active:
		_oa_on_pick(hid)
		return
	if _arena_player_rounds >= ARENA_PICKS_PER_SIDE:
		return   # 鐜╁杞凡缁撴潫锛堝悗缁负鏁屾柟杞紝閫氳繃 _action_arena_enemy_pick 鑷姩鎺ㄨ繘锛?	if not _arena_pending.has(hid):
		return
	# 鐜╁閫?1 涓繘鑷繁鐨勫崱缁勶紝鍙︿竴涓嚜鍔ㄨ繘鏁屾柟鍗＄粍
	_arena_picked.append(hid)
	for c in _arena_pending:
		if c != hid:
			_arena_enemy.append(c)
		_arena_pool.erase(c)
	_arena_pending = []
	_arena_player_rounds += 1
	log_message.emit("浣犻€夋嫨浜?%s銆傛晫鏂硅幏寰?%s銆? % [DataRegistry.get_hero(hid).display_name, DataRegistry.get_hero(_arena_enemy.back()).display_name if _arena_enemy.size() > 0 else "鈥?])
	_notify_team()   # 绔炴妧鍦洪€変汉瀹炴椂鏇存柊涓嬫柟闃熶紞
	_show_arena_round()

# ---- 鑱旀満绔炴妧鍦猴紙鍙屼汉鍚勮嚜 2 閫?1锛屾棤鍏堝悗銆侀殢鏃剁偣閫夛級----
# 瑙勫垯锛堜笌鍗曟満绔炴妧鍦哄悓婧愶紝鍙槸鏁屾柟涓虹湡浜猴級锛?#   涓绘満/瀹㈡埛绔悇鎷ユ湁鑷繁鐨?4 杞€欓€夛紙姣忚疆 2 鍚嶏紝鐢卞悓涓€绉嶅瓙娲楃墝鍚庣‘瀹氭€у垎閰嶃€佷簰涓嶉噸鍙狅級锛?#   姣忚疆浠庤嚜宸变袱寮犱腑閫?1 寮犵暀鐢紝鍙?1 寮犺嚜鍔ㄩ€佺粰瀵规柟銆傚叡 4 杞悗鍙屾柟鍚勫緱 8 鍚嶏紙鑷暀 4 + 瀵规柟閫?4锛夈€?#   閫夊崱鏃犲厛鍚庯細涓ょ闅忔椂鍚勮嚜鐐归€夛紝鍏堝畬鎴愮殑涓€鏂圭瓑寰呭彟涓€鏂癸紝鍏ㄩ儴瀹屾垚鍚庣敱涓绘満姹囨€诲崱缁勫箍鎾紝鍐嶈繘鍏ユ櫘閫氶儴缃层€?var _oa_active := false             # 鑱旀満绔炴妧鍦洪€夊崱杩涜涓?var _oa_round := 0                  # 鎴戝凡瀹屾垚鐨勮疆鏁帮紙0..ARENA_PICKS_PER_SIDE锛?var _oa_my_pairs: Array = []        # 鎴戞柟 4 杞€欓€夛紙姣忚疆 2 涓?hero id锛?var _oa_peer_pairs: Array = []      # 瀵圭 4 杞€欓€夛紙鏈湴鎺ㄥ锛岀敤浜庝富鏈烘牎楠?姹囨€伙級
var _oa_my_kept: Array = []         # 鎴戞柟姣忚疆鐣欎笅鐨勮嫳闆?var _oa_peer_kept: Array = []       # 涓绘満锛氬绔瘡杞暀涓嬬殑鑻遍泟锛堟寜杞埌杈鹃『搴忔敹闆嗭級
var _oa_finished := false           # 閫夊崱宸插叏閮ㄥ畬鎴?var _oa_pending: Array = []         # 涓绘満锛歞raft 灏氭湭鍚姩鏃舵敹鍒扮殑瀹㈡埛绔?pick 缂撳瓨锛堥槻涔卞簭涓㈠寘锛?
func _begin_online_arena_draft() -> void:
	state = State.ARENA_DRAFT
	_prepare_first_side()   # 鑱旀満绔炴妧鍦猴細寮€灞€鍏堟墜鎻愮ず涓?2 閫?1 閫変汉涓€璧峰脊鍑?	arena_pick_time_left = -1.0   # 鏈杞埌 2 閫?1 鏃?_oa_show_round 鍐嶇疆闄愭椂
	_oa_active = true
	_oa_round = 0
	_oa_my_pairs = []
	_oa_peer_pairs = []
	_oa_my_kept = []
	_oa_peer_kept = []
	_oa_finished = false
	# 鍙屾柟鍚岀瀛愭礂鏁存睜鍚庯紝鍓?8 鍚嶇粰涓绘満鍗婂尯銆佸悗 8 鍚嶇粰瀹㈡埛绔崐鍖猴紙鏈湴鎺ㄥ涓€鑷达紝鏃犻渶缃戠粶鍙戝€欓€夛級銆?	var pool := DataRegistry.heroes.keys().duplicate()
	if pool.size() < ARENA_PICKS_PER_SIDE * 4:
		# 姹犱笉瓒筹紙鍑犱箮涓嶄細鍙戠敓锛夛細涓ょ璧板悓涓€鍏滃簳鍗＄粍骞剁洿鎺ヨ繘鍏ラ儴缃诧紙鏃犻渶骞挎挱鈥斺€斾袱绔‘瀹氭€т竴鑷达級銆?log_message.emit("鑻遍泟姹犱笉瓒筹紝鑱旀満绔炴妧鍦烘敼鐢ㄩ粯璁ゅ崱缁勩€?)
		GameState.player_deck = ["hero_06", "hero_17", "hero_26"]
		GameState.enemy_deck = ["hero_13", "hero_12", "hero_23"]
		_oa_finished = true
		_oa_active = false
		_oa_finish_to_deploy()
		return
	_rng_shuffle(pool)
	for r in ARENA_PICKS_PER_SIDE:
		if GameState.is_host:
			_oa_my_pairs.append([pool[r * 2], pool[r * 2 + 1]])
			_oa_peer_pairs.append([pool[8 + r * 2], pool[8 + r * 2 + 1]])
		else:
			_oa_my_pairs.append([pool[8 + r * 2], pool[8 + r * 2 + 1]])
			_oa_peer_pairs.append([pool[r * 2], pool[r * 2 + 1]])
	log_message.emit("绔炴妧鍦洪€夊崱寮€濮嬶細鍏?4 杞紝姣忚疆浠庣粰浣犵殑涓ゅ紶涓€?1 寮犵暀鐢紝鍙︿竴寮犻€佺粰瀵规柟銆?)
	if GameState.is_host and _oa_pending.size() > 0:
		# 涓绘満鍚姩鏈熼棿鏀跺埌鐨勫鎴风 pick 缂撳瓨锛氱幇鍦ㄨˉ榻?var pend: Array = _oa_pending
		_oa_pending = []
		for p in pend:
			if p is Dictionary:
				_oa_on_peer_pick(int(p.get("round", -1)), String(p.get("hero", "")))
	_oa_show_round()

# 灞曠ず褰撳墠杞€欓€夛紱宸查€夋弧 4 杞垯鏄剧ず绛夊緟锛堢瓑瀵规柟瀹屾垚 / 涓绘満姹囨€诲箍鎾級
func _oa_show_round() -> void:
	if not _oa_active:
		return
	if _oa_round >= ARENA_PICKS_PER_SIDE:
		action_info.emit("浣犲凡瀹屾垚閫夊崱锛岀瓑寰呭鏂瑰畬鎴愨€︹€?)
		arena_pick_time_left = -1.0   # 绛夊緟瀵规柟锛氭湰绔笉鍐嶉檺鏃?arena_draft_requested.emit([])   # 绌哄€欓€?-> HUD 鏄剧ず绛夊緟闈㈡澘
		_oa_check_finish_host()
		return
	if _oa_round >= _oa_my_pairs.size():
		return
	arena_pick_time_left = ARENA_PICK_SECONDS   # 鏈鏂颁竴杞?2 閫?1锛氬紑濮嬮檺鏃?	arena_draft_requested.emit(_oa_my_pairs[_oa_round])
	action_info.emit("绔炴妧鍦洪€夊崱锛堢 %d/%d 杞級锛氫粠涓ゅ紶涓€?1 寮犵暀涓嬶紝鍙︿竴寮犲皢閫佺粰瀵规柟銆? % [_oa_round + 1, ARENA_PICKS_PER_SIDE])

# 鏈鏄惁姝ｅ浜庣珵鎶€鍦?2 閫?1 涓斿彲鐐归€夛紙鐢ㄤ簬鍊掕鏃讹細鍗曟満鐜╁杞?/ 鑱旀満鏈杞級
func _my_arena_choosing() -> bool:
	if state != State.ARENA_DRAFT:
		return false
	if GameState.is_online and _oa_active:
		return _oa_round < ARENA_PICKS_PER_SIDE and _oa_round < _oa_my_pairs.size()
	return _arena_player_rounds < ARENA_PICKS_PER_SIDE and _arena_pending.size() >= 2

# 瓒呮椂鑷姩閫夊綋鍓嶈疆绗竴寮狅紙鍗曟満璧?_on_arena_pick锛涜仈鏈鸿蛋 _oa_on_pick 骞跺悓姝ュ绔級
func _auto_pick_first() -> void:
	if state != State.ARENA_DRAFT:
		return
	if GameState.is_online and _oa_active:
		if _oa_round < _oa_my_pairs.size():
			var pair: Array = _oa_my_pairs[_oa_round]
			if pair.size() >= 2:
				_oa_on_pick(pair[0])
	else:
		if _arena_pending.size() >= 2:
			_on_arena_pick(_arena_pending[0])

# 鎴戞柟鐐归€夊綋鍓嶈疆鐨勪竴寮?func _oa_on_pick(hid: String) -> void:
	if not _oa_active or state != State.ARENA_DRAFT:
		return
	if _oa_round >= ARENA_PICKS_PER_SIDE or _oa_round >= _oa_my_pairs.size():
		return
	var pair: Array = _oa_my_pairs[_oa_round]
	if not pair.has(hid):
		return
	_oa_my_kept.append(hid)
	var gift: String = pair[1] if pair[0] == hid else pair[0]
	_oa_round += 1
	log_message.emit("浣犵暀涓嬩簡 %s锛屻€?s銆嶅皢閫佺粰瀵规柟銆? % [DataRegistry.get_hero(hid).display_name, DataRegistry.get_hero(gift).display_name])
	_notify_team()
	if GameState.is_host:
		_oa_check_finish_host()
		_oa_show_round()
	else:
		NetBus.send_to(1, JSON.stringify({ "type": "arena_pick", "round": _oa_round - 1, "hero": hid }))
		_oa_show_round()

# 涓绘満鏀跺埌瀹㈡埛绔煇涓€杞殑閫夋嫨锛堟寜杞『搴忔敹闆嗭級
func _oa_on_peer_pick(rd: int, hero: String) -> void:
	if not _oa_active or not GameState.is_host:
		return
	if rd < 0 or rd >= ARENA_PICKS_PER_SIDE or rd != _oa_peer_kept.size():
		return   # 鏈熸湜鎸?0..3 椤哄簭鍒拌揪锛屼贡搴?閲嶅鐩存帴蹇界暐
	if rd >= _oa_peer_pairs.size():
		return
	var pair: Array = _oa_peer_pairs[rd]
	if not pair.has(hero):
		return
	_oa_peer_kept.append(hero)
	_oa_check_finish_host()

# 涓绘満鍦ㄥ弻鏂归兘閫夋弧鍚庢眹鎬诲崱缁勫苟骞挎挱锛堝鎴风鏀跺埌骞挎挱鍚庝互骞挎挱涓哄噯锛?func _oa_check_finish_host() -> void:
	if not GameState.is_host or not _oa_active:
		return
	if _oa_round < ARENA_PICKS_PER_SIDE or _oa_peer_kept.size() < ARENA_PICKS_PER_SIDE:
		return
	if _oa_finished:
		return
	_oa_finished = true
	# 缁勮鍙屾柟鍗＄粍锛氳嚜宸?4 鐣?+ 瀵规柟姣忚疆娌￠€夛紙閫佺粰鎴戠殑锛? 寮狅紱瀵规柟鍚岀悊銆?	var pdeck: Array = []   # 涓绘満锛圥LAYER 鍗婂尯锛夊崱缁?	var edeck: Array = []   # 瀹㈡埛绔紙ENEMY 鍗婂尯锛夊崱缁?	for r in ARENA_PICKS_PER_SIDE:
		var mp: Array = _oa_my_pairs[r]
		var pp: Array = _oa_peer_pairs[r]
		pdeck.append(_oa_my_kept[r])
		pdeck.append(pp[1] if pp[0] == _oa_peer_kept[r] else pp[0])
		edeck.append(_oa_peer_kept[r])
		edeck.append(mp[1] if mp[0] == _oa_my_kept[r] else mp[0])
	GameState.player_deck = _order_deck(pdeck)
	GameState.enemy_deck = _order_deck(edeck)
	_oa_active = false
	NetBus.send_all(JSON.stringify({ "type": "arena_done", "pdeck": GameState.player_deck, "edeck": GameState.enemy_deck }))
	_oa_finish_to_deploy()

# 瀹㈡埛绔敹鍒颁富鏈哄箍鎾殑鏈€缁堝崱缁勫悗钀戒綅锛岀劧鍚庝袱绔兘浠庤繖閲岃繘鍏ラ儴缃?func _oa_apply_done(pdeck: Array, edeck: Array) -> void:
	if _oa_finished:
		return
	_oa_finished = true
	_oa_active = false
	GameState.player_deck = pdeck
	GameState.enemy_deck = edeck
	_oa_finish_to_deploy()

# 閫夊崱缁撴潫 -> 鍏抽棴閫夊崱闈㈡澘骞惰繘鍏ヤ笌鏅€氭ā寮忎竴鑷寸殑閮ㄧ讲娴佺▼
func _oa_finish_to_deploy() -> void:
	arena_draft_done.emit()
	state = State.IDLE
	log_message.emit("绔炴妧鍦洪€夊崱瀹屾垚锛氭垜鏂?%d 鍚?/ 鏁屾柟 %d 鍚嶏紝寮€濮嬮儴缃层€? % [GameState.player_deck.size(), GameState.enemy_deck.size()])
	_begin_deployment()


