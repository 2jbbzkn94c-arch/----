var hex_size := 60.0   # 鍏竟褰㈠鎺ュ崐寰勶紙鍍忕礌锛夛細鏁翠綋鏀惧ぇ妫嬬洏鏀硅繖閲岋紙48鈫?0 鏀惧ぇ绾?25%锛?
