	_pending_sub = ""
	selected = null
	# 閲嶇疆 GameState锛堟寜褰撳墠妯″紡锛涢噸缃悗閲嶆柊閮ㄧ讲/绔炴妧鍦洪€変汉锛?	if GameState.arena_mode:
		GameState.arena_mode = true   # 绔炴妧鍦烘ā寮忥細閲嶅紑鍚庝繚鎸佺珵鎶€鍦猴紝閲嶆柊闅忔満閫変汉锛堢洿鍒扮帺瀹惰繑鍥為€変汉鐣岄潰閫€鍑猴級
	GameState.round_number = 1
	GameState.active_side = GameState.SIDE_PLAYER
	GameState.match_over = false
	GameState.match_running = false
	# 娓呮帀鏃у灞€鐨勫洖鍚?绛夊緟鍊掕鏃朵笌瓒呮椂鏍囪锛岄伩鍏嶉噸寮€鍚庨《閮ㄨ繕鏄剧ず涓婁竴灞€鐨?鍓╀綑绉掓暟"
	turn_time_left = 0.0
	peer_turn_time_left = 0.0
	_turn_expired = false
	deploy_budget_left = DEPLOY_BUDGET_SECONDS
	deploy_budget_active = false
	arena_pick_time_left = -1.0
	_first_side_decided = false   # 閲嶅紑瑙嗕负鏂板紑灞€锛氶噸鏂伴殢鏈哄厛鎵嬪苟寮规鎻愮ず
	GameState.start_match(GameState.SIDE_PLAYER)
	if GameState.player_placement.size() > 0 or GameState.enemy_placement.size() > 0:
		# 鑷敱閮ㄧ讲锛氱洿鎺ユ斁缃苟寮€鎴?_place_units()
		_start_match()
	elif GameState.arena_mode and not GameState.is_online:
		# 鍗曟満绔炴妧鍦洪噸寮€锛氶噸鏂伴殢鏈虹敓鎴愰殰纰嶅苟鍥炲埌 2 閫?1 閫変汉锛堜笌 _ready 绔炴妧鍦哄垎鏀竴鑷达級銆?		# _begin_arena_draft 鍐呴儴浼氭竻绌哄崱缁勫苟鍒锋柊 HUD锛堟棫闃熶紞闈㈡澘闅忎箣鏀惰捣锛夈€?_place_obstacles()
		arena_pick_time_left = -1.0
		_begin_arena_draft()
	else:
		# 鏅€氭ā寮忛噸寮€锛氶噸鏂伴殢鏈虹敓鎴愰殰纰嶅啀杩涘叆閮ㄧ讲锛堜笌 _ready 鏅€氬垎鏀竴鑷达細鍏堟斁闅滅鍐嶉儴缃诧級
		_place_obstacles()
		_begin_deployment()

# 鍗曟満寮€灞€鍏堟墜锛氭瘡灞€闅忔満涓€娆″苟寮规鍛婄煡鍚庡啀閫変汉/涓婇鍙戙€?# 鑱旀満锛氱敤绉嶅瓙濂囧伓瀹氬厛鎵嬶紝涓ょ蹇呯劧涓€鑷达紙涓嶄緷璧栦袱绔?rng 璋冪敤鏄惁瀵归綈锛夈€?func _prepare_first_side() -> void:
	if _first_side_decided:
		return
	_first_side_decided = true
	if GameState.is_online:
		# 閬垮厤"涓ょ鍚勬幏涓€娆?rng 浜х敓鍒嗘"瀵艰嚧鎻愮ず涓庣姸鎬佹爮鍏堟墜涓嶄竴鑷?_deploy_side = 1 if GameState.online_seed % 2 == 1 else 0
	else:
		_deploy_side = rng.randi() % 2
	_first_side = GameState.SIDE_PLAYER if _deploy_side == 0 else GameState.SIDE_ENEMY
	if DisplayServer.get_name() == "headless":
		return   # 鏃犵獥鍙ｆ祴璇曪細涓嶆彁绀虹洿鎺ョ户缁?	# 鍗曟満/鑱旀満閮芥彁绀猴細"鎴戞柟/鏁屾柟"鎸夋湰绔樀钀ヨ瑙掕〃杩?	var who := "鎴戞柟" if _first_side == _my_side() else "鏁屾柟"
	first_side_notice.emit("鏈眬鍏堟墜锛?s" % who)   # HUD 鐭殏娴 ~1s 鑷姩娑堝け锛屼笉闃诲娴佺▼

func _begin_deployment() -> void:
	state = State.DEPLOY   # 鍏堣繘鍏ラ儴缃叉€侊細椤堕儴鏍囩鏄剧ず"閮ㄧ讲閫変汉"鑰屼笉鏄棫鍥炲悎
	_prepare_first_side()
	player_pool = GameState.player_deck.duplicate()
	enemy_pool = GameState.enemy_deck.duplicate()
	player_deployed = []
	enemy_deployed = []
	player_roster = []
	enemy_roster = []
	# 楂樹寒鍑虹敓鍖猴紙鎴戞柟钃濄€佹晫鏂圭孩锛?	var pc := {}
	for c in _deploy_cells(DataRegistry.Faction.PLAYER):
		pc[c] = Color(0.2, 0.6, 0.95, 0.55)
	for c in _deploy_cells(DataRegistry.Faction.ENEMY):
		pc[c] = Color(0.95, 0.35, 0.3, 0.5)
	_preview_cells = pc
	_apply_highlights()
	deploy_refresh.emit()
	if _deploy_side == 1:
		if not GameState.is_online:
			_enemy_deploy.call_deferred()
		else:
			# 鑱旀満锛氭晫杞敱瀵圭鐪熶汉閫変汉鏀剧疆锛屾湰绔瓑寰?action_info.emit("绛夊緟瀵规柟閫変汉鈥︹€? if GameState.is_host else "杞埌浣狅紙鏁屾柟锛夐€変汉锛氱偣閫変笅鏂硅嫳闆勩€?)
	_sync_deploy_timer()

func _deploy_cells(faction: int) -> Array:
	# 鍙屾柟鍑虹敓鍖烘暣鐗囬珮浜細鐜╁=搴曡鏁磋锛屾晫鏂?椤堕儴椤跺附琛?绗竴婊¤
	return _spawn_cells(faction)

func _deploy_spawn(faction: int, hero_id: String) -> void:
	var cells := _deploy_cells(faction)
	var cell := Vector2i(-99, -99)
	for c in cells:
		if not occupancy.has(c):
			cell = c
			break
	if cell.x == -99:
		return
	var u := _spawn_unit(hero_id, faction, cell)
	# 婕斿嚭锛氫粠鐧诲満鐐规贰鍏?+ 鏀惧ぇ
	u.modulate.a = 0.0
	u.scale = Vector2(0.2, 0.2)
	var t := create_tween()
	t.tween_property(u, "modulate:a", 1.0, 0.35)
	t.parallel().tween_property(u, "scale", Vector2.ONE, 0.35)

func _on_deploy_pick(hero_id: String) -> void:
	if state != State.DEPLOY or _deploy_side != 0:
		return
	if GameState.is_online and not GameState.is_host:
		return   # 鑱旀満鐜╁杞細鍙湁涓绘満鍙偣閫夛紙瀹㈡埛绔瓑寰咃級
	if not player_pool.has(hero_id):
		return
	_pending_deploy = hero_id   # 涓嶄粠鍗℃睜鎵ｉ櫎锛屼繚鎸佸竷灞€涓嶅姩
	state = State.PLACE_DEPLOY
	# 楂樹寒鎴戞柟鍑虹敓鏍硷紙缁胯壊锛? 鏁屾柟鍑虹敓鍖猴紙绾級淇濈暀
	_show_deploy_zones(Color(0.2, 0.85, 0.5, 0.7))
	deploy_refresh.emit()
	action_info.emit("鐐瑰嚮鎴戞柟鑳戒笂闃电殑浣嶇疆锛堢豢鑹叉牸锛夈€?)

# 鑱旀満鏁岃疆锛氬鎴风锛堥潪涓绘満锛夊湪 _deploy_side==1 鏃剁偣閫夋晫鏂硅嫳闆勩€?func _on_enemy_deploy_pick(hero_id: String) -> void:
	if state != State.DEPLOY or _deploy_side != 1:
		return
	if not GameState.is_online or GameState.is_host:
		return   # 鑱旀満鏁岃疆锛氬彧鏈夊鎴风鍙偣閫夛紙涓绘満绛夊緟锛?	if not enemy_pool.has(hero_id):
		return
	_pending_enemy_deploy = hero_id   # 涓嶄粠鍗℃睜鎵ｉ櫎锛屼繚鎸佸竷灞€涓嶅姩
	state = State.PLACE_DEPLOY
	# 楂樹寒鏁屾柟鍑虹敓鏍硷紙缁胯壊锛? 鎴戞柟鍑虹敓鍖猴紙钃濓級淇濈暀
	_show_enemy_deploy_zones(Color(0.2, 0.85, 0.5, 0.7))
	deploy_refresh.emit()
	action_info.emit("鐐瑰嚮鏁屾柟涓婇樀鐨勪綅缃紙缁胯壊鏍硷級銆?)

# 楂樹寒鏁屾柟鍑虹敓鍖猴紙鏁岃疆鏀句綅鎻愮ず锛涙垜鏂瑰嚭鐢熷尯淇濇寔娣¤摑锛?func _show_enemy_deploy_zones(enemy_color: Color) -> void:
	var pc := {}
	for c in _spawn_cells(DataRegistry.Faction.ENEMY):
		pc[c] = enemy_color
	for c in _spawn_cells(DataRegistry.Faction.PLAYER):
		pc[c] = Color(0.2, 0.6, 0.95, 0.45)
	_preview_cells = pc
	_apply_highlights()

func _try_place_deploy(cell: Vector2i) -> bool:
	if state != State.PLACE_DEPLOY or _pending_deploy == "":
		return false
	if not _in_spawn_cell(cell, DataRegistry.Faction.PLAYER):
		return false
	if occupancy.has(cell):
		return false
	var hid := _pending_deploy
	_pending_deploy = ""
	player_deployed.append(hid)
	player_pool.erase(hid)   # 涓婇樀鍚庢墠浠庡崱姹犳墸闄?	# 婕斿嚭鐧诲満
	var u := _spawn_unit(hid, DataRegistry.Faction.PLAYER, cell)
	u.modulate.a = 0.0
	u.scale = Vector2(0.2, 0.2)
	var t := create_tween()
	t.tween_property(u, "modulate:a", 1.0, 0.35)
	t.parallel().tween_property(u, "scale", Vector2.ONE, 0.35)
	AudioManager.play("select")
	# 鑱旀満锛氭妸杩欐閮ㄧ讲骞挎挱缁欏绔紙瀵圭涔?apply_deployment锛屼繚璇佷袱绔竴鑷达級
	if GameState.is_online and NetBus.is_online:
		NetBus.send_all(JSON.stringify({ "type": "deploy", "faction": DataRegistry.Faction.PLAYER, "hero": hid, "cell": [cell.x, cell.y] }))
	_deploy_after_pick()
	return true

# 鏁岃疆锛氬鎴风鍦ㄦ晫杞紙_deploy_side==1锛夋妸閫変腑鐨?enemy 鑻遍泟鏀惧埌鏁屾柟鍗婂満锛屽苟骞挎挱 ENEMY 閮ㄧ讲缁欎富鏈恒€?func _try_place_enemy_deploy(cell: Vector2i) -> bool:
	if state != State.PLACE_DEPLOY or _pending_enemy_deploy == "":
		return false
	if not _in_spawn_cell(cell, DataRegistry.Faction.ENEMY):
		return false
	if occupancy.has(cell):
		return false
	var hid := _pending_enemy_deploy
	_pending_enemy_deploy = ""
	enemy_deployed.append(hid)
	enemy_pool.erase(hid)
	var u := _spawn_unit(hid, DataRegistry.Faction.ENEMY, cell)
	u.modulate.a = 0.0
	u.scale = Vector2(0.2, 0.2)
	var t := create_tween()
	t.tween_property(u, "modulate:a", 1.0, 0.35)
	t.parallel().tween_property(u, "scale", Vector2.ONE, 0.35)
	AudioManager.play("select")
	if GameState.is_online and NetBus.is_online:
		NetBus.send_all(JSON.stringify({ "type": "deploy", "faction": DataRegistry.Faction.ENEMY, "hero": hid, "cell": [cell.x, cell.y] }))
	_deploy_after_pick()
	return true

# 鑱旀満閮ㄧ讲鍚屾锛氱綉缁滄敹鍒板鏂?閮ㄧ讲鏌愬崟浣?鏃惰皟鐢紝鍦ㄦ湰绔搴旈樀钀ユ斁缃紙faction/hero/cell锛夈€?# 涓绘満/瀹㈡埛绔弻鏂瑰悇閮ㄧ讲鑷繁鍗婂満锛屾渶缁堜富鏈烘眹鎬诲箍鎾?-> 寮€鎴樸€?func apply_deployment(faction: int, hero_id: String, cell: Vector2i) -> void:
	if not grid.in_bounds(cell) or occupancy.has(cell):
		return
	var u := _spawn_unit(hero_id, faction, cell)
	u.modulate.a = 0.0
	u.scale = Vector2(0.2, 0.2)
	var t := create_tween()
	t.tween_property(u, "modulate:a", 1.0, 0.35)
	t.parallel().tween_property(u, "scale", Vector2.ONE, 0.35)
	# 璁板綍閮ㄧ讲鐘舵€侊紙渚涚粺璁?鏀跺熬锛夆€斺€旂敤鍚屼竴涓?deployed 鍒楄〃
	if faction == DataRegistry.Faction.PLAYER:
		player_deployed.append(hero_id)
		player_pool.erase(hero_id)   # 涓庡彂璧风 _try_place_deploy 涓€鑷达細涓婇樀鍚庝粠鍗℃睜鎵ｉ櫎锛堜繚璇佷袱绔?roster 涓€鑷达級
	else:
		enemy_deployed.append(hero_id)
		enemy_pool.erase(hero_id)

func _on_deploy_pick_again(hero_id: String) -> void:
	if state != State.PLACE_DEPLOY or _pending_deploy == "":
		return
	if hero_id == _pending_deploy:
		# 鍙嶆倲锛氬彇娑堝綋鍓嶉€変腑锛堣嫳闆勪粛鍦ㄥ崱姹狅紝浣嶇疆涓嶅姩锛?_pending_deploy = ""
	elif player_pool.has(hero_id):
		# 鍒囨崲锛氭敼閫夊彟涓€鍚?_pending_deploy = hero_id
		state = State.PLACE_DEPLOY
		_show_deploy_spawn_hint()
		deploy_refresh.emit()
		return
	else:
		return
	# 鍥炲埌閫変汉鐘舵€侊紙鍙栨秷褰撳墠閫変腑锛?	state = State.DEPLOY
	# 鎭㈠鍙屾柟鍑虹敓鍖烘彁绀猴紙鎴戞柟钃?+ 鏁屾柟绾級锛屼笌寮€灞€涓€鑷?	_show_deploy_zones(Color(0.2, 0.6, 0.95, 0.55))
	deploy_refresh.emit()
	action_info.emit("璇风偣閫夎涓婇樀鐨勮嫳闆勶紙鍐嶆鐐瑰嚮鍙弽鎮旓級銆?)

# 鑱旀満鏁岃疆锛氬鎴风鏀句綅闃舵鍐嶆鐐规晫鏂硅嫳闆勫彲鍙嶆倲/鍒囨崲
func _on_enemy_deploy_pick_again(hero_id: String) -> void:
	if state != State.PLACE_DEPLOY or _pending_enemy_deploy == "":
		return
	if GameState.is_online and GameState.is_host:
		return
	if hero_id == _pending_enemy_deploy:
		# 鍙嶆倲锛氬彇娑堝綋鍓嶉€変腑锛堣嫳闆勪粛鍦ㄥ崱姹狅紝浣嶇疆涓嶅姩锛?_pending_enemy_deploy = ""
	elif enemy_pool.has(hero_id):
		# 鍒囨崲锛氭敼閫夊彟涓€鍚?_pending_enemy_deploy = hero_id
		state = State.PLACE_DEPLOY
		_show_enemy_deploy_zones(Color(0.2, 0.85, 0.5, 0.7))
		deploy_refresh.emit()
		return
	else:
		return
	# 鍥炲埌閫変汉鐘舵€侊紙鍙栨秷褰撳墠閫変腑锛?	state = State.DEPLOY
	_show_deploy_zones(Color(0.2, 0.6, 0.95, 0.55))
	deploy_refresh.emit()
	action_info.emit("璇风偣閫夎涓婇樀鐨勮嫳闆勶紙鍐嶆鐐瑰嚮鍙弽鎮旓級銆?)

# 楂樹寒鎴戞柟鍑虹敓鏍硷紙鏀句綅鎻愮ず锛?func _show_deploy_spawn_hint() -> void:
	_show_deploy_zones(Color(0.2, 0.85, 0.5, 0.7))
	action_info.emit("鐐瑰嚮鎴戞柟鑳戒笂闃电殑浣嶇疆锛堢豢鑹叉牸锛夈€?)

# 楂樹寒鍙屾柟鍑虹敓鍖猴細鎴戞柟鐢?player_color锛屾晫鏂瑰嚭鐢熷尯鍥哄畾绾㈣壊锛堥儴缃插叏绋嬩繚鐣欙紝鏀句綅闃舵涓嶆秷澶憋級
func _show_deploy_zones(player_color: Color) -> void:
	var pc := {}
	for c in _spawn_cells(DataRegistry.Faction.PLAYER):
		pc[c] = player_color
	for c in _spawn_cells(DataRegistry.Faction.ENEMY):
		pc[c] = Color(0.95, 0.35, 0.3, 0.5)   # 鏁屾柟鍑虹敓鍖虹孩鑹?	_preview_cells = pc
	_apply_highlights()

# 鏈鐪熶汉鎿嶄綔鐨勯儴缃茶疆鍒ゅ畾锛氳杞渶瑕佹湰绔湡浜轰笂浜猴紙鍚凡鐐硅嫳闆勫緟鏀句綅锛夈€?# 鍗曟満=鐜╁杞?_deploy_side==0)锛涜仈鏈?鏈瀵瑰簲鍗婂満杞紙涓绘満=鐜╁杞?0锛屽鎴风=鏁岃疆/1锛夈€?func _my_deploy_turn() -> bool:
	if state != State.DEPLOY and state != State.PLACE_DEPLOY:
		return false
	if not GameState.is_online:
		return _deploy_side == 0 and player_deployed.size() < DEPLOY_COUNT_BATTLE
	if GameState.is_host:
		return _deploy_side == 0 and player_deployed.size() < DEPLOY_COUNT_BATTLE
	return _deploy_side == 1 and enemy_deployed.size() < DEPLOY_COUNT_BATTLE

# 杞鍒囨崲/寮€灞€鏃跺悓姝ラ儴缃茶鏃讹細鏈鍏ㄩ儴閫変汉鍏变韩涓€涓€婚绠楋紙30s锛屼笉鎸夎疆閲嶇疆锛夈€?# 棰勭畻鑰楀敖鍚庯細涓嶅啀璇荤锛涗箣鍚庢瘡娆¤疆鍒拌嚜宸变笂浜猴紝鐩存帴鑷姩闅忔満琛?1 浜猴紙浠嶄竴杞竴涓€佸弻鏂硅疆娴侊級銆?func _sync_deploy_timer() -> void:
	if _my_deploy_turn():
		deploy_budget_active = true
		if deploy_budget_left <= 0.0:
			deploy_budget_active = false
			_auto_deploy_random()
	else:
		deploy_budget_active = false

# 棰勭畻鑰楀敖鐨勮嚜鍔ㄤ笂浜猴細浠庢湰绔墿浣欏崱姹?*闅忔満**鎸戜竴鍚嶆湭涓婇樀鑻遍泟鏀惧埌绌烘牸锛堟椂闂寸粨鏉熼殢鏈轰笂浜猴級銆?# 宸查€変腑鑻遍泟寰呮斁浣嶅垯鍏堟妸璇ヨ嫳闆勬斁鍒扮┖鏍硷紱姣忔鍙笂涓€浜猴紝鍥炲悎杞崲鍚庣户缁ˉ浣嶇洿鑷充笂婊°€?func _auto_deploy_random() -> void:
	if not _my_deploy_turn():
		return
	var fn := _my_faction()
	var cell := _free_spawn_cell(fn)
	if state == State.PLACE_DEPLOY:
		var sel := _pending_deploy if fn == DataRegistry.Faction.PLAYER else _pending_enemy_deploy
		if sel != "" and cell.x != -99:
			if fn == DataRegistry.Faction.PLAYER:
				_try_place_deploy(cell)
			else:
				_try_place_enemy_deploy(cell)
			return
		_pending_deploy = ""
		_pending_enemy_deploy = ""
		state = State.DEPLOY
	var pool: Array = player_pool if fn == DataRegistry.Faction.PLAYER else enemy_pool
	if pool.size() == 0:
		return
	var hid: String = pool[rng.randi_range(0, pool.size() - 1)]
	if fn == DataRegistry.Faction.PLAYER:
		_pending_deploy = hid
	else:
		_pending_enemy_deploy = hid
	state = State.PLACE_DEPLOY
	if cell.x != -99:
		if fn == DataRegistry.Faction.PLAYER:
			_try_place_deploy(cell)
		else:
			_try_place_enemy_deploy(cell)

func _enemy_deploy() -> void:
	if state != State.DEPLOY or _deploy_side != 1:
		return
	if enemy_pool.size() > 0 and enemy_deployed.size() < DEPLOY_COUNT_BATTLE:
		# 涓婁汉绛栫暐锛氫粠鍗℃睜鎸戜竴鍚?涓庡凡涓婂満鏁屼汉閰嶅悎鏈€濂?鐨勮嫳闆勪綔涓洪鍙戯紝
		# 鑰屼笉鏄畝鍗曟寜椤哄簭 pop_front 鈥斺€?淇濊瘉棣栧彂闃靛鏈哄埗鍗忓悓銆?var best_i := -1
		var best_sc := -1e9
		for i in enemy_pool.size():
			var cand: String = enemy_pool[i]
			# 棣栧彂浼樺厛锛氬甫 <鏇胯ˉ> 鏍囩鐨勮嫳闆勪笉涓诲姩棣栧彂锛堟妧鑳芥浛琛ョ櫥鍦烘墠瑙﹀彂锛岄鍙戞氮璐癸級
			var cd: DataRegistry.HeroDef = DataRegistry.get_hero(cand)
			if cd != null and cd.skills.has(DataRegistry.Skill.BENCH):
				continue
			var sc := _hero_strength(cand) + _deck_synergy(enemy_deployed, cand)
			if sc > best_sc:
				best_sc = sc
				best_i = i
		# 鑻ュ叏閮ㄥ崱姹犻兘鏄浛琛ュ瀷锛坆est_i 鏃犺В锛夛紝閫€鑰岄€夊崗鍚屾渶楂樼殑浠绘剰涓€鍚?if best_i < 0:
			best_i = 0
			var bs := -1e9
			for i in enemy_pool.size():
				var sc2 := _hero_strength(enemy_pool[i])
				if sc2 > bs:
					bs = sc2
					best_i = i
		var hid: String = enemy_pool[best_i]
		enemy_pool.remove_at(best_i)
		enemy_deployed.append(hid)
		var cell := _free_spawn_cell(DataRegistry.Faction.ENEMY)
		if cell.x != -99 and cell.y != -99:
			_deploy_spawn_at(DataRegistry.Faction.ENEMY, hid, cell)
		_deploy_after_pick()

func _deploy_spawn_at(faction: int, hero_id: String, cell: Vector2i) -> void:
	var u := _spawn_unit(hero_id, faction, cell)
	u.modulate.a = 0.0
	u.scale = Vector2(0.2, 0.2)
	var t := create_tween()
	t.tween_property(u, "modulate:a", 1.0, 0.35)
	t.parallel().tween_property(u, "scale", Vector2.ONE, 0.35)

func _deploy_after_pick() -> void:
	state = State.DEPLOY   # 涓€娆℃斁缃畬鎴愶紝鍥炲埌"缁х画閫変汉"妯″紡
	if player_deployed.size() >= DEPLOY_COUNT_BATTLE and enemy_deployed.size() >= DEPLOY_COUNT_BATTLE:
		_begin_after_deploy()
		return
	if _deploy_side == 0:
		_deploy_side = 1
		if not GameState.is_online:
			_enemy_deploy.call_deferred()
		else:
			# 鑱旀満锛氭晫杞疆鍒板绔紙瀹㈡埛绔級鐪熶汉閫変汉锛屾湰绔瓑寰?action_info.emit("绛夊緟瀵规柟閫変汉鈥︹€? if GameState.is_host else "杞埌浣狅紙鏁屾柟锛夐€変汉锛氱偣閫変笅鏂硅嫳闆勩€?)
	else:
		_deploy_side = 0
	deploy_refresh.emit()
	_sync_deploy_timer()   # 鍒囨崲鍚庣殑鏂拌疆鎸?鏄惁鏈鐪熶汉杞?鍐冲畾鏄惁闄愭椂

func _begin_after_deploy() -> void:
	# 鍏朵綑杩涘叆鏇胯ˉ甯?	player_roster = player_pool.duplicate()
	enemy_roster = enemy_pool.duplicate()
	player_dead = 0
	enemy_dead = 0
	_preview_cells = {}
	_apply_highlights()
	log_message.emit("閮ㄧ讲瀹屾垚锛屽鎴樺紑濮嬶紒")
	state = State.IDLE
	_start_match()
	deploy_refresh.emit()   # 閫氱煡 HUD 鏀惰捣閮ㄧ讲鐣岄潰
	_notify_team()          # 閫氱煡 HUD 鏄剧ず涓嬫柟闃熶紞鍗＄粍

func _setup_hud() -> void:
	var hud := HUD.new()
	hud.bind(self)
	add_child(hud)

# ---- 妫嬬洏甯冨眬灞呬腑锛堟寜瀹為檯鏍煎瓙鍍忕礌鑼冨洿璁＄畻锛屽吋瀹瑰钩椤跺竷灞€锛?----
func _board_origin() -> Vector2:
	var vsize := get_viewport().get_visible_rect().size
	var minx := INF
	var miny := INF
	var maxx := -INF
	var maxy := -INF
	# 鐢ㄦ湭缈昏浆鐨勫師濮嬪嚑浣曠畻鍖呭洿鐩掑苟灞呬腑锛堢炕杞槸缁曡鍖呭洿鐩掍腑蹇冩棆杞?180掳锛屼笉鏀瑰彉鍖呭洿鐩掞紝
	# 鍥犳 origin 鍦ㄧ炕/涓嶇炕涓嬩竴鑷达紝妫嬬洏淇濇寔灞呬腑涓嶆紓绉伙級銆?	for cell in grid.all_cells():
		var p := grid._raw_cell_to_world(cell)
		minx = min(minx, p.x)
		miny = min(miny, p.y)
		maxx = max(maxx, p.x)
		maxy = max(maxy, p.y)
	var bw := (maxx - minx) + 2.0 * hex_size
	# 姘村钩灞呬腑锛岄《閮ㄨ窛灞忓箷椤?90px
	return Vector2((vsize.x - bw) / 2.0 - minx + hex_size, 90.0 - miny + hex_size)

# ---- 寮€灞€鏀剧疆锛氬墠 3 鍚嶄笂闃碉紝鍏朵綑杩涙浛琛ュ腑 ----
func _place_units() -> void:
	player_roster = []
	enemy_roster = []
	# 鑻ユ祴璇曞満鏅彁渚涗簡鑷敱鏀剧疆锛屽垯鎸夋寚瀹氭牸鐩存帴鏀剧疆
	if GameState.player_placement.size() > 0 or GameState.enemy_placement.size() > 0:
		for cell in GameState.player_placement.keys():
			if grid.in_bounds(cell):   # 闃插尽锛氳烦杩囪秺鐣屾牸锛堟鐩樺昂瀵镐笉涓€鑷存椂閬垮厤寮€灞€澶辫触/鍗′綇锛?_spawn_unit(GameState.player_placement[cell], DataRegistry.Faction.PLAYER, cell)
		for cell in GameState.enemy_placement.keys():
			if grid.in_bounds(cell):
				_spawn_unit(GameState.enemy_placement[cell], DataRegistry.Faction.ENEMY, cell)
		_place_obstacles()
		log_message.emit("宸叉寜鑷敱閮ㄧ讲鏀剧疆鍙屾柟鍗曚綅銆?)
		return
	var p_deck := GameState.player_deck
	var e_deck := GameState.enemy_deck
	if p_deck.size() == 0:
		p_deck = _default_deck()
	if e_deck.size() == 0:
		e_deck = _default_deck()
	player_roster = []
	enemy_roster = []
	# 鐜╁鍦ㄤ笅鏂规渶鍚庝竴琛岋紱鏁屾柟鍦ㄩ《閮ㄥ嚭鐢熷尯锛堥《甯借 + 鏈€涓婇潰涓€鎺掓弧琛岋級
	var player_cells := [Vector2i(1, grid.height - 1), Vector2i(3, grid.height - 1), Vector2i(5, grid.height - 1)]
	# 鍓?3 鍚嶄笂闃碉紙鏁屾柟鐢?_free_spawn_cell 鍦ㄥ畬鏁村嚭鐢熷尯渚濇钀戒綅锛?	for i in range(DEPLOY_COUNT):
		if i < p_deck.size():
			_spawn_unit(p_deck[i], DataRegistry.Faction.PLAYER, player_cells[i])
		if i < e_deck.size():
			var ec := _free_spawn_cell(DataRegistry.Faction.ENEMY)
			if ec.x != -99 and ec.y != -99:
				_spawn_unit(e_deck[i], DataRegistry.Faction.ENEMY, ec)
	# 鍏朵綑杩涙浛琛ュ腑
	for i in range(DEPLOY_COUNT, p_deck.size()):
		player_roster.append(p_deck[i])
	for i in range(DEPLOY_COUNT, e_deck.size()):
		enemy_roster.append(e_deck[i])
	_place_obstacles()
	log_message.emit("鍙屾柟鍚勪笂闃?3 鍚嶈嫳闆勶紝鍙︽湁 %d / %d 鍚嶆浛琛ュ緟鍛姐€? % [player_roster.size(), enemy_roster.size()])

const OBSTACLE_DUR := 3
func _place_obstacles() -> void:
	# 鍙湪鎸囧畾鍧愭爣鐢熸垚锛堝垪浠庡乏鏁?col-1锛岃浠庝笅鏁?height-琛岋紝height=10锛?	var spots := [
		Vector2i(0, 5), Vector2i(1, 5), Vector2i(1, 4), Vector2i(2, 5), Vector2i(3, 5),
		Vector2i(3, 4), Vector2i(4, 5), Vector2i(5, 5), Vector2i(5, 4), Vector2i(6, 5),
	]
	_rng_shuffle(spots)
	var count := rng.randi_range(2, 4)
	var placed := 0
	for s in spots:
		if placed >= count:
			break
		if grid.in_bounds(s) and not occupancy.has(s) and not bombs.has(s) and not obstacles.has(s):
			obstacles[s] = OBSTACLE_DUR
			placed += 1
	_refresh_board()   # 鏂伴殰纰嶇粯鍒朵笂灞忥紙閲嶅紑绔炴妧鍦烘椂鏃ч殰纰嶅凡闅?reset 娓呯┖锛屾澶勫悓姝ユ樉绀烘柊闅滅锛?
func _damage_obstacle(cell: Vector2i, amt: int) -> void:
	if not obstacles.has(cell):
		return
	var left: int = obstacles[cell] - amt
	if left <= 0:
		obstacles.erase(cell)
		log_message.emit("闅滅鐗╄鎽ф瘉锛?)
	else:
		obstacles[cell] = left
	if board_view:
		board_view.obstacles = obstacles
		board_view.queue_redraw()

# 鍦ｈ癁鑰佷汉锛氬湪绌哄湴闅忔満鏀剧疆 n 涓鐩婇亾鍏凤紙"heal"/"atk"/"move"/"shield"锛?func _place_buff_items(u: Unit, n: int) -> void:
	var spots: Array = []
	for cell in grid.all_cells():
		if not occupancy.has(cell) and not obstacles.has(cell) and not bombs.has(cell) and not buff_items.has(cell):
			spots.append(cell)
	_rng_shuffle(spots)
	var types: Array = ["heal", "atk", "move", "shield"]   # 鍦ｈ癁鑰佷汉鐨勫洓绉嶇ぜ鐗?	var placed := 0
	while placed < n and spots.size() > 0:
		var c: Vector2i = spots.pop_back()
		buff_items[c] = types[rng.randi() % types.size()]
		placed += 1
	if placed > 0:
		log_message.emit("%s 鍦ㄧ┖鍦版斁缃簡 %d 涓鐩婇亾鍏枫€? % [u.display_name, placed])
		_refresh_board()

# 閬撳叿浣滅敤璇存槑锛堝彸閿煡鐪?鎷惧彇鐢級
func item_desc(type: String) -> String:
	match type:
		"heal":
			return "鎭㈠ 3 鐐硅閲?
		"atk":
			return "鏀诲嚮鍔?+1"
		"move":
			return "绉诲姩鍔?+1"
		"shield":
			return "鑾峰緱[鍦ｇ浘]锛氭姷鎸′竴娆″彈鍒扮殑浼ゅ"
		"gold":
			return "鏀诲嚮+1銆佽閲忎笂闄?3"
	return "澧炵泭閬撳叿"

# 榛勯噾鐭垮伐锛氬湪闅忔満绌哄湴鏀剧疆涓€鏋氶噾鐭匡紙buff_items 鐨?"gold" 绫诲瀷锛?func _place_gold(u: Unit) -> void:
	var spots: Array = []
	for cell in grid.all_cells():
		if not occupancy.has(cell) and not obstacles.has(cell) and not bombs.has(cell) and not buff_items.has(cell):
			spots.append(cell)
	if spots.size() == 0:
		return
	var c: Vector2i = spots[rng.randi() % spots.size()]
	buff_items[c] = "gold"
	log_message.emit("%s 鍦?%s 涓笅涓€鍧楅噾鐭裤€? % [u.display_name, str(c)])
	_refresh_board()

func _refresh_board() -> void:
	if board_view:
		board_view.obstacles = obstacles
		board_view.bombs = bombs
		board_view.buff_items = buff_items
		board_view.graves = graves
		board_view.queue_redraw()

func _spawn_unit(hero_id: String, faction: int, cell: Vector2i) -> Unit:
	var def := DataRegistry.get_hero(hero_id)
	var u := Unit.new(def, faction, cell, hex_size * 0.9)
	# 鎶€鑳斤細鐤捐 -> 绉诲姩鍔?+1
	if def.skills.has(DataRegistry.Skill.SWIFT):
		u.move_range += 1
	# 缁欏崟浣嶆寕涓婂搴旇嫳闆勭殑琛屼负鑴氭湰锛堟暟鍊间慨姝?鎶€鑳介€昏緫锛夛紝骞惰皟鐢ㄥ嚭鐢熼挬瀛?	u.behavior = HeroRegistry.create(hero_id)
	u.behavior.setup(self, u)
	u.behavior.on_spawn()
	u.position = board_view.cell_world_center(cell)
	u.hp_changed.connect(_on_unit_hp_changed)
	u.damaged.connect(_on_unit_damaged)
	u.died.connect(_on_unit_died)
	add_child(u)
	units.append(u)
	occupancy[cell] = u
	_sync_ranged_adjacent()   # 鏂板崟浣嶄笂鍦猴細鍒锋柊鍏?杩滅▼琚创韬?鐘舵€?	return u

func _start_match() -> void:
	log_message.emit("瀵瑰眬寮€濮嬶紒浣犵巼 3 鍚嶈嫳闆勮繋鎴樻晫鎵嬨€?)
	GameState.start_match(_first_side)
	if GameState.is_online:
		if GameState.is_host:
			# 鑱旀満锛氬紑灞€棣栧洖鍚堢敱涓绘満鏉冨▉鍏竷锛堜笌鍚庣画鍥炲悎涓€鑷达紝璧?begin_side 骞挎挱锛夈€?			# 鍚﹀垯瀹㈡埛绔嫢鎸夋湰鍦扮粨鏋滆嚜琛屽紑棣栧洖鍚堬紝鍙兘涓庝富鏈哄垽瀹氫笉涓€鑷达紝
			# 瀵艰嚧"鍏堟墜鎻愮ず鍐欐垜鏂广€佺姸鎬佹爮鍗存槸鏁屾柟鍥炲悎"銆?NetBus.send_all(JSON.stringify({ "type": "begin_side", "side": _first_side, "round": GameState.round_number }))
			_begin_side(_first_side)
		# 瀹㈡埛绔細涓嶆湰鍦版帹杩涘紑灞€棣栧洖鍚堬紝绛変富鏈虹殑 begin_side 骞挎挱缁熶竴琛屽姩鏂?return
	# 鍗曟満锛氬厛閫変汉鏂瑰厛琛屽姩锛堜笌閮ㄧ讲闃舵鐨勯€変汉椤哄簭涓€鑷达級
	_begin_side(_first_side)

# ---- 鍥炲悎璋冨害 ----
func _begin_side(side: int) -> void:
	if GameState.match_over:
		return   # 瀵瑰眬宸茬粨鏉燂紙濡傜儳姝诲垽璐燂級锛氫笉鍐嶅紑鏂板洖鍚?鏇胯ˉ鐣岄潰
	_ending_side = false   # 鏂板洖鍚堝紑濮嬶細瑙ｉ櫎"鍥炲悎鏈?鏍囪锛堝惈瀹㈡柟鎻愪氦缁撴潫鍚庣殑绛夊緟绐楀彛锛?	AudioManager.play("turn")
	_turn_expired = false   # 鏂板洖鍚堝紑濮嬶細娓呴櫎涓婁釜鍥炲悎鐨勮秴鏃跺緟鎻愪氦鏍囪
	state = State.ANIMATING   # 鍥炲悎寮€濮嬫妧鑳介€愪釜婕斿嚭鏈熼棿閿佸畾杈撳叆
	_clear_selection()       # 鍒囧洖鍚堬細娓呴櫎涓婂洖鍚堥€変腑鍗曚綅鍙婄Щ鍔?鏀诲嚮鑼冨洿楂樹寒锛堝惈瀹㈡埛绔敹鍒?begin_side 璺緞锛?	for u in units:
		u.reset_for_new_turn()
	# 鍙ょ伒绮炬€細鍙樿韩鍚庣殑鑻遍泟鍦ㄦ湰鏂瑰洖鍚堝紑濮嬫椂杩樺師涓烘湰婧愬苟閲嶆柊鍙樿韩銆?	# 鍙噸缃?鍗冲皢寮€濮嬪洖鍚堢殑杩欎竴鏂?鈥斺€斿彉韬悗鐨勫舰鎬佸簲淇濇寔鍒颁笅涓€娆″彉鍖?	# 锛堝鏂瑰洖鍚堢粨鏉?鏈柟鍥炲悎寮€濮嬶級锛岃€屼笉鏄湪鎴戞柟鍥炲悎缁撴潫鏃剁珛鍒绘墦鍥炲師褰€?	# 蹇呴』杩炲悓琛屼负鑴氭湰/鎶€鑳?鏁板€?鍚嶇О涓€璧疯繕鍘燂細鑻ュ彧杩樺師 hero_id锛?	# 琛屼负鑴氭湰浠嶆槸涓婁竴鍙樿韩鐨勮嫳闆勶紙渚嬪椋庤鑰咃級锛屼笅涓€鍥炲悎鍥炲悎寮€濮嬫妧鑳?	# 灏变笉浼氬啀瑙﹀彂 _transform锛屼笖椋庤鑰呭厜鐜寜 hero_id 鐨勫垽瀹氬叏閮ㄥけ鏁堛€?	var side_fn := side_faction(side)
	for u in units:
		if u.alive and u.transform_base_id != "" and u.faction == side_fn:
			u.hero_id = u.transform_base_id
			_apply_base_hero(u, u.transform_base_id)
			u._update_name_label()
			u._update_tags_label()
			u.refresh_stats()
	_sync_ranged_adjacent()   # 鍥炲悎鍒囨崲锛氭晫鏂圭Щ鍔?鎹綅鍚庡埛鏂拌繙绋嬭璐磋韩鐘舵€?	_tick_statuses(side)   # 鐚涙瘨绛夛細鍥炲悎寮€濮嬬粨绠?	await _trigger_turn_start_all(side)   # 鍥炲悎寮€濮嬬殑瑙掕壊鎶€鑳斤紙閫愪釜瑙﹀彂+杈规闂儊锛?	# 璁╁洖鍚堝紑濮嬪鐩婂湪鐗岄潰涓婂彲瑙?	for u in units:
		if u.alive and u.faction == side_faction(side):
			u.refresh_stats()
	# 鏈鏄惁鎿嶄綔杩欎竴鏂癸細鏄垜鏂瑰洖鍚?-> 杩涘叆鎴戞柟杈撳叆锛涘惁鍒欙紙瀵规柟鍥炲悎锛夌瓑寰?AI銆?	if side == _my_side():
		# 鎴戞柟鍥炲悎
		turn_time_left = TURN_TIME_LIMIT   # 寮€濮嬫湰绔洖鍚堥檺鏃?peer_turn_time_left = 0.0
		_time_sync_acc = 0.0
		if GameState.is_online:
			_send_turn_time_left()   # 绔嬪嵆鍚屾缁欏绔紙瀵规柟绛夊緟鐣岄潰鏄剧ず鍓╀綑鏃堕棿锛?if _pending_player_subs > 0 and _my_roster().size() > 0:
			_try_begin_next_sub()
			return
		state = State.PLAYER_INPUT
		action_info.emit("浣犵殑鍥炲悎锛堢 %d 鍥炲悎锛夛細鐐瑰嚮涓€鍚嶅繁鏂硅嫳闆勩€? % GameState.round_number)
		# 涓嶈嚜鍔ㄩ€変腑锛岀敱鐜╁鐐瑰嚮閫夋嫨
	else:
		# 鏁屾柟鍥炲悎锛氫笉鍦ㄦ湰绔搷浣滐紝娓呴浂璁℃椂锛堢瓑寰呭绔湡浜鸿鍔ㄦ椂鏄剧ず瀵圭鍓╀綑锛?turn_time_left = 0.0
		# 绛夊緟绔垵鍊?= 婊￠锛氳鍔ㄦ柟姝ゅ埢涔熷湪寮€濮嬭嚜宸辩殑 90 绉掕鏃讹紝
		# 鍏堜互婊￠鏈湴閫掑噺锛堝洖鍚堝垏鎹㈡紨鍑烘湡闂村鏂瑰箍鎾湭杈句篃涓嶆秷澶憋級锛岄殢鍚庤骞挎挱鏍″噯銆?if GameState.is_online:
			peer_turn_time_left = TURN_TIME_LIMIT
