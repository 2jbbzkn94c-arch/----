# 閫?姝ゅ埢鏈€鍚堥€?鐨勬晫鏂规浛琛ワ細鎸夊綋鍓嶆垬灞€闇€姹傜粰鍊欓€夋墦鍒嗭紝鍙栦唬鎸夊崱缁勯『搴忕‖椤躲€?# 闇€姹備緷鎹細缂哄墠鎺?鍢茶)浼樺厛琛ュ潶鍏嬶紱澶氫汉璐熶激鏃朵紭鍏堟敮鎻?鍏夌幆锛涜緭鍑哄亸灏戞椂浼樺厛杩滅▼锛?# 杩滅▼/鍢茶鍏奸【姝ｉ潰鎴樺姏锛涙浛琛ユ爣绛捐嫳闆勭櫥鍦烘湰灏辫兘瑙﹀彂鎶€鑳斤紝灏忓姞鍒嗐€?func _best_enemy_sub_idx() -> int:
	var best_i := 0
	var best_s := -1e18
	var has_taunt := false
	var wounded := 0
	var live_melee := 0   # 瀛樻椿涓旇兘涓婂墠绾跨殑鏁屾柟鍗曚綅鏁帮紙杩戞垬鎴栧槻璁斤級
	for u in units:
		if u == null or not is_instance_valid(u) or not u.alive:
