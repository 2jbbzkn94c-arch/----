			# 鑱旀満锛氭晫鏂规槸鐪熶汉锛屼笉璺?AI锛岀瓑寰呭绔湡浜哄彂鎸囦护
			action_info.emit("绛夊緟瀵规柟琛屽姩鈥︹€?)
			enemy_turn_waiting.emit()
		else:
			action_info.emit("鏁屾柟鍥炲悎鈥︹€?)
			_run_enemy_turn.call_deferred()

# 鍥炲悎寮€濮嬫椂缁撶畻姘镐箙/鎸佺画鐘舵€?func _tick_statuses(faction: int) -> void:
	for u in units:
		if u == null or not is_instance_valid(u):
			continue
		if u.alive and u.faction == faction and u.has_status("poison"):
			log_message.emit("%s 鍙楀埌[鐚涙瘨] 1 鐐逛激瀹炽€? % u.display_name)
			u.take_damage(1, true)   # 鐚涙瘨鏃犳潯浠朵激瀹?
func side_faction(side: int) -> int:
	return DataRegistry.Faction.PLAYER if side == GameState.SIDE_PLAYER else DataRegistry.Faction.ENEMY

# ---- 瑙嗚杈呭姪锛堣仈鏈猴細涓绘満=鐜╁鏂?钃濓紝瀹㈡埛绔?鏁屾柟/绾紱鍗曟満=鐜╁鏂癸級----
# 鏈浜虹被鎿嶄綔鐨勬槸鍝竴鏂广€?func _my_faction() -> int:
	if GameState.is_online and not GameState.is_host:
		return DataRegistry.Faction.ENEMY
	return DataRegistry.Faction.PLAYER

func _my_side() -> int:
	return GameState.SIDE_ENEMY if _my_faction() == DataRegistry.Faction.ENEMY else GameState.SIDE_PLAYER

func _opp_side() -> int:
	return GameState.SIDE_ENEMY if _my_side() == GameState.SIDE_PLAYER else GameState.SIDE_PLAYER

# 瀵规柟锛堟湰绔湅鍒拌鎵撹触鐨勯偅涓€鏂癸級銆?func _opp_faction() -> int:
	return DataRegistry.Faction.ENEMY if _my_faction() == DataRegistry.Faction.PLAYER else DataRegistry.Faction.PLAYER

# 鑳滆礋鍒ゅ畾鐢ㄨ瑙掑寲鐨勯樀浜¤鏁帮細鏈"鎴戞柟"闃典骸 / "瀵规柟"闃典骸銆?func _my_dead() -> int:
	return player_dead if _my_faction() == DataRegistry.Faction.PLAYER else enemy_dead

func _opp_dead() -> int:
	return enemy_dead if _my_faction() == DataRegistry.Faction.PLAYER else player_dead

# 鏈"鎴戞柟"鏇胯ˉ甯?/ "瀵规柟"鏇胯ˉ甯?/ 鎸囧畾闃佃惀鏇胯ˉ甯€?func _my_roster() -> Array:
	return player_roster if _my_faction() == DataRegistry.Faction.PLAYER else enemy_roster

func _opp_roster() -> Array:
	return enemy_roster if _my_faction() == DataRegistry.Faction.PLAYER else player_roster

func _roster_of(fn: int) -> Array:
	return player_roster if fn == DataRegistry.Faction.PLAYER else enemy_roster

# 褰撳墠鏇胯ˉ鎿嶄綔瀵瑰簲鐨勬浛琛ュ腑锛圚UD 閫変汉闈㈡澘鐢級銆?func _sub_roster() -> Array:
	return _roster_of(_sub_faction)

# 鍥炲悎寮€濮嬶細璇ラ樀钀ュ崟浣嶇殑鍥炲悎寮€濮嬫妧鑳斤紙閫愪釜瑙﹀彂锛屽甫瑙﹀彂杈规闂儊锛?func _trigger_turn_start_all(faction: int) -> void:
	# 閬嶅巻蹇収锛氳Е鍙戜腑鍙兘鏉€姝?绉婚櫎鍗曚綅锛岄伩鍏嶆姽闄ゅ厓绱犲鑷存紡澶勭悊
	for u in units.duplicate():
		if u == null or not is_instance_valid(u):
			continue
		if u.alive and u.faction == faction:
			if _trigger_turn_start(u):
				u.flash_passive()
				if get_tree() == null:
					return   # 鍦烘櫙宸查噴鏀撅紙鐐瑰嚮閲嶅紑/reload锛夛細瀹夊叏閫€鍑猴紝閬垮厤璁块棶 null get_tree()
				await get_tree().create_timer(0.35).timeout

# 鍥炲悎缁撴潫锛氳闃佃惀鍗曚綅鐨勫洖鍚堢粨鏉熸妧鑳斤紙閫愪釜瑙﹀彂锛屽甫瑙﹀彂杈规闂儊锛?func _trigger_turn_end_all(faction: int) -> void:
	# 閬嶅巻蹇収锛氳Е鍙戜腑鍙兘鏉€姝诲崟浣嶏紙濡傞楂呭叺娑堟暎锛夛紝閬垮厤鎶归櫎鍏冪礌瀵艰嚧婕忓鐞?	for u in units.duplicate():
		if u == null or not is_instance_valid(u):
			continue
		if u.alive and u.faction == faction:
			if _trigger_turn_end(u):
				u.flash_passive()
				if get_tree() == null:
					return   # 鍦烘櫙宸查噴鏀撅細瀹夊叏閫€鍑?await get_tree().create_timer(0.35).timeout

# 宸辨柟鍥炲悎缁撴潫鏃惰В闄や复鏃剁姸鎬?func _clear_statuses(faction: int) -> void:
	for u in units:
		if u == null or not is_instance_valid(u):
			continue
		if u.alive and u.faction == faction:
			u.clear_temp_statuses()
			u.atk_buff = 0
			u.move_buff = 0
			u.ramble_bonus = 0
			u.branch_override = false
			u.refresh_stats()

# 瀵规寚瀹氶樀钀ョ殑瀛樻椿鑻遍泟缁熶竴鎵ｈ锛堝洖鍚堢粨鏉熶激瀹筹紝鍙墸璇ユ柟锛夈€?# 鍗曟満锛氱洿鎺ユ湰鍦版墸锛涜仈鏈轰富鏈猴細鏈湴鎵ｅ悗骞挎挱璁╁鎴风瀵瑰悓闃佃惀閲嶆紨锛堜繚鎸佷袱绔閲忎竴鑷达級銆?func _apply_round_damage_to(faction: int, amount: int) -> void:
	for u in units:
		if u.alive and u.faction == faction:
			u.take_damage(amount)

# 鏌愭柟锛坰ide锛夎鍔ㄥ洖鍚堢粨鏉熸椂鐨勮秴鍥炲悎鎵ｈ缁撶畻锛堢 11 鍥炲悎璧凤紝鎵ｈ閲?= 褰撳墠鍥炲悎鏁?- 10锛夈€?# 姣忓崐鍥炲悎缁撴潫鍚勬墸鍚勶細鐜╁鍥炲悎缁撴潫鎵ｇ帺瀹堕槦銆佹晫鏂瑰洖鍚堢粨鏉熸墸鏁屾柟闃燂紙鍗曟満 AI 浜︾劧锛夈€?func _settle_side_round_damage(side: int) -> void:
	if not GameState.should_apply_round_damage():
		return
	var amount := GameState.round_damage_amount()
	if amount < 1:
		return
	var fn := side_faction(side)
	if GameState.is_online and GameState.is_host:
		# 涓绘満鏉冨▉缁撶畻锛氭湰鍦版墸 + 骞挎挱璁╁鎴风瀵瑰悓闃佃惀鎵ц鐩稿悓鎵ｈ锛堜笉鍥炵幆鑷韩锛?_apply_round_damage_to(fn, amount)
		NetBus.send_all(JSON.stringify({ "type": "round_damage", "faction": fn, "amount": amount }))
	else:
		# 鍗曟満锛氭湰鍦扮洿鎺ユ墸
		_apply_round_damage_to(fn, amount)

# ---- 鑳滆礋锛氫竴鏂圭疮璁?3 鍚嶈嫳闆勯樀浜″嵆鍒よ礋 ----
func _check_win() -> bool:
	# 涓€鏂圭疮璁￠樀浜?3 浜哄氨鍒よ礋锛堝惈鏇胯ˉ闃典骸锛夈€傜敤鏈瑙嗚鍖栬鏁帮細鎴戞柟闃典骸=鍒よ礋锛屽鏂归樀浜?鍒よ儨銆?	var my_dead: int = _my_dead()
	var opp_dead: int = _opp_dead()
	if my_dead >= LOSS_DEATH_COUNT and opp_dead >= LOSS_DEATH_COUNT:
		# 鍚屽綊浜庡敖锛氬垽瀹?*瀵规柟璐熴€佹湰绔儨**锛堝叏灞€璧㈠=鏈闃佃惀锛?var winner := _my_side()
		GameState.end_match(winner)
		state = State.ENDED
		_clear_selection()
		log_message.emit("鍙屾柟閮介樀浜¤揪 %d 鍚嶏紝鍚屽綊浜庡敖鈥斺€斾絾鍒ゆ湰绔幏鑳滐紙瀵规柟璐燂級銆? % LOSS_DEATH_COUNT)
		_emit_match_result(winner)
		return true
	if my_dead >= LOSS_DEATH_COUNT:
		var winner2 := _opp_side()
		GameState.end_match(winner2)
		state = State.ENDED
		_clear_selection()
		log_message.emit("璐ュ寳鈥︹€︽垜鏂硅嫳闆勯樀浜¤揪 %d 鍚嶃€? % LOSS_DEATH_COUNT)
		AudioManager.play("win")
		_emit_match_result(winner2)
		return true
	if opp_dead >= LOSS_DEATH_COUNT:
		var winner3 := _my_side()
		GameState.end_match(winner3)
		state = State.ENDED
		_clear_selection()
		log_message.emit("鑳滃埄锛佹晫鏂硅嫳闆勯樀浜¤揪 %d 鍚嶃€? % LOSS_DEATH_COUNT)
		AudioManager.play("win")
		_emit_match_result(winner3)
		return true
	return false

# 鑱旀満鑳滆礋灞曠ず锛氭湰绔脊妗嗭紝骞舵妸"鍏ㄥ眬璧㈠闃佃惀"骞挎挱缁欏鏂癸紝瀵规柟鎹寮硅嚜宸辩殑鑳滆礋妗嗐€?# 淇濊瘉姝讳骸鍗充娇鍙湪涓€绔粨绠楋紝鍙︿竴绔篃鑳界珛鍗虫樉绀哄灞€缁撴潫銆傚崟鏈轰粎鏈湴寮规銆?func _emit_match_result(winner_side: int) -> void:
	var local_win := (winner_side == _my_side())
	match_result.emit(local_win)
	if GameState.is_online and GameState.is_host:
		NetBus.send_all(JSON.stringify({ "type": "match_end", "winner": winner_side }))

func _dead_count(faction: int) -> int:
	return player_dead if faction == DataRegistry.Faction.PLAYER else enemy_dead

func _alive_count(faction: int) -> int:
	var n := 0
	for u in units:
		if u == null or not is_instance_valid(u):
			continue
		if u.alive and u.faction == faction:
			n += 1
	return n

# ---- 杈撳叆澶勭悊锛堝叏灞€榧犳爣鐐瑰嚮锛?---
func _unhandled_input(event: InputEvent) -> void:
	# 鍙抽敭鏌ョ湅鍗￠潰 / 鐢熸垚鐗╀綔鐢紙浠绘剰鏃跺埢锛?	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_RIGHT:
		var cell := grid.world_to_cell(get_global_mouse_position() - board_view.board_origin)
		var u = occupancy.get(cell, null)
		if buff_items.has(cell):
			item_view_requested.emit(buff_items[cell])
		elif u != null:
			card_view_requested.emit(u)
		return
	if event is InputEventMouseButton and event.pressed and event.button_index != MOUSE_BUTTON_LEFT:
		return
	# 閮ㄧ讲鏀剧疆锛氱偣閫夎嫳闆勫悗鐐瑰嚮鍑虹敓鏍?	if state == State.PLACE_DEPLOY:
		if event is InputEventMouseButton and event.pressed:
			var cell := grid.world_to_cell(get_global_mouse_position() - board_view.board_origin)
			if _pending_enemy_deploy != "":
				_try_place_enemy_deploy(cell)   # 鑱旀満鏁岃疆锛氬鎴风鏀炬晫鏂硅嫳闆?else:
				_try_place_deploy(cell)
		return
	# 鏇胯ˉ钀戒綅锛氱偣鍑诲嚭鐢熷湴绌烘牸鏀剧疆
	if state == State.PLACE_SUB:
		if event is InputEventMouseButton and event.pressed:
			var cell := grid.world_to_cell(get_global_mouse_position() - board_view.board_origin)
			_try_place_sub(cell)
		return
	# 鐐稿脊鏀剧疆锛氱偣鍑荤偢寮逛汉鐩搁偦绌哄湴鏀剧疆锛堣仈鏈鸿蛋鎸囦护娴侊紝瑙?_submit_bomb_place锛?	if state == State.PLACE_BOMB:
		if event is InputEventMouseButton and event.pressed:
			var cell := grid.world_to_cell(get_global_mouse_position() - board_view.board_origin)
			_submit_bomb_place(cell)
		return
	if state != State.PLAYER_INPUT:
		return
	# 纭棬鎺э細鍙湁"褰撳墠琛屽姩鏂?== 鏈闃佃惀"鏃舵湰绔墠鑳芥搷浣溿€?	# 鍗充娇 state 琚缃负 PLAYER_INPUT锛屾湰绔篃缁濅笉鍝嶅簲锛堥槻姝㈠悗鎵嬫柟鍦ㄦ垜鏂瑰洖鍚堣鍔級銆?	if GameState.active_side != _my_side():
		return
	# 鎷栨嫿鎾や笅锛氭寜浣忓繁鏂硅嫳闆勶紙宸﹂敭锛夛紝鎷栧埌涓嬫柟鍑虹敓鐐归噴鏀惧嵆鎾や笅
	if _drag_unit != null:
		if event is InputEventMouseButton and not event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
			_finish_drag()
		elif event is InputEventMouseMotion:
			_drag_follow()
		return
	if event is InputEventMouseButton and event.pressed:
		var cell := grid.world_to_cell(get_global_mouse_position() - board_view.board_origin)
		var cu = occupancy.get(cell, null)
		if cu != null and cu.alive and cu.faction == _my_faction():
			_begin_drag(cu)
			return
		_on_cell_clicked(cell)

func _on_cell_clicked(cell: Vector2i) -> void:
	var clicked_unit = occupancy.get(cell, null)   # 鍙兘鏄?null/绌?鍗曚綅锛涚敤鐪熷€煎垽鏂?	var my_f := _my_faction()
	# 鐐瑰嚮宸辨柟鍗曚綅锛堝皻鏈畬鎴愪袱绉嶈鍔級-> 閫変腑锛涘啀娆＄偣鍑诲凡閫変腑鐨勮嫳闆勫垯鍙栨秷锛堝弽鎮旓級
	if clicked_unit != null and clicked_unit.alive and clicked_unit.faction == my_f:
		if clicked_unit.moved_this_turn and clicked_unit.attacked_this_turn:
			action_info.emit("%s 鏈洖鍚堝凡瀹屾垚锛堢Щ鍔ㄣ€佹敾鍑诲悇涓€娆★級銆? % clicked_unit.display_name)
			return
		if selected == clicked_unit:
			_clear_selection()
			action_info.emit("宸插彇娑堥€夋嫨銆?)
		else:
			_select(clicked_unit)
		return
	if selected != null:
		# 鏀诲嚮锛氱偣鍑绘晫鏂瑰崟浣嶄笖鍦ㄥ悎娉曠洰鏍囧唴锛堝惈鍢茶闄愬埗锛夛紝涓旀湰鍥炲悎灏氭湭鏀诲嚮
		if clicked_unit != null and clicked_unit.alive and clicked_unit.faction != my_f and not selected.attacked_this_turn and _valid_targets(selected).has(clicked_unit) and _can_actively_attack(selected):
			submit_attack(units.find(selected), units.find(clicked_unit))
			return
		# 鐩爣鏄晫鏂瑰崟浣嶃€佸彲鏀诲嚮銆佹湰鍥炲悎鏈敾鍑伙紝浣嗕笉鍦ㄥ綋鍓嶆牸灏勭▼鍐?-> 鏄剧ず璇ユ晫鏂瑰彲绉诲姩/鏀诲嚮鑼冨洿
		if clicked_unit != null and clicked_unit.alive and clicked_unit.faction != my_f and not selected.attacked_this_turn and _can_actively_attack(selected) and not _valid_targets(selected).has(clicked_unit):
			_preview_enemy(clicked_unit)
			return
		# 绉诲姩锛氱偣鍑诲彲杈剧┖鏍硷紙鏈洖鍚堝皻鏈Щ鍔級
		if clicked_unit == null and not selected.moved_this_turn and reachable_map.has(cell):
			submit_move(units.find(selected), cell)
			return
		# 鏀诲嚮闅滅鐗╋細浠讳綍鍙富鍔ㄦ敾鍑荤殑鑻遍泟锛岀偣鍑诲皠绋嬪唴闅滅鍗冲彲-1琛€锛堜紣鏈ㄥ伐棰濆-99锛?if clicked_unit == null and not selected.attacked_this_turn and obstacles.has(cell) and enemy_cells.has(cell) and _can_actively_attack(selected):
			submit_attack_obstacle(units.find(selected), cell)
			return
	# 鐐瑰嚮鏁屾柟鍗曚綅锛氭樉绀哄叾绉诲姩/鏀诲嚮鑼冨洿锛堥瑙堬級+ 灞炴€?	if clicked_unit != null and clicked_unit.alive and clicked_unit.faction != _my_faction():
		_preview_enemy(clicked_unit)
		return
	_clear_selection()
	action_info.emit("璇风偣鍑讳竴鍚嶅繁鏂硅嫳闆勩€?)

func _skill_names(skills: Array) -> String:
	var out := ""
	for s in skills:
		match s:
			DataRegistry.Skill.TAUNT:
				out += " 鍢茶"
			DataRegistry.Skill.SWIFT:
				out += " 鐤捐"
			DataRegistry.Skill.INFILTRATE:
				out += " 娓楅€?
			DataRegistry.Skill.LOGISTICS:
				out += " 鍚庡嫟"
	return out

func _in_attack_range(a: Unit, b: Unit) -> bool:
	var d := grid.distance(a.cell, b.cell)
	if d < 1 or d > _effective_attack_range(a):
		return false
	# 琛€閿侊細鍙兘娌跨洿绾挎敾鍑伙紙6 鏉¤酱鍚戞柟鍚戯級锛屾澶勭粺涓€鎷︽埅鐩寸嚎澶栫殑鐩爣
	if a.branch_override and not _is_straight_line_cells(a.cell, b.cell):
		return false
	# 闅滅鐗╅樆鎸℃敾鍑昏绾匡紙琛€閿?杩滅▼涓嶈兘闅斿鎵擄紱璐磋韩鏀诲嚮鏃犱腑闂存牸涓嶅彈褰卞搷锛?	if _attack_path_blocked(a.cell, b.cell):
		return false
	return true

# 浠庢寚瀹氭牸鍑哄彂銆佹煇鍗曚綅鑳芥敾鍑诲埌鐨勭洰鏍囷紙鍚槻璁姐€佽繙绋嬪姩鎬侊級
func _attackable_from(u: Unit, from_cell: Vector2i) -> Array:
	var range_at := _effective_range_at(u, from_cell)
	var taunts: Array = []
	for v in units:
		if v.alive and v.faction != u.faction and v.skills.has(DataRegistry.Skill.TAUNT):
			var d := grid.distance(from_cell, v.cell)
			if d >= 1 and d <= range_at:
				taunts.append(v)
	var out: Array = []
	for v in units:
		if v.alive and v.faction != u.faction:
			var d := grid.distance(from_cell, v.cell)
			if d >= 1 and d <= range_at:
				if taunts.size() > 0 and not v.skills.has(DataRegistry.Skill.TAUNT):
					continue
				if u.branch_override and not _is_straight_line_cells(from_cell, v.cell):   # 琛€閿侊細鍙兘鐩寸嚎鏀诲嚮
					continue
				if _attack_path_blocked(from_cell, v.cell):   # 闅滅鐗╅樆鎸¤绾?continue
				out.append(v)
	return out

func _effective_range_at(u: Unit, from_cell: Vector2i) -> int:
	if u.attack_type == DataRegistry.AttackType.RANGED and _enemy_adjacent_at(u, from_cell):
		return 1
	return u.attack_range

func _enemy_adjacent_at(u: Unit, from_cell: Vector2i) -> bool:
	for v in units:
		if v.alive and v.faction != u.faction and grid.distance(from_cell, v.cell) == 1:
			if _attack_path_blocked(from_cell, v.cell):
				continue   # 琚殰纰嶇墿闅旀柇涓嶇畻璐磋韩
			return true
	return false

# 杩滅▼鍔ㄦ€佸皠绋嬶細鏈夌浉閭绘晫浜烘椂灏勭▼闄嶄负 1锛涘惁鍒欑敤鍩虹灏勭▼(杩滅▼=2)
func _has_enemy_adjacent(a: Unit) -> bool:
	for v in units:
		if v.alive and v.faction != a.faction and grid.distance(a.cell, v.cell) == 1:
			# 琚殰纰嶇墿闅旀柇鐨勭浉閭绘敾鍑讳笉绠?琚创韬?锛氬彧鏈夊郊姝よ兘瀹為檯浜ゆ垬(瑙嗙嚎閫氱晠)鎵嶇畻銆?if _attack_path_blocked(a.cell, v.cell):
				continue
			return true
	return false

func _effective_attack_range(a: Unit) -> int:
	if a.attack_type == DataRegistry.AttackType.RANGED and _has_enemy_adjacent(a):
		return 1
	return a.attack_range

# 鍚屾鎵€鏈夊崟浣嶇殑"杩滅▼琚创韬?鏍囧織锛堢Щ鍔?鏀诲嚮/鍥炲悎鍒囨崲鍚庤皟鐢紝鐢ㄤ簬闈㈡澘涓庝激瀹崇粨绠楋級
func _sync_ranged_adjacent() -> void:
	for u in units:
		if u == null or not is_instance_valid(u):
			continue
		if u.alive and u.attack_type == DataRegistry.AttackType.RANGED:
			u.set_ranged_adjacent(_has_enemy_adjacent(u))
		else:
			u.set_ranged_adjacent(false)

# 涓嬫柟闃熶紞灞曠ず锛氬彧鏄剧ず鏇胯ˉ甯紙灏氭湭涓婂満銆佸緟鏇胯ˉ鐨勮嫳闆勶級銆?# 宸蹭笂闃电殑鍗曚綅鍦ㄦ鐩樹笂鎴樻枟銆佷笉鍦ㄦ浛琛ュ腑锛涘凡姝讳骸/宸茶ˉ浣嶇殑涔熶笉鍦ㄥ叾涓紱
# 鍥犳涓嶄細鍑虹幇"鐧惧彉绮剧伒鍙樿韩鎬?鎴?宸蹭笂闃?宸叉鑻遍泟娣峰叆涓嬫柟闃熶紞"鐨勯棶棰樸€?# 绔炴妧鍦洪€変汉闃舵锛氳繑鍥炴垜鏂瑰凡閫夎嫳闆勶紙瀹炴椂鏇存柊锛夛紱鍚﹀垯杩斿洖鏇胯ˉ甯€?func _player_team_ids() -> Array:
	if GameState.arena_mode and state == State.ARENA_DRAFT:
		if GameState.is_online:
			return _oa_my_kept.duplicate()   # 鑱旀満绔炴妧鍦猴細鏄剧ず鑷繁宸茬暀涓嬬殑鑻遍泟
		return _arena_picked.duplicate()
	# 姘歌繙鏄剧ず鏈"鎴戞柟"鐨勬浛琛ュ腑锛堣仈鏈哄鎴风=绾㈡柟鑷繁鐨勬浛琛ワ紝涓嶉殢鍥炲悎鍒囨崲锛?	return _my_roster().duplicate()

# 鍗曚綅/闃靛鍙樺寲鍚庨€氱煡 HUD 鍒锋柊涓嬫柟闃熶紞灞曠ず
func _notify_team() -> void:
	team_updated.emit()

# ---- 閮ㄧ讲鏈熺殑鏈瑙嗚 ----
# 鏈"鎴戞柟"閮ㄧ讲鍗℃睜锛氫富鏈?鍗曟満=PLAYER 姹狅紙钃濓級锛屽鎴风=ENEMY 姹狅紙绾級銆?func _my_deploy_pool() -> Array:
	return player_pool if _my_faction() == DataRegistry.Faction.PLAYER else enemy_pool

# 鏈"鎴戞柟"宸查儴缃叉暟閲忥紙閮ㄧ讲闈㈡澘鏍囬鐢級銆?func _my_deployed_count() -> int:
	return player_deployed.size() if _my_faction() == DataRegistry.Faction.PLAYER else enemy_deployed.size()

func _opp_deployed_count() -> int:
	return enemy_deployed.size() if _my_faction() == DataRegistry.Faction.PLAYER else player_deployed.size()

# 鏀诲嚮浼ゅ锛氳繙绋嬭璐磋韩鏃跺熀纭€鏀诲嚮闄嶄负 1锛坆uff 鍙犲姞锛岃 Unit.effective_atk锛?func _attack_damage(a: Unit) -> int:
	return a.effective_atk()

# 鐩爣鏄惁鍙涓诲姩鏀诲嚮锛堝悗鍕や笉鑳戒富鍔ㄦ敾鍑伙級
func _can_actively_attack(a: Unit) -> bool:
	return a.can_attack() and not _is_logistics(a)

# ---- 鍢茶瑙勫垯锛氳嫢鏀诲嚮鑼冨洿鍐呭瓨鍦ㄥ甫鍢茶鐨勫绔嬪崟浣嶏紝鍒欏彧鑳芥敾鍑诲槻璁藉崟浣?----
func _taunters_in_range(a: Unit) -> Array:
	var out: Array = []
	for v in units:
		if v.alive and v.faction != a.faction and v.skills.has(DataRegistry.Skill.TAUNT) and _in_attack_range(a, v):
			out.append(v)
	return out

func _valid_targets(a: Unit) -> Dictionary:  # Unit -> true
	var taunts := _taunters_in_range(a)
	var out := {}
	for v in units:
		if v.alive and v.faction != a.faction and _in_attack_range(a, v):
			if taunts.size() > 0 and not v.skills.has(DataRegistry.Skill.TAUNT):
				continue
			if a.branch_override and not _is_straight_line(a, v):   # 琛€閿侊細鍙兘鐩寸嚎鏀诲嚮
				continue
			out[v] = true
	return out

# 琛€閿侊細鍒ゅ畾 b 鏄惁浣嶄簬浠?a 鍑哄彂鐨勬煇鏉″叚杈瑰舰鐩寸嚎涓?func _is_straight_line(a: Unit, b: Unit) -> bool:
	return _is_straight_line_cells(a.cell, b.cell)

func _is_straight_line_cells(from_cell: Vector2i, to_cell: Vector2i) -> bool:
	var da := grid.axial_of(from_cell)
	var db := grid.axial_of(to_cell)
	var dx := db.x - da.x
	var dy := db.y - da.y
	if dx == 0 and dy == 0:
		return true
	# 褰掍竴鍖栧埌鍩烘湰姝ラ暱锛屾鏌ユ槸鍚︿负 6 涓酱鍚戞柟鍚戜箣涓€鐨勬暣鏁板€?	var g := _gcd(abs(dx), abs(dy))
	var sx := int(dx / float(g))
	var sy := int(dy / float(g))
	var dirs: Array = [Vector2i(1, 0), Vector2i(0, 1), Vector2i(-1, 1), Vector2i(-1, 0), Vector2i(0, -1), Vector2i(1, -1)]
	for d in dirs:
		if d.x == sx and d.y == sy:
			return true
	return false

func _gcd(a: int, b: int) -> int:
	while b != 0:
		var t := a % b
		a = b
		b = t
	return max(a, 1)

# 鏀诲嚮瑙嗙嚎锛氫粠 from 鍒?to 涔嬮棿锛堜笉鍚袱绔級鏄惁瀛樺湪闅滅鐗╅樆鎸°€?# 鐢ㄨ酱鍚戝潗鏍囧仛 Bresenham 寮忔彃鍊硷紝閫愭牸妫€鏌?obstacles銆備换涓€涓棿鏍兼湁闅滅鍒欐敾鍑昏鎸°€?func _attack_path_blocked(from_cell: Vector2i, to_cell: Vector2i) -> bool:
	if from_cell == to_cell:
		return false
	var fa := grid.axial_of(from_cell)
	var ta := grid.axial_of(to_cell)
	var dx := ta.x - fa.x
	var dy := ta.y - fa.y
	var steps := maxi(abs(dx), abs(dy))
	if steps <= 1:
		return false   # 璐磋韩/鐩搁偦锛氫腑闂存棤鏍?	for s in range(1, steps):
		var ax: int = fa.x + int(round(float(dx) * float(s) / float(steps)))
		var ay: int = fa.y + int(round(float(dy) * float(s) / float(steps)))
		var off := grid.offset_of(Vector2i(ax, ay))
		if obstacles.has(off):
			return true
		if occupancy.has(off):
			return true   # 鍗曚綅锛堟晫鎴戯級涔熼樆鎸℃敾鍑昏绾匡細鐩寸嚎涓嶅彲绌胯繃浠栦汉閽╃洰鏍?	return false

# ---- 閫変腑涓庨珮浜?----
func _select(u: Unit) -> void:
	AudioManager.play("select")
	_do_select(u)

func _do_select(u: Unit) -> void:
	_clear_selection()
	selected = u
	u.set_selected(true)
	_compute_ranges(u)
	_apply_highlights()
	var info := "宸查€変腑 %s锛圚P %d锛屾敾 %d锛夈€? % [u.display_name, u.hp, u.atk]
	if not u.moved_this_turn:
		info += "缁胯壊鍙Щ鍔?
	if not u.attacked_this_turn:
		info += ("锛? if not u.moved_this_turn else "") + "绾㈣壊鍙敾鍑?
	# 灞曠ず璇ヨ鑹叉妧鑳斤紙鍚棤鍏抽敭璇嶈閿佺瓑鐗规畩鏁堟灉锛?	var def := DataRegistry.get_hero(u.hero_id)
	if def != null and def.desc != "":
		info += "\n鎶€鑳斤細%s" % def.desc
	action_info.emit(info)
	highlight_changed.emit()

func _clear_selection() -> void:
	if selected:
		selected.set_selected(false)
	selected = null
	reachable_map = {}
	enemy_cells = {}
	_preview_cells = {}
	if board_view:
		board_view.clear_highlights()
	highlight_changed.emit()

# 鏁屾柟棰勮锛氱偣鍑绘晫鏂规瀛愭樉绀哄叾绉诲姩鑼冨洿涓?褰撳墠鏍煎彲鏀诲嚮鑼冨洿"锛堜笉鎵撴柇鍥炲悎锛?func _preview_enemy(u: Unit) -> void:
	_clear_selection()
	var pc := {}
	var reach := _move_reachable(u)
	for k in reach.keys():
		pc[k] = Color(0.35, 0.55, 0.95, 0.65)   # 钃濓細鏁屾柟鍙Щ鍔?	# 鏀诲嚮鑼冨洿锛氬彧鏄剧ず"褰撳墠鏍?鑳界洿鎺ユ敾鍑诲埌鐨勭洰鏍?	var attack_cells := {}
	for v in _attackable_from(u, u.cell):
		attack_cells[v.cell] = true
	for c in attack_cells.keys():
		pc[c] = Color(1.0, 0.6, 0.25, 0.9)   # 姗欙細褰撳墠鏍煎彲鏀诲嚮
	pc[u.cell] = Color(0.95, 0.85, 0.3, 0.9)
	_preview_cells = pc
	_apply_highlights()
	action_info.emit("%s锛堟晫鏂癸級HP %d 鏀诲嚮 %d 路 钃?鍙Щ鍔?姗?鍙敾鍑? % [u.display_name, u.hp, u.effective_atk()])

func _compute_ranges(u: Unit) -> void:
	reachable_map = {}
	enemy_cells = {}
	# 绉诲姩锛堣嫢鏈洖鍚堝皻鏈Щ鍔?涓?闈炵湬鏅曪級
	if not u.moved_this_turn and u.can_move():
		var reach := _move_reachable(u)
		for k in reach.keys():
			if not occupancy.has(k):
				reachable_map[k] = true
	# 鏀诲嚮锛堣嫢鏈洖鍚堝皻鏈敾鍑汇€佸彲鏀诲嚮銆佷笖闈炲悗鍕涓嶈兘涓诲姩鏀诲嚮]锛?	if not u.attacked_this_turn and u.can_attack() and not _is_logistics(u):
		# 鍙樉绀?褰撳墠鏍?鑳界洿鎺ユ敾鍑诲埌鐨勭洰鏍囷紙鏃犳硶鑷姩绉诲姩鍚庢敾鍑伙紝鏁呬笉骞堕泦鍙揪鏍硷級
		for v in _attackable_from(u, u.cell):
			if v.alive:
				enemy_cells[v.cell] = true
	# 鍙敾鍑诲皠绋嬪唴鐨勯殰纰嶇墿锛堟墍鏈夎嫳闆勯兘鑳芥敾鍑婚殰纰嶏級
	if not u.attacked_this_turn and u.can_attack() and not _is_logistics(u):
		for oc in obstacles.keys():
			var d := grid.distance(u.cell, oc)
			if d >= 1 and d <= _effective_attack_range(u):
				# 琛€閿侊細鏀诲嚮闅滅鍚屾牱鍙兘娌?6 鏂瑰悜鐩寸嚎锛堜笌鏀诲嚮鏁屾柟鍗曚綅涓€鑷达級
				if u.branch_override and not _is_straight_line_cells(u.cell, oc):
					continue
				enemy_cells[oc] = true

func _is_logistics(u: Unit) -> bool:
	return u.skills.has(DataRegistry.Skill.LOGISTICS)

# 璁＄畻鍗曚綅鍙Щ鍔ㄨ寖鍥达紙鑰冭檻娓楅€忔妧鑳斤細鍙┛瓒婃晫鏂规牸瀛愪絾涓嶅彲鍋滈潬锛涘喕缁撳熬鐢熸晥锛涢殰纰嶇墿闃绘尅锛?func _move_reachable(u: Unit) -> Dictionary:
	# 澶уぇ楠戝＋锛氬啿閿嬧€斺€旀部 6 涓?*杞村悜**鐩寸嚎鏂瑰悜鍐蹭换鎰忚窛绂伙紝鐩村埌琚樆鎸★紙绉诲姩鍔涗笉灏侀《锛?	if u.hero_id == "hero_24":
		var out := {}
		var dirs: Array[Vector2i] = [Vector2i(1, 0), Vector2i(0, 1), Vector2i(-1, 1), Vector2i(-1, 0), Vector2i(0, -1), Vector2i(1, -1)]
		for d in dirs:
			var ax := grid.axial_of(u.cell) + d
			while true:
				var off := grid.offset_of(ax)
				if not grid.in_bounds(off):
					break
				if occupancy.has(off) or obstacles.has(off) or graves.has(off):
					break
				out[off] = true
				ax += d
		return out
	var stop_forbidden := occupancy.duplicate()
	var path_blockers := occupancy.duplicate()
	if u.skills.has(DataRegistry.Skill.INFILTRATE):
		# 鏁屾柟鍗曚綅涓庨殰纰嶇墿/澧撶閮藉彉涓?鍙€氳浣嗕笉鍙仠"锛屽弸鏂逛粛闃绘尅
		path_blockers = {}
		for c in occupancy.keys():
			if occupancy[c].faction == u.faction:
				path_blockers[c] = true
		for oc in obstacles.keys():
			stop_forbidden[oc] = true   # 娓楅€忥細闅滅鍙┛琛岋紝浣嗕笉鍙惤鍋?for g in graves.keys():
			stop_forbidden[g] = true    # 娓楅€忥細澧撶鍙┛琛岋紝浣嗕笉鍙惤鍋?	else:
		# 闅滅鐗?澧撶鍚屾牱闃绘尅閫氳鈥斺€斿彧鍐欏叆鏈湴鎷疯礉锛屽嬁姹℃煋 occupancy
		for oc in obstacles.keys():
			stop_forbidden[oc] = true
			path_blockers[oc] = true
		for g in graves.keys():
			stop_forbidden[g] = true
			path_blockers[g] = true
	return grid.reachable(u.cell, u.effective_move(), stop_forbidden, path_blockers)

func _build_highlight_colors() -> Dictionary:
	var colors := {}
	for c in reachable_map.keys():
		colors[c] = Color(0.25, 0.75, 0.3, 0.7)
	for c in enemy_cells.keys():
		colors[c] = Color(0.9, 0.25, 0.2, 0.8)
	if selected != null:
		colors[selected.cell] = Color(1.0, 0.85, 0.3, 0.9)
	for c in _preview_cells.keys():
		colors[c] = _preview_cells[c]   # 鏁屾柟棰勮瑕嗙洊
	return colors

func _apply_highlights() -> void:
	if board_view:
		board_view.set_highlights(_build_highlight_colors())

# ---- 缃戠粶鎸囦护锛堜富鏈烘潈濞佹墽琛屽叆鍙ｏ級----
# apply_command 鐢变富鏈鸿皟鐢紝鎸夋寚浠ょ被鍨嬪垎鍙戝埌瀵瑰簲 Battle 鎿嶄綔銆俢md 褰㈠锛?#   {"type":"move","u":int,"to":[x,y]}                  # u=units 绱㈠紩锛岀Щ鍔ㄥ埌 to
#   {"type":"attack","u":int,"t":int}                   # u 鏀诲嚮 units[t]
#   {"type":"select","u":int}                           # 閫変腑 units[u]
# 瀹㈡埛绔笉鐩存帴鎵ц锛屽彧鍙戞寚浠ょ粰涓绘満锛涗富鏈烘墽琛屽悗骞挎挱缁撴灉銆?func apply_command(cmd: Dictionary) -> void:
	var u_idx := int(cmd.get("u", -1))
	var u: Unit = units[u_idx] if u_idx >= 0 and u_idx < units.size() else null
	match String(cmd.get("type", "")):
		"move":
			var to: Vector2i = _v2(cmd.get("to"))
			if u != null and is_instance_valid(u) and u.alive:
				_do_move(u, to, false)
		"attack":
			var t_idx := int(cmd.get("t", -1))
			var t: Unit = units[t_idx] if t_idx >= 0 and t_idx < units.size() else null
			if u != null and t != null and is_instance_valid(u) and is_instance_valid(t) and u.alive and t.alive:
				_do_attack(u, t, false)
		"select":
			if u != null and is_instance_valid(u) and u.alive:
				_select(u)
		"obstacle":
			var oc: Vector2i = _v2(cmd.get("cell"))
			if u != null and is_instance_valid(u) and u.alive and obstacles.has(oc):
				_do_attack_obstacle(u, oc)
		"bomb":
			# 鐐稿脊浜烘斁缃偢寮癸紙鑱旀満涓绘満鎵ц / 瀹㈡埛绔洖鏀鹃噸婕斿悓涓€鏉℃寚浠わ級
			var bc: Vector2i = _v2(cmd.get("cell"))
			if u != null and is_instance_valid(u) and u.alive and u.hero_id == "hero_35":
				_apply_bomb_cmd(u, bc)

# 鏀诲嚮闅滅鐗╃殑瀹屾暣鍓綔鐢紙涓ょ閲嶆紨涓€鑷达級锛氭墸琛屽姩 + 浼ゅ + AOE/绌块€忔妧鑳?+ 鏀跺熬銆?func _do_attack_obstacle(u: Unit, cell: Vector2i) -> void:
	if u == null or not is_instance_valid(u) or not u.alive:
		return
	if not obstacles.has(cell):
		return
	# 琛€閿侊細鏀诲嚮闅滅鍚屾牱鍙兘娌?6 鏂瑰悜鐩寸嚎锛堟潈濞佹墽琛屽涔熸牎楠岋紝闃茬粫杩?UI 楂樹寒锛?	if u.branch_override and not _is_straight_line_cells(u.cell, cell):
		return   # 闈炴硶鐩爣鐩存帴蹇界暐锛屼笉娑堣€楄鍔紙UI 楂樹寒宸茶繃婊わ紝姝ゅ涓哄厹搴曪級
	state = State.ANIMATING   # 婕斿嚭鏈熼棿閿佸畾杈撳叆
	u.attacked_this_turn = true
	_clear_selection()
	# 婕斿嚭锛氳繙绋?璺?1)鎶曟幏鐗╅鍚戦殰纰嶅懡涓紱杩戞垬(璺?)鏀诲嚮鑰呭悜闅滅杞绘尌涓€鍑汇€傚懡涓悗缁熶竴缁撶畻銆?	var dist := grid.distance(u.cell, cell)
	if dist > 1:
		_launch_obstacle_projectile(u, cell)
	else:
		_melee_obstacle_hit(u, cell)

# 杩滅▼鏀诲嚮闅滅鐗╋細鎶曟幏鐗╅鍚戦殰纰嶆牸锛屽懡涓悗缁撶畻銆?func _launch_obstacle_projectile(u: Unit, cell: Vector2i) -> void:
	var from := board_view.cell_world_center(u.cell)
	var to := board_view.cell_world_center(cell)
	var proj := Projectile.new()
	proj.position = from
	proj.rotation = (to - from).angle()
	add_child(proj)
	var flight := clampf(float(grid.distance(u.cell, cell)) * 0.08, 0.15, 0.4)
	var t := create_tween()
	t.tween_property(proj, "position", to, flight).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	t.tween_callback(func():
		proj.queue_free()
		_impact_obstacle(u, cell))

# 杩戞垬鏀诲嚮闅滅鐗╋細鏀诲嚮鑰呭悜闅滅杞绘尌锛堝皬鍓嶅啿+鍥炰綅锛夛紝鍛戒腑鍚庣粨绠椼€?func _melee_obstacle_hit(u: Unit, cell: Vector2i) -> void:
	var apos := board_view.cell_world_center(u.cell)
	var swing_to := apos.lerp(board_view.cell_world_center(cell), 0.3)
	var t := create_tween()
	t.tween_property(u, "position", swing_to, 0.1)
	t.tween_callback(func():
		if u == null or not is_instance_valid(u):
			return   # 鏀诲嚮鑰呭湪鎸ュ嚮婕斿嚭鏈熼棿琚噴鏀撅細涓
		var back := create_tween()
		back.tween_property(u, "position", apos, 0.08)
		back.tween_callback(func():
			if u != null and is_instance_valid(u):
				_impact_obstacle(u, cell)))

# 闅滅鍙楀嚮鍛戒腑锛氬懡涓伀鑺辨紨鍑?+ 缁撶畻浼ゅ锛堜粎鐩存帴鏀诲嚮鐨勪激瀹筹紝浼愭湪宸ラ澶?99锛夈€?# 鑻遍泟鎶€鑳斤紙婧呭皠/绌块€?鍑婚€€绛夛級涓嶅啀浣滅敤浜庨殰纰嶇墿锛屾澶勪笉瑙﹀彂浠讳綍鑻遍泟鐗规妧銆?func _impact_obstacle(u: Unit, cell: Vector2i) -> void:
	if u == null or not is_instance_valid(u) or not u.alive:
		return
	if not obstacles.has(cell):
		_after_player_action()
		return
	_obstacle_hit_fx(cell)
	var dmg := _hero(u).obstacle_damage()
	_damage_obstacle(cell, dmg)
	log_message.emit("%s 鏀诲嚮闅滅鐗┿€? % u.display_name)
	_after_player_action()

# 闅滅鍙楀嚮鐏姳锛氶殰纰嶆牸闂幇涓€鍦堢櫧鑹插啿鍑绘尝鍚庢秷鏁ｃ€?func _obstacle_hit_fx(cell: Vector2i) -> void:
	var center := board_view.cell_world_center(cell)
	var ring := RingFlash.new()
	ring.position = center
	add_child(ring)
	var t := ring.create_tween()
	t.tween_property(ring, "scale", Vector2(1.0, 1.0), 0.28).from(Vector2(0.2, 0.2))
	t.parallel().tween_property(ring, "modulate:a", 0.0, 0.28)
	t.tween_callback(ring.queue_free)

# ---- 鐜╁鎿嶄綔鎻愪氦锛堝尯鍒?鍗曟満 / 鑱旀満涓绘満 / 鑱旀満瀹㈡埛绔級----
# _on_cell_clicked 绛夌晫闈㈣緭鍏ヨ皟鐢細鍗曟満鐩存帴鎵ц锛涜仈鏈哄鎴风鍙戞寚浠ょ粰涓绘満锛堜笉鏈湴鎵ц锛夛紱
# 鑱旀満涓绘満鏈湴鎵ц骞跺箍鎾€傝繑鍥?true 琛ㄧず宸叉彁浜ゃ€?func submit_move(unit_idx: int, to: Vector2i) -> bool:
	var cmd := { "type": "move", "u": unit_idx, "to": [to.x, to.y] }
	return _dispatch_player_op(cmd)

func submit_attack(unit_idx: int, target_idx: int) -> bool:
	var cmd := { "type": "attack", "u": unit_idx, "t": target_idx }
	return _dispatch_player_op(cmd)

func submit_attack_obstacle(unit_idx: int, cell: Vector2i) -> bool:
	var cmd := { "type": "obstacle", "u": unit_idx, "cell": [cell.x, cell.y] }
	return _dispatch_player_op(cmd)

# 鍗曟満锛氭湰鍦版墽琛屻€傝仈鏈哄鎴风锛氬彂涓绘満锛堜笉鏈湴鎵ц锛夈€傝仈鏈轰富鏈猴細鏈湴鎵ц + 骞挎挱銆?func _dispatch_player_op(cmd: Dictionary) -> bool:
	# 纭棬鎺э細浠?褰撳墠琛屽姩鏂?== 鏈闃佃惀"鎵嶈兘鎻愪氦琛屽姩锛堥槻姝㈠悗鎵嬫柟璧版彁浜よ矾寰勮鍔級銆?	if GameState.active_side != _my_side():
		return false
	if not GameState.is_online:
		apply_command(cmd)
		return true
	if GameState.is_host:
		apply_command(cmd)
		NetBus.send_all(JSON.stringify(cmd))
		return true
	# 瀹㈡埛绔細鍙彂鎸囦护缁欎富鏈猴紙涓绘満 id=1锛夛紝涓嶆湰鍦版墽琛?	NetBus.send_to(1, JSON.stringify(cmd))
	return true

# 鑱旀満"鍐嶆潵涓€灞€"锛氫笉閫€鍑鸿繛鎺ャ€備富鏈烘潈濞侀噸鍚€斺€旈噸闅忔満绉嶅瓙骞跺箍鎾紝鍙岀閲嶈浇 Main 鍦烘櫙閲嶈蛋閮ㄧ讲/閫夊崱銆?# 瀹㈡埛绔偣鍑?-> 鍙戣姹傜粰涓绘満锛涗富鏈虹偣鍑绘垨鏀跺埌璇锋眰 -> 骞挎挱 restart_new(鏂扮瀛? + 鏈閲嶈浇锛涘鎴风鏀跺埌骞挎挱鍚庨噸杞姐€?func request_rematch_online() -> void:
	if not GameState.is_online:
		return
	if GameState.is_host:
		_start_online_rematch()
	else:
		if not _rematch_requested:
			_rematch_requested = true
			NetBus.send_to(1, JSON.stringify({ "type": "restart_req" }))

func _start_online_rematch() -> void:
	if not GameState.is_host or _rematch_started:
		return
	_rematch_started = true
	# 澶嶄綅瀵瑰眬绾у瓧娈碉紙淇濈暀 is_online/is_host/arena_mode/鍗＄粍锛涙柊鍦烘櫙 Battle._ready 鎹閲嶈蛋姝ｇ‘鍒嗘敮锛?	GameState.round_number = 1
	GameState.match_over = false
	GameState.match_running = false
	GameState.surrender = false
	randomize()   # 鍏ㄥ眬 RNG 鍥哄畾搴忓垪 -> 姣忓眬涓嶅悓绉嶅瓙 -> 鍙戠墝/鍏堝悗鎵嬮殢鏈?	GameState.online_seed = randi()
	NetBus.send_all(JSON.stringify({ "type": "restart_new", "seed": GameState.online_seed }))
	get_tree().change_scene_to_file("res://scenes/Main.tscn")

func _apply_online_rematch(seed_value: int) -> void:
	# 瀹㈡埛绔敹鍒颁富鏈洪噸鍚箍鎾細鍚屼富鏈哄浣嶅悗閲嶈浇 Main锛堝悓绉嶅瓙纭畾鎬у紑灞€锛?	GameState.online_seed = seed_value
	GameState.round_number = 1
	GameState.match_over = false
	GameState.match_running = false
	GameState.surrender = false
	get_tree().change_scene_to_file("res://scenes/Main.tscn")

# 瀵圭閫€鍑?鏂嚎锛氳仈鏈哄灞€涓换涓€鏂圭寮€锛堣繑鍥炲ぇ鍘?鍏抽棴锛夛紝鍙︿竴绔篃瑕佹柇寮€骞跺洖澶у巺锛岄伩鍏嶅崱鍦ㄥ灞€閲屻€?func _on_net_disconnected() -> void:
	if not GameState.is_online:
		return
	if state == State.ENDED:
		return   # 宸茬粨绠楋紙鑳滆礋妗嗗湪锛夛細鐩存帴鍥炲ぇ鍘呯敱缁撶畻鎸夐挳澶勭悊锛屼笉鍐嶉澶栬烦杞?	GameState.reset_online()
	NetBus.stop()
	get_tree().change_scene_to_file("res://scenes/NetLobby.tscn")

# 鏀跺埌瀵圭娑堟伅锛氳嫢鏄父鎴忔寚浠わ紝鍒?apply_command 鎵ц/閲嶆紨锛堜富鏈烘敹鍒板鎴风鎸囦护 -> 鎵ц锛涘鎴风鏀跺埌涓绘満骞挎挱 -> 閲嶆紨锛夈€?func _on_net_packet(_from_id: int, text: String) -> void:
	if not GameState.is_online:
		return
	var cmd: Variant = JSON.parse_string(text)
	if cmd is Dictionary:
		var t := String(cmd.get("type", ""))
		if t == "restart_req":
			# 瀹㈡埛绔姹?鍐嶆潵涓€灞€" -> 涓绘満鏉冨▉閲嶅惎锛堝箍鎾柊绉嶅瓙锛泂end_all 涓嶅洖鐜紝涓绘満鏈湴涔熼噸鍚級
			if GameState.is_host:
				_start_online_rematch()
			return
		if t == "restart_new":
			# 涓绘満骞挎挱閲嶅惎 -> 瀹㈡埛绔簲鐢ㄦ柊绉嶅瓙骞堕噸杞斤紙涓绘満涓嶆帴鏀惰嚜宸辩殑骞挎挱锛?if not GameState.is_host:
				_apply_online_rematch(int(cmd.get("seed", 12345)))
			return
		if t == "turn_time":
			# 瀵圭琛屽姩鍥炲悎鍓╀綑绉掓暟鍚屾锛堟湰绔瓑寰呮椂鏄剧ず"瀵规柟 鈴?N 绉?锛?peer_turn_time_left = float(cmd.get("left", 0))
			return
		if t == "arena_pick":
			# 鑱旀満绔炴妧鍦猴細瀹㈡埛绔妸姣忚疆閫夋嫨鍙戠粰涓绘満锛堜富鏈烘敹闆嗛綈鍙屾柟鍚庢眹鎬诲箍鎾級
			if GameState.is_host:
				if _oa_active:
					_oa_on_peer_pick(int(cmd.get("round", -1)), String(cmd.get("hero", "")))
				else:
					# 涓绘満 draft 灏氭湭鍒濆鍖栵紙鍚屽抚杩涘叆鍦烘櫙绔炴€侊級锛氱紦瀛橈紝鍚姩鏃惰ˉ鏀?_oa_pending.append({ "round": int(cmd.get("round", -1)), "hero": String(cmd.get("hero", "")) })
			return
		if t == "arena_done":
			# 涓绘満宸叉妸鍙屾柟鍗＄粍姹囨€诲ソ锛堥€夊崱鍏ㄩ儴瀹屾垚锛夛紝瀹㈡埛绔互骞挎挱涓哄噯杩涘叆閮ㄧ讲
			if not GameState.is_host:
				_oa_apply_done(cmd.get("pdeck", []), cmd.get("edeck", []))
			return
		if t == "deploy":
			# 瀵圭閮ㄧ讲浜嗕竴姝ワ細鏈涔熸斁缃紝淇濊瘉涓ょ閮ㄧ讲涓€鑷达紱闅忓悗鎸夋湰鍦扮姸鎬佹帹杩涜疆娆★紙涓ょ鎺ㄨ繘閫昏緫鐩稿悓 -> 涓€鑷达級
			apply_deployment(int(cmd.get("faction", 0)), String(cmd.get("hero", "")), _v2(cmd.get("cell")))
			if state == State.DEPLOY or state == State.PLACE_DEPLOY:
				_deploy_after_pick()
			return
		if t == "begin_side":
			# 涓绘満鏉冨▉鍏竷"褰撳墠琛屽姩鏂?鍥炲悎鍙?锛氬鎴风鎹鍚屾 active_side/round 骞舵墽琛?_begin_side銆?			# 涓绘満鏈湴宸插湪 _end_side 閲屾墽琛岃繃 _begin_side锛屽拷鐣ヨ嚜宸辩殑骞挎挱锛坆roadcast 涓嶅洖鐜紝浠嶉槻寰★級銆?GameState.sync_turn(int(cmd.get("side", GameState.active_side)), int(cmd.get("round", GameState.round_number)))
			if not GameState.is_host:
				_begin_side(GameState.active_side)
			return
		if t == "end_turn":
			# 鍙湁涓绘満鎵ц鍥炲悎鎺ㄨ繘锛涘鎴风涓嶆湰鍦版帹杩涳紝绛変富鏈虹殑 begin_side 骞挎挱銆?if GameState.is_host:
				var s := int(cmd.get("side", -1))
				# 闃查噸澶?杩囨湡缁撴潫鎸囦护锛氭寚浠ゅ搴旂殑涓€鏂瑰繀椤讳粛鏄綋鍓嶈鍔ㄦ柟锛屼笖褰撳墠涓嶅湪鍒囧洖鍚堢粨绠椾腑銆?if s != GameState.active_side:
					return
				if state == State.ANIMATING:
					return
				_end_side(s)
			return
		if t == "sub":
			# 鏇胯ˉ钀戒綅锛氫袱绔噸婕斿悓涓€"鏀剧疆鏇胯ˉ"閫昏緫銆備富鏈猴細鏈湴鎵ц + 骞挎挱锛涘鎴风鏀跺埌鍚庨噸婕斻€?_place_sub(int(cmd.get("faction", DataRegistry.Faction.PLAYER)), String(cmd.get("hero", "")), _v2(cmd.get("cell")))
			if GameState.is_host:
				NetBus.send_all(text)
			return
		if t == "withdraw":
			# 涓诲姩鎾や笅锛氫袱绔竴鑷存妸璇ュ崟浣嶆挙涓嬪満锛堣涓洪樀浜″苟鍙兘瑙﹀彂鏇胯ˉ锛夈€?			# 涓绘満鏀跺埌瀹㈡埛绔寚浠?-> 鏉冨▉鎵ц + 骞挎挱锛涘鎴风鏀跺埌涓绘満骞挎挱 -> 閲嶆紨銆?var w_idx := int(cmd.get("u", -1))
			var wu: Unit = units[w_idx] if w_idx >= 0 and w_idx < units.size() else null
			_apply_withdraw(wu)
			if GameState.is_host:
				NetBus.send_all(text)
			return
		if t == "round_damage":
			# 涓绘満缁撶畻鐨勬湰鏂瑰洖鍚堣秴鍥炲悎鎵ｈ骞挎挱锛氬鎴风瀵瑰悓闃佃惀鎵ц鐩稿悓鎵ｈ锛堜笉鍥炵幆涓绘満锛屼粎瀹㈡埛绔敹鍒帮級
			if not GameState.is_host:
				_apply_round_damage_to(int(cmd.get("faction", DataRegistry.Faction.PLAYER)), int(cmd.get("amount", 0)))
			return
		if t == "match_end":
			# 涓绘満鏉冨▉鍏竷瀵瑰眬缁撴潫锛氬鎴风鑻ュ皻鏈湰鍦扮粨绠楋紙姝讳骸鍙彂鐢熷湪涓绘満绔級锛岃ˉ缁撶畻骞跺脊鑳滆礋妗嗐€?var winner := int(cmd.get("winner", GameState.SIDE_PLAYER))
			GameState.end_match(winner)
			if state != State.ENDED:
				state = State.ENDED
				_clear_selection()
				match_result.emit(winner == _my_side())
			return
		# 涓绘満锛氭敹鍒板鎴风鎸囦护 -> 鎵ц + 骞挎挱锛涘鎴风锛氭敹鍒颁富鏈哄箍鎾?-> 閲嶆紨鍚屼竴鏉℃寚浠?if GameState.is_host:
			apply_command(cmd)
			NetBus.send_all(text)
		else:
			apply_command(cmd)

# 鏁扮粍瀛楅潰閲?[x,y] -> Vector2i
func _v2(a) -> Vector2i:
	if a is Array and (a as Array).size() >= 2:
		return Vector2i(int(a[0]), int(a[1]))
	return Vector2i.ZERO

# ---- 绉诲姩 ----
func _do_move(u: Unit, target_cell: Vector2i, for_enemy: bool) -> void:
	if u == null or not is_instance_valid(u):   # 闃插尽锛氬崟浣嶅凡閲婃斁鍒欒烦杩?return
	# 鐩爣宸茶**鍏跺畠鍗曚綅**鍗犳嵁 -> 鎷︽埅锛岄伩鍏嶈鐩?occupancy 閫犳垚閲嶅彔澶辫仈
	if occupancy.has(target_cell) and occupancy[target_cell] != u:
		_finish_move(u, for_enemy)
		return
	# AI 璁″垝涓嶅簲钀藉埌闅滅鏍硷紙闃插尽鎬ф嫤鎴級
	if obstacles.has(target_cell):
		_finish_move(u, for_enemy)
		return
	# 澧撶鏍奸樆鎸＄Щ鍔紙闃插尽鎬ф嫤鎴級
	if graves.has(target_cell):
		_finish_move(u, for_enemy)
		return
	state = State.ANIMATING
	# 璁板綍绉诲姩璺濈锛堝ぇ澶ч獞澹啿閿嬪姞鎴?/ 椋庤鑰呴槦鍙嬪洖琛€鐢級銆?	# 澶уぇ楠戝＋鐨勫啿閿嬪姞鎴愬湪涓嬫柟璺緞绠楀畾鍚庢寜"瀹為檯鍐插埌鏍兼暟"缁熶竴缁撶畻锛堝惈琚樆鎸″壀瑁佺殑鎯呭喌锛夈€?	u.last_move_dist = grid.distance(u.cell, target_cell)
	# 閫愭牸璺緞锛堟部鏍煎瓙璧帮紱鍐查攱涓虹洿绾挎牸鍒楋紱瀵昏矾澶辫触鍒欑洿濂旂洰鏍囷級銆?	# 澶ч獞澹啿閿嬶細閫愭牸妫€鏌ラ樆鎸★紝閫斾腑閬囬殰纰?澧撶/鍏朵粬鍗曚綅鍗冲仠鍦ㄩ樆鎸″墠鈥斺€?	# 鐜╁ UI 鐨勫彲杈炬牸鏈氨鎸″锛堣 _move_reachable锛夛紝姝ゅ鍏滃簳 AI/鑱旀満鎸囦护璇畻绌垮銆?	var path: Array
	if u.hero_id == "hero_24":
		path = []
		for c in _charge_line_cells(u.cell, target_cell):
			if occupancy.has(c) or obstacles.has(c) or graves.has(c):
				break
			path.append(c)
			if c == target_cell:
				break
	else:
		path = grid.find_path(u.cell, target_cell, _current_path_blockers(u))
		if path.size() == 0 or path.back() != target_cell:
			path = [target_cell]
	# 闃插尽锛氭棤璁鸿皟鐢ㄦ柟浼犲叆澶氳繙鐨勭洰鏍囷紝鍗曟绉诲姩涓嶅緱瓒呰繃鍗曚綅鐨勫疄闄呯Щ鍔ㄥ姏銆?	# 鎶婅矾寰勬埅鏂埌鏈夋晥绉诲姩鍔涙鏁帮紝鏉滅粷鏁屾柟 AI 璁″垝鍋忓樊/鍋忕Щ瀵艰嚧瓒?绋嬬Щ鍔ㄣ€?	var max_steps := u.effective_move()
	if u.hero_id == "hero_24":
		max_steps = 60   # 澶ч獞澹啿閿嬶細鐩寸嚎鍐蹭换鎰忚窛绂伙紝涓嶆埅鏂?	if path.size() > max_steps:
		path = path.slice(0, max_steps)
	if path.size() == 0:
		# 鍐查攱涓€姝ユ湭鍔紙闈㈠墠琚尅锛夛細鍘熷湴鏀跺熬锛屼笉浼犻€侊紱鍐查攱鍔犳垚鎸?0 璁?if u.hero_id == "hero_24":
			u.last_move_dist = 0
			u.ramble_bonus = 0
			u.refresh_stats()
		_finish_move(u, for_enemy)
		return
	var final_cell: Vector2i = path[path.size() - 1] if path.size() > 0 else target_cell
	# 鍐查攱琚壀瑁佹椂鎸?瀹為檯鍐插埌鐨勬牸鏁?缁撶畻锛堥伩鍏嶇┛澧欒惤鐐瑰墠鐨勫姞鎴愯櫄楂橈級
	if u.hero_id == "hero_24":
		u.last_move_dist = path.size()
		u.ramble_bonus = u.last_move_dist
		u.refresh_stats()
	occupancy.erase(u.cell)
	u.cell = final_cell
	occupancy[final_cell] = u
	_animate_step_path(u, path, 0, for_enemy)

# 娌胯矾寰勯€愭牸鎺ㄨ繘锛堟瘡鏍间竴灏忔锛岃蛋瀹屽啀缁撶畻锛?func _animate_step_path(u: Unit, path: Array, idx: int, for_enemy: bool) -> void:
	if u == null or not is_instance_valid(u):   # 闃插尽锛氬崟浣嶅凡閲婃斁鍒欏仠姝?return
	if idx >= path.size():
		_finish_move(u, for_enemy)
		return
	var cell: Vector2i = path[idx]
	var t := create_tween()
	t.tween_property(u, "position", board_view.cell_world_center(cell), 0.2)   # 姣忔牸绉诲姩鐣ユ斁鎱?	t.tween_callback(func():
		# 鐐稿脊锛氱粡杩囨垨韪忎笂鐐稿脊鏍煎嵆鐖嗙偢锛堢偢寮逛汉闄ゅ锛夛紱鐖嗙偢鑷存鍒欏仠姝㈠墠杩涗絾浠嶅畬鎴愮Щ鍔ㄦ敹灏?if _bomb_enter_check(u, cell, for_enemy):
			_animate_step_path(u, path, idx + 1, for_enemy)
		else:
			_finish_move(u, for_enemy))

# 杩涘叆涓€鏍兼椂妫€娴嬬偢寮癸細闈炵偢寮逛汉缁忚繃/韪忎笂鍗冲紩鐖嗐€傝繑鍥?true 琛ㄧず鍗曚綅浠嶅彲缁х画鍓嶈繘銆?func _bomb_enter_check(u: Unit, cell: Vector2i, _for_enemy: bool) -> bool:
	if u == null or not is_instance_valid(u):
		return true   # 鍗曚綅宸查噴鏀撅細涓嶅啀缁х画鍒ょ偢寮癸紝瀹夊叏閫€鍑?	if u.hero_id == "hero_35":
		return true   # 鐐稿脊浜猴細纰?缁忕偢寮瑰畨鍏?	if not bombs.has(cell):
		return true
	bombs.erase(cell)
	if board_view:
		board_view.bombs = bombs
		board_view.queue_redraw()
	log_message.emit("%s 韪╀腑鐐稿脊锛? % u.display_name)
	u.take_damage(5)
	return u.alive   # 鐖嗙偢鑷存 -> 鍋滄鍓嶈繘锛堜笉鍐嶈蛋瀹屽墿浣欒矾寰勶級

# 缁熶竴鐐稿脊瑙﹀彂锛氫换鎰忔柟寮忥紙鍑婚€€/鎷夎繎/鎹綅/鐬Щ/闅忔満姝モ€︼級璁╃偢寮逛汉浠ュ鐨勫崟浣嶅嚭鐜板湪鐐稿脊鏍间笂閮戒細寮曠垎銆?# 妫€鏌?unit 褰撳墠鎵€鍦ㄦ牸锛涜嫢涓虹偢寮规牸涓旈潪鐐稿脊浜哄垯鐖嗙偢銆備緵鍚勪綅绉昏惤鐐硅皟鐢ㄣ€?func _trigger_bomb(u: Unit) -> void:
	if u == null or not is_instance_valid(u) or u.hero_id == "hero_35":
		return   # 鐐稿脊浜哄畨鍏紱闈炲崟浣?宸查噴鏀捐烦杩?	if not bombs.has(u.cell):
		return
	bombs.erase(u.cell)
	if board_view:
		board_view.bombs = bombs
		board_view.queue_redraw()
	log_message.emit("%s 韪╀腑鐐稿脊锛? % u.display_name)
	u.take_damage(5)

# 鍐查攱锛坔ero_24锛夛細浠?from 娌挎煇鏉?*杞村悜**鐩寸嚎鏂瑰悜閫愭牸鐩村埌 to 鐨勭洿绾挎牸鍒?func _charge_line_cells(from: Vector2i, to: Vector2i) -> Array:
	var dirs: Array[Vector2i] = [Vector2i(1, 0), Vector2i(0, 1), Vector2i(-1, 1), Vector2i(-1, 0), Vector2i(0, -1), Vector2i(1, -1)]
	var fa := grid.axial_of(from)
	var ta := grid.axial_of(to)
	for d in dirs:
		var path: Array = []
		var cur := fa
		for i in range(60):
			cur += d
			var off := grid.offset_of(cur)
			if not grid.in_bounds(off):
				break
			path.append(off)
			if cur == ta:
				return path
	return [to]

# 璁＄畻褰撳墠鍗曚綅绉诲姩鏃剁殑閫氳闃绘尅锛堜笌 _move_reachable 鐨?path_blockers 涓€鑷达級
func _current_path_blockers(u: Unit) -> Dictionary:
	var blockers := occupancy.duplicate()
	if u.skills.has(DataRegistry.Skill.INFILTRATE):
		blockers = {}
		for c in occupancy.keys():
			if occupancy[c].faction == u.faction:
				blockers[c] = true
		# 娓楅€忥細闅滅/澧撶鍙┛琛岋紝涓嶄綔涓洪樆鎸?	else:
		for oc in obstacles.keys():
			blockers[oc] = true
		for g in graves.keys():
			blockers[g] = true
	return blockers

# 鍏堢Щ鍔ㄥ埌鎸囧畾鏍笺€佸啀鏀诲嚮鍚屼竴鐩爣锛堝悎骞剁殑"绉诲姩+鏀诲嚮"锛?func _finish_move(u: Unit, for_enemy: bool) -> void:
	if u == null or not is_instance_valid(u):   # 闃插尽锛氬崟浣嶅凡閲婃斁鍒欒烦杩?return
	var prev_move_buff := u.move_use_buff   # 绉诲姩寮€濮嬪墠宸叉湁鐨勭Щ鍔?buff锛堟湰娆＄Щ鍔ㄥ簲娑堣€楃殑閮ㄥ垎锛?	u.moved_this_turn = true
	# 椋庤鑰呭厜鐜細璇ラ樀钀ユ湁椋庤鑰呮椂锛屽叾浠栭槦鍙嬫寜绉诲姩璺濈鍥炶锛堥璇€呮湰浜轰笉鍦ㄥ厜鐜唴锛?	if u.alive and u.hero_id != "hero_43" and _has_wind_speaker(u.faction) and u.last_move_dist > 0:
		_heal(u, u.last_move_dist)
		log_message.emit("%s 绉诲姩 %d 鏍硷紝椋庤鑰呬护鍏跺洖澶?%d 鐐圭敓鍛姐€? % [u.display_name, u.last_move_dist, u.last_move_dist])
	# 鐐稿脊鐖嗙偢锛氶潪鐐稿脊浜鸿笍涓婄偢寮规牸锛堝凡鐢?_bomb_enter_check 鍦ㄩ€愭牸鍔ㄧ敾涓鐞嗭細缁忚繃鎴栧仠鐣欏潎鐖嗙偢锛?	# 澧炵泭閬撳叿/閲戠熆锛氭嬀鍙栧姞鎴?	if buff_items.has(u.cell):
		var btype: String = buff_items[u.cell]
		if btype == "gold" and u.hero_id != "hero_42":
			# 閲戠熆鍙湁榛勯噾鐭垮伐鍙嬀鍙栵細鍏朵粬鍗曚綅韪╁埌涓嶆秷璐广€侀噾鐭夸繚鐣欏湪鏍间笂
			pass
		else:
			buff_items.erase(u.cell)
			if btype == "atk":
				u.atk_use_buff += 1   # 涓€娆℃€э細涓嬩竴娆℃敾鍑?1锛屾敾鍑荤粨绠楀悗娑堝け
				u.refresh_stats()
				log_message.emit("%s 鎷惧彇鏀诲嚮閬撳叿锛氫笅涓€娆℃敾鍑?+1锛? % u.display_name)
			elif btype == "move":
				u.move_use_buff += 1   # 涓€娆℃€э細涓嬩竴娆＄Щ鍔?1锛岀Щ鍔ㄥ悗娑堝け
				log_message.emit("%s 鎷惧彇绉诲姩閬撳叿锛氫笅涓€娆＄Щ鍔ㄥ姏 +1锛? % u.display_name)
			elif btype == "heal":
				var g := mini(3, u.max_hp - u.hp)
				_heal(u, 3)
				log_message.emit("%s 鎷惧彇鍥炶閬撳叿锛屾仮澶?%d 鐐圭敓鍛斤紒" % [u.display_name, g])
			elif btype == "shield":
				u.add_status("shield")   # 鍦ｇ浘锛氭姷鎸′竴娆″彈鍒扮殑浼ゅ锛堥潪鍙犲姞锛?u.refresh_stats()
				log_message.emit("%s 鎷惧彇鎶ょ浘閬撳叿锛岃幏寰梉鍦ｇ浘]锛? % u.display_name)
			elif btype == "gold":
				u.atk += 1
				u.perm_atk += 1   # 姘镐箙鍔犳垚锛屽彉韬椂淇濈暀
				u.max_hp += 3
				u.hp = min(u.hp + 3, u.max_hp)
				u.refresh_stats()
				log_message.emit("%s 鎷惧彇閲戠熆锛佹敾鍑?1銆佽閲忎笂闄?3銆? % u.display_name)
			_refresh_board()
	# 鍏堝埛鏂?杩滅▼琚创韬?鐘舵€侊紝鍐嶈Е鍙戠Щ鍔ㄥ悗鎶€鑳解€斺€斿尰鎶ゅ叺绛夌敤"绉诲姩鍚?鏀诲嚮鍔?璐磋韩鐘舵€佺粨绠?	# 锛堣嫢璐磋韩鍒锋柊鍦ㄦ妧鑳戒箣鍚庯紝杩滅▼鍖荤枟鍏佃劚绂昏创韬椂鐨勬不鐤椾細浠嶆寜璐磋韩鐨?鏀诲嚮绠楋級銆?	_sync_ranged_adjacent()
	if u.alive:
		_trigger_on_move(u)   # 绉诲姩鍚庢妧鑳斤紙鍖绘姢鍏?鐑涚伀/闆嫵/鏈棩绛夛級
	# 鍦ｈ癁鑰佷汉绉诲姩 buff锛氬彧娓呮帀"鏈绉诲姩寮€濮嬪墠宸叉湁鐨?锛堟湰娆＄Щ鍔ㄤ娇鐢級锛屾湰娆℃墠鎹″埌鐨勪繚鐣欑粰涓嬩竴娆＄Щ鍔ㄣ€?	# 鍥犱负鎹?buff 闈犺蛋杩囧幓锛屾鏃舵湰娆＄Щ鍔ㄥ凡缁撶畻锛屼笉搴旀妸鏂版崱鐨勫綋浣滆鏈绉诲姩鐢ㄦ帀銆?	if prev_move_buff > 0:
		u.move_use_buff = maxi(u.move_use_buff - prev_move_buff, 0)
		u.refresh_stats()
	_clear_selection()
	if for_enemy:
		action_finished.emit()   # 鏁屾柟绉诲姩鍔ㄧ敾+缁撶畻缁撴潫锛岄€氱煡鍥炴斁缁х画
		return
	# 鐐稿脊浜猴細寰呴€夋牸鏀剧偢寮?	if _pending_bomb_unit == u:
		state = State.PLACE_BOMB
		_begin_bomb_place(u)
		return
	_continue_after_move(u)

# 绉诲姩鍚庣殑閫氱敤鏀跺熬锛氳繕鑳芥敾鍑诲垯缁х画閫変腑璇ュ崟浣嶏紝鍚﹀垯杩涘叆鍥炲悎缁撴潫鍒ゆ柇
func _continue_after_move(u: Unit) -> void:
	# 鍚庡嫟涓嶈兘涓诲姩鏀诲嚮锛氱Щ鍔ㄥ悗鍗冲畬鎴愶紝鐩存帴杩涘叆鍥炲悎缁撴潫鍒ゆ柇
	if _is_logistics(u):
		_after_player_action()
		return
	if not u.attacked_this_turn:
		state = State.PLAYER_INPUT
		_do_select(u)
		return
	_after_player_action()

# ---- 鏀诲嚮锛堝惈杩戞垬鍙嶅嚮锛?---
func _do_attack(attacker: Unit, target: Unit, for_enemy: bool) -> void:
	state = State.ANIMATING
	_clear_selection()
	AudioManager.play("attack")
	log_message.emit("%s 鏀诲嚮 %s銆? % [attacker.display_name, target.display_name])
	# 杩滅▼涓旈潪璐磋韩锛堣窛绂?1锛夛細鍙戝皠鎶曟幏鐗╅鍚戠洰鏍囷紝鍛戒腑鍚庣粨绠楋紙涓嶈创韬獊杩涳級
	if attacker.attack_type == DataRegistry.AttackType.RANGED and grid.distance(attacker.cell, target.cell) > 1:
		_launch_projectile(attacker, target, for_enemy)
		return
	# 杩戞垬 / 杩滅▼璐磋韩锛堣窛绂?1锛夛細鍘熷湴鍑烘嫑锛堝幓鎺夌獊杩涘啿閿嬶級锛屽懡涓悗缁撶畻锛堜細琚弽鍑伙級
	_play_melee_hit(attacker, target, for_enemy)

# 杩戞垬鍑烘嫑锛氭敾鍑昏€呭悜鐩爣灏忓箙鍓嶅啿鍋氭敾鍑诲姩鐢伙紝鍛戒腑鍚庣粨绠椾激瀹炽€?# 缁撶畻瀹屽叏缁撴潫鍚庯紝鎵嶈疆鍒板弽鍑伙紙鍏堟敾鍑伙紝鍚庡弽鍑伙紝鍔ㄧ敾涓庣粨绠楀垎寮€鍛堢幇锛夈€?func _play_melee_hit(attacker: Unit, target: Unit, for_enemy: bool) -> void:
	if attacker == null or not is_instance_valid(attacker) or target == null or not is_instance_valid(target):
		_finish_attack(attacker, for_enemy)
		return
	var apos := board_view.cell_world_center(attacker.cell)
	var hit_to := apos.lerp(board_view.cell_world_center(target.cell), 0.35)   # 鏀诲嚮鑰呰交鍐叉帴杩?	var t := create_tween()
	t.tween_property(attacker, "position", hit_to, 0.12)
	t.tween_callback(func():
		if attacker == null or not is_instance_valid(attacker):
			return   # 鏀诲嚮鑰呭湪鍑烘嫑婕斿嚭鏈熼棿琚噴鏀撅細涓鏈杩戞垬鍔ㄧ敾閾?		# 鍛戒腑锛氬洖鍒板師浣嶏紝鍐嶇粨绠椾激瀹?var back := create_tween()
		back.tween_property(attacker, "position", apos, 0.1)
		back.tween_callback(func(): _apply_attack(attacker, target, for_enemy)))

# 杩滅▼鏀诲嚮婕斿嚭锛氬嚭鐢熺偣鐢熸垚鎶曞奖鐗╋紝娌跨洿绾块鍒扮洰鏍囧苟鍛戒腑
func _launch_projectile(attacker: Unit, target: Unit, for_enemy: bool) -> void:
	var from := board_view.cell_world_center(attacker.cell)
	var to := board_view.cell_world_center(target.cell)
	var proj := Projectile.new()
	proj.position = from
	# 鏈濆悜鐩爣锛屾嫋灏捐嚜鐒舵寚鍚戦琛屽弽鏂瑰悜
	proj.rotation = (to - from).angle()
	add_child(proj)
	var flight := clampf(grid.distance(attacker.cell, target.cell) * 0.08, 0.15, 0.4)
	var t := create_tween()
	t.tween_property(proj, "position", to, flight).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	t.tween_callback(func():
		proj.queue_free()
		_apply_attack(attacker, target, for_enemy))

func _apply_attack(attacker: Unit, target: Unit, for_enemy: bool) -> void:
	if attacker == null or not is_instance_valid(attacker) or target == null or not is_instance_valid(target):
		if for_enemy:
			action_finished.emit()   # 鎹曡幏鍗曚綅宸查噴鏀撅細鏁屾柟鍥炴斁浠嶉』鏀捐锛岄伩鍏嶅崱姝?return   # 鎹曡幏鍗曚綅宸查噴鏀撅紙tween 鍥炶皟鏈熼棿琚?free锛夛細瀹夊叏閫€鍑?	var dmg := _attack_damage(attacker) * _bonus_damage(attacker, target)
	_attack_hp_before = target.hp   # 璁板綍鏀诲嚮鍓嶈閲忥紝渚涙敾鍑诲悗鎶€鑳藉垽瀹氾紙鍙ゆ媺鍚歌绛夛級
	# 鏀诲嚮鑰呬笓灞炴垬鏂楃壒鏁堬紙璐村悎鑻遍泟鏈哄埗锛?	if attacker.alive and attacker.hero_id == "hero_30" and target != null and is_instance_valid(target):
		# 瀣夌毊姝荤锛氫笓灞為暟鍒€寮у舰鏀跺壊锛堝敮涓€鐗规晥锛屼笉鍙犲姞閫氱敤鍏夌幆锛岀獊鍑?姝荤闀板垁"锛?_spawn_scythe(attacker, target)
	if target.alive:
		# 闀胯鏈矇榛橈細鐢?on_attack 缁熶竴缁撶畻鍩虹浼ゅ锛堝嚮閫€鈫?鍊嶏紝涓嶈兘鈫?鍊嶅崟娆★級锛?		# 闀胯琚矇榛橈細鍙仛鍩虹鏀诲嚮浼ゅ锛堟妧鑳藉嚮閫€/2鍊嶅け鏁堬級銆?if not _hero(attacker).handles_base_damage() or not attacker.skill_allowed():
			target.take_damage(dmg)
	_last_attacked = target
	# 鏀诲嚮鍚庢妧鑳藉湪**鍛戒腑鐬棿**瑙﹀彂锛堝鎴橀敜鏀婚檷/鍐板喕锛夛紝璁╁弽鍑荤粨绠楁椂宸插悆鍒?debuff
	_trigger_on_attack(attacker, _last_attacked, for_enemy)
	# 澶槼鏂╋細姣忔鏀诲嚮鍚庢敾鍑诲姏-1锛堢珛鍗虫樉绀猴紝涓嶇瓑鍙嶅嚮锛?	_hero(attacker).on_after_attack()
	# 鍙嶅嚮锛氬悗鍕ゅ崟浣嶄篃浼氬弽鍑伙紙鍚庡嫟涓嶈兘涓诲姩鏀诲嚮锛屼絾琚繎鎴樻敾鍑诲悗浼氳繕鎵嬶級銆?	# 鏅€氬崟浣嶉粯璁ゆ瘡鍥炲悎鍙兘鍙嶅嚮涓€娆★紱澶嶄粐鑰咃紙鏃犻檺鍙嶅嚮锛変笉鍙?宸茬敤杩囦竴娆?闄愬埗銆?	var can_counter := target.alive and target.can_attack() and grid.distance(attacker.cell, target.cell) == 1 and (not target.counter_used_this_turn or _hero(target).infinite_counter())
	if can_counter:
		target.counter_used_this_turn = true
	_clear_selection()
	# 鏀诲嚮缁撶畻瀹屾垚锛氱◢浣滃仠椤胯鏀诲嚮鍛戒腑鍛堢幇瀹屾暣锛屽啀寮€濮嬪弽鍑伙紙鍏堟敾鍑汇€佸悗鍙嶅嚮锛屽姩鐢讳笌缁撶畻閿欏紑锛?	if can_counter:
		var gap := create_tween()
		gap.tween_interval(0.15)
		gap.tween_callback(func(): _play_counter(attacker, target, for_enemy))
	else:
		_finish_attack(attacker, for_enemy)

# 鍙嶅嚮婕斿嚭锛氬弽鍑昏€呭悜鏀诲嚮鑰呰交鍐蹭竴涓嬪啀缁撶畻浼ゅ锛岄殢鍚庡洖鍒板師浣?func _play_counter(attacker: Unit, target: Unit, for_enemy: bool) -> void:
	if not is_instance_valid(target) or not is_instance_valid(attacker):
		_finish_attack(attacker, for_enemy)
		return
	var counterer := target
	# 鍙嶅嚮鍓嶅厛鍚屾"杩滅▼琚创韬?鐘舵€侊細鎴橀敜鏀婚檷(-1)绛?debuff 宸插湪鍛戒腑鏃舵柦鍔狅紝
	# 鑰岃繙绋嬭璐磋韩鏃跺熀纭€鏀诲嚮搴旈檷涓?锛堣嫢涓嶅悓姝ワ紝鍙嶅嚮鑰呬細鎸夋湭璐磋韩鐨勫熀纭€鏀诲嚮鍙嶅嚮锛屼激瀹抽敊璇亸楂橈級
	_sync_ranged_adjacent()
	var cpos := board_view.cell_world_center(counterer.cell)   # 钀界偣=鑷韩鏍煎瓙涓績锛堜笉鍙椾腑閫旀崲浣?鐬Щ褰卞搷锛?	var lunge_to := cpos.lerp(board_view.cell_world_center(attacker.cell), 0.62)   # 娌垮弽鍚戠洿绾胯交鍐?	# 鍙嶅嚮浼ゅ = 鍙嶅嚮鑰?*瀹炴椂鏀诲嚮鍊?*锛堝惈buff/鏀婚檷/鍐查攱鍔犳垚锛屼笉濂楃敤杩滅▼鐩搁偦闄嶆敾锛?	var cdmg := counterer.effective_atk() * _counter_bonus(counterer, attacker)
	AudioManager.play("attack")
	var ct := create_tween()
	ct.tween_property(counterer, "position", lunge_to, 0.1)
	ct.tween_callback(func():
		if not is_instance_valid(counterer):
			_finish_attack(attacker, for_enemy)
			return   # 鍙嶅嚮鑰呭湪婕斿嚭鏈熼棿琚噴鏀撅細璺宠繃鍙嶅嚮锛屾甯告敹灏?if is_instance_valid(attacker):
			log_message.emit("%s 鍙嶅嚮 %s锛岄€犳垚 %d 浼ゅ锛? % [counterer.display_name, attacker.display_name, cdmg])
			attacker.take_damage(cdmg, false, true)
		var br := create_tween()
		br.tween_property(counterer, "position", cpos, 0.12)
		br.tween_callback(func():
			# 澶槼鏂╋細姣忔鍙嶅嚮鍚庢敾鍑诲姏-1锛岀洿鍒版仮澶嶆甯?if is_instance_valid(counterer) and counterer.alive:
				_hero(counterer).on_after_counter()
			_finish_attack(attacker, for_enemy)))

func _finish_attack(attacker: Unit, for_enemy: bool) -> void:
	# 鏀诲嚮鑰呭彲鑳藉凡鍦ㄦ紨鍑洪摼涓樀浜?琚噴鏀撅紙鍙嶅嚮銆佺偢寮广€佸厜鐜弽浼ょ瓑锛夛細
	# 鍙湪鏈浠嶅瓨娲绘椂鏀瑰叾鐘舵€侊紱娴佺▼蹇呴』鐓у父鎺ㄨ繘锛屽惁鍒欐晫鏂瑰洖鏀句細鍗℃銆?	var alive_attacker := attacker != null and is_instance_valid(attacker) and attacker.alive
	if alive_attacker:
		attacker.attacked_this_turn = true
		# 鍦ｈ癁鑰佷汉鏀诲嚮 buff锛氭湰娆℃敾鍑诲凡鐢ㄦ帀锛屾晥鏋滄秷澶?if attacker.atk_use_buff > 0:
			attacker.atk_use_buff = 0
			attacker.refresh_stats()
	_sync_ranged_adjacent()   # 鏀诲嚮鍚庯紙鎹綅/鍑婚€€/鎷夎繎锛夌浉閭诲叧绯诲彉鍖栵細鍒锋柊杩滅▼琚创韬姸鎬?	if _check_win():
		return
	if for_enemy:
		action_finished.emit()   # 鏁屾柟鏀诲嚮锛堝惈鍙嶅嚮锛夋紨鍑虹粨鏉燂紝閫氱煡鍥炴斁缁х画
		return
	# 杩樿兘绉诲姩 -> 缁х画閫変腑璇ュ崟浣?	if alive_attacker and not attacker.moved_this_turn:
		state = State.PLAYER_INPUT
		_do_select(attacker)
		return
	_after_player_action()

func _after_player_action() -> void:
	if _has_remaining_player():
		state = State.PLAYER_INPUT
		# 涓嶈嚜鍔ㄩ€変腑涓嬩竴涓紝鐢辩帺瀹剁偣鍑伙紙涔熷彲鐐圭粨鏉熷洖鍚堟彁鍓嶇粨鏉燂級
		action_info.emit("杩樻湁鑻遍泟鏈畬鎴愯鍔細鐐瑰嚮閫夋嫨锛屾垨鐐广€岀粨鏉熷洖鍚堛€嶃€?)
	else:
		# 鎴戞柟鑻遍泟鍏ㄩ儴琛屽姩瀹屾瘯锛氫笉鑷姩缁撴潫鍥炲悎锛屾彁绀虹帺瀹舵墜鍔ㄧ偣銆岀粨鏉熷洖鍚堛€?state = State.PLAYER_INPUT
		action_info.emit("鎵€鏈夎嫳闆勫凡瀹屾垚琛屽姩锛岀偣銆岀粨鏉熷洖鍚堛€嶄氦缁欐晫鏂广€?)

# 鏌愬崟浣嶆槸鍚﹀凡瀹屾垚鏈洖鍚堬紙绉诲姩+鏀诲嚮鍚勪竴娆★級
# 鏌愬崟浣嶆槸鍚﹀凡瀹屾垚鏈洖鍚堬紙绉诲姩+鏀诲嚮鍚勪竴娆★紱鍚庡嫟涓嶈兘鏀诲嚮锛岀Щ鍔ㄥ悗鍗冲畬鎴愶級
func _is_done(u: Unit) -> bool:
	if _is_logistics(u):
		return u.moved_this_turn   # 鍚庡嫟锛氬彧绉诲姩锛岀Щ鍔ㄥ悗鍗崇畻瀹屾垚
	return u.moved_this_turn and u.attacked_this_turn

func _has_remaining_player() -> bool:
	for u in units:
		if u.alive and u.faction == _my_faction() and not _is_done(u):
			return true
	return false

func _end_player_side() -> void:
	_end_side(GameState.SIDE_PLAYER)

# 缁撴潫鏌愪竴鏂瑰洖鍚堛€俿ide = 鍒氱粨鏉熻鍔ㄧ殑涓€鏂广€?# 鑱旀満涓嬩粎鍦ㄤ富鏈烘墽琛岋紙涓绘満鏄洖鍚堟帹杩涚殑鍞竴鏉冨▉锛夛紝闅忓悗骞挎挱 begin_side 缁欏鎴风鍚屾銆?func _end_side(side: int) -> void:
	if _check_win():
		return
	_ending_side = true   # 缁撴潫/缁撶畻鏈熼棿闃典骸鐨勬浛琛ヤ竴寰嬫帹杩熷埌鏈柟涓嬪洖鍚堝啀琛?	state = State.ANIMATING   # 鍥炲悎缁撴潫鎶€鑳介€愪釜瑙﹀彂鏈熼棿閿佸畾杈撳叆
	_clear_selection()       # 缁撴潫鍥炲悎锛氭竻闄ら€変腑鍗曚綅鍙婂叾绉诲姩/鏀诲嚮鑼冨洿楂樹寒锛岄伩鍏嶆畫鐣?	await _trigger_turn_end_all(side_faction(side))
	_clear_statuses(side_faction(side))
	# 绗?11 鍥炲悎璧凤細鏈柟鍥炲悎缁撴潫鍙墸鏈柟鐨勮锛堝弻鏂瑰悇鑷洖鍚堢粨鏉熷悇鎵ｅ悇锛屼笉涓€璧锋墸锛?	_settle_side_round_damage(side)
	if GameState.match_over:
		_ending_side = false
		return   # 缁撶畻鎵ｈ瀵艰嚧鏈眬宸茬粨鏉燂紙濡傝秴鍥炲悎鐑ф鍒よ礋锛夛細涓嶅啀鎺ㄨ繘鍥炲悎/寮€涓嬪洖鍚堢晫闈?	_ending_side = false   # 缁撶畻瀹屾瘯锛氫箣鍚庯紙鍚崲杈规紨鍑烘湡闂达級鐨勯樀浜℃仮澶嶆甯告浛琛ヨ鍒?	GameState.end_current_side(_first_side)
	# 鎹㈣竟鍋滈】锛氳"涓婁竴鏂瑰洖鍚堢粨鏉熺殑婕斿嚭"涓?涓嬩竴鏂瑰洖鍚堝紑濮嬭鍔ㄧ殑婕斿嚭"涔嬮棿
	# 鏈夊彲鎰熺煡闂撮殧锛屼笉浼氶灏剧浉杩炪€傚仠椤垮湪 _begin_side 涔嬪墠锛屾晠涔熷厛浜庝笅鍥炲悎琚姩瑙﹀彂銆?	await get_tree().create_timer(0.8).timeout
	# 涓绘満鏉冨▉锛氬厛骞挎挱"鏂板洖鍚堝紑濮?锛坅ctive_side 宸叉帹杩涖€侀檮褰撳墠鍥炲悎鍙凤級锛屽啀鎵ц _begin_side銆?	# 鍗充娇 _begin_side 鍐呴儴鍥犳浛琛ョ瓑鎻愬墠 return锛屽鎴风涔熻兘姝ｇ‘鍚屾骞惰繘鍏ョ瓑寰?鎿嶄綔銆?	if GameState.is_online and GameState.is_host:
		NetBus.send_all(JSON.stringify({ "type": "begin_side", "side": GameState.active_side, "round": GameState.round_number }))
	await _begin_side(GameState.active_side)

# 鑱旀満缁撴潫鍥炲悎鍏ュ彛锛氭垜鏂圭偣"缁撴潫鍥炲悎"銆?func submit_end_turn() -> bool:
	# 浠呭綋鍓嶈鍔ㄦ柟鏄垜鏂规椂鎵嶅彲缁撴潫
	if GameState.active_side != _my_side():
		return false
	if state != State.PLAYER_INPUT:
		return false
	var cmd := { "type": "end_turn", "side": GameState.active_side }
	if not GameState.is_online:
		_end_side(GameState.active_side)
		return true
	# 鑱旀満锛氬洖鍚堟帹杩涚敱涓绘満鍞竴鏉冨▉鎵ц銆傚鎴风鍙妸"鎴戠粨鏉熷洖鍚?鍙戠粰涓绘満锛屼笉鏈湴鎺ㄨ繘銆?	if GameState.is_host:
		# 涓绘満鏈湴鎺ㄨ繘锛坃end_side 鏈熬浼氬箍鎾?begin_side 缁欏鎴风鍚屾锛?_end_side(GameState.active_side)
	else:
		NetBus.send_to(1, JSON.stringify(cmd))
		# 瀹㈡埛绔篃鍚屾娓呮帀鏈樀钀ュ洖鍚堜复鏃剁姸鎬侊紙鐑堢劙绁徃 +1 鏀荤瓑鎸夊洖鍚堢粨鏉熺敓鏁堢殑 buff锛夛紝
		# 鍚﹀垯涓绘満鏉冨▉娓呴櫎鍚庯紝鏈鐢婚潰涓婄殑 buff 浼氳法鍥炲悎娈嬬暀鍙犲姞銆?_clear_statuses(_my_faction())
		# 鏈鍥炲悎宸叉彁浜ょ粨鏉燂細鍦ㄦ敹鍒颁富鏈?begin_side 骞挎挱鍓嶉兘瑙嗕负"鍥炲悎鏈獥鍙?锛?		# 姝ゆ湡闂存湰闃佃惀鍥犵儳琛€/缁撶畻姝讳骸鍙鍚嶉銆佷笉绔嬪嵆寮规浛琛ワ紙閬垮厤鏇胯ˉ閫氶亾鍦ㄥ垏鍥炲悎涓€旇鍗′綇锛夈€?_ending_side = true
		state = State.ANIMATING   # 闃叉鍦ㄤ富鏈哄洖鍖呭墠鍙嶅鐐瑰嚮"缁撴潫鍥炲悎"閲嶅缁撶畻
	return true

func _on_unit_hp_changed(_u: Unit) -> void:
	pass

# 鍗曚綅鍙楀埌浼ゅ鏃惰Е鍙戠殑琚姩鏈哄埗锛堝厜鐜被锛氬湥鍏?濉旂浘/閿ゅご椴紝浜ょ敱鍚勮嫳闆勮剼鏈鐞嗭級
func _on_unit_damaged(u: Unit, amount: int) -> void:
	for s in units:
		if s.alive:
			_hero(s).on_someone_damaged(u, amount)

# 濉旂浘涓诲姩鍑忓厤锛氬湪鐩爣鍙椾激瀹崇粨绠?*涔嬪墠**璋冪敤銆?# 鑻ョ洰鏍囩浉閭绘湁鍚岄樀钀ュ鐩?hero_11)涓旀湰娆′激瀹?1锛屽垯濉旂浘浠ｆ浛鎵垮彈1鐐癸細
# 鐩爣瀹為檯浼ゅ鍑?锛屽鐩炬墸1琛€锛堢洿鎺ユ墸锛岄伩鍏嶉€掑綊鍐嶈Е鍙戝鐩撅級銆?# 杩斿洖鐩爣搴斿彈鍒扮殑瀹為檯浼ゅ銆傚鐩炬湭鐢熸晥鏃惰繑鍥炲師浼ゅ銆?func _bulwark_absorb(target: Unit, dmg: int) -> int:
	if dmg <= 1:
		return dmg
	if target == null or not target.alive:
		return dmg
	for s in units:
		if s.alive and s != target and s.hero_id == "hero_11" and s.faction == target.faction and grid.distance(s.cell, target.cell) == 1:
			# 濉旂浘浠ｆ浛鎵垮彈1鐐癸紙鐩存帴鎵ｈ锛屼笉瑙﹀彂濉旂浘閫掑綊/浼ゅ鍚庨挬瀛愶級
			s.hp = max(s.hp - 1, 0)
			s.hp_changed.emit(s)
			s._update_hp_label()
			if s.hp <= 0:
				s.die()
			log_message.emit("%s 鐨勫鐩句唬鏇挎壙鍙?1 鐐逛激瀹炽€? % s.display_name)
			return dmg - 1
	return dmg

# ============ 瑙掕壊涓撳睘鎶€鑳芥晥鏋滅郴缁?============

# 杩斿洖鏌愬崟浣嶇殑琛屼负鑴氭湰锛堣嫳闆勬妧鑳藉疄鐜帮級銆傚厹搴曡繑鍥?HeroBase 绌哄疄渚嬨€?func _hero(u: Unit) -> HeroBase:
	if u == null or not is_instance_valid(u):
		return HeroBase.new()
	if u.behavior == null:
		u.behavior = HeroRegistry.create(u.hero_id)
		u.behavior.setup(self, u)
	return u.behavior


# 鏀诲嚮/鍙嶅嚮鐨勪激瀹冲€嶇巼锛堜箻鍦ㄥ熀纭€浼ゅ涓婏級
func _bonus_damage(attacker: Unit, target: Unit) -> int:
	if not attacker.skill_allowed():   # 娌夐粯锛氳鍔ㄤ激瀹冲€嶇巼澶辨晥
		return 1
	if attacker.attack_type == DataRegistry.AttackType.RANGED and _has_enemy_adjacent(attacker):
		return 1   # 杩滅▼琚创韬細涓嶈Е鍙戜激瀹冲€嶇巼鎶€鑳?	return _hero(attacker).damage_mult(target)

func _counter_bonus(defender: Unit, _attacker: Unit) -> int:
	if not defender.skill_allowed():   # 娌夐粯锛氬弽鍑诲€嶇巼澶辨晥
		return 1
	return _hero(defender).counter_mult()

func _is_lowest_hp(u: Unit) -> bool:
	var lowest := u.hp
	for v in units:
		if v.alive and v.hp < lowest:
			return false
	return true

# 鐩爣鏄惁鏈笌鍏朵粬鏁屼汉鐩搁偦锛堟帓闄ゆ敾鍑昏€呰嚜韬級
func _is_isolated(target: Unit, attacker: Unit) -> bool:
	# 鍙€冭檻涓庣洰鏍囧悓闃佃惀鐨?鍏朵粬鏁屼汉"锛堝鏀诲嚮鑰呮槸鏁屼汉锛夛紱涓嶇撼鍏ユ敾鍑昏€呴槦鍙嬩笌闅滅鐗?	for v in units:
		if v.alive and v != target and v != attacker and v.faction == target.faction and grid.distance(target.cell, v.cell) == 1:
			return false   # 鏈夊悓闃佃惀鏁屼汉鐩搁偦 鈫?鐩爣涓嶅绔?	return true

# 鏀诲嚮鍚庣殑瑙掕壊涓撳睘鎶€鑳斤紙target 鍙兘涓?null锛?func _trigger_on_attack(u: Unit, target: Unit, _for_enemy: bool) -> void:
	if target == null or not target.alive:
		if target != null and not u.skill_allowed():
			return
		if target != null and u.attack_type == DataRegistry.AttackType.RANGED and _has_enemy_adjacent(u):
			return   # 杩滅▼琚创韬細鎶€鑳芥晥鏋滄棤娉曢€犳垚锛堟浜＄洰鏍囦篃涓€鏍凤級
		if target != null:
			_hero(u).on_attack_dead(target)   # 鐩爣琚墦姝绘椂鐨勪笓灞炴晥鏋滐紙鏆楀煙鍗犳嵁/闀垮墤绌块€?鐧芥父渚燗OE/瓒呮柊鏄熷嚮閫€锛?return
	if not u.skill_allowed():   # 娌夐粯锛氭棤娉曡Е鍙戞敾鍑诲悗鎶€鑳?return
	if u.attack_type == DataRegistry.AttackType.RANGED and _has_enemy_adjacent(u):
		return   # 杩滅▼琚创韬細灏勭▼/鏀诲嚮闄嶄负1锛屼笖鎶€鑳芥晥鏋滄棤娉曢€犳垚
	_hero(u).on_attack(target)

func _add_status_msg(u: Unit, status: String, label: String) -> void:
	u.add_status(status)
	u.refresh_stats()   # 鐘舵€佸彉鍖栧悗鍒锋柊鐗岄潰鏁板€硷紙濡傛敾闄嶅鑷存敾鍑绘暟瀛楀洖钀斤級
	log_message.emit("%s 鑾峰緱[%s]銆? % [u.display_name, label])

# 鏌愭牸鐩搁偦鐨勫绔嬮樀钀ュ崟浣?func _enemies_adjacent_to(cell: Vector2i, faction: int) -> Array:
	var out: Array = []
	for v in units:
		if v.alive and v.faction != faction and grid.distance(cell, v.cell) == 1:
			out.append(v)
	return out

# 鏌愭牸鐩搁偦鐨勯殰纰嶆牸
func _adjacent_obstacles_at(cell: Vector2i) -> Array:
	var out: Array = []
	for n in grid.neighbors(cell):
		if obstacles.has(n):
			out.append(n)
	return out

# 绉诲姩鍚庣殑瑙掕壊涓撳睘鎶€鑳?func _trigger_on_move(u: Unit) -> void:
	if not u.skill_allowed():   # 娌夐粯锛氭棤娉曡Е鍙戠Щ鍔ㄥ悗鎶€鑳?return
	_hero(u).on_move()

# 鍥炲悎寮€濮嬫椂锛堣闃佃惀锛夌殑瑙掕壊鎶€鑳?func _trigger_turn_start(u: Unit) -> bool:
	if not u.skill_allowed():   # 娌夐粯锛氭棤娉曡Е鍙戝洖鍚堝紑濮嬫妧鑳?return false
	var played := _hero(u).on_turn_start()
	if played:
		u.burst_fx(DataRegistry.hero_fx(u.hero_id).color, DataRegistry.hero_fx(u.hero_id).text)
	return played

# 鍥炲悎缁撴潫鏃讹紙璇ラ樀钀ワ級鐨勮鑹叉妧鑳?func _trigger_turn_end(u: Unit) -> bool:
	# 楠烽珔鍏碉細鍥炲悎缁撴潫鏃舵秷鏁ｏ紙骞插噣娣″嚭锛屼笉寮逛激瀹虫暟瀛椼€佷笉瑙﹀彂琚姩闂儊锛?	if u.hero_id == "summon_skeleton":
		log_message.emit("楠烽珔鍏甸殢鍥炲悎缁撴潫鑰屾秷鏁ｃ€?)
		if u.alive:
			u.alive = false
			var dt := create_tween()
			dt.tween_property(u, "modulate:a", 0.0, 0.25)
			dt.tween_callback(func(): _on_unit_died(u))
		return false
	if not u.skill_allowed():   # 娌夐粯锛氭棤娉曡Е鍙戝洖鍚堢粨鏉熸妧鑳斤紙楠烽珔鍏垫秷鏁ｄ笉鍙楀奖鍝嶏級
		return false
	return _hero(u).on_turn_end()

# 鏇胯ˉ鐧诲満鏃惰Е鍙?func _trigger_on_enter(u: Unit) -> void:
	if not u.skill_allowed():   # 娌夐粯锛氭棤娉曡Е鍙戠櫥鍦烘妧鑳?return
	# 鏇胯ˉ涓撳睘鐧诲満鎶€鑳斤紙娉㈢浘/澶槼鏂?姊呮灄/鐚庨鑰咃級
	_hero(u).on_enter()
	# 鍥炲悎寮€濮嬬被鑻遍泟锛堝湥璇炶€佷汉鏀鹃亾鍏?榛勯噾鐭垮伐涓㈢熆/姝荤伒娉曞笀鍙敜绛夛級鏇胯ˉ鐧诲満涔熺珛鍗宠Е鍙戯紝
	# 鍚﹀垯瑕佺瓑鍒颁笅涓繁鏂瑰洖鍚堝紑濮嬶紝鏄惧緱鎶€鑳芥棤鏁堛€?	if u.hero_id != "hero_28":   # 鍙ょ伒绮炬€彉韬悗宸茶嚜琛屽鐞嗗洖鍚堝紑濮嬶紝閬垮厤鍐嶆瑙﹀彂
		if _hero(u).on_turn_start():
			u.burst_fx(DataRegistry.hero_fx(u.hero_id).color, DataRegistry.hero_fx(u.hero_id).text)

# ============ 鏁堟灉鍘熻 ============
func _heal(u: Unit, amt: int) -> void:
	if not u.alive or u.hp >= u.max_hp:
		return
	u.hp = min(u.hp + amt, u.max_hp)
	u.hp_changed.emit(u)
	u._update_hp_label()
	u.float_heal(amt)

func _heal_adjacent_lowest(u: Unit) -> bool:
	var best: Unit = null
	for v in units:
		if v.alive and v.faction == u.faction and grid.distance(u.cell, v.cell) == 1 and v.hp < v.max_hp:
			if best == null or v.hp < best.hp:
				best = v
	if best != null:
		var heal := maxi(1, u.effective_atk())
		_heal(best, heal)
		return true
	return false   # 娌℃湁鍙不鐤楃殑鍙椾激闃熷弸

func _adjacent_enemies(u: Unit) -> Array:
	var out: Array = []
	for v in units:
		if v.alive and v.faction != u.faction and grid.distance(u.cell, v.cell) == 1:
			out.append(v)
	return out

# 涓?x 鍚岄樀钀ヤ笖鐩搁偦鐨勫崟浣嶏紙鐢ㄤ簬"浼ゅ/鍑婚€€鐩爣鐩搁偦鐨勬晫浜?绫绘簠灏勶級
func _same_side_adjacent(x: Unit) -> Array:
	var out: Array = []
	for v in units:
		if v.alive and v != x and v.faction == x.faction and grid.distance(x.cell, v.cell) == 1:
			out.append(v)
	return out

func _has_wind_speaker(faction: int) -> bool:
	for v in units:
		if v.alive and v.faction == faction and v.hero_id == "hero_43":
			return true
	return false

func _adjacent_ally(u: Unit) -> Array:
	var out: Array = []
	for v in units:
		if v.alive and v.faction == u.faction and grid.distance(u.cell, v.cell) == 1:
			out.append(v)
	return out

func _lowest_enemy(u: Unit) -> Unit:
	var best: Unit = null
	for v in units:
		if v.alive and v.faction != u.faction:
			if best == null or v.hp < best.hp:
				best = v
	return best

func _adjacent_obstacles(u: Unit) -> Array:
	var out: Array = []
	for n in grid.neighbors(u.cell):
		if obstacles.has(n):
			out.append(n)
	return out

# 鐐稿脊浜猴細姝ｅ墠鏂癸紙鏈濇晫鏂瑰簳绾挎柟鍚戯級鐨勭浉閭绘牸
func _front_cell(u: Unit) -> Vector2i:
	var best := u.cell
	var best_d := INF
	for n in grid.neighbors(u.cell):
		var d: float
		if u.faction == DataRegistry.Faction.PLAYER:
			# 鐜╁浠庝笅鏂硅繘鏀伙紝姝ｅ墠鏂规湞涓婏紙鍖呭洿鏁屾柟搴曠嚎 y 鏈€灏忥級
			d = grid.cell_to_world(n).y
		else:
			# 鏁屾柟浠庝笂鏂硅繘鏀伙紝姝ｅ墠鏂规湞涓嬶紙鍖呭洿鐜╁搴曠嚎 y 鏈€澶э級
			d = -grid.cell_to_world(n).y
		if d < best_d:
			best_d = d
			best = n
	return best

# 鐐稿脊浜哄懆鍥村彲鏀剧偢寮圭殑绌哄湴锛堢浉閭汇€佺晫鍐呫€佹棤鍗曚綅/闅滅/宸叉湁鐐稿脊锛?func _bomb_spots(u: Unit) -> Array:
	var out: Array = []
	for n in grid.neighbors(u.cell):
		if grid.in_bounds(n) and not occupancy.has(n) and not obstacles.has(n) and not bombs.has(n):
			out.append(n)
	return out

# 杩涘叆鐐稿脊閫夋牸鐘舵€侊細楂樹寒鍙敤绌哄湴锛涙棤绌轰綅鍒欒蛋姝ｅ父鏀跺熬
func _begin_bomb_place(u: Unit) -> void:
	var spots := _bomb_spots(u)
	if spots.size() == 0:
		_pending_bomb_unit = null
		_continue_after_move(u)
		return
	var pc := {}
	for c in spots:
		pc[c] = Color(0.95, 0.62, 0.15, 0.85)   # 姗欒壊鍙斁鐐稿脊
	_preview_cells = pc
	_apply_highlights()
	action_info.emit("%s锛氶€夋嫨涓€澶勭┖鍦版斁缃偢寮广€? % u.display_name)

# 鐐归€夋斁鐐稿脊鏍硷紙鍗曟満鐩存帴鏀撅紱鑱旀満璧版寚浠ゆ祦锛氫富鏈烘潈濞佹墽琛屽苟骞挎挱锛屽鎴风鍙戠粰涓绘満锛?func _submit_bomb_place(cell: Vector2i) -> bool:
	if _pending_bomb_unit == null:
		return false
	if not GameState.is_online:
		return _try_place_bomb(cell)
	var u := _pending_bomb_unit
	var cmd := { "type": "bomb", "u": units.find(u), "cell": [cell.x, cell.y] }
	if GameState.is_host:
		apply_command(cmd)
		NetBus.send_all(JSON.stringify(cmd))
	else:
		NetBus.send_to(1, JSON.stringify(cmd))
	return true

# 鍗曟満鏈湴鏀剧疆锛堜繚鐣?閫夐敊鍙噸閫?浜や簰锛?func _try_place_bomb(cell: Vector2i) -> bool:
	if _pending_bomb_unit == null:
		return false
	var u := _pending_bomb_unit
	if _apply_bomb_placement(u, cell):
		_pending_bomb_unit = null
		_preview_cells = {}
		_apply_highlights()
		_continue_after_move(u)
		return true
	action_info.emit("璇风偣鍑荤偢寮逛汉鐩搁偦鐨勭┖鍦版斁缃偢寮广€?)
	_pending_bomb_unit = u
	state = State.PLACE_BOMB
	_begin_bomb_place(u)
	return false

# 鑱旀満鐐稿脊鎸囦护钀藉湴锛堜富鏈烘墽琛?/ 瀹㈡埛绔洖鏀撅級锛氭牎楠岃惤鐐瑰悗鏀剧疆骞剁户缁Щ鍔ㄥ悗娴佺▼
func _apply_bomb_cmd(u: Unit, cell: Vector2i) -> void:
	if u == null or not is_instance_valid(u) or not u.alive:
		return
	if not _apply_bomb_placement(u, cell):
		return   # 闈炴硶钀界偣锛圲I 宸茶繃婊わ紝姝ゅ鍏滃簳锛夛細蹇界暐锛屼笉鎺ㄨ繘娴佺▼
	_pending_bomb_unit = null
	_preview_cells = {}
	_apply_highlights()
	_continue_after_move(u)

# 鐐稿脊钀界偣鍏叡鏍￠獙骞舵斁缃紙鍗曟満 / 鑱旀満涓绘満 / 鍥炴斁绔叡鐢ㄥ悓涓€瑙勫垯锛?func _apply_bomb_placement(u: Unit, cell: Vector2i) -> bool:
	if u == null or not is_instance_valid(u):
		return false
	if cell == u.cell or not grid.in_bounds(cell) or grid.distance(u.cell, cell) != 1 \
			or occupancy.has(cell) or obstacles.has(cell) or bombs.has(cell):
		return false
	bombs[cell] = true
	if board_view:
		board_view.bombs = bombs
		board_view.queue_redraw()
	log_message.emit("%s 鍦?%s 鏀剧疆浜嗙偢寮广€? % [u.display_name, str(cell)])
	return true

func _knockback(target: Unit, from_cell: Vector2i) -> bool:
	# 鍙"from -> target"鐩寸嚎姝ｅ悗鏂归偅涓€鏍硷紝骞舵牎楠屽畠纭疄绱ч偦鐩爣涓旀洿杩滅鏀诲嚮鑰?	var from_axial := grid.axial_of(from_cell)
	var target_axial := grid.axial_of(target.cell)
	var step := target_axial - from_axial
	if step == Vector2i.ZERO:
		return false
	var best := grid.offset_of(target_axial + step)
	var target_dist := grid.distance(from_cell, target.cell)
	# 鏍￠獙锛歜est 椤荤揣閭荤洰鏍?璺濈1)锛屼笖姣旂洰鏍囩鏀诲嚮鑰呮洿杩滀竴鏍硷紙鍦ㄦ鍚庢柟鐩寸嚎涓婏級
	if not grid.in_bounds(best) or occupancy.has(best) or obstacles.has(best) or graves.has(best):
		return false
	if grid.distance(target.cell, best) != 1 or grid.distance(from_cell, best) != target_dist + 1:
		return false
	occupancy.erase(target.cell)
	target.cell = best
	occupancy[best] = target
	_trigger_bomb(target)   # 琚嚮閫€鍒扮偢寮规牸锛氱偢寮逛汉浠ュ鍗冲紩鐖?	var t := create_tween()
	t.tween_property(target, "position", board_view.cell_world_center(best), 0.18)
	return true

func _swap_units(a: Unit, b: Unit) -> void:
	var ca := a.cell
	var cb := b.cell
	occupancy.erase(ca)
	occupancy.erase(cb)
	a.cell = cb
	b.cell = ca
	occupancy[cb] = a
	occupancy[ca] = b
	_trigger_bomb(a)
	_trigger_bomb(b)
	var t := create_tween()
	t.tween_property(a, "position", board_view.cell_world_center(cb), 0.2)
	t.parallel().tween_property(b, "position", board_view.cell_world_center(ca), 0.2)

# 鏆楀煙锛氱洰鏍囪鏀诲嚮鎵撴鏃讹紝鍗犳嵁鍏剁┖鍑虹殑鏍煎瓙锛堣繎浼?浜ゆ崲"锛?func _occupy_dead_cell(u: Unit, target: Unit) -> void:
	if u == null or not is_instance_valid(u) or not u.alive:
		return
	var c := target.cell
	if not grid.in_bounds(c):
		return
	# 鐩爣鍒氭銆佸皻鏈粠 occupancy 绉婚櫎锛堟贰鍑哄姩鐢讳腑锛夛細鍏佽鍗犳嵁鍏跺師鏍硷紱
	# 鑻ヨ鏍艰**鍏朵粬瀛樻椿鍗曚綅**鍗犳嵁鍒欐斁寮冦€?	if occupancy.has(c) and occupancy[c] != target:
		return
	occupancy.erase(u.cell)
	# 鐩爣宸叉锛屼粠 occupancy 绉婚櫎鍏跺師鏍煎崰鐢紝鍐嶈鏆楀煙鍏ヤ綅
	if occupancy.get(c) == target:
		occupancy.erase(c)
	u.cell = c
	occupancy[c] = u
	_trigger_bomb(u)   # 鐬Щ/鍗犳嵁鍒扮偢寮规牸锛氱偢寮逛汉浠ュ鍗冲紩鐖?	var t := create_tween()
	t.tween_property(u, "position", board_view.cell_world_center(c), 0.2)

# 鍑婚€€闅滅锛氭妸 oc 澶勯殰纰嶆部"from_cell -> oc"鐩寸嚎鎺ㄥ埌涓嬩竴绌烘牸锛堜繚鐣欒€愪箙锛夛紱鎺ㄤ笉鍔ㄨ繑鍥?false
func _knockback_obstacle(oc: Vector2i, from_cell: Vector2i) -> bool:
	if not obstacles.has(oc):
		return false
	var from_axial := grid.axial_of(from_cell)
	var oc_axial := grid.axial_of(oc)
	var step := oc_axial - from_axial
	if step == Vector2i.ZERO:
		return false
	var best := grid.offset_of(oc_axial + step)
	if not grid.in_bounds(best) or occupancy.has(best) or obstacles.has(best):
		return false
	var dur: int = obstacles[oc]
	obstacles.erase(oc)
	obstacles[best] = dur
	if board_view:
		board_view.obstacles = obstacles
		board_view.queue_redraw()
	return true

# 琛€閿佹媺闅滅锛氭妸 oc 澶勯殰纰嶆部"琛€閿?>闅滅"鍙嶆柟鍚戞媺杩戜竴鏍硷紙鏈濊閿佹柟鍚戯紱淇濈暀鑰愪箙锛夈€傛媺涓嶅姩杩斿洖 false銆?func _pull_obstacle(oc: Vector2i, from_cell: Vector2i) -> bool:
	if not obstacles.has(oc):
		return false
	var from_axial := grid.axial_of(from_cell)
	var oc_axial := grid.axial_of(oc)
	var step := oc_axial - from_axial
	if step == Vector2i.ZERO:
		return false
	var best := grid.offset_of(oc_axial - step)   # 鍙嶆柟鍚戯細鏈濊閿佽蛋涓€鏍?	if not grid.in_bounds(best) or occupancy.has(best) or obstacles.has(best):
		return false
	var dur: int = obstacles[oc]
	obstacles.erase(oc)
	obstacles[best] = dur
	if board_view:
		board_view.obstacles = obstacles
		board_view.queue_redraw()
	return true

func _pull_to(u: Unit, target: Unit) -> void:
	# 鐩爣宸茶创韬?璺濈1)锛氬凡鍦ㄨ閿侀潰鍓嶏紝鏃犻渶鍐嶆媺鍔紙閬垮厤鎶婂凡璐磋韩鐨勬晫浜哄啀浣嶇Щ涓€鏍硷級
	if grid.distance(u.cell, target.cell) <= 1:
		return
	# 娌?琛€閿?>鐩爣"杩炵嚎鏂瑰悜锛屾妸鐩爣鎷夊埌琛€閿侀潰鍓嶏紙绱ц创琛€閿併€佹湞鐩爣鏂瑰悜鐨勯偅涓€鏍硷級
	var best: Vector2i = Vector2i(-99, -99)
	var best_d := 99999
	for n in grid.neighbors(u.cell):
		if occupancy.has(n) or obstacles.has(n) or graves.has(n):
			continue
		var d := grid.distance(n, target.cell)
		if d < best_d:
			best_d = d
			best = n
	if best.x == -99:
		return
	_spawn_chain(u, target)   # 琛€閿侀摼瀛愬嬀鎷夋紨鍑猴紙浠庤閿佸皠鍚戠洰鏍囷級
	occupancy.erase(target.cell)
	target.cell = best
	occupancy[best] = target
	_trigger_bomb(target)   # 琚媺杩戝埌鐐稿脊鏍硷細鐐稿脊浜轰互澶栧嵆寮曠垎
	var t := create_tween()
	t.tween_property(target, "position", board_view.cell_world_center(best), 0.2)
	log_message.emit("琛€閿佹妸 %s 鎷夊埌闈㈠墠锛?s锛夈€? % [target.display_name, str(best)])

func _pierce_back(u: Unit, target: Unit) -> void:
	_pierce_line(u, target.cell)

# 浠?given_cell 涓烘敾鍑荤洰鏍囷紝绌块€忓叾韬悗鐩寸嚎鍒版鐩樿竟缂?func _pierce_line(u: Unit, target_cell: Vector2i) -> void:
	# 鐢ㄨ酱鍚戞柟鍚戣绠?鐩爣韬悗"鐨勭洿绾匡紝娌胯杞村悜绌块€忓埌妫嬬洏杈圭紭锛?	# 浼ゅ璺緞涓婄殑鎵€鏈夋晫浜猴紙鐪熸鐨勫叚杈瑰舰鐩寸嚎锛屼笉鍙楀垪閿欎綅褰卞搷锛夈€?	# 闅滅鐗╀笉鍐嶈鍓戞皵鐮村潖锛氬墤姘斿彧鏄┛杩囷紝涓嶉€犳垚鎶€鑳藉鍦板舰鏁堟灉銆?	var a := grid.axial_of(u.cell)
	var t := grid.axial_of(target_cell)
	var step := t - a   # 鐩爣鐩稿鏀诲嚮鑰呯殑杞村悜鍩烘湰姝ラ暱锛堥暱鍓戜负鐩搁偦鏀诲嚮锛屾闀夸负鍗曟锛?	if step == Vector2i.ZERO:
		return
	_spawn_sword_qi(u, step)
	var cur := t + step   # 鐩爣韬悗绗竴鏍?	for _i in 60:
		var off := grid.offset_of(cur)
		if not grid.in_bounds(off):
			break
		var v = occupancy.get(off, null)
		if v != null and v.alive and v.faction != u.faction:
			v.take_damage(u.effective_atk())
		cur += step

# 鍓戞皵婕斿嚭锛氫粠鏀诲嚮鑰呮部鐩爣鐩寸嚎鏂瑰悜椋炲埌灏藉ご鍚庢秷鏁?func _spawn_sword_qi(u: Unit, step: Vector2i) -> void:
	var start := board_view.cell_world_center(u.cell)
	var end_axial := grid.axial_of(u.cell) + step * 8
	var end := board_view.cell_world_center(grid.offset_of(end_axial))
	var dir := end - start
	var qi := SwordQi.new()
	qi.position = start
	qi.rotation = dir.angle()
	add_child(qi)
	var dur := clampf(dir.length() * 0.01, 0.22, 0.5)
	var t := create_tween()
	t.tween_property(qi, "position", end, dur).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	t.tween_callback(qi.queue_free)

# 瀣夌毊姝荤锛氶暟鍒€寮у舰鏀跺壊鈥斺€斾竴閬撳集鏈堝舰绱粦鑹插垁鍒冧粠姝荤鎵悜鐩爣鏂瑰悜锛屽垝杩囧姬绾垮悗娣″嚭銆?func _spawn_scythe(u: Unit, target: Unit) -> void:
	var start := board_view.cell_world_center(u.cell)
	var to := board_view.cell_world_center(target.cell)
	var dir := to - start
	var scy := ScytheBlade.new()
	scy.position = start
	scy.rotation = dir.angle()
	add_child(scy)
	var dur := clampf(dir.length() * 0.012, 0.22, 0.45)
	var reach := dir.length() + hex_size * 0.6
	var t := create_tween()
	t.tween_property(scy, "position", start + dir.normalized() * reach, dur).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	t.parallel().tween_property(scy, "scale", Vector2(1.15, 0.7), dur)   # 鏀跺壊鏃跺垁鍒冪暐寰帇涓?	t.parallel().tween_property(scy, "modulate:a", 0.0, dur)
	t.tween_callback(scy.queue_free)

# 琛€閿侀摼瀛愶細浠庤閿佸皠鍚戠洰鏍囥€侀殢鐩爣琚媺鍥炶€屾敹鎷㈢殑閾剧姸鍏夋潯锛堣创鍚?閾惧瓙鍕捐繃鏉?锛夈€?func _spawn_chain(u: Unit, target: Unit) -> void:
	var start := board_view.cell_world_center(u.cell)
	var tpos := board_view.cell_world_center(target.cell)
	var chain := BloodChain.new()
	chain.position = start
	chain.rotation = (tpos - start).angle()
	chain.length = (tpos - start).length()
	add_child(chain)
	var t := create_tween()
	t.tween_property(chain, "scale", Vector2(0.85, 0.5), 0.16).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)   # 鎷夎繎鏃堕摼瀛愭敹鎷?	t.parallel().tween_property(chain, "modulate:a", 0.0, 0.4)
	t.tween_callback(chain.queue_free)

func _random_step(v: Unit) -> void:
	var nbrs := grid.neighbors(v.cell)
	var options: Array = []
	for n in nbrs:
		# 鍙厑璁哥Щ鍔ㄥ埌鐣屽唴銆佷笖鏈鍗曚綅/闅滅/鐐稿脊/澧撶鍗犳嵁鐨勬牸
		if grid.in_bounds(n) and not occupancy.has(n) and not obstacles.has(n) and not bombs.has(n) and not graves.has(n):
			options.append(n)
	if options.size() > 0:
		var n: Vector2i = options[rng.randi() % options.size()]
		occupancy.erase(v.cell)
		v.cell = n
		occupancy[n] = v
		# 缂撴參绉诲姩鍔ㄧ敾锛岃€岄潪鐬Щ
		var t := create_tween()
		t.tween_property(v, "position", board_view.cell_world_center(n), 0.35)

func _summon_skeletons(u: Unit) -> void:
	var slots: Array = []
	for n in grid.neighbors(u.cell):
		if not occupancy.has(n):
			slots.append(n)
	var count := mini(2, slots.size())
	for i in count:
		var def := DataRegistry.get_summon("summon_skeleton")
		if def == null:
			return
		var s := Unit.new(def, u.faction, slots[i], hex_size * 0.9)
		s.position = board_view.cell_world_center(slots[i])
		s.hp_changed.connect(_on_unit_hp_changed)
		s.died.connect(_on_unit_died)
		s.modulate.a = 0.0
		add_child(s)
		units.append(s)
		occupancy[slots[i]] = s
		_trigger_bomb(s)   # 鍙敜鍒扮偢寮规牸锛氱偢寮逛汉浠ュ鍗冲紩鐖?var st := create_tween()
		st.tween_property(s, "modulate:a", 1.0, 0.3)
		log_message.emit("鍙敜浜嗛楂呭叺銆?)

func _heal_lowest_and_swap(u: Unit) -> bool:
	var best: Unit = null
	for v in units:
		if v.alive and v.faction == u.faction and v != u and v.hp < v.max_hp:
			if best == null or v.hp < best.hp:
				best = v
	if best != null:
		_heal(best, 8)
		_swap_units(u, best)
		return true
	return false   # 鏃犲彲娌荤枟鐨勫彈浼ら槦鍙嬶細鎶€鑳芥湭鐢熸晥

func _hurt_lowest_enemy_stun(u: Unit) -> bool:
	var best: Unit = null
	for v in units:
		if v.alive and v.faction != u.faction:
			if best == null or v.hp < best.hp:
				best = v
	if best != null:
		best.take_damage(3)
		_add_status_msg(best, "stun", "鐪╂檿")
		return true
	return false   # 娌℃湁鏁屾柟鐩爣锛氭妧鑳芥湭鐢熸晥

# 鍙ょ伒绮炬€細鎶婂崟浣嶅畬鏁磋繕鍘熶负鏈簮鑻遍泟锛坔ero_id/鏁板€?鎶€鑳?琛屼负鑴氭湰/鍚嶇О锛夛紝
# 渚?鍥炲悎寮€濮嬪洖婧湰婧?涓?姣忔鍙樿韩鍓嶉噸缃?鍏辩敤銆傝嫢鍙繕鍘?hero_id锛?# 琛屼负鑴氭湰浼氬仠鐣欏湪涓婁竴鍙樿韩鐨勮嫳闆勪笂锛屽鑷翠笅鍥炲悎鏃犳硶鍐嶆鍙樿韩銆?# 椋庤鑰呭厜鐜瓑鎸?hero_id 鐨勫垽瀹氬叏閮ㄥけ鏁堛€?func _apply_base_hero(u: Unit, hid: String) -> void:
	var bdef := DataRegistry.get_hero(hid)
	if bdef == null:
		return
	u.skills = bdef.skills.duplicate()
	u.atk = bdef.atk + u.perm_atk   # 淇濈暀姘镐箙鏀诲嚮鍔犳垚锛堟崱閲戝潡/鏀诲嚮閬撳叿/娑岀數锛夛紝涓嶈閲嶇疆
	u.move_range = bdef.move_range
	if bdef.skills.has(DataRegistry.Skill.SWIFT):
		u.move_range += 1
	u.attack_range = bdef.attack_range
	u.attack_type = bdef.attack_type
	u.display_name = bdef.display_name
	u.behavior = HeroRegistry.create(hid)
	u.behavior.setup(self, u)

# 鍙ょ伒绮炬€細闅忔満鍙樹负宸辨柟闃熶紞涓殑涓€鍚嶅叾浠栬鑹诧紝鏆傛椂鑾峰緱鍏舵妧鑳戒笌鏁板€?func _transform(u: Unit, picked_override: String = "") -> void:
