const DEFAULT_DECK_SIZE := 5

func _default_deck() -> Array:
	var ids := DataRegistry.heroes.keys()
	ids.sort()
	var out: Array = []
	for i in mini(DEFAULT_DECK_SIZE, ids.size()):
		out.append(ids[i])
	return out
const LOSS_DEATH_COUNT := 3   # 涓€鏂圭疮璁?3 鍚嶈嫳闆勯樀浜″嵆鍒よ礋

# 鏇胯ˉ涓庨樀浜＄粺璁?var player_roster: Array = []   # 鎴戞柟鏇胯ˉ鑻遍泟 id锛堝皻鏈笂鍦猴級
var enemy_roster: Array = []    # 鏁屾柟鏇胯ˉ鑻遍泟 id
