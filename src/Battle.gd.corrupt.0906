		return   # 鏇胯ˉ闈㈡澘宸插湪杩涜锛氭湰娆¤惤浣嶅悗浼氳嚜鍔ㄥ紑涓嬩竴涓?	_pending_player_subs -= 1
	_begin_substitution()

func _begin_substitution() -> void:
	_sub_faction = _my_faction()
	state = State.SUBSTITUTING
	sub_select_requested.emit()
	action_info.emit("鏈夎嫳闆勯樀浜★紒浠庢浛琛ラ槦浼嶄腑閫夋嫨涓€鍚嶄笂闃点€?)

func _on_sub_pick(hero_id: String) -> void:
	var roster := _roster_of(_sub_faction)
	if not roster.has(hero_id):
		return
	_pending_sub = hero_id   # 涓嶄粠姝ゅ鎵?roster锛堣惤浣?_place_sub 鎵嶆墸锛屼笖涓ょ涓€鑷达級
	state = State.PLACE_SUB
	# 楂樹寒鍙湪鍑虹敓鍦版斁缃殑鏍煎瓙 + **鏈柟**澧撶鏍硷紙涓嶈兘钀藉湪瀵规柟澧撶涓婏級
	var pc := {}
	for c in _spawn_cells(_sub_faction):
		pc[c] = Color(0.2, 0.85, 0.5, 0.7)
	for c in graves.keys():
		var gd = graves[c]
		var my_grave: bool = typeof(gd) != TYPE_DICTIONARY or int(gd.get("fn", -1)) == _sub_faction
		if my_grave and not pc.has(c):
			pc[c] = Color(0.75, 0.6, 0.35, 0.8)   # 鏈柟澧撶鏍硷細鍦熼粍鑹?	_preview_cells = pc
	_apply_highlights()
	action_info.emit("閫夋嫨 %s 鐨勭櫥鍦轰綅缃紙缁挎牸=鍑虹敓鍦帮紝鍦熼粍鏍?鏈柟闃典骸澧撶澶勶級銆? % DataRegistry.get_hero(hero_id).display_name)

func _try_place_sub(cell: Vector2i) -> bool:
	if _pending_sub == "":
		return false
	# 澧撶鍙惤浣嶏紝浣嗗彧鍏佽鏈柟澧撶锛堝鏂瑰纰戜笉鑳戒綔涓烘浛琛ョ櫥鍦虹偣锛?	var on_grave := false
	if graves.has(cell):
		var gd = graves[cell]
		on_grave = typeof(gd) != TYPE_DICTIONARY or int(gd.get("fn", -1)) == _sub_faction
	if not on_grave and not _in_spawn_cell(cell, _sub_faction):
		return false
	if occupancy.has(cell):
		return false
	var hid := _pending_sub
	var fn := _sub_faction
	_pending_sub = ""
	# 鑱旀満锛氫富鏈烘潈濞併€傚鎴风鍙彂鎸囦护锛堜笉鏈湴鎵ц锛夛紝涓绘満鎵ц+骞挎挱锛屽鎴风鏀跺埌鍐嶉噸婕斻€?	if GameState.is_online and not GameState.is_host:
		_apply_sub_ui_cleanup(fn)
		NetBus.send_to(1, JSON.stringify({ "type": "sub", "faction": fn, "hero": hid, "cell": [cell.x, cell.y] }))
		return true
	# 涓绘満/鍗曟満锛氭湰鍦拌惤浣?	_place_sub(fn, hid, cell)
	if GameState.is_online:
		NetBus.send_all(JSON.stringify({ "type": "sub", "faction": fn, "hero": hid, "cell": [cell.x, cell.y] }))
	return true

# 瀹㈡埛绔偣"鏀剧疆"鍚庡厛娓呯悊鏈湴閫変腑/楂樹寒/鍏抽棴闈㈡澘锛堢瓑寰呬富鏈哄箍鎾噸婕旓紝涓嶅湪鏈湴鐪熸钀戒綅锛夈€?func _apply_sub_ui_cleanup(fn: int) -> void:
	_preview_cells = {}
	_apply_highlights()
	if _sub_faction == fn:
		_sub_faction = -1
	sub_placed.emit()
	_resume_after_sub()   # 鎭㈠鍥炲悎鐘舵€侊紙鏈淇濇寔杈撳叆锛岀瓑寰呬富鏈哄箍鎾洖鏉ワ級

# 鏉冨▉钀戒綅锛堜袱绔竴鑷存墽琛岋級锛歴pawn + 鏀跺熬锛堟竻澧撶/鎭㈠鍥炲悎/骞挎挱锛夈€?func _place_sub(fn: int, hero_id: String, cell: Vector2i) -> void:
	var roster := _roster_of(fn)
	roster.erase(hero_id)
	var nu := _spawn_unit(hero_id, fn, cell)
	_trigger_on_enter(nu)   # 鏇胯ˉ鐧诲満鎶€鑳斤紙娉㈢浘/澶槼鏂?姊呮灄/鐚庨鑰咃級
	_preview_cells = {}
	_apply_highlights()
	log_message.emit("鏇胯ˉ鐧诲満锛?s銆? % DataRegistry.get_hero(hero_id).display_name)
	# 鍙竻闄?鏈钀戒綅鍗犵敤鐨勮繖搴у纰?锛涘悓闃佃惀鍏朵粬澧撶淇濈暀鍒板叾鏇胯ˉ瀹屾垚
	# 锛堝悓鏃堕樀浜″浜烘椂閫愪釜鏇胯ˉ锛岀浜屼汉鐨勫纰戜笉鑳芥彁鍓嶆秷澶憋級銆?	if graves.has(cell):
		graves.erase(cell)
		_refresh_board()
	_sub_faction = -1
	sub_placed.emit()   # 閫氱煡 HUD 鍏抽棴鏇胯ˉ閫変汉闈㈡澘
	state = State.IDLE   # 娓呮帀 PLACE_SUB 鍗犱綅锛氬厑璁?鍚屾椂闃典骸澶氫汉"鏃剁户缁脊涓嬩竴涓浛琛?	# 鍚屾椂闃典骸澶氬悕闃熷弸锛氭湰鍚嶉琛ュ畬鍚庤嫢杩樻湁寰呰ˉ鍚嶉锛岀户缁脊涓嬩竴涓浛琛ラ潰鏉匡紝鑰屼笉鏄洿鎺ユ仮澶嶅洖鍚堛€?	# 娉ㄦ剰锛氳繛缁浛琛ユ湡闂?*涓嶅埛鏂?*甯搁┗"鏇胯ˉ闃熶紞"闈㈡澘锛堥伩鍏嶅畠鍜屾浛琛ラ潰鏉块噸鍙狅級锛?	# 甯搁┗闈㈡澘鐣欏埌鏈€鍚庝竴涓浛琛ュ畬鎴愬悗鍐嶅埛鏂般€?	var more_subs := _pending_player_subs > 0 and fn == _my_faction() and _my_roster().size() > 0
	if more_subs:
		_try_begin_next_sub()
	else:
		_resume_after_sub() # 鎭㈠鍥炲悎鐘舵€?_notify_team()      # 鍏ㄩ儴鏇胯ˉ瀹屾垚鍚庯細鍒锋柊甯搁┗"鏇胯ˉ闃熶紞"闈㈡澘
	# 鍙湁"纭疄娌℃湁涓嬩竴涓浛琛?鏃舵墠娓呯悊璇ラ樀钀ュ墿浣欏纰戯紙鍚﹀垯绗簩浜虹殑澧撶浼氳鎻愬墠鎶规帀锛夈€?	if not more_subs:
		var fn_done := _roster_of(fn).size() == 0
		if fn == _my_faction():
			if fn_done:
				_pending_player_subs = 0   # 鏇胯ˉ鑰楀敖锛氭竻绌哄墿浣欏悕棰濓紝閬垮厤娈嬬暀
			fn_done = fn_done or _pending_player_subs <= 0
		if fn_done:
			_clear_side_graves(fn)

# 娓呴櫎鏌愪竴鏂圭殑鍏ㄩ儴澧撶锛堣鏂规浛琛ュ凡鍏ㄩ儴琛ュ畬鏃惰皟鐢級
func _clear_side_graves(fn: int) -> void:
	var changed := false
	for g in graves.keys():
		var gd = graves[g]
		if typeof(gd) == TYPE_DICTIONARY and int(gd.get("fn", -1)) == fn:
			graves.erase(g)
			changed = true
	if changed:
		_refresh_board()

func _resume_after_sub() -> void:
	# 鎭㈠娴佺▼锛氭湰杞槸鍚︽垜鏂硅鍔ㄣ€傛槸鎴戞柟鍥炲悎 -> 鍥炲埌鎴戞柟杈撳叆锛涘惁鍒欑瓑寰呭鏂?AI銆?	if GameState.active_side == _my_side():
		state = State.PLAYER_INPUT
		if _has_remaining_player():
			action_info.emit("缁х画浣犵殑鍥炲悎銆?)
		else:
			# 鎵€鏈夎嫳闆勫凡琛屽姩瀹岋細涓嶈嚜鍔ㄧ粨鏉燂紝鎻愮ず鐜╁鎵嬪姩鐐广€岀粨鏉熷洖鍚堛€?action_info.emit("鎵€鏈夎嫳闆勫凡瀹屾垚琛屽姩锛岀偣銆岀粨鏉熷洖鍚堛€嶄氦缁欐晫鏂广€?)
	else:
		state = State.ENEMY_TURN
		if GameState.is_online:
			action_info.emit("绛夊緟瀵规柟琛屽姩鈥︹€?)
			enemy_turn_waiting.emit()
		else:
			action_info.emit("鏁屾柟鍥炲悎鈥︹€?)

# 涓诲姩鎾や笅锛堟彁浜ゅ叆鍙ｏ紝浠呮湰绔搷浣滄椂璋冪敤锛夛細鏍￠獙鍚庢墽琛岋紝鑱旀満璧扮綉浠ゅ悓姝ャ€?func _withdraw_unit(u: Unit) -> void:
	if state != State.PLAYER_INPUT:
		return
	if u == null or not u.alive or u.faction != _my_faction():
		action_info.emit("璇峰厛閫変腑涓€鍚嶆垜鏂硅嫳闆勶紝鍐嶇偣鍑汇€屾挙涓嬨€嶃€?)
		return
	if not GameState.is_online:
		_apply_withdraw(u)
		return
	# 鑱旀満锛氫富鏈烘潈濞佹墽琛?骞挎挱锛涘鎴风鍙彂鎸囦护缁欎富鏈恒€?	# 绱㈠紩蹇呴』鍦?_apply_withdraw 涔嬪墠鍙栵細鎵ц鍚?u 宸蹭粠 units 绉婚櫎锛屽啀 find 鍙細寰楀埌 -1锛?	# 瀵圭鎸?-1 鎵句笉鍒板崟浣?-> 鎾や笅涓嶅悓姝ワ紙浣嗗悗缁?sub 鏄唴瀹瑰鍧€锛岀収甯稿悓姝ワ紝褰㈡垚"鍙笂浜嗘柊鑻遍泟"鐨勫亣璞★級銆?	var w_idx := units.find(u)
	if GameState.is_host:
		_apply_withdraw(u)
		if w_idx >= 0:
			NetBus.send_all(JSON.stringify({ "type": "withdraw", "u": w_idx }))
	else:
		if w_idx >= 0:
			NetBus.send_to(1, JSON.stringify({ "type": "withdraw", "u": w_idx }))

# 鎾や笅鐨勬潈濞佹墽琛岋紙涓ょ涓€鑷达級锛氫粎鏈鍥炲悎鍙Е鍙戞湰绔嫳闆勬挙涓嬶紱鐪熸绉婚櫎鍗曚綅璧?_on_unit_died锛?# 姝讳骸鏂瑰睘浜庤皝銆佺敱璋佹浛琛ワ紝鐢?_on_unit_died 鐨勮瑙掑寲閫昏緫淇濊瘉涓ょ涓€鑷淬€?func _apply_withdraw(u: Unit) -> void:
	if u == null or not is_instance_valid(u) or not u.alive:
		return
	log_message.emit("%s 琚富鍔ㄦ挙涓嬶紙瑙嗕负闃典骸锛夈€? % u.display_name)
	var mine := u.faction == _my_faction()
	if mine:
		_clear_selection()
		state = State.ANIMATING   # 浠呮挙涓嬫柟闇€瑕侀攣杈撳叆锛涘绔彧鏄湅鍒板鏂规挙涓嬶紝鍥炲悎鐘舵€佷笉鍔?	u.alive = false
	_on_unit_died(u, false)   # 涓诲姩鎾や笅锛氫笉绔嬪纰戯紱琛ヤ綅/鑳滆礋鐢?_on_unit_died 澶勭悊
	if state == State.ENDED:
		return
	if not mine:
		return   # 瀵圭瑙嗚锛氬彧绉婚櫎璇ュ崟浣嶏紝涓嶅垏鎹㈡湰绔洖鍚堢姸鎬侊紙绛夋挙涓嬫柟鐨?sub 骞挎挱锛?	# 鎾や笅鏂规敹灏撅細_on_unit_died 鍦ㄦ湰鏂瑰洖鍚堝唴宸茶繘鍏ユ浛琛ユ祦绋嬪垯鐩存帴杩斿洖锛岄伩鍏嶉噸澶嶅脊绐?	if state == State.SUBSTITUTING or state == State.PLACE_SUB:
		return
	if _my_roster().size() > 0:
		_pending_player_subs += 1
		_try_begin_next_sub()   # 鎾や笅涓€浜轰篃绠椾竴涓浛琛ュ悕棰濓紱涓嶅湪鏇胯ˉ娴佺▼涓垯鐩存帴寮€濮?	else:
		action_info.emit("宸叉棤鏇胯ˉ锛屾湰闃靛噺灏戜竴鍚嶈嫳闆勩€?)
		_resume_after_sub()

# 鎸夐挳鍏ュ彛锛氭挙涓嬪綋鍓嶉€変腑鐨勬垜鏂硅嫳闆?func _withdraw_player_unit() -> void:
	_withdraw_unit(selected)

# ---- 鎷栨嫿鎾や笅锛堢偣鍑昏嫳闆勬寜浣忔嫋鍒板嚭鐢熺偣閲婃斁锛?----
func _begin_drag(u: Unit) -> void:
	if _drag_unit != null or u == null or not u.alive:
		return
	_drag_unit = u
	_drag_start_mouse = get_global_mouse_position()
	_drag_orig_pos = u.position
	_dragging = false
	_clear_selection()
	u.z_index = 30

func _drag_follow() -> void:
	if _drag_unit == null or not is_instance_valid(_drag_unit) or not _drag_unit.alive:
		_cancel_drag()
		return
	if not _dragging and get_global_mouse_position().distance_to(_drag_start_mouse) > _DRAG_THRESHOLD:
		_dragging = true
		action_info.emit("鎶婅嫳闆勬嫋鍒版渶涓嬫柟锛堝嚭鐢熺偣涔嬩笅锛夋澗寮€鍗冲彲鎾や笅銆?)
		_show_drag_highlight()
	if _dragging:
		_drag_unit.position = get_global_mouse_position()

func _show_drag_highlight() -> void:
	# 楂樹寒"鏈鎴戞柟"鍑虹敓鍖猴紙鑱旀満涓绘満=钃?瀹㈡埛绔?绾紱鍗曟満=鐜╁锛夛紝鎾や笅鍒拌鍖轰笅鏂瑰嵆鍙€?	var pc := {}
	for c in _spawn_cells(_my_faction()):
		pc[c] = Color(0.2, 0.9, 0.5, 0.85)
	_preview_cells = pc
	_apply_highlights()

func _clear_drag_highlight() -> void:
	_preview_cells = {}
	_apply_highlights()

func _finish_drag() -> void:
	if _drag_unit == null:
		return
	var u := _drag_unit
	var was_dragging := _dragging
	_drag_unit = null
	_dragging = false
	if not is_instance_valid(u) or not u.alive:
		return
	u.z_index = 2
	_clear_drag_highlight()
	if was_dragging:
		# 鎷栧埌鍑虹敓鐐逛笅鏂癸紙妫嬬洏鏈€涓嬫部涔嬪锛夊嵆鎾や笅
		if get_global_mouse_position().y >= _player_spawn_drop_y():
			u.position = _drag_orig_pos
			_withdraw_unit(u)
		else:
			u.position = _drag_orig_pos
			action_info.emit("鏈嫋鍒板嚭鐢熺偣涓嬫柟锛屻€屾挙涓嬨€嶅凡鍙栨秷銆?)
	else:
		# 娌℃湁鎷栧姩 -> 瑙嗕负鏅€氱偣鍑婚€変腑
		_on_cell_clicked(u.cell)

# 鏈"鎴戞柟"鍑虹敓鐐规墍鍦ㄨ鐨勫叏灞€ y锛堝嚭鐢熺偣涓嬫柟鍗虫挙涓嬪尯锛夈€傝繑鍥炶琛屼腑蹇冪殑鏈€澶?y銆?# 鐢ㄦ湰绔瑙掞細涓绘満=鐜╁琛岋紙灞忓箷涓嬫柟锛夛紝瀹㈡埛绔?绾㈡柟鍑虹敓鍖猴紙缈昏浆鍚庡悓鏍蜂綅浜庡睆骞曚笅鏂癸級銆?func _player_spawn_drop_y() -> float:
	var maxy := -INF
	for c in _spawn_cells(_my_faction()):
		maxy = max(maxy, board_view.cell_world_center(c).y)
	return maxy

func _cancel_drag() -> void:
	if _drag_unit != null and is_instance_valid(_drag_unit):
		_drag_unit.z_index = 2
		_drag_unit.position = _drag_orig_pos
	_drag_unit = null
	_dragging = false
	_clear_drag_highlight()

func _free_spawn_cell(faction: int) -> Vector2i:
	# 浼樺厛鍦ㄦ湰鏂瑰嚭鐢熷尯鍐呯殑鏈柟澧撶鏍艰惤浣嶏紙闃典骸鍘熷湴琛ヤ綅锛夛紝鍐嶅彇鏅€氱┖鏍?	for c in graves.keys():
		var info = graves[c]
		var fn := -1
		if typeof(info) == TYPE_DICTIONARY:
			fn = int(info.get("fn", -1))
		if fn == faction and _in_spawn_cell(c, faction) and not occupancy.has(c):
			return c
	var free: Array = []
	for c in _spawn_cells(faction):
		if not occupancy.has(c):
			free.append(c)
	if free.size() == 0:
		return Vector2i(-99, -99)
	# 鏁屾柟锛氬垎鏁ｈ惤浣嶁€斺€旈€変笌"宸查儴缃叉晫鏂瑰崟浣嶆墍鍦ㄥ垪"鏈€杩滅殑绌哄垪锛屾í鍚戞媺寮€銆侀伩鍏嶆墡鍫嗕粠宸﹀埌鍙?	if faction == DataRegistry.Faction.ENEMY:
		var best: Vector2i = free[0]
		var best_d := -1
		for c in free:
			var mind := 999999
			for u in units:
				if u.alive and u.faction == DataRegistry.Faction.ENEMY and abs(u.cell.x - c.x) < mind:
					mind = abs(u.cell.x - c.x)
			# 鏃犲凡閮ㄧ讲鍗曚綅鏃讹紝浼樺厛鍙栨渶澶栦晶鍒楋紙杈圭紭锛夛紝涔嬪悗閫愭鍚戝唴
			if mind == 999999:
				mind = max(c.x, grid.width - 1 - c.x)
			if mind > best_d:
				best_d = mind
				best = c
		return best
	# 鍏朵粬闃佃惀锛氬彇绗竴涓┖鏍?	return free[0]

func _in_spawn_cell(cell: Vector2i, faction: int) -> bool:
	return _spawn_cells(faction).has(cell)

func _spawn_cells(faction: int) -> Array:
	var out: Array = []
	if faction == DataRegistry.Faction.PLAYER:
		var row := grid.height - 1
		for c in grid.width:
			var cell := Vector2i(c, row)
			if grid.in_bounds(cell):
				out.append(cell)
	else:
		# 鏁屾柟鍑虹敓鍖猴紙椤堕儴锛歳ow 0 = 椤跺附琛岋紝row 1 = 绗竴婊¤锛夛紝鍒楄法 0..6
		var ecells: Array = [
			Vector2i(0, 1), Vector2i(1, 0), Vector2i(2, 1), Vector2i(3, 0),
			Vector2i(4, 1), Vector2i(5, 0), Vector2i(6, 1),
		]
		for c in ecells:
			if grid.in_bounds(c) and not occupancy.has(c):
				out.append(c)
	return out

func _spawn_benchbackup(hero_id: String, side: int, grave: Vector2i) -> void:
	var def := DataRegistry.get_hero(hero_id)
	if def == null:
		return
	var u := Unit.new(def, side, grave, hex_size * 0.9)
	if def.skills.has(DataRegistry.Skill.SWIFT):
		u.move_range += 1
	u.position = board_view.cell_world_center(grave)
	u.hp_changed.connect(_on_unit_hp_changed)
	u.damaged.connect(_on_unit_damaged)
	u.died.connect(_on_unit_died)
	u.modulate = Color(0.6, 1.0, 0.6, 1.0)   # 鏇胯ˉ鍏ュ満鐨勬爣璁拌壊
	var t := create_tween()
	u.modulate.a = 0.0
	add_child(u)
	units.append(u)
	occupancy[grave] = u
	t.tween_property(u, "modulate:a", 1.0, 0.3)
	log_message.emit("%s 鏇胯ˉ鐧诲満锛?s锛夈€? % [def.display_name, "鎴戞柟" if side == DataRegistry.Faction.PLAYER else "鏁屾柟"])
	# 鏇胯ˉ鐧诲満鏁堟灉
	_trigger_on_enter.call_deferred(u)

# ---- 寮哄姏 AI锛氭悳绱㈡晫鏂规湰鍥炲悎鍏ㄩ儴鎿嶄綔骞舵墦鍒嗭紝鎵ц鏈€浼樺簭鍒?----
func _run_enemy_turn() -> void:
	var my_session := _session_id   # 璁板綍鏈鍥炴斁鎵€灞炰細璇濓紝閲嶅紑鍚庝細鍙?	if get_tree() == null:
		return   # 鍦烘櫙宸查噴鏀撅紙鐐瑰嚮閲嶅紑/reload锛夛細瀹夊叏閫€鍑?	await get_tree().create_timer(0.5).timeout
	if my_session != _session_id:
		return   # 宸查噸寮€锛氭湰浼氳瘽浣滃簾锛屽畨鍏ㄩ€€鍑?	# 鏋勫缓妯℃嫙蹇収锛堜笌 units 椤哄簭涓€鑷达紝鐢ㄤ簬鍥炴斁鏄犲皠锛?	var refs: Array = units.duplicate()
	var descs: Array = []
	var occ_snap := {}
	for i in units.size():
		var u: Unit = units[i]
		descs.append({
			"fn": u.faction, "hero": u.hero_id, "cell": u.cell, "hp": u.hp, "max_hp": u.max_hp,
			"atk": u.atk, "eatk": u.effective_atk(), "move": u.move_range, "emove": u.effective_move(),
			"atk_range": u.attack_range,
			"atk_type": u.attack_type, "skills": u.skills, "name": u.display_name,
			"stunned": u.has_status("stun"), "silenced": u.has_status("silence"),
			"shield": u.has_status("shield"), "heavy": u.has_status("heavy"),
			"poisoned": u.has_status("poison"), "frozen": u.has_status("freeze"),
		})
		occ_snap[u.cell] = i

	var ai := BattleAI.new(grid)
	ai.difficulty = GameState.ai_difficulty
	# 閲戠熆锛坆uff_items[cell]=="gold"锛変緵 AI 鍙傝€冿紝璁╅粍閲戠熆宸ヤ紭鍏堣蛋杩囧幓鎷惧彇
	var gold_snap := {}
	for c in buff_items.keys():
		if buff_items[c] == "gold":
			gold_snap[c] = true
	# 澧撶锛堥樀浜℃牸锛変緵 AI 鍙傝€冿細闃绘尅绉诲姩锛屼笉鍙惤鍋?	var grave_snap := {}
	for c in graves.keys():
		grave_snap[c] = true
	# 闅滅鐗╀緵 AI 鍙傝€冿細闃绘尅绉诲姩涓庢敾鍑昏绾?	var obstacle_snap := {}
	for c in obstacles.keys():
		obstacle_snap[c] = true
	var sim := ai.build_state(descs, occ_snap, gold_snap, grave_snap, obstacle_snap)
	var plan: Array = ai.search(sim, DataRegistry.Faction.ENEMY)

	# 鍥炴斁鎵ц鏈€浼樺簭鍒?	for step in plan:
		if GameState.match_over:
			break
		if my_session != _session_id:
			return   # 宸查噸寮€锛氬畨鍏ㄩ€€鍑猴紝閬垮厤璁块棶宸查噴鏀惧崟浣?await _wait_sub_done()   # 鑻ュ湪鏇胯ˉ娴佺▼鍒欐殏鍋滐紝绛夌帺瀹堕€夊ソ骞惰惤浣?var idx: int = step["idx"]
		if idx < 0 or idx >= refs.size():
			continue
		var u: Unit = refs[idx]
		if not is_instance_valid(u) or not u.alive:
			continue
		var a: Dictionary = step["action"]
		if a.has("move") and a["move"] != null:
			_do_move(u, a["move"], true)
			await _wait_action_done()   # 绛夊緟绉诲姩鍔ㄧ敾鐪熸鎾畬锛堜笌鐜╁渚ц妭濂忎竴鑷达級
		if a.has("atk") and int(a["atk"]) >= 0:
			var t_idx := int(a["atk"])
			if t_idx >= 0 and t_idx < refs.size() and is_instance_valid(refs[t_idx]):
				var t: Unit = refs[t_idx]
				if t.alive and t.faction != DataRegistry.Faction.ENEMY and is_instance_valid(u):
					# 鍙厑璁告敾鍑诲綋鍓嶅皠绋嬪唴鐨勭洰鏍囷紙闃插尽AI璁″垝鍋忓樊/绉诲姩澶辫触瀵艰嚧瓒婄晫鏀诲嚮锛?if _in_attack_range(u, t):
						_do_attack(u, t, true)
						await _wait_action_done()   # 绛夊緟鏀诲嚮锛堝惈鍙嶅嚮锛夋紨鍑哄畬鍏ㄧ粨鏉?
	if not _check_win():
		await _trigger_turn_end_all(DataRegistry.Faction.ENEMY)
		_clear_statuses(DataRegistry.Faction.ENEMY)
		_settle_side_round_damage(GameState.SIDE_ENEMY)   # 绗?1鍥炲悎璧凤細鏁屽崐鍥炲悎缁撴潫鍙墸鏁屾柟
		GameState.end_current_side(_first_side)
		# 鎹㈣竟鍋滈】锛氭晫鏂硅鍔ㄥ畬姣?鈫?鎴戞柟鍥炲悎寮€濮嬭鍔ㄤ箣闂寸暀鍑洪棿闅旓紙涓庣帺瀹剁粨鏉熷洖鍚堜竴鑷达級
		await get_tree().create_timer(0.8).timeout
		_begin_side(GameState.SIDE_PLAYER)

# 鏇胯ˉ娴佺▼鏈熼棿鏆傚仠鏁屾柟 AI 鎵ц锛堣疆璇㈢洿鍒版浛琛ョ粨鏉燂級
func _wait_sub_done() -> void:
	var my_session := _session_id
	while state == State.SUBSTITUTING or state == State.PLACE_SUB:
		if my_session != _session_id:
			return   # 宸查噸寮€锛氬畨鍏ㄩ€€鍑?if get_tree() == null:
			return   # 宸茶劚绂诲満鏅爲锛氬仠姝㈣疆璇紝閬垮厤璁块棶 null get_tree()
		await get_tree().process_frame

# 绛夊緟鏁屾柟鍗曚綅鐨勪竴鎷涘姩鐢绘挱瀹岋紙绉诲姩/鏀诲嚮锛夈€備俊鍙蜂笌瓒呮椂绔為€燂細
# 姝ｅ父鎯呭喌涓?_finish_move/_finish_attack 浼氬彂灏?action_finished锛岀珛鍗宠繑鍥烇紱
# 鑻ラ槻寰¤矾寰勬紡鍙戝皠锛堝崟浣嶈閲婃斁銆佸紓甯告彁鍓嶈繑鍥炵瓑锛夛紝1.5s 瓒呮椂鍏滃簳锛岄伩鍏嶅洖鏀炬案涔呮寕璧枫€?func _wait_action_done() -> void:
	var my_session := _session_id
	var done := [false]   # 鐢ㄦ暟缁勬壙杞斤細lambda 鏀瑰厓绱犱笉瑙﹀彂"閲嶈祴鍊兼崟鑾?娣锋穯
	action_finished.connect(func(): done[0] = true, CONNECT_ONE_SHOT)
	if get_tree() == null:
		return   # 宸茶劚绂诲満鏅爲锛氱洿鎺ヨ繑鍥?	var limit := get_tree().create_timer(3.0)
	while not done[0] and not limit.time_left <= 0.0:
		if my_session != _session_id:
			return   # 宸查噸寮€锛氬畨鍏ㄩ€€鍑?if get_tree() == null:
			return   # 宸茶劚绂诲満鏅爲锛氬仠姝㈣疆璇?await get_tree().process_frame
