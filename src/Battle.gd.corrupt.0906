var _time_sync_acc := 0.0          # 琛屽姩鏂瑰墿浣欐椂闂村箍鎾妭娴佺疮鍔犲櫒

## 璁剧疆闅忔満绉嶅瓙锛堣仈鏈轰富鏈虹敤锛夛細鍚屼竴杈撳叆+鍚岀瀛?=> 鍙屾柟缁撴灉涓€鑷淬€傚崟鏈轰笉璋冪敤鍒欎繚鎸侀粯璁ら殢鏈恒€?
func set_random_seed(seed_value: int) -> void:
	rng.seed = seed_value

# 鐢?rng 娲楃墝锛堟浛浠?Array.shuffle 鐨勫叏灞€闅忔満锛屼繚璇佽仈鏈哄悓绉嶅瓙涓嬩袱绔竴鑷达級
func _rng_shuffle(arr: Array) -> void:
	for i in range(arr.size() - 1, 0, -1):
		var j := rng.randi_range(0, i)
		var tmp = arr[i]
		arr[i] = arr[j]
		arr[j] = tmp

