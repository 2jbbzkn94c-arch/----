		if u.faction != DataRegistry.Faction.ENEMY:
			continue
		if u.skills.has(DataRegistry.Skill.TAUNT):
			has_taunt = true
			live_melee += 1
		elif u.attack_type == DataRegistry.AttackType.MELEE:
			live_melee += 1
		if u.hp < u.max_hp:
